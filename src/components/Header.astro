---
import { site } from '../data/site';
import { industries } from '../data/industries';
import { personas } from '../data/personas';
import type { PersonaId } from '../data/personas';
import { hasPersonaDetail } from '../data/personaDetails';

interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;

/* Who We Serve dropdown — mirrors the hub's team order. Entries auto-enable
   (full opacity, clickable) once a persona's detail page exists. */
const wssOrder: PersonaId[] = ['marketing', 'operations', 'technology', 'finance', 'facilities', 'leadership'];
const whoWeServeChildren = wssOrder.map((id) => {
  const p = personas.find((x) => x.id === id)!;
  return { href: `/who-we-serve/${id}`, label: p.label, comingSoon: !hasPersonaDetail(id) };
});

const nav = [
  { href: '/platform', label: 'Platform' },
  {
    href: '/industries',
    label: 'Industries',
    children: industries.map((i) => ({ href: `/industries/${i.slug}`, label: i.name })),
  },
  { href: '/who-we-serve', label: 'Who We Serve', children: whoWeServeChildren },
  {
    href: '/resources',
    label: 'Resources',
    children: [
      { href: '/blog', label: 'Blog' },
      { href: '/resources/case-studies', label: 'Case studies' },
      { href: 'https://www.lucisystems.com/the-signal/home', label: 'Newsletter', external: true },
      { href: 'https://support.lucisystems.com', label: 'Support portal', external: true },
    ],
  },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
---

<header class:list={['site-header', dark && 'site-header--on-hero']}>
  <div class="site-header__inner container container--wide">
    <a class="site-header__logo" href="/">
      <img
        class="site-header__logoimg site-header__logoimg--dark"
        src="/images/logos/luci-full-mintmark-white.png"
        alt="LUCI Systems"
        width="2224"
        height="571"
        loading="eager"
      />
      <img
        class="site-header__logoimg site-header__logoimg--light"
        src="/images/logos/luci-full-mintmark-blacktext.png"
        alt="LUCI Systems"
        width="2224"
        height="571"
        loading="eager"
      />
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      {
        nav.map((item) =>
          item.children ? (
            <div class="site-header__item site-header__item--menu">
              <a
                class:list={[
                  'site-header__link',
                  path.startsWith(item.href) && item.href !== '/' && 'is-active',
                ]}
                href={item.href}
              >
                {item.label}<span class="site-header__caret" aria-hidden="true">▾</span>
              </a>
              <div class="site-header__dropdown" role="menu">
                {item.children.map((child) => (
                  child.comingSoon ? (
                    <span
                      class="site-header__dropdown-item site-header__dropdown-item--soon"
                      role="menuitem"
                      aria-disabled="true"
                    >
                      <span>{child.label}</span>
                      <em class="site-header__soon">Coming soon</em>
                    </span>
                  ) : (
                    <a
                      class="site-header__dropdown-item"
                      href={child.href}
                      role="menuitem"
                      {...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {child.label}
                    </a>
                  )
                ))}
              </div>
            </div>
          ) : (
            <a
              class:list={['site-header__link', path.startsWith(item.href) && item.href !== '/' && 'is-active']}
              href={item.href}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="site-header__actions">
      <a class="site-header__cta btn btn--primary" href="/contact">{site.ctaPrimary}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    border-bottom: 2px solid var(--header-border);
  }

  [data-theme='dark'] .site-header--on-hero {
    background: var(--navy-deep);
    border-bottom-color: rgba(var(--mint-rgb), 0.35);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 96px;
    max-width: 1400px;
  }

  /* Logo lockup — mint mark + wordmark, sized by height, theme-aware swap */
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logoimg {
    height: clamp(30px, 2.7vw, 38px);
    width: auto;
    display: block;
  }

  .site-header__logoimg--light {
    display: none;
  }

  [data-theme='light'] .site-header__logoimg--dark {
    display: none;
  }

  [data-theme='light'] .site-header__logoimg--light {
    display: block;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 4px clamp(14px, 1.4vw, 30px);
    flex: 1;
    min-width: 0;
    font-size: clamp(16px, 1.3vw, 20px);
    font-weight: 600;
    font-family: var(--font-head);
  }

  .site-header__link {
    position: relative;
    color: var(--header-text);
    text-decoration: none;
    padding: 12px 2px;
    white-space: nowrap;
    transition: color 0.15s ease-out;
  }

  /* Mint hairline underline reveals on hover/active — LUCI accent cue */
  .site-header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: var(--mint);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.18s ease-out;
  }

  [data-theme='light'] .site-header__link::after {
    background: var(--accent-light);
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--link);
  }

  .site-header__link:hover::after,
  .site-header__link.is-active::after {
    transform: scaleX(1);
  }

  [data-theme='dark'] .site-header--on-hero .site-header__link:hover,
  [data-theme='dark'] .site-header--on-hero .site-header__link.is-active {
    color: var(--mint);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  [data-theme='dark'] .site-header--on-hero .site-header__cta {
    background: var(--navy-deep);
    color: var(--gold);
  }

  [data-theme='dark'] .site-header--on-hero .site-header__cta:hover {
    background: var(--navy);
    color: var(--gold);
  }

  .site-header__item--menu {
    position: relative;
  }

  .site-header__caret {
    margin-left: 4px;
    font-size: 0.7em;
    opacity: 0.6;
  }

  .site-header__item--menu > .site-header__link::after {
    left: 0;
    right: 0;
    bottom: 4px;
  }

  .site-header__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    background: var(--off-white);
    border: 1px solid var(--rule-light);
    box-shadow: 0 10px 28px rgba(10, 22, 28, 0.16);
    padding: 8px 0;
  }

  .site-header__item--menu:hover .site-header__dropdown,
  .site-header__item--menu:focus-within .site-header__dropdown {
    display: block;
  }

  .site-header__dropdown-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    color: var(--ink-strong);
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
  }

  .site-header__dropdown-item:hover {
    background: rgba(var(--mint-rgb), 0.1);
    color: var(--accent-light);
  }

  /* Not-yet-built pages: dimmed, non-interactive, flagged "Coming soon". */
  .site-header__dropdown-item--soon {
    color: var(--navy-muted);
    font-weight: 500;
    cursor: default;
  }

  .site-header__dropdown-item--soon:hover {
    background: transparent;
    color: var(--navy-muted);
  }

  .site-header__soon {
    font-style: normal;
    font-family: var(--font-head);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-light);
    white-space: nowrap;
  }

  .site-header__cta {
    font-family: var(--font-display);
    font-size: clamp(10px, 0.8vw, 12px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: clamp(11px, 1vw, 13px) clamp(16px, 1.3vw, 22px);
    /* Gold text on the navy chip — bright --gold (#EDD086), the canonical gold
       for text on dark, matching the other gold text across the site. */
    color: var(--gold);
    transition: color 0.15s ease-out, background 0.15s ease-out;
  }

  .site-header__cta:hover {
    color: var(--gold);
  }

  /* Below laptop width, drop to the mobile header (nav hidden) */
  @media (max-width: 1180px) {
    .site-header__nav {
      display: none;
    }
    .site-header__inner {
      min-height: 80px;
      gap: var(--space-3);
    }
    .site-header__logoimg {
      height: 30px;
    }
  }
</style>
