---
interface Props {
  lockupName: string;
  lockupRole: string;
  deck: string;
  sectionId?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  lockupName,
  lockupRole,
  deck,
  sectionId = 'platform-thesis',
  imageSrc = '/images/hero-platform-employee.png?v=1',
  imageAlt =
    'A LUCI technician at a laptop in a back-of-house operations office, running the LUCI orchestration platform — the property floorplan and live device nodes visible on screen.',
} = Astro.props;
---

<section id={sectionId} class="plat-hero">
  <img
    class="plat-hero__photo"
    src={imageSrc}
    alt={imageAlt}
    loading="eager"
    decoding="async"
    draggable="false"
  />
  <span class="plat-hero__scrim" aria-hidden="true"></span>

  <div class="plat-hero__inner container container--wide">
    <div class="header-lockup is-in" data-reveal>
      <h2 class="header-lockup__name" set:html={lockupName} />
      <span class="header-lockup__rule" aria-hidden="true"></span>
      <p class="header-lockup__role">{lockupRole}</p>
    </div>
    <p class="plat-hero__deck">{deck}</p>
  </div>
</section>

<style>
  .plat-hero {
    position: relative;
    width: 100%;
    min-height: clamp(440px, 76vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--off-white);
    background: var(--navy-deep);
    isolation: isolate;
  }

  /* ── Full-bleed photo ───────────────────────────────────── */
  .plat-hero__photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    pointer-events: none;
    user-select: none;
  }

  /* ── Legibility veil — strong on the left/bottom where copy sits ── */
  .plat-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(100deg, rgba(8, 17, 22, 0.92) 0%, rgba(8, 17, 22, 0.62) 40%, rgba(8, 17, 22, 0.18) 72%, rgba(8, 17, 22, 0.05) 100%),
      linear-gradient(to top, rgba(8, 17, 22, 0.9) 0%, rgba(8, 17, 22, 0.28) 46%, transparent 74%);
  }

  /* ── Copy ───────────────────────────────────────────────── */
  .plat-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(80px, 10vw, 120px) clamp(40px, 5vw, 64px);
  }
  .plat-hero .header-lockup { display: block; margin-bottom: var(--space-3); }
  .plat-hero .header-lockup__name {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--mint);
    margin: 0;
    text-transform: uppercase;
  }
  .plat-hero .header-lockup__rule {
    display: block;
    width: 40px;
    height: 3px;
    margin: 14px 0 12px;
    background: var(--mint);
    border-radius: 2px;
  }
  .plat-hero .header-lockup__role {
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 1.35;
    color: var(--mint);
    margin: 0;
  }
  .plat-hero__deck {
    max-width: 46ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.9);
    text-align: left;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 760px) {
    .plat-hero__photo { object-position: 70% center; }
    .plat-hero__deck { max-width: 90%; }
  }
</style>
