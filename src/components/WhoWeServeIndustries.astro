---
import { whoWeServe } from '../data/whoWeServe';

const industries = whoWeServe.industries;
---

<ul class="wss-ind" role="list">
  {industries.map((ind, i) => (
    <li class:list={['wss-ind__cell', `wss-ind__cell--${i + 1}`]}>
      <a class="wss-ind__card" href={`/industries/${ind.slug}`}>
        <img
          class="wss-ind__img"
          src={ind.image}
          alt=""
          loading="lazy"
          decoding="async"
          width="1280"
          height="853"
        />
        <span class="wss-ind__scrim" aria-hidden="true"></span>
        <span class="wss-ind__body">
          <span class="wss-ind__name">{ind.name}</span>
          <span class="wss-ind__line">{ind.line}</span>
          <span class="wss-ind__cta">See this environment <span aria-hidden="true">→</span></span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .wss-ind {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(150px, auto);
    gap: clamp(14px, 1.6vw, 20px);
  }

  /* Bento placement: two wide cards on top, three on the bottom. */
  .wss-ind__cell--1 { grid-column: 1 / 4; grid-row: 1; }
  .wss-ind__cell--2 { grid-column: 4 / 7; grid-row: 1; }
  .wss-ind__cell--3 { grid-column: 1 / 3; grid-row: 2; }
  .wss-ind__cell--4 { grid-column: 3 / 5; grid-row: 2; }
  .wss-ind__cell--5 { grid-column: 5 / 7; grid-row: 2; }

  .wss-ind__card {
    position: relative;
    display: block;
    height: 100%;
    min-height: 200px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--navy);
  }
  .wss-ind__cell--1 .wss-ind__card { min-height: 240px; }

  .wss-ind__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease-out;
  }

  .wss-ind__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(8, 17, 22, 0.94) 0%,
      rgba(8, 17, 22, 0.55) 42%,
      rgba(8, 17, 22, 0.08) 72%,
      transparent 88%
    );
    transition: background 0.3s ease-out;
  }
  .wss-ind__card:hover .wss-ind__scrim,
  .wss-ind__card:focus-visible .wss-ind__scrim {
    background: linear-gradient(
      to top,
      rgba(8, 17, 22, 0.97) 0%,
      rgba(8, 17, 22, 0.72) 50%,
      rgba(8, 17, 22, 0.22) 78%,
      transparent 95%
    );
  }
  .wss-ind__card:hover .wss-ind__img,
  .wss-ind__card:focus-visible .wss-ind__img {
    transform: scale(1.05);
  }
  .wss-ind__card:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 3px;
  }

  .wss-ind__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(16px, 1.8vw, 24px);
    z-index: 1;
  }
  .wss-ind__name {
    font-family: var(--font-head);
    font-size: clamp(17px, 1.7vw, 21px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--off-white);
  }
  .wss-ind__cell--1 .wss-ind__name {
    font-size: clamp(20px, 2vw, 26px);
  }
  .wss-ind__line {
    font-family: var(--font-body);
    font-size: clamp(13px, 1.15vw, 15px);
    font-weight: 400;
    line-height: 1.45;
    color: rgba(245, 248, 250, 0.84);
    max-width: 42ch;
  }
  .wss-ind__cta {
    margin-top: 6px;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mint);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  }
  .wss-ind__card:hover .wss-ind__cta,
  .wss-ind__card:focus-visible .wss-ind__cta {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .wss-ind {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wss-ind__cell--1 { grid-column: 1 / -1; grid-row: auto; }
    .wss-ind__cell--2 { grid-column: 1 / -1; grid-row: auto; }
    .wss-ind__cell--3 { grid-column: auto; grid-row: auto; }
    .wss-ind__cell--4 { grid-column: auto; grid-row: auto; }
    .wss-ind__cell--5 { grid-column: 1 / -1; grid-row: auto; }
    .wss-ind__cell--1 .wss-ind__card { min-height: 220px; }
    .wss-ind__cta { opacity: 1; transform: none; }
  }

  @media (max-width: 520px) {
    .wss-ind {
      grid-template-columns: 1fr;
    }
  }
</style>
