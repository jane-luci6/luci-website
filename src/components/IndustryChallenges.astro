---
import type { IndustryChallenge } from '../data/industryDetails';

interface Props {
  challenges: IndustryChallenge[];
}

const { challenges } = Astro.props;
const count = challenges.length;

const flipGlyph = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>`;
---

<ul class:list={['ind-challenges', `ind-challenges--count-${count}`]} role="list">
  {challenges.map((item, i) => (
    <li
      class:list={['ind-challenges__item', item.featured && 'ind-challenges__item--featured']}
      tabindex="0"
    >
      <div class="ind-challenges__card">
        <div class="ind-challenges__face ind-challenges__face--front">
          <img
            class="ind-challenges__img"
            src={item.image}
            alt=""
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
            width="1280"
            height="853"
            style={item.imagePosition ? `object-position: ${item.imagePosition}` : undefined}
          />
          <span class="ind-challenges__scrim" aria-hidden="true"></span>
          <div class="ind-challenges__front-body">
            <h3 class="ind-challenges__head">{item.head}</h3>
            <span class="ind-challenges__flip" aria-hidden="true" set:html={flipGlyph} />
          </div>
        </div>
        <div class="ind-challenges__face ind-challenges__face--back">
          <p class="ind-challenges__back-kicker">The problem</p>
          <h3 class="ind-challenges__back-head">{item.head}</h3>
          <p class="ind-challenges__copy">{item.body}</p>
          <span class="ind-challenges__flip ind-challenges__flip--back" aria-hidden="true" set:html={flipGlyph} />
        </div>
      </div>
      <p class="ind-challenges__sr-copy">
        <span class="ind-challenges__sr-label">{item.head}</span> {item.body}
      </p>
    </li>
  ))}
</ul>

<script>
  const section = document.querySelector('.ind-challenges');
  if (section && window.matchMedia('(hover: none)').matches) {
    section.querySelectorAll('.ind-challenges__item').forEach((item) => {
      item.addEventListener('click', () => item.classList.toggle('is-flipped'));
    });
  }
</script>

<style>
  .ind-challenges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 24px);
    max-width: var(--content-wide);
  }

  @media (min-width: 720px) {
    .ind-challenges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ind-challenges__item--featured {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .ind-challenges {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .ind-challenges__item {
      grid-column: span 2;
    }

    .ind-challenges__item:nth-child(4) {
      grid-column: span 3;
    }

    .ind-challenges__item:nth-child(5) {
      grid-column: span 3;
    }

    .ind-challenges__item--featured {
      grid-column: 1 / -1;
    }

    /* Six items: uniform span-2 grid (3 per row, 2 rows) — no full-width banner, no orphan,
       and the featured card matches the row height so both rows stay equal. */
    .ind-challenges--count-6 .ind-challenges__item,
    .ind-challenges--count-6 .ind-challenges__item:nth-child(4),
    .ind-challenges--count-6 .ind-challenges__item:nth-child(5),
    .ind-challenges--count-6 .ind-challenges__item:nth-child(6) {
      grid-column: span 2;
    }

    .ind-challenges--count-6 .ind-challenges__item--featured {
      grid-column: span 2;
    }

    .ind-challenges--count-6 .ind-challenges__item--featured .ind-challenges__card {
      min-height: clamp(260px, 42vw, 320px);
    }

    /* Both rows stay uniform: the back face overlays the card instead of driving its
       height, so long body copy scrolls rather than stretching the row. */
    .ind-challenges--count-6 .ind-challenges__card {
      min-height: clamp(280px, 40vw, 340px);
    }

    .ind-challenges--count-6 .ind-challenges__face--back {
      position: absolute;
      inset: 0;
      overflow: auto;
    }
  }

  .ind-challenges__item {
    position: relative;
    perspective: 1400px;
  }

  .ind-challenges__item:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 4px;
    border-radius: 14px;
  }

  .ind-challenges__card {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.45s ease-out;
    border-radius: 14px;
    min-height: clamp(260px, 42vw, 320px);
    height: 100%;
  }

  .ind-challenges__item--featured .ind-challenges__card {
    min-height: clamp(300px, 34vw, 400px);
  }

  @media (hover: hover) {
    .ind-challenges__item:hover .ind-challenges__card,
    .ind-challenges__item:focus-within .ind-challenges__card {
      transform: rotateY(180deg);
    }
  }

  .ind-challenges__item.is-flipped .ind-challenges__card {
    transform: rotateY(180deg);
  }

  .ind-challenges__face {
    border-radius: 14px;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .ind-challenges__face--front {
    position: absolute;
    inset: 0;
    background: var(--navy-deep);
  }

  .ind-challenges__face--back {
    position: relative;
    transform: rotateY(180deg);
    background: var(--navy-deep);
    padding: clamp(20px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 100%;
  }

  .ind-challenges__item--featured .ind-challenges__face--back {
    padding: clamp(28px, 3.5vw, 40px);
    max-width: none;
  }

  .ind-challenges__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ind-challenges__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(8, 17, 22, 0.92) 0%,
      rgba(8, 17, 22, 0.35) 42%,
      rgba(8, 17, 22, 0.08) 100%
    );
  }

  .ind-challenges__item--featured .ind-challenges__scrim {
    background: linear-gradient(
      105deg,
      rgba(8, 17, 22, 0.55) 0%,
      rgba(8, 17, 22, 0.12) 45%,
      rgba(8, 17, 22, 0.04) 100%
    ),
    linear-gradient(to top, rgba(8, 17, 22, 0.9) 0%, transparent 52%);
  }

  .ind-challenges__front-body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: clamp(20px, 2.4vw, 28px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .ind-challenges__item--featured .ind-challenges__front-body {
    padding: clamp(28px, 3.5vw, 40px);
    max-width: min(62ch, 78%);
  }

  @media (max-width: 719px) {
    .ind-challenges__item--featured .ind-challenges__front-body {
      max-width: none;
    }
  }

  .ind-challenges__head {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--off-white);
    max-width: 22ch;
  }

  .ind-challenges__item--featured .ind-challenges__head {
    font-size: clamp(24px, 2.8vw, 34px);
    max-width: 20ch;
  }

  .ind-challenges__flip {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: rgba(104, 227, 190, 0.14);
    color: var(--mint);
    transition: transform 0.45s ease-out, background 0.2s ease-out;
  }

  .ind-challenges__flip :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (hover: hover) {
    .ind-challenges__item:hover .ind-challenges__flip,
    .ind-challenges__item:focus-within .ind-challenges__flip {
      transform: rotateY(180deg);
      background: rgba(104, 227, 190, 0.22);
    }
  }

  .ind-challenges__flip--back {
    margin-top: auto;
    align-self: flex-end;
  }

  .ind-challenges__back-kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 248, 250, 0.45);
  }

  .ind-challenges__back-head {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    max-width: 28ch;
  }

  .ind-challenges__copy {
    margin: 0;
    max-width: 48ch;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.25vw, 16px);
    font-weight: 400;
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.84);
  }

  .ind-challenges__sr-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ind-challenges__card,
    .ind-challenges__flip {
      transition: none;
    }

    .ind-challenges__item:hover .ind-challenges__card,
    .ind-challenges__item:focus-within .ind-challenges__card,
    .ind-challenges__item.is-flipped .ind-challenges__card {
      transform: none;
    }

    .ind-challenges__face--back {
      position: relative;
      transform: none;
      margin-top: 8px;
      min-height: auto;
    }

    .ind-challenges__card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0;
      height: auto;
      min-height: 0;
    }

    .ind-challenges__face--front {
      position: relative;
      min-height: clamp(220px, 38vw, 300px);
    }

    .ind-challenges__item {
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .ind-challenges__flip {
      display: none;
    }
  }
</style>
