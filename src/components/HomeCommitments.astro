---
// "Our four commitments" — how we work with you.
// Mirrors the capabilities document's soft-icon commitment grid (page 8):
// light soft-icon tiles, duotone icons (mint-dark #2b9e80 primary + gold #CEB06E
// accent, mint-tinted fill), bold Space Grotesk head + readable body.
// Source of truth for copy + icons: LUCI Systems Design System/ui_kits/sales/capabilities-document.html
const items = [
  {
    svg: `<svg viewBox="0 0 24 24" fill="none"><path d="M3 18h18" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round"/><path d="M7 18a5 5 0 0 1 10 0" fill="#68E3BE" fill-opacity="0.22" stroke="#2b9e80" stroke-width="1.8" stroke-linejoin="round"/><g stroke="#CEB06E" stroke-width="1.8" stroke-linecap="round"><path d="M12 4v2.4"/><path d="M5.2 7.8l1.6 1.6"/><path d="M18.8 7.8l-1.6 1.6"/></g></svg>`,
    head: 'Support begins before deployment.',
    body: 'Every LUCI engagement starts with the FDE team embedded in the property. Support begins on day one.',
  },
  {
    svg: `<svg viewBox="0 0 24 24" fill="none"><circle cx="8.5" cy="8" r="3" fill="#68E3BE" fill-opacity="0.22" stroke="#2b9e80" stroke-width="1.8"/><path d="M3.5 19a5 5 0 0 1 10 0" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round"/><circle cx="17" cy="9.5" r="2.4" stroke="#CEB06E" stroke-width="1.8"/><path d="M14.5 19a3.5 3.5 0 0 1 7 0" stroke="#CEB06E" stroke-width="1.8" stroke-linecap="round"/></svg>`,
    head: 'The team that builds your system supports it.',
    body: 'The engineer who walks the property on day one answers the call in year five. LUCI does not hand off engagements.',
  },
  {
    svg: `<svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z" fill="#68E3BE" fill-opacity="0.20" stroke="#2b9e80" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.2" stroke="#CEB06E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    head: 'One team owns every incident, end to end.',
    body: 'No ticket queue, no escalation path, no third party — LUCI owns diagnosis and resolution. Properties report up to <strong>85% fewer support calls</strong>.',
  },
  {
    svg: `<svg viewBox="0 0 24 24" fill="none"><path d="M4 17l5-5 3 3 6-7" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 8h5v5" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 5l.9 2L8 7.9 6 8.8 5 11l-.9-2.1L2 7.9 4 7z" fill="#CEB06E"/></svg>`,
    head: 'The platform gets more capable every day.',
    body: 'Continuous refinement means every release and every year adds capability — inherited by every property on the platform.',
  },
];
---

<section class="home-commitments" aria-labelledby="home-commitments-title">
  <div class="home-commitments__inner container container--wide">
    <header class="home-commitments__head">
      <p class="home-commitments__kicker">How we work with you</p>
      <h2 id="home-commitments-title" class="home-commitments__title">
        Our four <span class="home-commitments__title-mark">commitments</span>
      </h2>
    </header>

    <ul class="home-commitments__grid" role="list">
      {items.map((it) => (
        <li class="home-commitments__item">
          <span class="home-commitments__icon" aria-hidden="true" set:html={it.svg} />
          <div class="home-commitments__copy">
            <p class="home-commitments__item-head">{it.head}</p>
            <p class="home-commitments__item-body" set:html={it.body} />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-commitments {
    background: var(--off-white);
    color: var(--ink);
    border-top: 1px solid rgba(10, 22, 28, 0.08);
  }

  .home-commitments__inner {
    padding-block: clamp(56px, 9vw, 96px);
  }

  .home-commitments__head {
    max-width: 680px;
    margin: 0 0 clamp(32px, 4vw, 48px);
  }

  .home-commitments__kicker {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .home-commitments__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--ink-strong);
  }

  /* Gold underline mark on "commitments" — non-text accent on light.
     Bright gold at reduced opacity; the on-light gold lives as a mark. */
  .home-commitments__title-mark {
    text-decoration: underline;
    text-decoration-color: rgba(var(--gold-rgb), 0.55);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .home-commitments__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 40px) clamp(32px, 5vw, 64px);
  }

  .home-commitments__item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    align-items: start;
  }

  /* Soft-icon tile — canonical LUCI treatment: pale mint gradient, 16px radius,
     inset mint hairline, no shadow or dark fill. */
  .home-commitments__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(155deg, #E6F5EF 0%, #F3FAF8 100%);
    box-shadow: inset 0 0 0 1px rgba(43, 158, 128, 0.14);
    flex: none;
  }
  .home-commitments__icon :global(svg) {
    width: 28px;
    height: 28px;
    display: block;
  }

  .home-commitments__copy {
    min-width: 0;
  }

  .home-commitments__item-head {
    margin: 0 0 8px;
    padding-top: 4px;
    font-family: var(--font-body);
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }

  .home-commitments__item-body {
    margin: 0;
    max-width: 52ch;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.55;
    color: rgba(53, 79, 92, 0.82);
  }

  /* Stat highlight in readable accent-light (mint-dark green) on light —
     gold can't carry text on light, so the stat leans on the green accent. */
  .home-commitments__item-body :global(strong) {
    color: var(--accent-light);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .home-commitments__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
