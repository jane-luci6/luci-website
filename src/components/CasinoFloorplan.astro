---
// Casino resort floorplan — ChatGPT-generated architectural drawing,
// transposed to dark (invert + screen blend = light lines on navy). The
// drawing carries its own labels; the surrounding copy + pillar cards carry
// the LUCI story.
---
<div class="fp-cad">
  <img
    class="fp-cad__img"
    src="/images/industries/casino/casino-floorplan.png?v=2"
    alt="Architectural floorplan of a resort and casino: casino floor, ballroom, pool, restaurants and bars, theater, hotel lobby and parking."
    loading="lazy"
    decoding="async"
    width="790"
    height="1024"
  />
</div>

<style>
  .fp-cad {
    position: relative;
    isolation: isolate; /* keep the screen blend inside this box */
    background: var(--navy-deep);
    border-radius: 12px;
    overflow: hidden;
  }
  .fp-cad__img {
    display: block;
    width: 100%;
    height: auto;
    /* black-on-white → white-on-navy: invert the drawing, then screen-blend
       so the white background drops out and the navy mat shows through. */
    filter: invert(1);
    mix-blend-mode: screen;
  }
</style>
