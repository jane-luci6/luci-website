---
// Casino resort floorplan — modernized: aurora-glow glass stage, gradient
// signal-trace leader lines with a traveling pulse, radar-ping zone nodes,
// glass callout cards with numbered badges, and a clickable 01-04 tab rail.
// Reveal is a one-shot sequence (settles once all 4 are visible); tabs let
// a visitor re-highlight any zone afterward. Descriptors are pulled from
// the Casinos & Gaming industry strategy.
const zones = [
  {
    label: 'Set the tone on arrival',
    desc: 'Every screen, speaker, and light at the door sets the tone for the visit.',
    plate: { side: 'right', right: '1%', top: '29%' },
    delay: 0,
    lines: [{ x1: 79, y1: 29, x2: 72, y2: 36 }],
  },
  {
    label: 'Drive energy on the floor',
    desc: 'The gaming floor should feel like something — energy, momentum, the right game on the right screen.',
    plate: { side: 'right', right: '1%', top: '62.5%' },
    delay: 3.5,
    lines: [{ x1: 79, y1: 62.5, x2: 63.75, y2: 54.2 }],
  },
  {
    label: 'Move guests toward amenities',
    desc: 'Dining, entertainment, the pool — the spaces that now pay the bills, on cue.',
    plate: { side: 'left', left: '1%', top: '52%' },
    delay: 7,
    lines: [
      { x1: 21, y1: 52, x2: 28.3, y2: 17.6 },
      { x1: 21, y1: 52, x2: 29.2, y2: 39.1 },
      { x1: 21, y1: 52, x2: 29.2, y2: 67.4 },
    ],
  },
  {
    label: 'Extend loyalty across every space',
    desc: 'The right moment, in the right place, at the right time — everywhere.',
    plate: { side: 'left', left: '1%', top: '14%' },
    delay: 10.5,
    lines: [
      { x1: 21, y1: 14, x2: 50.4, y2: 14.6 },
      { x1: 21, y1: 14, x2: 63.75, y2: 52.7 },
    ],
  },
];
---
<div class="fp-stage" data-fp-animate>
  <div class="fp-tabs" role="tablist" aria-label="Casino zones LUCI orchestrates">
    <div class="fp-tabs__track"><div class="fp-tabs__fill" data-fp-fill></div></div>
    {zones.map((z, i) => (
      <button type="button" class="fp-tab" data-fp-tab={i} aria-label={z.label}>
        <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      </button>
    ))}
  </div>

  <div class="fp-mount">
    <img
      class="fp-mount__img"
      src="/images/industries/casino/casino-floorplan.png?v=2"
      alt="Architectural floorplan of a resort and casino: casino floor, ballroom, pool, restaurants and bars, theater, hotel lobby and parking."
      loading="lazy"
      decoding="async"
      width="790"
      height="1024"
    />
    <div class="fp-scan" aria-hidden="true"></div>

    <svg class="fp-overlay" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="fp-leadgrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#edd086" />
          <stop offset="100%" stop-color="#68e3be" />
        </linearGradient>
        <radialGradient id="fp-dotgrad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#eafff6" />
          <stop offset="100%" stop-color="#68e3be" />
        </radialGradient>
      </defs>

      {zones.map((z, i) => (
        <g class="fp-callout" data-zone={i} style={`--d:${z.delay}s`}>
          {z.lines.map((ln) => (
            <g>
              <path
                class="fp-lead"
                d={`M ${ln.x1} ${ln.y1} L ${ln.x2} ${ln.y2}`}
                vector-effect="non-scaling-stroke"
                pathLength="1"
              />
              <circle
                class="fp-pulse"
                r="0.9"
                cx={ln.x1}
                cy={ln.y1}
                style={`offset-path: path('M ${ln.x1} ${ln.y1} L ${ln.x2} ${ln.y2}')`}
              />
              <circle class="fp-ring" cx={ln.x2} cy={ln.y2} r="1" />
              <circle class="fp-ring fp-ring--b" cx={ln.x2} cy={ln.y2} r="1" />
              <circle class="fp-dot" cx={ln.x2} cy={ln.y2} r="0.6" />
            </g>
          ))}
        </g>
      ))}
    </svg>

    <div class="fp-plates">
      {zones.map((z, i) => (
        <div
          class={`fp-plate fp-plate--${z.plate.side}`}
          data-zone={i}
          style={`--d:${z.delay}s; --left:${z.plate.left ?? 'auto'}; --right:${z.plate.right ?? 'auto'}; --top:${z.plate.top};`}
        >
          <span class="fp-plate__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="fp-plate__label">{z.label}</span>
          <span class="fp-plate__desc">{z.desc}</span>
        </div>
      ))}
    </div>
  </div>
</div>
<script>
  const stage = document.querySelector<HTMLElement>('[data-fp-animate]');
  if (stage) {
    const tabs = Array.from(stage.querySelectorAll<HTMLButtonElement>('[data-fp-tab]'));
    const fill = stage.querySelector<HTMLElement>('[data-fp-fill]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function pulseZone(i: number) {
      stage!.querySelectorAll(`[data-zone="${i}"]`).forEach((el) => {
        el.classList.remove('is-pulsing');
        // restart the animation even if it's already been triggered
        void (el as HTMLElement).offsetWidth;
        el.classList.add('is-pulsing');
      });
      tabs.forEach((t, ti) => t.classList.toggle('is-current', ti === i));
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => pulseZone(i));
    });

    function reveal() {
      stage!.classList.add('is-visible');
      const delaysMs = [0, 3500, 7000, 10500];
      delaysMs.forEach((ms, i) => {
        window.setTimeout(() => {
          tabs[i]?.classList.add('is-done');
          if (fill) fill.style.width = `${(i + 1) * 25}%`;
        }, reduce ? 0 : ms);
      });
    }

    if (reduce || !('IntersectionObserver' in window)) {
      reveal();
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              reveal();
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      io.observe(stage);
    }
  }
</script>
<style>
  /* ---------- Outer stage: aurora glass card (matches PlatformOrbit) ---------- */
  .fp-stage {
    position: relative;
    border-radius: 20px;
    padding: clamp(16px, 2.4vw, 32px);
    background: radial-gradient(120% 90% at 50% 0%, #123040 0%, var(--navy) 42%, var(--navy-deep) 100%);
    border: 1px solid rgba(var(--mint-rgb), 0.16);
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .fp-stage::before {
    content: '';
    position: absolute;
    inset: -30% -10%;
    background:
      radial-gradient(40% 50% at 18% 22%, rgba(var(--mint-rgb), 0.14), transparent 70%),
      radial-gradient(38% 46% at 88% 84%, rgba(var(--gold-rgb), 0.1), transparent 70%);
    filter: blur(40px);
    animation: fp-aurora 22s ease-in-out infinite alternate;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes fp-aurora {
    0% { transform: translate3d(-4%, -2%, 0) scale(1); }
    100% { transform: translate3d(5%, 3%, 0) scale(1.08); }
  }

  /* ---------- Tabs / progress rail ---------- */
  .fp-tabs {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.4vw, 28px);
    margin-bottom: clamp(16px, 2.4vw, 28px);
  }
  .fp-tabs__track {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 50%;
    height: 1px;
    background: rgba(var(--mint-rgb), 0.16);
    z-index: -1;
  }
  .fp-tabs__fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--gold), var(--mint));
    transition: width 0.5s ease-out;
  }
  .fp-tab {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    background: rgba(16, 35, 45, 0.7);
    border: 1px solid rgba(var(--mint-rgb), 0.3);
    color: rgba(245, 248, 250, 0.55);
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: transform 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .fp-tab:hover,
  .fp-tab:focus-visible {
    transform: translateY(-2px);
    color: var(--mint);
    border-color: var(--mint);
  }
  .fp-tab.is-done {
    color: var(--mint);
    border-color: rgba(var(--mint-rgb), 0.55);
  }
  .fp-tab.is-current {
    color: var(--navy-deep);
    background: linear-gradient(135deg, var(--gold), var(--mint));
    border-color: transparent;
    box-shadow: 0 0 18px rgba(var(--mint-rgb), 0.5);
  }
  .fp-tab:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 3px;
  }
  /* ---------- Image mount ---------- */
  .fp-mount {
    position: relative;
    /* No z-index / isolation: we WANT the inverted image to screen-blend
       with the stage's aurora background (so its black bg drops out and the
       floorplan dissolves into the same glow as the surrounding box). */
  }
  .fp-mount__img {
    position: relative;
    display: block;
    margin-inline: auto;
    width: 65.83%;
    height: auto;
    filter: invert(1);
    mix-blend-mode: screen;
    /* No hard rectangle edge + soft feather so the floorplan melts into the
       aurora stage instead of reading as a pasted-on slab. */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
    mask-composite: intersect;
  }

  /* One-shot light sweep down the floorplan on reveal */
  .fp-scan {
    position: absolute;
    left: 17.08%;
    right: 17.08%;
    top: 0;
    height: 40%;
    background: linear-gradient(180deg, rgba(104, 227, 190, 0.5), transparent);
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .fp-stage.is-visible .fp-scan {
    animation: fp-scan-sweep 1.1s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  @keyframes fp-scan-sweep {
    0% { opacity: 0; transform: translateY(-20%); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translateY(220%); }
  }

  /* ---------- SVG overlay: signal-trace lines + radar nodes ---------- */
  .fp-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .fp-lead {
    fill: none;
    stroke: url(#fp-leadgrad);
    stroke-width: 1.6;
    stroke-linecap: round;
    /* Hide with opacity (not dasharray) — dasharray + pathLength +
       non-scaling-stroke is inconsistent across browsers and can leave a
       stub of the line visible from load. Opacity is bulletproof. */
    opacity: 0;
    transition: opacity 0.5s ease;
    transition-delay: var(--d, 0s);
  }
  .fp-stage.is-visible .fp-callout .fp-lead { opacity: 1; }

  .fp-pulse {
    fill: #eafff6;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .fp-stage.is-visible .fp-callout .fp-pulse {
    animation: fp-pulse-travel 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes fp-pulse-travel {
    0% { offset-distance: 0%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  .fp-dot {
    fill: url(#fp-dotgrad);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
    transition-delay: calc(var(--d, 0s) + 0.55s);
  }
  .fp-stage.is-visible .fp-callout .fp-dot { transform: scale(1); opacity: 1; }

  /* Radar-ping rings around each node, staggered */
  .fp-ring {
    fill: none;
    stroke: var(--mint);
    stroke-width: 0.5;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }
  .fp-stage.is-visible .fp-callout .fp-ring {
    animation: fp-ring-ping 2.6s ease-out infinite;
    animation-delay: calc(var(--d, 0s) + 0.75s);
  }
  .fp-stage.is-visible .fp-callout .fp-ring--b {
    animation-delay: calc(var(--d, 0s) + 2.05s);
  }
  @keyframes fp-ring-ping {
    0% { transform: scale(0.6); opacity: 0.5; }
    100% { transform: scale(3.4); opacity: 0; }
  }

  /* Click-to-replay pulse flash on a zone's line/dot/rings */
  .fp-callout.is-pulsing .fp-dot {
    animation: fp-dot-flash 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .fp-callout.is-pulsing .fp-ring {
    animation: fp-ring-ping 0.9s ease-out;
  }
  @keyframes fp-dot-flash {
    0% { transform: scale(1); }
    40% { transform: scale(1.8); }
    100% { transform: scale(1); }
  }
  /* ---------- Callout plates: frosted glass cards ---------- */
  .fp-plates {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .fp-plate {
    position: absolute;
    left: var(--left, auto);
    right: var(--right, auto);
    top: var(--top);
    transform: translateY(-50%);
    width: 20%;
    min-width: 208px;
    padding: 18px 20px 16px;
    background: rgba(16, 35, 45, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(var(--mint-rgb), 0.28);
    border-radius: 14px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 20px rgba(var(--mint-rgb), 0.12);
    overflow: hidden;
    opacity: 0;
  }
  .fp-plate::before {
    content: '';
    position: absolute;
    top: 0;
    left: 16px;
    right: 16px;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), var(--mint));
  }
  .fp-plate__num {
    position: absolute;
    right: 12px;
    bottom: -12px;
    font-family: var(--font-display);
    font-size: 58px;
    font-weight: 700;
    line-height: 1;
    color: rgba(var(--mint-rgb), 0.14);
    pointer-events: none;
  }
  .fp-plate__label {
    position: relative;
    display: block;
    font-family: var(--font-body);
    font-size: clamp(16px, 1.7vw, 20px);
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.15;
    color: var(--mint);
  }
  .fp-plate__desc {
    position: relative;
    display: block;
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: clamp(13px, 1.35vw, 15px);
    font-weight: 400;
    line-height: 1.45;
    color: rgba(245, 248, 250, 0.78);
  }
  .fp-stage.is-visible .fp-plate {
    animation: fp-plate-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--d, 0s) + 0.5s);
  }
  @keyframes fp-plate-in {
    0% { opacity: 0; transform: translateY(-50%) translateY(10px) scale(0.94); }
    60% { opacity: 1; transform: translateY(-50%) translateY(-2px) scale(1.02); }
    100% { opacity: 1; transform: translateY(-50%) translateY(0) scale(1); }
  }
  .fp-plate.is-pulsing {
    animation: fp-plate-flash 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes fp-plate-flash {
    0% { box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 20px rgba(var(--mint-rgb), 0.12); }
    40% { box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 36px rgba(var(--mint-rgb), 0.55); transform: translateY(-50%) scale(1.03); }
    100% { box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 20px rgba(var(--mint-rgb), 0.12); transform: translateY(-50%) scale(1); }
  }

  /* ---------- Narrow screens: stack, drop absolute overlay ---------- */
  @media (max-width: 900px) {
    .fp-stage { padding: clamp(14px, 3vw, 20px); }
    .fp-mount { display: flex; flex-direction: column; }
    .fp-mount__img { width: 100%; }
    .fp-scan { left: 0; right: 0; }
    .fp-overlay { display: none; }
    .fp-plates {
      position: static;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 14px;
    }
    .fp-plate {
      position: static;
      left: auto;
      right: auto;
      top: auto;
      transform: none;
      width: auto;
      min-width: 0;
      opacity: 1;
      animation: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-stage::before { animation: none; }
    .fp-scan { display: none; }
    .fp-lead { transition: none; opacity: 1; }
    .fp-pulse { display: none; }
    .fp-dot { transition: none; transform: scale(1); opacity: 1; }
    .fp-ring { animation: none !important; opacity: 0; }
    .fp-plate { animation: none !important; opacity: 1; }
    .fp-plate.is-pulsing { animation: none; }
  }
</style>
