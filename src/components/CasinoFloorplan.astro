---
// Casino resort floorplan — generated architectural drawing transposed to
// dark, with four callouts that pop up one-by-one. Labels live outside the
// floorplan in the side margins; arrows point in to the relevant zones.
// Descriptors are pulled from the Casinos & Gaming industry strategy.
---
<div class="fp-cad" data-fp-animate>
  <img
    class="fp-cad__img"
    src="/images/industries/casino/casino-floorplan.png?v=2"
    alt="Architectural floorplan of a resort and casino: casino floor, ballroom, pool, restaurants and bars, theater, hotel lobby and parking."
    loading="lazy"
    decoding="async"
    width="790"
    height="1024"
  />

  <svg class="fp-cad__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <marker id="fparrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 Z" fill="#68e3be"/>
      </marker>
    </defs>
    <!-- 1 Set the tone on arrival → Hotel Lobby -->
    <g class="fp-grp" style="--d:0s">
      <line class="fp-lead" x1="82" y1="29" x2="75.4" y2="40" vector-effect="non-scaling-stroke" pathLength="1" marker-end="url(#fparrow)"/>
      <circle class="fp-dot" cx="75.4" cy="40" r="0.6"/>
    </g>
    <!-- 2 Drive energy on the floor → Casino -->
    <g class="fp-grp" style="--d:3.5s">
      <line class="fp-lead" x1="82" y1="62.5" x2="63.75" y2="54.2" vector-effect="non-scaling-stroke" pathLength="1" marker-end="url(#fparrow)"/>
      <circle class="fp-dot" cx="63.75" cy="54.2" r="0.6"/>
    </g>
    <!-- 3 Move guests toward amenities → Pool, Restaurants, Theater -->
    <g class="fp-grp" style="--d:7s">
      <line class="fp-lead" x1="18" y1="38" x2="28.3" y2="17.6" vector-effect="non-scaling-stroke" pathLength="1" marker-end="url(#fparrow)"/>
      <line class="fp-lead" x1="18" y1="38" x2="29.2" y2="39.1" vector-effect="non-scaling-stroke" pathLength="1" marker-end="url(#fparrow)"/>
      <line class="fp-lead" x1="18" y1="38" x2="29.2" y2="67.4" vector-effect="non-scaling-stroke" pathLength="1" marker-end="url(#fparrow)"/>
      <circle class="fp-dot" cx="28.3" cy="17.6" r="0.6"/>
      <circle class="fp-dot" cx="29.2" cy="39.1" r="0.6"/>
      <circle class="fp-dot" cx="29.2" cy="67.4" r="0.6"/>
    </g>
    <!-- 4 Extend loyalty across every space → Ballroom, Casino -->
    <g class="fp-grp" style="--d:10.5s">
      <line class="fp-lead" x1="18" y1="9" x2="50.4" y2="14.6" vector-effect="non-scaling-stroke" pathLength="1" marker-end="url(#fparrow)"/>
      <line class="fp-lead" x1="18" y1="9" x2="63.75" y2="52.7" vector-effect="non-scaling-stroke" pathLength="1" marker-end="url(#fparrow)"/>
      <circle class="fp-dot" cx="50.4" cy="14.6" r="0.6"/>
      <circle class="fp-dot" cx="63.75" cy="52.7" r="0.6"/>
    </g>
  </svg>

  <div class="fp-cad__plates">
    <div class="fp-plate fp-plate--r" style="--d:0s; --right:2%; --top:29%;">
      <span class="fp-plate__label">Set the tone on arrival</span>
      <span class="fp-plate__desc">Every screen, speaker, and light at the door sets the tone for the visit.</span>
    </div>
    <div class="fp-plate fp-plate--r" style="--d:3.5s; --right:2%; --top:62.5%;">
      <span class="fp-plate__label">Drive energy on the floor</span>
      <span class="fp-plate__desc">The gaming floor should feel like something — energy, momentum, the right game on the right screen.</span>
    </div>
    <div class="fp-plate fp-plate--l" style="--d:7s; --left:2%; --top:38%;">
      <span class="fp-plate__label">Move guests toward amenities</span>
      <span class="fp-plate__desc">Dining, entertainment, the pool — the spaces that now pay the bills, on cue.</span>
    </div>
    <div class="fp-plate fp-plate--l" style="--d:10.5s; --left:2%; --top:9%;">
      <span class="fp-plate__label">Extend loyalty across every space</span>
      <span class="fp-plate__desc">The right moment, in the right place, at the right time — everywhere.</span>
    </div>
  </div>
</div>
<script>
  const els = document.querySelectorAll('[data-fp-animate]');
  if (els.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.2 });
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-visible'));
  }
</script>
<style>
  .fp-cad {
    position: relative;
    isolation: isolate;
    background: var(--navy-deep);
    border-radius: 12px;
    overflow: hidden;
    /* matches the overlay viewBox so % coords line up */
    aspect-ratio: 1200 / 1024;
  }
  .fp-cad__img {
    position: absolute;
    top: 0;
    left: 17.08%;       /* 205/1200 — centers the 790px drawing in the frame */
    width: 65.83%;       /* 790/1200 */
    height: 100%;
    object-fit: cover;
    filter: invert(1);
    mix-blend-mode: screen;
  }
  .fp-cad__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .fp-cad__plates {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* arrows + dots — hidden until reveal */
  .fp-lead {
    stroke: rgba(104, 227, 190, 0.65);
    stroke-width: 1.4;
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s ease-out;
    transition-delay: var(--d, 0s);
  }
  .fp-dot {
    fill: #68e3be;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.2, 1.4, 0.4, 1), opacity 0.3s ease;
    transition-delay: calc(var(--d, 0s) + 0.45s);
  }

  /* callout plates (HTML) — hidden, then pop in */
  .fp-plate {
    position: absolute;
    left: var(--left, auto);
    right: var(--right, auto);
    top: var(--top);
    transform: translateY(-50%) translateY(8px);
    width: 16%;
    min-width: 168px;
    padding: 12px 16px 13px;
    background: rgba(10, 22, 28, 0.94);
    border: 1px solid rgba(104, 227, 190, 0.55);
    border-left: 3px solid var(--mint);
    border-radius: 12px;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  /* mint accent bar sits on the edge facing the floorplan */
  .fp-plate--l { border-left: none; border-right: 3px solid var(--mint); }
  .fp-plate__label {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 17px);
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.15;
    color: var(--mint);
  }
  .fp-plate__desc {
    display: block;
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: clamp(11.5px, 1.2vw, 13px);
    font-weight: 400;
    line-height: 1.4;
    color: rgba(245, 248, 250, 0.72);
  }

  /* reveal: one-by-one, each held long enough to read before the next */
  .fp-cad.is-visible .fp-lead { stroke-dashoffset: 0; }
  .fp-cad.is-visible .fp-dot {
    transform: scale(1);
    opacity: 1;
    animation: fp-pulse 2.8s ease-in-out infinite;
    animation-delay: calc(var(--d, 0s) + 0.7s);
  }
  .fp-cad.is-visible .fp-plate {
    opacity: 1;
    transform: translateY(-50%) translateY(0);
  }

  @keyframes fp-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.4); }
  }

  /* narrow screens: gutters can't hold the plates, so stack them below */
  @media (max-width: 900px) {
    .fp-cad {
      aspect-ratio: auto;
      display: flex;
      flex-direction: column;
      padding: 14px;
    }
    .fp-cad__img {
      position: static;
      left: auto;
      width: 100%;
      height: auto;
      border-radius: 8px;
    }
    .fp-cad__lines { display: none; }
    .fp-cad__plates {
      position: static;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 14px;
    }
    .fp-plate {
      position: static;
      left: auto;
      right: auto;
      top: auto;
      transform: none;
      width: auto;
      min-width: 0;
      opacity: 1;
      transition: opacity 0.5s ease;
    }
    .fp-cad.is-visible .fp-plate { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-lead { stroke-dashoffset: 0; transition: none; }
    .fp-dot { transform: scale(1); opacity: 1; transition: none; animation: none; }
    .fp-plate { opacity: 1; transform: translateY(-50%); transition: none; }
  }
</style>
