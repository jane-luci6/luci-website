---
import type { PersonaNarrative } from '../data/personaDetails';

interface Props {
  narrative: PersonaNarrative;
}

const { narrative } = Astro.props;
const n = narrative;
---

<div class="pnt">
  <p class="pnt__sublead">{n.subLead}</p>

  <div class="pnt__arc">
    <svg class="pnt__wave" viewBox="0 0 1000 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="pntWaveMint" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#2b9e80" stop-opacity="0" />
          <stop offset="0.5" stop-color="#2b9e80" stop-opacity="0.55" />
          <stop offset="1" stop-color="#2b9e80" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="pntWaveGold" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#ceb06e" stop-opacity="0" />
          <stop offset="0.5" stop-color="#ceb06e" stop-opacity="0.4" />
          <stop offset="1" stop-color="#ceb06e" stop-opacity="0" />
        </linearGradient>
      </defs>
      <g class="pnt__wave-group">
        <path d="M-50,70 Q 75,25 200,70 T 450,70 T 700,70 T 950,70 T 1200,70" />
        <path d="M-50,86 Q 75,46 200,86 T 450,86 T 700,86 T 950,86 T 1200,86" />
      </g>
    </svg>

    <span class="pnt__axis" aria-hidden="true"></span>

    <ol class="pnt__moments" role="list">
      {n.moments.map((m) => (
        <li class="pnt__node">
          <span class="pnt__time">{m.time}</span>
          <span class="pnt__dot" aria-hidden="true"></span>
          <p class="pnt__cap">{m.caption}</p>
        </li>
      ))}
    </ol>
  </div>

  <p class="pnt__support">{n.support}</p>
  <p class="pnt__closing">{n.closing}</p>
</div>

<style>
  .pnt {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2vw, 26px);
    max-width: var(--content-wide, 1120px);
  }
  .pnt__sublead {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 17px);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-light);
  }

  .pnt__arc {
    position: relative;
    margin: clamp(8px, 1.5vw, 20px) 0 clamp(8px, 1vw, 16px);
    padding: 8px 0 0;
  }
  .pnt__wave {
    position: absolute;
    left: 0;
    right: 0;
    top: -10px;
    width: 100%;
    height: 150px;
    overflow: visible;
    pointer-events: none;
  }
  .pnt__wave-group {
    animation: pntDrift 9s linear infinite;
  }
  .pnt__wave path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .pnt__wave path:nth-child(1) {
    stroke: url(#pntWaveMint);
  }
  .pnt__wave path:nth-child(2) {
    stroke: url(#pntWaveGold);
  }
  @keyframes pntDrift {
    to { transform: translateX(-150px); }
  }

  .pnt__axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 70px;
    height: 1px;
    background: var(--rule-light);
  }

  .pnt__moments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 2vw, 24px);
    position: relative;
  }
  .pnt__node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }
  .pnt__time {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-light);
    white-space: nowrap;
  }
  .pnt__dot {
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background: var(--off-white);
    box-shadow: 0 0 0 2px var(--accent-light), 0 0 14px rgba(43, 158, 128, 0.35);
  }
  .pnt__cap {
    margin: 0;
    max-width: 22ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.5;
    color: var(--ink);
  }

  .pnt__support {
    margin: clamp(8px, 1vw, 16px) 0 0;
    max-width: 62ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.6;
    color: var(--ink);
  }
  .pnt__closing {
    margin: 0;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    border-top: 1px solid var(--rule-light);
    padding-top: clamp(16px, 2vw, 24px);
  }

  @media (max-width: 760px) {
    .pnt__wave {
      display: none;
    }
    .pnt__arc {
      padding: 0;
    }
    .pnt__axis {
      top: 0;
      left: 7px;
      width: 1px;
      height: 100%;
      background: var(--rule-light);
    }
    .pnt__moments {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .pnt__node {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 14px;
      padding: 0 0 clamp(18px, 4vw, 26px) 0;
    }
    .pnt__dot {
      flex: 0 0 auto;
      margin-top: 3px;
    }
    .pnt__cap {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pnt__wave-group {
      animation: none;
    }
  }
</style>
