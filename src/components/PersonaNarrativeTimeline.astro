---
import type { PersonaNarrative } from '../data/personaDetails';

interface Props {
  narrative: PersonaNarrative;
}

const { narrative } = Astro.props;
const n = narrative;
---

<div class="pnt">
  {n.subLead && <p class="pnt__sublead">{n.subLead}</p>}

  <div class="pnt__chapter">
    <p class="pnt__chapter-label">The energy curve</p>
    <div class="pnt__stage">
      <svg class="pnt__wave" viewBox="0 0 1000 240" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="pntFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#68e3be" stop-opacity="0.26" />
            <stop offset="1" stop-color="#68e3be" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="pntStroke" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#2b9e80" />
            <stop offset="0.55" stop-color="#68e3be" />
            <stop offset="1" stop-color="#ceb06e" />
          </linearGradient>
        </defs>
        <line class="pnt__axis" x1="0" y1="196" x2="1000" y2="196" />
        <path class="pnt__area" d="M0,195 C 70,195 80,130 125,130 C 170,130 210,185 250,185 C 290,185 320,95 375,95 C 430,95 460,180 500,180 C 540,180 580,62 625,62 C 670,62 710,175 750,175 C 790,175 840,30 875,30 C 920,30 960,165 1000,165 L 1000,240 L 0,240 Z" fill="url(#pntFill)" />
        <path class="pnt__line" d="M0,195 C 70,195 80,130 125,130 C 170,130 210,185 250,185 C 290,185 320,95 375,95 C 430,95 460,180 500,180 C 540,180 580,62 625,62 C 670,62 710,175 750,175 C 790,175 840,30 875,30 C 920,30 960,165 1000,165" fill="none" stroke="url(#pntStroke)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <g class="pnt__dots">
          <circle class="pnt__glow" cx="125" cy="130" r="13" />
          <circle class="pnt__glow" cx="375" cy="95" r="13" />
          <circle class="pnt__glow" cx="625" cy="62" r="13" />
          <circle class="pnt__glow" cx="875" cy="30" r="13" />
          <circle class="pnt__dot" cx="125" cy="130" r="6.5" />
          <circle class="pnt__dot" cx="375" cy="95" r="6.5" />
          <circle class="pnt__dot" cx="625" cy="62" r="6.5" />
          <circle class="pnt__dot" cx="875" cy="30" r="6.5" />
        </g>
      </svg>

      <ol class="pnt__marks" role="list">
        {n.moments.map((m) => (
          <li class="pnt__mark">
            <span class="pnt__mark-t">{m.time}</span>
            <p class="pnt__mark-c">{m.caption}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="pnt__payoff">
    {n.support && <p class="pnt__support">{n.support}</p>}
    <blockquote class="pnt__closing" set:html={n.closing}></blockquote>
  </div>
</div>

<style>
  .pnt {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 36px);
    max-width: var(--content-wide, 1120px);
  }
  .pnt__sublead {
    margin: 0;
    max-width: 40ch;
    font-family: var(--font-body);
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--off-white);
  }

  .pnt__chapter {
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid rgba(245, 248, 250, 0.12);
    border-radius: 14px;
    background: rgba(10, 22, 28, 0.35);
  }
  .pnt__chapter-label {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 248, 250, 0.45);
  }

  .pnt__stage {
    position: relative;
    padding: 0;
  }
  .pnt__wave {
    width: 100%;
    height: clamp(160px, 22vw, 240px);
    display: block;
    overflow: visible;
  }
  .pnt__axis {
    stroke: rgba(245, 248, 250, 0.18);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .pnt__line {
    stroke-dasharray: 2600;
    stroke-dashoffset: 2600;
    animation: pntDraw 2.4s ease-out 0.2s forwards;
  }
  @keyframes pntDraw { to { stroke-dashoffset: 0; } }
  .pnt__glow { fill: rgba(104, 227, 190, 0.22); }
  .pnt__dot {
    fill: var(--navy-deep);
    stroke: var(--mint);
    stroke-width: 2;
    opacity: 0;
    animation: pntPop 0.5s ease-out forwards;
  }
  .pnt__dots circle.pnt__dot:nth-child(5) { animation-delay: 0.7s; }
  .pnt__dots circle.pnt__dot:nth-child(6) { animation-delay: 1.2s; }
  .pnt__dots circle.pnt__dot:nth-child(7) { animation-delay: 1.7s; }
  .pnt__dots circle.pnt__dot:nth-child(8) { animation-delay: 2.2s; }
  @keyframes pntPop {
    from { opacity: 0; transform: scale(0.4); }
    to { opacity: 1; transform: scale(1); }
  }

  .pnt__marks {
    list-style: none;
    margin: clamp(14px, 2vw, 22px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 2vw, 24px);
  }
  .pnt__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }
  .pnt__mark-t {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .pnt__mark-c {
    margin: 0;
    max-width: 30ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.82);
  }

  .pnt__payoff {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .pnt__support {
    margin: 0;
    max-width: 52ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.82);
  }
  .pnt__closing {
    margin: 0;
    width: 100%;
    padding-top: clamp(18px, 2vw, 24px);
    border-top: 2px solid var(--mint);
    text-align: center;
    font-family: var(--font-body);
    font-size: clamp(24px, 3.4vw, 40px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--off-white);
    font-style: normal;
  }
  .pnt__closing em {
    font-style: normal;
    color: var(--mint);
  }
  /* "With LUCI" underline — same mint underline + glow as the homepage
     differentiator statement. */
  .pnt__closing .pnt__luci {
    position: relative;
    display: inline-block;
    color: var(--off-white);
    text-shadow: 0 0 20px rgba(var(--mint-rgb), 0.26);
  }
  .pnt__closing .pnt__luci::after {
    content: '';
    position: absolute;
    left: 0.05em;
    right: 0.05em;
    bottom: -0.08em;
    height: 0.08em;
    background: var(--mint);
    box-shadow: 0 0 14px rgba(var(--mint-rgb), 0.5);
  }

  @media (max-width: 760px) {
    .pnt__marks { grid-template-columns: 1fr; }
    .pnt__mark { flex-direction: row; align-items: flex-start; text-align: left; gap: 14px; }
    .pnt__mark-c { max-width: none; }
    .pnt__closing { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pnt__line { animation: none; stroke-dashoffset: 0; }
    .pnt__dot { animation: none; opacity: 1; }
  }
</style>
