---
import type { PersonaNarrative } from '../data/personaDetails';

interface Props {
  narrative: PersonaNarrative;
}

const { narrative } = Astro.props;
const n = narrative;
const curve = n.curve ?? 'rise';

/** Rise = Ops energy peak (smooth bezier). Fall = Marketing message decay (staircase).
 *  Rise viewBox: 0 0 1000 380 — curve in top portion, labels below.
 *  Fall viewBox: 0 0 1200 460 — staircase in top portion, labels below. */
const risePath = {
  area: 'M0,195 C 70,195 80,130 125,130 C 170,130 210,185 250,185 C 290,185 320,95 375,95 C 430,95 460,180 500,180 C 540,180 580,62 625,62 C 670,62 710,175 750,175 C 790,175 840,30 875,30 C 920,30 960,165 1000,165 L 1000,240 L 0,240 Z',
  line: 'M0,195 C 70,195 80,130 125,130 C 170,130 210,185 250,185 C 290,185 320,95 375,95 C 430,95 460,180 500,180 C 540,180 580,62 625,62 C 670,62 710,175 750,175 C 790,175 840,30 875,30 C 920,30 960,165 1000,165',
  dots: [
    { cx: 125, cy: 130 },
    { cx: 375, cy: 95 },
    { cx: 625, cy: 62 },
    { cx: 875, cy: 30 },
  ],
};

const uid = `pnt-${curve}`;

/** Fall staircase: four treads descending, contiguous end-to-end across the full 1000-wide viewBox.
 *  Each tread 250 wide; centers 300px apart so 230px labels have a 20px gap between them.
 *  Right end of one = left end of next (vertical drop connectors). */
const fallTreads = [
  { x1: 0,   x2: 250, y: 60,  cx: 125, color: '#68E3BE', drop: '#8ed3b5', marker: 'arrowg' },
  { x1: 250, x2: 500, y: 130, cx: 375, color: '#8ed3b5', drop: '#bcae7a', marker: 'arrowg' },
  { x1: 500, x2: 750, y: 200, cx: 625, color: '#bcae7a', drop: '#EDD086', marker: 'arrow'  },
  { x1: 750, x2: 1000, y: 264, cx: 875, color: '#EDD086', drop: null,    marker: null    },
];

/** Stack accumulation: four columns, each a growing stack of cost layers.
 *  Stage 1 = 1 block (the purchase, mint). Each stage adds a cooler/heavier layer on top.
 *  Bottom block always mint (the original purchase); new layers fade to amber.
 *  viewBox: 0 0 1000 460 — stacks in top portion, labels below (same as fall). */
const stackBlockW = 168;
const stackBlockH = 34;
const stackGap = 5;
const stackBaseY = 224; // bottom of lowest block
const stackLayerColors = ['#68E3BE', '#8ed3b5', '#bcae7a', '#EDD086'];
const stackCols = [125, 375, 625, 875].map((cx, colIdx) => {
  const layers = [];
  for (let i = 0; i <= colIdx; i++) {
    const y = stackBaseY - stackBlockH - i * (stackBlockH + stackGap);
    layers.push({ y, color: stackLayerColors[i], opacity: 1 - i * 0.06 });
  }
  return { cx, layers };
});

/** Converge: A/V systems as isolated proprietary silos — OFF your network.
 *  Different node shapes = different vendor systems (not a unified platform).
 *  No connection lines = they're silos that don't talk to each other.
 *  Nodes scatter at different heights = unorganized, not on your network.
 *  Faint dotted line at bottom = "your network" — the nodes are NOT on it.
 *  Alert markers grow = more that can fail and page you with no way to diagnose.
 *  viewBox: 0 0 1000 460 — scattered nodes in top portion, labels below. */
const convergeNetY = 215; // faint "your network" line at the bottom
const convergeNodeR = 8;
const convergeNodeSpacing = 38;
const convergeNodeColors = ['#68E3BE', '#8ed3b5', '#bcae7a', '#EDD086'];
const convergeShapes = ['circle', 'square', 'triangle', 'hexagon'];
// Scattered y-positions for nodes — different heights per stage, showing isolation
const convergeNodeYs = [
  [140],                    // stage 1: 1 node
  [115, 155],              // stage 2: 2 nodes, different heights
  [100, 140, 168],        // stage 3: 3 nodes, more scattered
  [95, 125, 150, 172],   // stage 4: 4 nodes, very scattered
];
const convergeAlertY = 80; // alerts above the highest nodes
const convergeCols = [125, 375, 625, 875].map((cx, colIdx) => {
  const nodeCount = colIdx + 1;
  const alertCount = colIdx;
  const ys = convergeNodeYs[colIdx];
  const nodes = [];
  for (let i = 0; i < nodeCount; i++) {
    const offset = (i - (nodeCount - 1) / 2) * convergeNodeSpacing;
    nodes.push({
      cx: cx + offset,
      cy: ys[i],
      color: convergeNodeColors[i],
      shape: convergeShapes[i],
    });
  }
  const alerts = [];
  for (let i = 0; i < alertCount; i++) {
    const nodeIdx = i + 1;
    const offset = (nodeIdx - (nodeCount - 1) / 2) * convergeNodeSpacing;
    const ax = cx + offset;
    alerts.push({ d: `M ${ax - 6} ${convergeAlertY + 6} L ${ax + 6} ${convergeAlertY + 6} L ${ax} ${convergeAlertY - 6} Z` });
  }
  return { cx, nodes, alerts };
});

/** Default icon set for 'iconcards' (IT persona). Overridable via narrative.icons. */
const defaultCardIcons = [
  `<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M 32 8 L 56 20 L 56 44 L 32 56 L 8 44 L 8 20 Z" fill="rgba(104,227,190,0.08)"/><path d="M 32 8 L 56 20 L 32 32 L 8 20 Z" fill="rgba(104,227,190,0.12)"/><path d="M 32 32 L 56 20 M 32 32 L 8 20 M 32 32 L 32 56" stroke-dasharray="3 3" opacity="0.5"/><text x="32" y="40" text-anchor="middle" fill="currentColor" stroke="none" font-size="14" font-family="Inter, sans-serif" opacity="0.5">?</text></svg>`,
  `<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M 8 32 Q 32 14 56 32 Q 32 50 8 32 Z" fill="rgba(141,211,181,0.08)"/><circle cx="32" cy="32" r="8" fill="rgba(141,211,181,0.12)"/><line x1="14" y1="18" x2="50" y2="46" stroke-width="3"/></svg>`,
  `<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><rect x="6" y="10" width="20" height="14" rx="3" fill="rgba(188,174,122,0.1)"/><rect x="38" y="10" width="20" height="14" rx="3" fill="rgba(188,174,122,0.1)"/><rect x="22" y="40" width="20" height="14" rx="3" fill="rgba(188,174,122,0.1)"/><line x1="26" y1="24" x2="28" y2="34" stroke-dasharray="2 4" opacity="0.4"/><line x1="38" y1="24" x2="36" y2="34" stroke-dasharray="2 4" opacity="0.4"/><line x1="48" y1="24" x2="42" y2="40" stroke-dasharray="2 4" opacity="0.4"/></svg>`,
  `<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><rect x="22" y="14" width="20" height="36" rx="4" fill="rgba(237,208,134,0.1)"/><line x1="28" y1="44" x2="36" y2="44" stroke-width="2"/><path d="M 14 22 Q 10 32 14 42" fill="none" opacity="0.6"/><path d="M 50 22 Q 54 32 50 42" fill="none" opacity="0.6"/><path d="M 10 16 Q 4 32 10 48" fill="none" opacity="0.3"/><path d="M 54 16 Q 60 32 54 48" fill="none" opacity="0.3"/><text x="32" y="36" text-anchor="middle" fill="currentColor" stroke="none" font-size="14" font-family="Inter, sans-serif" font-weight="700">!</text></svg>`,
];
const cardIcons = n.icons ?? defaultCardIcons;

/** Escalate: A/V & Facilities — increasing complexity as a continuum.
 *  Stage 1 (The Estate): ~40 dots, neat grid, all mint — manageable.
 *  Stage 2 (The Sprawl): ~3x dots, crowded, mixed colors, jittered — fragmented.
 *  Stage 3 (The Legwork): same dense field + tangled connection lines — the chase.
 *  Stage 4 (The Clock): same + one red alert node with radiating waves — the failure.
 *  viewBox: 0 0 1000 460 — dots in top portion, labels below. */
const escalateColors = ['#68E3BE', '#8ed3b5', '#bcae7a', '#EDD086'];
const escalateCols = [125, 375, 625, 875].map((cx, colIdx) => {
  const dots: { x: number; y: number; r: number; color: string; opacity: number }[] = [];
  const lines: { x1: number; y1: number; x2: number; y2: number }[] = [];
  let alert: { x: number; y: number } | null = null;

  if (colIdx === 0) {
    // Stage 1: ~40 dots, neat grid, all mint
    const cols = 8, rows = 5, spacing = 18, r = 2.5;
    const startX = cx - ((cols - 1) * spacing) / 2;
    const startY = 55;
    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        dots.push({ x: startX + col * spacing, y: startY + row * spacing, r, color: '#68E3BE', opacity: 0.72 });
      }
    }
  } else {
    // Stages 2-4: ~176 dots, crowded, mixed colors, jittered
    const cols = 16, rows = 11, spacing = 10, r = 1.6;
    const startX = cx - ((cols - 1) * spacing) / 2;
    const startY = 35;
    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        const idx = row * cols + col;
        const jX = ((idx * 7) % 5 - 2) * 0.6;
        const jY = ((idx * 13) % 5 - 2) * 0.6;
        const cIdx = (idx + colIdx * 3) % 4;
        dots.push({
          x: startX + col * spacing + jX,
          y: startY + row * spacing + jY,
          r,
          color: escalateColors[cIdx],
          opacity: 0.42 + ((idx * 3) % 5) * 0.08,
        });
      }
    }
    if (colIdx >= 2) {
      // Stages 3-4: tangled connection lines
      for (let i = 0; i < 28; i++) {
        const a = (i * 37 + colIdx * 11) % dots.length;
        let b = (i * 53 + colIdx * 19 + 7) % dots.length;
        if (b === a) b = (b + 1) % dots.length;
        lines.push({ x1: dots[a].x, y1: dots[a].y, x2: dots[b].x, y2: dots[b].y });
      }
    }
    if (colIdx === 3) {
      // Stage 4: alert node
      alert = { x: dots[87].x, y: dots[87].y };
    }
  }
  return { cx, dots, lines, alert };
});
---

<section class={`pnt pnt--${curve}`} id={uid}>
  <div class="pnt__inner">

    {curve === 'rise' && (
      <div class="pnt__chart pnt__chart--rise">
        <svg viewBox="0 0 1000 380" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Energy curve rising to a peak">
          <defs>
            <linearGradient id={`${uid}-grad`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(104,227,190,0.28)" />
              <stop offset="100%" stop-color="rgba(104,227,190,0)" />
            </linearGradient>
          </defs>
          <path d={risePath.area} fill={`url(#${uid}-grad)`} />
          <path d={risePath.line} fill="none" stroke="var(--mint)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          {risePath.dots.map((d, i) => (
            <circle cx={d.cx} cy={d.cy} r="6" fill="var(--navy-deep)" stroke="var(--mint)" stroke-width="2.5"
              class={`pnt__dot pnt__dot--${i+1}`} />
          ))}
          {risePath.dots.map((d, i) => (
            <foreignObject x={d.cx - 110} y={255} width="220" height="120">
              <div xmlns="http://www.w3.org/1999/xhtml" class="pnt__label pnt__label--rise">
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--rise`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'fall' && (
      <div class="pnt__chart pnt__chart--fall">
        <svg viewBox="0 0 1000 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Marketing message losing energy at each handoff">
          <defs>
            <marker id="arrow" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9" orient="auto">
              <path d="M 2 2 L 10 6 L 2 10 Z" fill="#EDD086" />
            </marker>
            <marker id="arrowg" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9" orient="auto">
              <path d="M 2 2 L 10 6 L 2 10 Z" fill="#8ed3b5" />
            </marker>
          </defs>

          {fallTreads.map((t, i) => (
            <g class={`pnt__tread pnt__tread--${i+1}`}>
              {t.drop && (
                <line x1={t.x2} y1={t.y} x2={t.x2} y2={fallTreads[i+1].y} stroke={t.drop} stroke-width="2"
                  marker-end={`url(#${t.marker})`} class={`pnt__drop pnt__drop--${i+1}`} />
              )}
              <line x1={t.x1} y1={t.y} x2={t.x2} y2={t.y}
                stroke={t.color}
                stroke-width={i === 3 ? 2 : 3}
                stroke-dasharray={i === 3 ? '6 6' : 'none'}
                stroke-linecap="round" />
              <circle cx={t.cx} cy={t.y} r="6" fill="var(--navy-deep)" stroke={t.color} stroke-width="2.5" />
            </g>
          ))}

          {fallTreads.map((t, i) => (
            <foreignObject x={t.cx - 115} y={t.y + 22} width="230" height="180">
              <div xmlns="http://www.w3.org/1999/xhtml" class={`pnt__label pnt__label--${i+1}`}>
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--${i+1}`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'stack' && (
      <div class="pnt__chart pnt__chart--stack">
        <svg viewBox="0 0 1000 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Cost layers accumulating from one purchase into a heavy pile">
          {stackCols.map((col, i) => (
            <g class={`pnt__col pnt__col--${i+1}`}>
              {col.layers.map((layer, j) => (
                <rect
                  x={col.cx - stackBlockW / 2}
                  y={layer.y}
                  width={stackBlockW}
                  height={stackBlockH}
                  rx="5"
                  fill={layer.color}
                  fill-opacity={layer.opacity}
                  class={`pnt__block pnt__block--${j+1}`}
                />
              ))}
              <circle cx={col.cx} cy={stackBaseY - stackBlockH / 2} r="5" fill="var(--navy-deep)" stroke={stackLayerColors[0]} stroke-width="2.5" class={`pnt__stacknode pnt__stacknode--${i+1}`} />
            </g>
          ))}

          {stackCols.map((col, i) => (
            <foreignObject x={col.cx - 115} y={250} width="230" height="180">
              <div xmlns="http://www.w3.org/1999/xhtml" class={`pnt__label pnt__label--${i+1}`}>
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--${i+1}`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'converge' && (
      <div class="pnt__chart pnt__chart--converge">
        <svg viewBox="0 0 1000 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="A/V systems from different vendors sitting as isolated silos off your network, accumulating failures you can't diagnose">
          {/* Faint dotted line = "your network" — the nodes are NOT on it */}
          <line x1="40" y1={convergeNetY} x2="960" y2={convergeNetY} stroke="rgba(104,227,190,0.15)" stroke-width="1.5" stroke-dasharray="4 8" />
          <text x="500" y={convergeNetY + 22} text-anchor="middle" fill="rgba(104,227,190,0.35)" font-size="11" font-family="Inter, sans-serif" letter-spacing="0.15em" text-transform="uppercase">YOUR NETWORK</text>

          {convergeCols.map((col, i) => (
            <g class={`pnt__col pnt__col--${i+1}`}>
              {/* Alert markers — failures you can't diagnose */}
              {col.alerts.map((a) => (
                <path d={a.d} fill="#EDD086" fill-opacity="0.75" class="pnt__alert" />
              ))}
              {/* Nodes — different shapes for different vendor systems, scattered at different heights */}
              {col.nodes.map((node, j) => {
                const r = convergeNodeR;
                if (node.shape === 'circle') {
                  return <circle cx={node.cx} cy={node.cy} r={r} fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                } else if (node.shape === 'square') {
                  return <rect x={node.cx - r} y={node.cy - r} width={r * 2} height={r * 2} rx="2" fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                } else if (node.shape === 'triangle') {
                  return <path d={`M ${node.cx} ${node.cy - r} L ${node.cx + r} ${node.cy + r} L ${node.cx - r} ${node.cy + r} Z`} fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" stroke-linejoin="round" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                } else {
                  return <path d={`M ${node.cx} ${node.cy - r} L ${node.cx + r} ${node.cy - r/2} L ${node.cx + r} ${node.cy + r/2} L ${node.cx} ${node.cy + r} L ${node.cx - r} ${node.cy + r/2} L ${node.cx - r} ${node.cy - r/2} Z`} fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" stroke-linejoin="round" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                }
              })}
            </g>
          ))}

          {convergeCols.map((col, i) => (
            <foreignObject x={col.cx - 115} y={250} width="230" height="180">
              <div xmlns="http://www.w3.org/1999/xhtml" class={`pnt__label pnt__label--${i+1}`}>
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--${i+1}`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'iconcards' && (
      <div class="pnt__chart pnt__chart--iconcards">
        <div class="pnt__cards">
          {n.moments.map((m, i) => (
            <div class={`pnt__card pnt__card--${i+1}`}>
              <div class="pnt__card-icon" set:html={cardIcons[i]} />
              <span class="pnt__card-stage">{m.time}</span>
              <span class="pnt__card-body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'escalate' && (
      <div class="pnt__chart pnt__chart--escalate">
        <svg viewBox="0 0 1000 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Endpoint complexity escalating from a manageable estate through sprawl, diagnostic chase, to a live failure">
          {escalateCols.map((col, i) => (
            <g class={`pnt__esc-col pnt__esc-col--${i+1}`}>
              {col.lines.map((l) => (
                <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="rgba(237,208,134,0.22)" stroke-width="0.6" />
              ))}
              {col.dots.map((d) => (
                <circle cx={d.x} cy={d.y} r={d.r} fill={d.color} fill-opacity={d.opacity} />
              ))}
              {col.alert && (
                <g class="pnt__esc-alert">
                  <circle cx={col.alert.x} cy={col.alert.y} r="4" fill="#ED5555" />
                  <circle cx={col.alert.x} cy={col.alert.y} r="9" fill="none" stroke="#ED5555" stroke-width="1.5" opacity="0.5" class="pnt__esc-wave" />
                  <circle cx={col.alert.x} cy={col.alert.y} r="14" fill="none" stroke="#ED5555" stroke-width="1" opacity="0.25" class="pnt__esc-wave2" />
                </g>
              )}
            </g>
          ))}
          {escalateCols.map((col, i) => (
            <foreignObject x={col.cx - 115} y={250} width="230" height="180">
              <div xmlns="http://www.w3.org/1999/xhtml" class={`pnt__label pnt__label--${i+1}`}>
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>
        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--${i+1}`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {n.closing && (
      <div class="pnt__closing">
        <div class="pnt__rule"></div>
        <p class="pnt__closing-text" set:html={n.closing} />
        {n.closingSupport && (
          <p class="pnt__closing-support">{n.closingSupport}</p>
        )}
      </div>
    )}
  </div>
</section>

<style>
.pnt { width: 100%; }
.pnt__inner {
  width: 100%;
}

/* Rise chart (Ops) */
.pnt__chart--rise svg { width: 100%; height: auto; display: block; }
.pnt__dot {
  opacity: 0;
  animation: pnt-pop 0.5s ease-out forwards;
}
.pnt__dot--1 { animation-delay: 0.2s; }
.pnt__dot--2 { animation-delay: 0.5s; }
.pnt__dot--3 { animation-delay: 0.8s; }
.pnt__dot--4 { animation-delay: 1.1s; }
@keyframes pnt-pop {
  from { opacity: 0; transform: scale(0.4); }
  to { opacity: 1; transform: scale(1); }
}

/* Fall chart (Marketing) */
.pnt__chart--fall svg { width: 100%; height: auto; display: block; overflow: visible; }
.pnt__tread { opacity: 0; animation: pnt-fadein 0.6s ease-out forwards; }
.pnt__tread--1 { animation-delay: 0.15s; }
.pnt__tread--2 { animation-delay: 0.45s; }
.pnt__tread--3 { animation-delay: 0.75s; }
.pnt__tread--4 { animation-delay: 1.05s; }
.pnt__drop { opacity: 0; animation: pnt-fadein 0.4s ease-out forwards; animation-delay: 0.35s; }
.pnt__drop--2 { animation-delay: 0.65s; }
