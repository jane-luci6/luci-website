---
import type { PersonaNarrative } from '../data/personaDetails';

interface Props {
  narrative: PersonaNarrative;
}

const { narrative } = Astro.props;
const n = narrative;
const curve = n.curve ?? 'rise';

/** Rise = Ops energy peak (smooth bezier). Fall = Marketing message decay (staircase).
 *  Rise viewBox: 0 0 1000 380 — curve in top portion, labels below.
 *  Fall viewBox: 0 0 1200 460 — staircase in top portion, labels below. */
const risePath = {
  area: 'M0,195 C 70,195 80,130 125,130 C 170,130 210,185 250,185 C 290,185 320,95 375,95 C 430,95 460,180 500,180 C 540,180 580,62 625,62 C 670,62 710,175 750,175 C 790,175 840,30 875,30 C 920,30 960,165 1000,165 L 1000,240 L 0,240 Z',
  line: 'M0,195 C 70,195 80,130 125,130 C 170,130 210,185 250,185 C 290,185 320,95 375,95 C 430,95 460,180 500,180 C 540,180 580,62 625,62 C 670,62 710,175 750,175 C 790,175 840,30 875,30 C 920,30 960,165 1000,165',
  dots: [
    { cx: 125, cy: 130 },
    { cx: 375, cy: 95 },
    { cx: 625, cy: 62 },
    { cx: 875, cy: 30 },
  ],
};

const uid = `pnt-${curve}`;

/** Fall staircase: four treads descending, contiguous end-to-end across the full 1000-wide viewBox.
 *  Each tread 250 wide; centers 300px apart so 230px labels have a 20px gap between them.
 *  Right end of one = left end of next (vertical drop connectors). */
const fallTreads = [
  { x1: 0,   x2: 250, y: 60,  cx: 125, color: '#68E3BE', drop: '#8ed3b5', marker: 'arrowg' },
  { x1: 250, x2: 500, y: 130, cx: 375, color: '#8ed3b5', drop: '#bcae7a', marker: 'arrowg' },
  { x1: 500, x2: 750, y: 200, cx: 625, color: '#bcae7a', drop: '#EDD086', marker: 'arrow'  },
  { x1: 750, x2: 1000, y: 264, cx: 875, color: '#EDD086', drop: null,    marker: null    },
];

/** Stack accumulation: four columns, each a growing stack of cost layers.
 *  Stage 1 = 1 block (the purchase, mint). Each stage adds a cooler/heavier layer on top.
 *  Bottom block always mint (the original purchase); new layers fade to amber.
 *  viewBox: 0 0 1000 460 — stacks in top portion, labels below (same as fall). */
const stackBlockW = 168;
const stackBlockH = 34;
const stackGap = 5;
const stackBaseY = 224; // bottom of lowest block
const stackLayerColors = ['#68E3BE', '#8ed3b5', '#bcae7a', '#EDD086'];
const stackCols = [125, 375, 625, 875].map((cx, colIdx) => {
  const layers = [];
  for (let i = 0; i <= colIdx; i++) {
    const y = stackBaseY - stackBlockH - i * (stackBlockH + stackGap);
    layers.push({ y, color: stackLayerColors[i], opacity: 1 - i * 0.06 });
  }
  return { cx, layers };
});

/** Converge: A/V systems piling onto the network, creating a tangled burden.
 *  Different node shapes = different vendor systems (not a unified platform).
 *  Connection lines cross between nodes = integration tangle.
 *  Network line gets progressively thicker = load increasing.
 *  Alert markers grow = more that can fail and page you.
 *  viewBox: 0 0 1000 460 — network in top portion, labels below. */
const convergeLineY = 160;
const convergeNodeR = 8;
const convergeNodeSpacing = 38;
const convergeAlertY = 118;
const convergeNodeColors = ['#68E3BE', '#8ed3b5', '#bcae7a', '#EDD086'];
const convergeShapes = ['circle', 'square', 'triangle', 'hexagon'];
const convergeCols = [125, 375, 625, 875].map((cx, colIdx) => {
  const nodeCount = colIdx + 1;
  const alertCount = colIdx;
  const nodes = [];
  for (let i = 0; i < nodeCount; i++) {
    const offset = (i - (nodeCount - 1) / 2) * convergeNodeSpacing;
    // Slight vertical scatter in later stages — things getting out of control
    const scatter = colIdx > 0 ? (i % 2 === 0 ? -3 - colIdx * 2 : 3 + colIdx * 2) : 0;
    nodes.push({
      cx: cx + offset,
      cy: convergeLineY + scatter,
      color: convergeNodeColors[i],
      shape: convergeShapes[i],
    });
  }
  // Connection lines between nodes (the integration tangle)
  const connections = [];
  for (let i = 0; i < nodeCount - 1; i++) {
    for (let j = i + 1; j < nodeCount; j++) {
      connections.push({ x1: nodes[i].cx, y1: nodes[i].cy, x2: nodes[j].cx, y2: nodes[j].cy });
    }
  }
  // Alert markers (larger, with exclamation feel)
  const alerts = [];
  for (let i = 0; i < alertCount; i++) {
    const nodeIdx = i + 1;
    const offset = (nodeIdx - (nodeCount - 1) / 2) * convergeNodeSpacing;
    const ax = cx + offset;
    const ay = convergeAlertY - colIdx * 4; // alerts creep upward as burden grows
    alerts.push({ d: `M ${ax - 6} ${ay + 6} L ${ax + 6} ${ay + 6} L ${ax} ${ay - 6} Z` });
  }
  // Network line segment thickness — heavier with each stage
  const lineWeight = 2 + colIdx * 1.5;
  return { cx, nodes, connections, alerts, lineWeight };
});
---

<section class={`pnt pnt--${curve}`} id={uid}>
  <div class="pnt__inner">

    {curve === 'rise' && (
      <div class="pnt__chart pnt__chart--rise">
        <svg viewBox="0 0 1000 380" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Energy curve rising to a peak">
          <defs>
            <linearGradient id={`${uid}-grad`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(104,227,190,0.28)" />
              <stop offset="100%" stop-color="rgba(104,227,190,0)" />
            </linearGradient>
          </defs>
          <path d={risePath.area} fill={`url(#${uid}-grad)`} />
          <path d={risePath.line} fill="none" stroke="var(--mint)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          {risePath.dots.map((d, i) => (
            <circle cx={d.cx} cy={d.cy} r="6" fill="var(--navy-deep)" stroke="var(--mint)" stroke-width="2.5"
              class={`pnt__dot pnt__dot--${i+1}`} />
          ))}
          {risePath.dots.map((d, i) => (
            <foreignObject x={d.cx - 110} y={255} width="220" height="120">
              <div xmlns="http://www.w3.org/1999/xhtml" class="pnt__label pnt__label--rise">
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--rise`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'fall' && (
      <div class="pnt__chart pnt__chart--fall">
        <svg viewBox="0 0 1000 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Marketing message losing energy at each handoff">
          <defs>
            <marker id="arrow" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9" orient="auto">
              <path d="M 2 2 L 10 6 L 2 10 Z" fill="#EDD086" />
            </marker>
            <marker id="arrowg" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9" orient="auto">
              <path d="M 2 2 L 10 6 L 2 10 Z" fill="#8ed3b5" />
            </marker>
          </defs>

          {fallTreads.map((t, i) => (
            <g class={`pnt__tread pnt__tread--${i+1}`}>
              {t.drop && (
                <line x1={t.x2} y1={t.y} x2={t.x2} y2={fallTreads[i+1].y} stroke={t.drop} stroke-width="2"
                  marker-end={`url(#${t.marker})`} class={`pnt__drop pnt__drop--${i+1}`} />
              )}
              <line x1={t.x1} y1={t.y} x2={t.x2} y2={t.y}
                stroke={t.color}
                stroke-width={i === 3 ? 2 : 3}
                stroke-dasharray={i === 3 ? '6 6' : 'none'}
                stroke-linecap="round" />
              <circle cx={t.cx} cy={t.y} r="6" fill="var(--navy-deep)" stroke={t.color} stroke-width="2.5" />
            </g>
          ))}

          {fallTreads.map((t, i) => (
            <foreignObject x={t.cx - 115} y={t.y + 22} width="230" height="180">
              <div xmlns="http://www.w3.org/1999/xhtml" class={`pnt__label pnt__label--${i+1}`}>
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--${i+1}`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'stack' && (
      <div class="pnt__chart pnt__chart--stack">
        <svg viewBox="0 0 1000 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Cost layers accumulating from one purchase into a heavy pile">
          {stackCols.map((col, i) => (
            <g class={`pnt__col pnt__col--${i+1}`}>
              {col.layers.map((layer, j) => (
                <rect
                  x={col.cx - stackBlockW / 2}
                  y={layer.y}
                  width={stackBlockW}
                  height={stackBlockH}
                  rx="5"
                  fill={layer.color}
                  fill-opacity={layer.opacity}
                  class={`pnt__block pnt__block--${j+1}`}
                />
              ))}
              <circle cx={col.cx} cy={stackBaseY - stackBlockH / 2} r="5" fill="var(--navy-deep)" stroke={stackLayerColors[0]} stroke-width="2.5" class={`pnt__stacknode pnt__stacknode--${i+1}`} />
            </g>
          ))}

          {stackCols.map((col, i) => (
            <foreignObject x={col.cx - 115} y={250} width="230" height="180">
              <div xmlns="http://www.w3.org/1999/xhtml" class={`pnt__label pnt__label--${i+1}`}>
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--${i+1}`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    {curve === 'converge' && (
      <div class="pnt__chart pnt__chart--converge">
        <svg viewBox="0 0 1000 460" preserveAspectRatio="xMidYMid meet" role="img" aria-label="A/V systems from different vendors piling onto the network, creating a tangled burden of endpoints, integrations, and alerts">
          {/* Network line — progressively heavier across stages */}
          {convergeCols.map((col, i) => {
            const x1 = i === 0 ? 40 : convergeCols[i - 1].cx + 60;
            const x2 = i === convergeCols.length - 1 ? 960 : col.cx + 60;
            return <line x1={x1} y1={convergeLineY} x2={x2} y2={convergeLineY} stroke="rgba(104,227,190,0.18)" stroke-width={col.lineWeight} stroke-linecap="round" />;
          })}

          {convergeCols.map((col, i) => (
            <g class={`pnt__col pnt__col--${i+1}`}>
              {/* Tangled connection lines between nodes */}
              {col.connections.map((c) => (
                <line x1={c.x1} y1={c.y1} x2={c.x2} y2={c.y2} stroke="rgba(237,208,134,0.25)" stroke-width="1" stroke-dasharray="3 3" class="pnt__netline" />
              ))}
              {/* Alert markers */}
              {col.alerts.map((a) => (
                <path d={a.d} fill="#EDD086" fill-opacity="0.75" class="pnt__alert" />
              ))}
              {/* Nodes — different shapes for different vendor systems */}
              {col.nodes.map((node, j) => {
                const r = convergeNodeR;
                if (node.shape === 'circle') {
                  return <circle cx={node.cx} cy={node.cy} r={r} fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                } else if (node.shape === 'square') {
                  return <rect x={node.cx - r} y={node.cy - r} width={r * 2} height={r * 2} rx="2" fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                } else if (node.shape === 'triangle') {
                  return <path d={`M ${node.cx} ${node.cy - r} L ${node.cx + r} ${node.cy + r} L ${node.cx - r} ${node.cy + r} Z`} fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" stroke-linejoin="round" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                } else {
                  return <path d={`M ${node.cx} ${node.cy - r} L ${node.cx + r} ${node.cy - r/2} L ${node.cx + r} ${node.cy + r/2} L ${node.cx} ${node.cy + r} L ${node.cx - r} ${node.cy + r/2} L ${node.cx - r} ${node.cy - r/2} Z`} fill="var(--navy-deep)" stroke={node.color} stroke-width="2.5" stroke-linejoin="round" class={`pnt__netnode pnt__netnode--${j+1}`} />;
                }
              })}
            </g>
          ))}

          {convergeCols.map((col, i) => (
            <foreignObject x={col.cx - 115} y={250} width="230" height="180">
              <div xmlns="http://www.w3.org/1999/xhtml" class={`pnt__label pnt__label--${i+1}`}>
                <span class="pnt__stage">{n.moments[i].time}</span>
                <span class="pnt__body">{n.moments[i].caption}</span>
              </div>
            </foreignObject>
          ))}
        </svg>

        <div class="pnt__mobile-list" aria-hidden="true">
          {n.moments.map((m, i) => (
            <div class={`pnt__mobile-item pnt__mobile-item--${i+1}`}>
              <span class="pnt__stage">{m.time}</span>
              <span class="pnt__body">{m.caption}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {n.closing && (
      <div class="pnt__closing">
        <div class="pnt__rule"></div>
        <p class="pnt__closing-text" set:html={n.closing} />
        {n.closingSupport && (
          <p class="pnt__closing-support">{n.closingSupport}</p>
        )}
      </div>
    )}
  </div>
</section>

<style>
.pnt { width: 100%; }
.pnt__inner {
  width: 100%;
}

/* Rise chart (Ops) */
.pnt__chart--rise svg { width: 100%; height: auto; display: block; }
.pnt__dot {
  opacity: 0;
  animation: pnt-pop 0.5s ease-out forwards;
}
.pnt__dot--1 { animation-delay: 0.2s; }
.pnt__dot--2 { animation-delay: 0.5s; }
.pnt__dot--3 { animation-delay: 0.8s; }
.pnt__dot--4 { animation-delay: 1.1s; }
@keyframes pnt-pop {
  from { opacity: 0; transform: scale(0.4); }
  to { opacity: 1; transform: scale(1); }
}

/* Fall chart (Marketing) */
.pnt__chart--fall svg { width: 100%; height: auto; display: block; overflow: visible; }
.pnt__tread { opacity: 0; animation: pnt-fadein 0.6s ease-out forwards; }
.pnt__tread--1 { animation-delay: 0.15s; }
.pnt__tread--2 { animation-delay: 0.45s; }
.pnt__tread--3 { animation-delay: 0.75s; }
.pnt__tread--4 { animation-delay: 1.05s; }
.pnt__drop { opacity: 0; animation: pnt-fadein 0.4s ease-out forwards; animation-delay: 0.35s; }
.pnt__drop--2 { animation-delay: 0.65s; }
.pnt__drop--3 { animation-delay: 0.95s; }
@keyframes pnt-fadein { to { opacity: 1; } }

/* Stack chart (Finance) */
.pnt__chart--stack svg { width: 100%; height: auto; display: block; overflow: visible; }
.pnt__col { opacity: 0; animation: pnt-fadein 0.6s ease-out forwards; }
.pnt__col--1 { animation-delay: 0.15s; }
.pnt__col--2 { animation-delay: 0.45s; }
.pnt__col--3 { animation-delay: 0.75s; }
.pnt__col--4 { animation-delay: 1.05s; }
.pnt__stacknode {
  opacity: 0;
  animation: pnt-pop 0.5s ease-out forwards;
}
.pnt__stacknode--1 { animation-delay: 0.3s; }
.pnt__stacknode--2 { animation-delay: 0.6s; }
.pnt__stacknode--3 { animation-delay: 0.9s; }
.pnt__stacknode--4 { animation-delay: 1.2s; }

/* Converge chart (IT) */
.pnt__chart--converge svg { width: 100%; height: auto; display: block; overflow: visible; }
.pnt__netnode {
  opacity: 0;
  animation: pnt-pop 0.5s ease-out forwards;
}
.pnt__netnode--1 { animation-delay: 0.2s; }
.pnt__netnode--2 { animation-delay: 0.4s; }
.pnt__netnode--3 { animation-delay: 0.6s; }
.pnt__netnode--4 { animation-delay: 0.8s; }
.pnt__alert {
  opacity: 0;
  animation: pnt-fadein 0.4s ease-out forwards;
  animation-delay: 0.5s;
}
.pnt__netline {
  opacity: 0;
  animation: pnt-fadein 0.5s ease-out forwards;
  animation-delay: 0.3s;
}

.pnt__label {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 0 6px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.pnt__label .pnt__stage {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.pnt__label .pnt__body {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 1.5;
}
/* Rise labels: all mint (energy building) */
.pnt__label--rise .pnt__stage,
.pnt__label--rise .pnt__body { color: var(--mint); }
/* Fall labels: color fade across stages */
.pnt__label--1 .pnt__stage,
.pnt__label--1 .pnt__body { color: #68E3BE; }
.pnt__label--2 .pnt__stage,
.pnt__label--2 .pnt__body { color: #8ed3b5; }
.pnt__label--3 .pnt__stage,
.pnt__label--3 .pnt__body { color: #bcae7a; opacity: 0.85; }
.pnt__label--4 .pnt__stage,
.pnt__label--4 .pnt__body { color: #EDD086; opacity: 0.7; }

/* Closing / payoff line */
.pnt__closing {
  margin-top: 40px;
  padding-top: 28px;
  border-top: 1px solid rgba(104,227,190,0.18);
  text-align: center;
}
.pnt__closing-text {
  font-family: var(--font-body);
  font-size: clamp(22px, 3vw, 28px);
  line-height: 1.45;
  color: var(--off-white);
  margin: 0 auto;
  max-width: 52ch;
}
.pnt__closing-text :global(em) {
  font-style: normal;
  color: var(--mint);
}
.pnt__closing-text :global(.pnt__luci) {
  position: relative;
  display: inline-block;
  font-family: var(--font-body);
  font-weight: 700;
  color: var(--off-white);
  text-shadow: 0 0 20px rgba(var(--mint-rgb), 0.26);
}
.pnt__closing-text :global(.pnt__luci)::after {
  content: '';
  position: absolute;
  left: 0.05em;
  right: 0.05em;
  bottom: -0.08em;
  height: 0.08em;
  background: var(--mint);
  box-shadow: 0 0 14px rgba(var(--mint-rgb), 0.5);
}
.pnt__closing-support {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: clamp(15px, 1.6vw, 18px);
  font-weight: 400;
  line-height: 1.6;
  color: rgba(245, 248, 250, 0.6);
  max-width: 52ch;
  margin: 14px auto 0;
}

/* Mobile: stack the four stages as a list with colored left border */
.pnt__mobile-list { display: none; flex-direction: column; gap: 18px; margin-top: 8px; }
.pnt__mobile-item {
  border-left: 3px solid;
  padding: 6px 0 6px 16px;
}
.pnt__mobile-item .pnt__stage {
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  display: block;
  margin-bottom: 4px;
}
.pnt__mobile-item .pnt__body {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 15px;
  line-height: 1.5;
}
.pnt__mobile-item--1 { border-color: #68E3BE; }
.pnt__mobile-item--1 .pnt__stage,
.pnt__mobile-item--1 .pnt__body { color: #68E3BE; }
.pnt__mobile-item--2 { border-color: #8ed3b5; }
.pnt__mobile-item--2 .pnt__stage,
.pnt__mobile-item--2 .pnt__body { color: #8ed3b5; }
.pnt__mobile-item--3 { border-color: #bcae7a; }
.pnt__mobile-item--3 .pnt__stage,
.pnt__mobile-item--3 .pnt__body { color: #bcae7a; }
.pnt__mobile-item--4 { border-color: #EDD086; }
.pnt__mobile-item--4 .pnt__stage,
.pnt__mobile-item--4 .pnt__body { color: #EDD086; opacity: 0.85; }
.pnt__mobile-item--rise { border-color: var(--mint); }
.pnt__mobile-item--rise .pnt__stage,
.pnt__mobile-item--rise .pnt__body { color: var(--mint); }

@media (max-width: 640px) {
  .pnt__chart--fall svg,
  .pnt__chart--rise svg,
  .pnt__chart--stack svg,
  .pnt__chart--converge svg { display: none; }
  .pnt__chart--fall .pnt__mobile-list,
  .pnt__chart--rise .pnt__mobile-list,
  .pnt__chart--stack .pnt__mobile-list,
  .pnt__chart--converge .pnt__mobile-list { display: flex; }
}

@media (prefers-reduced-motion: reduce) {
  .pnt__dot, .pnt__tread, .pnt__drop, .pnt__col, .pnt__stacknode, .pnt__netnode, .pnt__alert, .pnt__netline { animation: none; opacity: 1; }
}
</style>
