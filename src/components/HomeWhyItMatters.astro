---
// "Why it matters" — the four outcomes delivered by the consolidation above.
// Sits directly below HomeLedger ("Consolidation you can see") on the same navy
// canvas. A wide downward triangle bridges the two.
//
// De-boxed, icon-led stack: four hairline-separated rows, each a duotone line
// icon (mint primary, gold accent) + bold head + the detail, all visible at
// once. No flip, no index numerals, no empty poster space. Two columns on wide
// viewports (two independent stacks, one horizontal hairline between the rows,
// no vertical divider so it reads as lists — not a spreadsheet), one column on
// mobile. Icons are distinct per pillar. Voice: operational, declarative.

const pillars = [
  {
    head: 'Complete visibility and control across your property',
    detail:
      'No more chasing status across disconnected dashboards. LUCI rolls every endpoint, zone, and system into one live view of the property — see it all at a glance and act on any of it without switching tools.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="#68e3be"/><circle cx="12" cy="12" r="3" stroke="#68e3be"/><circle cx="12" cy="12" r="1.1" fill="#edd086" stroke="none"/></svg>`,
  },
  {
    head: 'Align your teams by default',
    detail:
      'IT, operations, and guest services work from the same source of truth. Change something once and every team sees it — no forwarded screenshots, no version drift, no finger-pointing.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="7" r="2.4" stroke="#68e3be"/><circle cx="18" cy="7" r="2.4" stroke="#68e3be"/><circle cx="12" cy="17" r="2.4" fill="#edd086" stroke="#edd086"/><path d="M7.7 8.5 10.5 15.3" stroke="#68e3be"/><path d="M16.3 8.5 13.5 15.3" stroke="#68e3be"/><path d="M8.4 7 15.6 7" stroke="#68e3be"/></svg>`,
  },
  {
    head: 'Fully activate the guest experience',
    detail:
      'Every screen becomes a live, on-brand moment — wayfinding, promotions, event info, entertainment — scheduled and controlled from one place, so the experience is intentional instead of accidental.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" stroke="#68e3be"/><path d="M9 20h6" stroke="#68e3be"/><path d="M12 17v3" stroke="#68e3be"/><path d="M12 7.4l1.1 2.7 2.7 1.1-2.7 1.1L12 15l-1.1-2.7-2.7-1.1 2.7-1.1z" fill="#edd086" stroke="none"/></svg>`,
  },
  {
    head: 'Invest in the only A/V that scales and improves',
    detail:
      'One platform that grows with you instead of fragmenting as you grow. Add endpoints, rooms, or properties without rip-and-replace — and software updates mean the system you own keeps getting better, not older.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20V13" stroke="#68e3be"/><path d="M12 20V9" stroke="#68e3be"/><path d="M17 20V5" stroke="#edd086"/><path d="M4 8l5-4 5 3 6-5" stroke="#68e3be"/></svg>`,
  },
];
---

<section class="home-why" aria-label="What that consolidation delivers">
  <div class="home-why__inner container container--wide">
    <!-- Wide, shallow downward triangle (the pointing portion only). Inset ~8%
         from each edge so no hard cutoff at the page edge. Gold→mint echoes the
         differentiator's consolidation funnel; bridges ledger → pillars. -->
    <svg class="home-why__apply" viewBox="0 0 1200 96" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="why-apply-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#edd086" stop-opacity="0.5" />
          <stop offset="1" stop-color="#68e3be" stop-opacity="0.95" />
        </linearGradient>
      </defs>
      <path d="M100,0 L1100,0 L600,96 Z" fill="url(#why-apply-grad)" />
    </svg>

    <ul class="home-why__list" role="list">
      {pillars.map((p) => (
        <li class="home-why__row">
          <span class="home-why__icon" aria-hidden="true" set:html={p.icon} />
          <div class="home-why__copy">
            <p class="home-why__head">{p.head}</p>
            <p class="home-why__detail">{p.detail}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-why {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--navy);
    color: var(--off-white);
  }

  /* Mint/gold circuit pattern — site standard: single tile, cover (enlarge+crop, no
     seam), lighten blend, 0.22, with the navy veil that fades it behind the content. */
  .home-why::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: url('/images/textures/texture-circuit-header-mintgold.png');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    mix-blend-mode: lighten;
    opacity: 0.22;
  }
  .home-why::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(10, 22, 28, 0.86) 16%, rgba(10, 22, 28, 0.86) 84%, transparent 100%);
  }

  .home-why__inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(28px, 3.4vw, 44px);
    padding-bottom: clamp(64px, 10vw, 112px);
    max-width: 1180px;
  }

  .home-why__apply {
    display: block;
    width: 100%;
    height: clamp(56px, 6.5vw, 84px);
    margin: 0 0 clamp(40px, 5vw, 64px);
    filter: drop-shadow(0 10px 20px rgba(var(--mint-rgb), 0.34));
  }

  .home-why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(40px, 5vw, 72px);
    row-gap: 0;
    align-items: start;
  }

  /* Each row: icon tile + copy, hairline-separated. Two columns read as two
     independent stacks; the row-2 top border is the single divider between the
     two rows (no vertical line, so it never reads as a spreadsheet grid). */
  .home-why__row {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: clamp(24px, 3vw, 36px) 0;
  }
  .home-why__row:nth-child(3),
  .home-why__row:nth-child(4) {
    border-top: 1px solid rgba(var(--mint-rgb), 0.14);
  }

  /* Soft duotone icon tile — house style adapted to dark: mint-tinted gradient,
     inset mint hairline, no drop shadow. Icon is line work with one gold accent. */
  .home-why__icon {
    flex: 0 0 auto;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: linear-gradient(155deg, rgba(104, 227, 190, 0.14) 0%, rgba(104, 227, 190, 0.04) 100%);
    box-shadow: inset 0 0 0 1px rgba(var(--mint-rgb), 0.22);
  }
  .home-why__icon :global(svg) {
    width: 28px;
    height: 28px;
    display: block;
  }

  .home-why__copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .home-why__head {
    margin: 0 0 8px;
    max-width: 22ch;
    font-family: var(--font-head);
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--off-white);
  }

  .home-why__detail {
    margin: 0;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.15vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.72);
  }

  @media (max-width: 760px) {
    .home-why__list {
      grid-template-columns: 1fr;
      column-gap: 0;
    }
    .home-why__row {
      border-top: 1px solid rgba(var(--mint-rgb), 0.14);
    }
    .home-why__row:first-child {
      border-top: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-why__apply {
      filter: none;
    }
  }
</style>
