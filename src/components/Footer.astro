---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide">
    <p class="site-footer__tagline display-label">{site.tagline}</p>
    <nav class="site-footer__nav" aria-label="Utility">
      <a href="https://support.lucisystems.com" target="_blank" rel="noopener noreferrer">Customer login</a>
      <a href="/privacy-policy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/accessibility">Accessibility</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </nav>
    <p class="site-footer__copy">&copy; {year} {site.name}, Inc.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: rgba(245, 248, 250, 0.78);
    padding: var(--space-5) var(--page-pad);
    border-top: 4px solid var(--mint);
  }

  .site-footer__tagline {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13px;
  }

  .site-footer__nav a {
    color: rgba(245, 248, 250, 0.78);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--mint);
  }

  .site-footer__copy {
    margin-top: var(--space-3);
    font-size: 12px;
    color: rgba(245, 248, 250, 0.5);
  }
</style>
