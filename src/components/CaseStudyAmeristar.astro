---
import { ameristarCaseStudy } from '../data/site';
import { ameristarCaseStudyDetail as cs } from '../data/caseStudyAmeristar';

const { dek, logoSrc } = ameristarCaseStudy;
---

<article class="cs-page">
  <div class="cs-page__sheet">
    <header class="cs-hero">
      <div class="cs-hero__kicker"><span>Case Study</span></div>
      <h1 class="cs-hero__title">
        <span class="cs-hero__leadin">{cs.heroLeadIn}</span>
        <em>{cs.heroDisplay}</em>
      </h1>
      <p class="cs-hero__dek">{dek}</p>
      <div class="cs-hero__actions">
        <a class="cs-download" href={cs.pdfHref} download={cs.pdfFilename}>
          <span class="cs-download__icon" aria-hidden="true">↓</span>
          Download PDF
        </a>
      </div>
      <p class="cs-hero__property">
        {cs.property}
        <span>{cs.propertyMeta}</span>
      </p>
    </header>

    <section class="cs-glance" aria-label="At a glance">
      <div class="cs-glance__logo">
        <img src={logoSrc} alt="Ameristar Council Bluffs" width="220" height="44" />
      </div>
      <div class="cs-facts">
        {cs.facts.map((fact) => (
          <div>
            <p class="cs-facts__label">{fact.label}</p>
            <p class="cs-facts__value">{fact.value}</p>
          </div>
        ))}
      </div>
      <ul class="cs-inventory" aria-label="Retrofit scope">
        {cs.inventory.map((item) => (
          <li class="cs-inventory__item">
            <p class="cs-inventory__num">{item.value}</p>
            <p class="cs-inventory__label">{item.label}</p>
          </li>
        ))}
      </ul>
      <div class="cs-summary">
        {cs.summary.map((cell) => (
          <div class="cs-summary__cell">
            <p class="cs-summary__label">{cell.label}</p>
            <p class="cs-summary__text">{cell.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="cs-photo-band" aria-labelledby="cs-challenge-title">
      <img class="cs-photo-band__img" src={cs.challenge.photo.src} alt={cs.challenge.photo.alt} width="768" height="1024" loading="lazy" />
      <div class="cs-photo-band__scrim" aria-hidden="true"></div>
      <div class="cs-photo-band__content">
        <h2 id="cs-challenge-title" class="cs-sec__title">{cs.challenge.titleBefore}<span class="cs-sec__title-accent">{cs.challenge.titleAccent}</span></h2>
        <div class="cs-copy">
          {cs.challenge.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="cs-sec cs-sec--mid">
      <h2 class="cs-sec__title">{cs.approach.titleBefore}<span class="cs-sec__title-accent">{cs.approach.titleAccent}</span></h2>
      <div class="cs-copy">
        {cs.approach.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <ul class="cs-scope" aria-label="What was done">
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="4" width="18" height="14" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M7 10l3 2.2L7 14.4" fill="none" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="12" y1="14.5" x2="16.5" y2="14.5" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>{cs.approach.scope[0]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M3 9h18M3 15h18M9 3v18M15 3v18" stroke="#68E3BE" stroke-width="1.3"/>
            <rect x="9" y="9" width="6" height="6" fill="#EDD086" fill-opacity="0.9"/>
          </svg>
          <span>{cs.approach.scope[1]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="3" width="16" height="5" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <rect x="4" y="10" width="16" height="5" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <rect x="4" y="17" width="16" height="4" rx="1.5" stroke="#68E3BE" stroke-width="1.8"/>
            <circle cx="7.5" cy="5.5" r="1" fill="#EDD086"/>
            <circle cx="7.5" cy="12.5" r="1" fill="#EDD086"/>
          </svg>
          <span>{cs.approach.scope[2]}</span>
        </li>
      </ul>
      <div class="cs-copy">
        <p>{cs.approach.closing}</p>
      </div>
    </section>

    <section class="cs-sec cs-consolidation" aria-labelledby="cs-consolidation-title">
      <header class="cs-consolidation__header">
        <h2 id="cs-consolidation-title" class="cs-consolidation__title"><em>Consolidation</em> you can see</h2>
      </header>
      <ul class="cs-consolidation__list">
        {cs.consolidation.map((item) => (
          <li class="cs-consolidation__item">
            <p class="cs-consolidation__item-title">
              <span class="cs-consolidation__problem">{item.problem}</span>
              <span class="cs-consolidation__arrow" aria-hidden="true">&rarr;</span>
              <span class="cs-consolidation__solution">{item.solution}</span>
            </p>
            <p class="cs-consolidation__item-text">{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="cs-quote">
      <blockquote class="cs-quote__text">&ldquo;{cs.quote.text}&rdquo;</blockquote>
      <p class="cs-quote__attrib">
        <span>{cs.quote.role}</span>
        {cs.quote.org}
      </p>
    </section>

    <section class="cs-sec cs-sec--dark">
      <h2 class="cs-sec__title">{cs.results.titleBefore}<span class="cs-sec__title-accent">{cs.results.titleAccent}</span></h2>
      <ul class="cs-results">
        {cs.results.bullets.map((item) => <li>{item}</li>)}
      </ul>
      <div class="cs-copy">
        {cs.results.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="cs-scope-story" aria-labelledby="cs-scope-story-title">
      <h2 id="cs-scope-story-title" class="cs-scope-story__title">
        {cs.scopeStory.titleBefore}<em>{cs.scopeStory.titleAccent}</em>
      </h2>
      <ul class="cs-scope-stats" aria-label="Property scope managed through LUCI">
        {cs.scopeStory.stats.map((stat) => (
          <li class="cs-scope-stat">
            <p class="cs-scope-stat__value">{stat.value}</p>
            <p class="cs-scope-stat__label">{stat.label}</p>
          </li>
        ))}
      </ul>
      <svg class="cs-scope-converge" viewBox="0 0 100 120" preserveAspectRatio="none" aria-hidden="true">
        <defs><linearGradient id="ameristar-funnel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#edd086" stop-opacity="0.75"/><stop offset="1" stop-color="#68e3be" stop-opacity="0.7"/></linearGradient></defs>
        <line x1="15" y1="0" x2="50" y2="116" stroke="url(#ameristar-funnel)"/>
        <line x1="38" y1="0" x2="50" y2="116" stroke="url(#ameristar-funnel)"/>
        <line x1="62" y1="0" x2="50" y2="116" stroke="url(#ameristar-funnel)"/>
        <line x1="85" y1="0" x2="50" y2="116" stroke="url(#ameristar-funnel)"/>
      </svg>
      <div class="cs-scope-arrow" aria-hidden="true"></div>
      <div class="cs-scope-dest">
        <span class="cs-scope-dest-rule" aria-hidden="true"></span>
        <p class="cs-scope-story__outcome">
          {cs.scopeStory.outcomeBefore}<em>{cs.scopeStory.outcomeAccent}</em>{cs.scopeStory.outcomeAfter}
        </p>
        <p class="cs-scope-story__dek">{cs.scopeStory.dek}</p>
      </div>
    </section>

    <section class="cs-sec cs-sec--light">
      <h2 class="cs-sec__title">{cs.whatsNext.titleBefore}<span class="cs-sec__title-accent">{cs.whatsNext.titleAccent}</span></h2>
      <div class="cs-copy">
        <p>{cs.whatsNext.intro}</p>
        <ul class="cs-plan">
          {cs.whatsNext.plans.map((item) => (
            <li>
              <span>
                <strong>{item.title}</strong> {item.body}
              </span>
            </li>
          ))}
        </ul>
        <p class="cs-bottom-line">{cs.whatsNext.bottomLine}</p>
      </div>
    </section>

    <section class="cs-cta">
      <p class="cs-cta__body">Curious what this looks like for your property? <span class="cs-cta__accent">Let&rsquo;s talk.</span></p>
      <div class="cs-cta__actions">
        <a class="cs-cta-btn" href="/contact">
          Talk to LUCI
          <span class="cs-cta-btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="cs-cta-btn cs-cta-btn--secondary" href={cs.pdfHref} download={cs.pdfFilename}>
          <span class="cs-download__icon" aria-hidden="true">↓</span>
          Download PDF
        </a>
      </div>
      <div class="cs-cta__about">
        <p class="cs-cta__about-label">{cs.cta.aboutLabel}</p>
        <p class="cs-cta__statement">{cs.cta.aboutStatement}</p>
      </div>
    </section>
  </div>
</article>

<style>
  .cs-page {
    background: var(--navy-deep);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .cs-page__sheet {
    max-width: 880px;
    margin: 0 auto;
    background: #fff;
  }

  /* Hero — mesh stays vivid at the right edge; a scrim mutes it behind the
     left-aligned title, dek, and property line so the type stays legible. */
  .cs-hero {
    background-color: var(--navy-deep);
    background-image:
      linear-gradient(to right,
        rgba(8, 18, 24, 0.86) 0%,
        rgba(8, 18, 24, 0.80) 48%,
        rgba(8, 18, 24, 0.42) 78%,
        rgba(8, 18, 24, 0.10) 100%),
      url('/images/mesh/luci-bg-hero-1920x1080.svg');
    background-size: cover; background-position: center; background-repeat: no-repeat;
    padding: clamp(40px, 8vw, 84px) clamp(28px, 6vw, 64px) clamp(40px, 7vw, 72px);
    overflow: hidden; position: relative;
  }
  .cs-hero::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px;
    background: linear-gradient(to right, var(--mint) 0 62%, var(--gold) 62% 100%);
  }
  .cs-hero__kicker { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
  .cs-hero__kicker::before { content: ''; width: 28px; height: 2px; background: var(--mint); }
  .cs-hero__kicker span {
    font-family: var(--font-display); font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--mint);
  }
  .cs-hero__title {
    margin: 0 0 26px; font-family: var(--font-head); font-weight: 700;
    font-size: clamp(34px, 6.5vw, 60px); line-height: 1.04; letter-spacing: -0.03em;
    color: var(--off-white); max-width: 16ch;
  }
  .cs-hero__leadin {
    display: block; font-family: var(--font-head);
    font-size: clamp(17px, 2.2vw, 24px); font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(235, 245, 248, 0.82); margin-bottom: 14px;
  }
  .cs-hero__title :global(em) {
    display: block; font-family: var(--font-display); font-style: normal;
    font-size: clamp(24px, 4.8vw, 44px); line-height: 1.2; letter-spacing: 0;
    color: var(--mint); text-transform: uppercase; max-width: 12ch;
  }
  .cs-hero__dek {
    margin: 0 0 30px; font-size: clamp(17px, 2.2vw, 20px); line-height: 1.6;
    color: rgba(235, 245, 248, 0.82); max-width: 58ch;
  }
  .cs-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 30px; }
  .cs-download {
    display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600;
    letter-spacing: 0.04em; text-decoration: none; color: var(--mint);
    border: 1px solid rgba(104, 227, 190, 0.45); padding: 12px 20px;
    transition: background 0.15s, border-color 0.15s;
  }
  .cs-download:hover { background: rgba(104, 227, 190, 0.08); border-color: var(--mint); }
  .cs-download__icon { font-size: 16px; line-height: 1; }
  .cs-hero__property {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 0;
    padding-top: 24px; border-top: 1px solid rgba(104, 227, 190, 0.15);
    font-size: 13px; font-weight: 600; letter-spacing: 0.04em; color: var(--gold);
  }
  .cs-hero__property span { color: rgba(165, 179, 188, 0.7); font-weight: 500; }

  /* Glance */
  .cs-glance {
    background: var(--off-white);
    padding: clamp(32px, 5vw, 48px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid var(--rule-light);
  }
  .cs-glance__logo { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--rule-light); }
  .cs-glance__logo img { height: 44px; width: auto; display: block; }
  .cs-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 32px; }
  @media (max-width: 620px) { .cs-facts { grid-template-columns: repeat(2, 1fr); gap: 20px 24px; } }
  .cs-facts__label {
    margin: 0 0 8px; font-family: var(--font-display); font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-light);
  }
  .cs-facts__value { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.3; color: var(--navy); }

  /* Scope inventory (denominator) */
  .cs-inventory {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--rule-light); border: 1px solid var(--rule-light);
    margin-bottom: 28px; list-style: none; padding: 0; margin-left: 0; margin-right: 0;
  }
  @media (max-width: 620px) { .cs-inventory { grid-template-columns: repeat(2, 1fr); } }
  .cs-inventory__item { background: #fff; padding: 18px 16px; text-align: left; }
  .cs-inventory__num {
    margin: 0 0 6px; font-family: var(--font-head); font-size: clamp(28px, 4vw, 36px);
    font-weight: 700; line-height: 1; letter-spacing: -0.03em; color: var(--accent-light);
  }
  .cs-inventory__label {
    margin: 0; font-size: 13px; line-height: 1.35; color: var(--ink); font-weight: 500;
  }

  .cs-summary {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--rule-light); border: 1px solid var(--rule-light);
  }
  @media (max-width: 620px) { .cs-summary { grid-template-columns: 1fr; } }
  .cs-summary__cell { background: #fff; padding: 22px; }
  .cs-summary__label {
    margin: 0 0 10px; font-family: var(--font-display); font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-light);
  }
  .cs-summary__text { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink); }
  /* Sections */
  .cs-sec {
    padding: clamp(44px, 6vw, 72px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid var(--rule-light);
  }
  .cs-sec--white { background: #fff; }
  .cs-sec--light { background: var(--off-white); }
  .cs-sec--mid {
    position: relative; isolation: isolate;
    background-color: var(--navy-mid);
    border-bottom-color: rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }
  .cs-sec--mid::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 95% 100% at 0% 35%, rgba(104, 227, 190, 0.28) 0%, transparent 68%),
      radial-gradient(ellipse 60% 75% at 15% 100%, rgba(104, 227, 190, 0.14) 0%, transparent 58%);
  }
  .cs-sec--mid > :global(*) { position: relative; z-index: 1; }
  .cs-sec--dark { background: var(--navy); border-bottom-color: rgba(0, 0, 0, 0.3); }
  .cs-sec__title {
    margin: 0 0 22px; font-family: var(--font-head); font-weight: 700;
    font-size: clamp(24px, 4vw, 34px); line-height: 1.12; letter-spacing: -0.025em; max-width: 24ch;
  }
  .cs-sec--white .cs-sec__title, .cs-sec--light .cs-sec__title { color: var(--navy); }
  .cs-sec--mid .cs-sec__title, .cs-sec--dark .cs-sec__title { color: var(--off-white); }
  .cs-sec__title-accent { color: var(--gold); }
  .cs-sec--white .cs-sec__title-accent, .cs-sec--light .cs-sec__title-accent { color: var(--accent-light); }
  .cs-copy p { margin: 0 0 18px; font-size: 17px; line-height: 1.72; max-width: 64ch; }
  .cs-copy p:last-child { margin-bottom: 0; }
  .cs-sec--white .cs-copy p, .cs-sec--light .cs-copy p { color: var(--ink); }
  .cs-sec--mid .cs-copy p { color: rgba(235, 245, 248, 0.88); }
  .cs-sec--dark .cs-copy p { color: rgba(235, 245, 248, 0.92); }

  /* Full-bleed photo section — text rides a horizontal scrim */
  .cs-photo-band {
    position: relative;
    overflow: hidden;
    min-height: clamp(380px, 52vw, 520px);
    border-bottom: none;
  }
  .cs-photo-band__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 72%;
    display: block;
  }
  .cs-photo-band__scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to right,
      rgba(245, 248, 250, 0.96) 0%,
      rgba(245, 248, 250, 0.92) 48%,
      rgba(245, 248, 250, 0.62) 68%,
      rgba(245, 248, 250, 0.18) 88%,
      rgba(245, 248, 250, 0) 100%);
  }
  .cs-photo-band__content {
    position: relative; z-index: 2;
    padding: clamp(44px, 6vw, 72px) clamp(28px, 6vw, 64px);
    max-width: 48ch;
  }
  .cs-photo-band .cs-sec__title { color: var(--navy); }
  .cs-photo-band .cs-sec__title-accent { color: var(--accent-light); }
  .cs-photo-band .cs-copy p { color: var(--ink); }
  @media (max-width: 640px) {
    .cs-photo-band { min-height: 420px; }
    .cs-photo-band__scrim {
      background: linear-gradient(to bottom,
        rgba(245, 248, 250, 0.96) 0%,
        rgba(245, 248, 250, 0.88) 48%,
        rgba(245, 248, 250, 0.35) 72%,
        rgba(245, 248, 250, 0) 100%);
    }
    .cs-photo-band__content { max-width: none; }
  }

  /* Scope list — icon-based 2-column grid */
  .cs-scope {
    list-style: none; margin: 28px 0 28px; padding: 0; max-width: 64ch;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
  }
  .cs-scope li {
    display: flex; flex-direction: row; align-items: flex-start; gap: 14px;
    padding: 16px 18px; font-size: 15px; line-height: 1.5; margin: 0;
    color: rgba(235, 245, 248, 0.9); background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(104, 227, 190, 0.4); border-radius: 14px;
  }
  .cs-scope li svg { display: block; width: 28px; height: 28px; flex-shrink: 0; }
  .cs-scope li:nth-child(3) { grid-column: 1 / -1; }
  @media (max-width: 620px) { .cs-scope { grid-template-columns: 1fr; } }

  /* Consolidation you can see — dark section matching Yaamava style */
  .cs-consolidation {
    position: relative; isolation: isolate; overflow: hidden;
    background-color: var(--navy-deep);
    background-image:
      linear-gradient(to right,
        var(--navy-deep) 0%,
        var(--navy-deep) 42%,
        rgba(7, 15, 20, 0.92) 58%,
        rgba(7, 15, 20, 0.62) 100%),
      url('/images/case-studies/ameristar-rack-before.png');
    background-size: cover, cover;
    background-position: left top, right center;
    background-repeat: no-repeat;
    border-bottom-color: rgba(104, 227, 190, 0.2);
  }
  .cs-consolidation__header { margin-bottom: 32px; position: relative; z-index: 1; }
  .cs-consolidation__title {
    margin: 0; font-family: var(--font-head); font-weight: 700;
    font-size: clamp(24px, 4vw, 34px); line-height: 1.12; letter-spacing: -0.025em;
    color: var(--off-white); max-width: 28ch;
  }
  .cs-consolidation__title em { font-style: normal; color: var(--gold); }
  .cs-consolidation__list {
    list-style: none; margin: 0; padding: 0; max-width: 56ch;
    border-top: 1px solid rgba(235, 245, 248, 0.18);
    position: relative; z-index: 1;
  }
  .cs-consolidation__item { padding: 22px 0; border-bottom: 1px solid rgba(235, 245, 248, 0.18); }
  .cs-consolidation__item-title {
    margin: 0 0 8px; font-family: var(--font-head); font-weight: 700;
    font-size: 17px; line-height: 1.35;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
  }
  .cs-consolidation__problem,
  .cs-consolidation__solution { color: var(--mint); }
  .cs-consolidation__arrow { color: var(--off-white); font-weight: 400; }
  .cs-consolidation__item-text {
    margin: 0; font-family: var(--font-body); font-size: 17px; line-height: 1.65; color: rgba(235, 245, 248, 0.84);
  }
  /* Quote — light block under the dark consolidation section */
  .cs-quote {
    background: #ffffff;
    padding: clamp(44px, 7vw, 76px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid rgba(8, 24, 34, 0.08);
  }
  .cs-quote__text {
    margin: 0 0 20px; font-family: var(--font-body); font-size: clamp(19px, 2.6vw, 24px);
    font-style: italic; line-height: 1.45; color: var(--navy);
    border-left: 5px solid var(--accent-light); padding: 6px 0 6px 26px; max-width: 52ch;
  }
  .cs-quote__attrib {
    margin: 0; padding-left: 31px; font-size: 12px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.6; color: var(--navy-muted);
  }
