---
interface Props {
  heroImage: string;
  heroAlt?: string;
  heroVideo?: string;
  heroPoster?: string;
  kicker?: string;
  lockupName: string;
  lockupRole: string;
  deck?: string;
  deckHtml?: string;
  sectionId?: string;
}

const {
  heroImage,
  heroAlt = '',
  heroVideo = '',
  heroPoster = '',
  kicker = '',
  lockupName,
  lockupRole,
  deck = '',
  deckHtml = '',
  sectionId = 'persona-thesis',
} = Astro.props;
---

<section id={sectionId} class="persona-hero">
  {heroVideo ? (
    <>
      <video
        class="persona-hero__video"
        src={heroVideo}
        poster={heroPoster || heroImage}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src={heroVideo} type="video/mp4" />
      </video>
      <img
        class="persona-hero__poster"
        src={heroPoster || heroImage}
        alt=""
        width="1920"
        height="820"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
    </>
  ) : (
    <img
      class="persona-hero__img"
      src={heroImage}
      alt={heroAlt}
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  )}
  <span class="persona-hero__scrim" aria-hidden="true"></span>
  <span class="persona-hero__grain" aria-hidden="true"></span>

  <div class="persona-hero__inner container container--wide">
    {kicker && <p class="persona-hero__kicker display-label">{kicker}</p>}
    <div class="header-lockup is-in" data-reveal>
      <h2 class="header-lockup__name" set:html={lockupName} />
    </div>
    {deckHtml ? (
      <p class="persona-hero__deck persona-hero__deck--html" set:html={deckHtml} />
    ) : (
      deck && <p class="persona-hero__deck">{deck}</p>
    )}
  </div>
</section>

<style>
  .persona-hero {
    position: relative;
    width: 100%;
    min-height: clamp(320px, 40vw, 440px);
    aspect-ratio: 3 / 1;
    max-height: 60vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--off-white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .persona-hero__img,
  .persona-hero__video,
  .persona-hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .persona-hero__video {
    transform: scale(1.08);
    transform-origin: center center;
  }

  .persona-hero__poster {
    display: none;
  }

  .persona-hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(105deg, rgba(8, 17, 22, 0.92) 0%, rgba(8, 17, 22, 0.5) 44%, rgba(8, 17, 22, 0.22) 100%),
      linear-gradient(to top, rgba(8, 17, 22, 0.94) 0%, rgba(8, 17, 22, 0.38) 50%, transparent 74%);
  }

  .persona-hero__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.26;
    background-image: url('/images/textures/texture-circuit-header-mintgold.png');
    background-size: cover;
    background-repeat: no-repeat;
    mix-blend-mode: soft-light;
  }

  .persona-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: clamp(72px, 9vw, 104px) clamp(36px, 5vw, 60px);
  }

  .persona-hero__kicker {
    color: var(--mint);
    margin: 0 0 var(--space-3);
    letter-spacing: 0.2em;
  }

  .persona-hero .header-lockup {
    display: block;
    margin-bottom: var(--space-3);
  }

  .persona-hero .header-lockup__name {
    font-family: var(--font-display);
    font-size: clamp(38px, 6vw, 64px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--mint);
    margin: 0;
    text-transform: uppercase;
  }

  .persona-hero .header-lockup__rule {
    display: block;
    width: 40px;
    height: 3px;
    margin: 16px 0 12px;
    background: var(--mint);
    border-radius: 2px;
  }

  .persona-hero .header-lockup__role {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 1.35;
    color: var(--mint);
    margin: 0;
  }

  .persona-hero__deck {
    max-width: var(--measure);
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.9);
    text-align: left;
  }

  .persona-hero__deck--html {
    font-family: var(--font-display);
    font-size: clamp(11px, 1.05vw, 13px);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 248, 250, 0.82);
    max-width: 44ch;
    margin-top: 4px;
  }
  .persona-hero__deck--html :global(em) {
    font-style: normal;
    color: var(--mint);
  }

  @media (max-width: 720px) {
    .persona-hero {
      aspect-ratio: auto;
      min-height: clamp(360px, 70vw, 460px);
      max-height: none;
    }

    .persona-hero__video {
      transform: scale(1.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .persona-hero__video {
      display: none;
    }

    .persona-hero__poster {
      display: block;
      transform: scale(1.08);
      transform-origin: center center;
    }
  }
</style>
