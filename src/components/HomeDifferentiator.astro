---
import { homeDifferentiator } from '../data/homeDifferentiator';
import { floorTicker } from '../data/floorControl';

const { setupLead, line2Lead, line2Accent, line2Tail, foot } = homeDifferentiator;
const destinationLead = line2Lead.replace('With LUCI, ', '');
const [footBefore, footAfter = ''] = foot.split('open APIs');

// Ticker icons (the systems a property runs today) — Commitments-style duotone, drawn
// to match the Capabilities doc soft icons: mint-dark #2b9e80 primary stroke + a soft
// mint-tinted fill on the main shape, with one gold #CEB06E accent element each. Shown
// inline (no tile) on the dark ticker, scaled up so the duotone reads on its own. The
// star (Event AV) carries the gold as a gold→mint gradient on the star itself instead
// of a separate accent dot.
const icons: Record<string, string> = {
  monitor: `<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="13" rx="2" fill="#68E3BE" fill-opacity="0.20" stroke="#2b9e80" stroke-width="1.8"/><path d="M9 21h6M12 17v4" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round"/><circle cx="17.5" cy="8" r="1.5" fill="#CEB06E"/></svg>`,
  grid: `<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" fill="#68E3BE" fill-opacity="0.18" stroke="#2b9e80" stroke-width="1.8"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18" stroke="#2b9e80" stroke-width="1.4"/><rect x="9" y="9" width="6" height="6" fill="#CEB06E" fill-opacity="0.9"/></svg>`,
  bulb: `<svg viewBox="0 0 24 24" fill="none"><path d="M12 3a6 6 0 0 0-3.8 10.6c.8.6 1.3 1.5 1.3 2.4h5c0-.9.5-1.8 1.3-2.4A6 6 0 0 0 12 3Z" fill="#CEB06E" fill-opacity="0.85" stroke="#2b9e80" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.5 18.5h5M10 21h4" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round"/></svg>`,
  wave: `<svg viewBox="0 0 24 24" fill="none"><path d="M3 12c2-4 4 4 6 0s4-4 6 0 4 4 6 0" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="20.5" cy="12" r="1.7" fill="#CEB06E"/></svg>`,
  sign: `<svg viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="11" rx="1.5" fill="#68E3BE" fill-opacity="0.20" stroke="#2b9e80" stroke-width="1.8"/><path d="M12 14v6M8 20h8" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round"/><path d="M7 7h6" stroke="#CEB06E" stroke-width="1.8" stroke-linecap="round"/></svg>`,
  speaker: `<svg viewBox="0 0 24 24" fill="none"><path d="M4 9v6h3l5 4V5L7 9H4Z" fill="#68E3BE" fill-opacity="0.20" stroke="#2b9e80" stroke-width="1.8" stroke-linejoin="round"/><path d="M15 8.5c1.5 2 1.5 5 0 7M17.5 6c2.5 3 2.5 9 0 12" stroke="#CEB06E" stroke-width="1.8" stroke-linecap="round"/></svg>`,
  play: `<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" fill="#68E3BE" fill-opacity="0.20" stroke="#2b9e80" stroke-width="1.8"/><path d="M10 9l6 3-6 3V9Z" fill="#CEB06E"/></svg>`,
  gear: `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3.5" fill="#68E3BE" fill-opacity="0.20" stroke="#2b9e80" stroke-width="1.8"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.5 5.5l1.8 1.8M16.7 16.7l1.8 1.8M18.5 5.5l-1.8 1.8M7.3 16.7l-1.8 1.8" stroke="#CEB06E" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="1.3" fill="#CEB06E"/></svg>`,
  slider: `<svg viewBox="0 0 24 24" fill="none"><path d="M6 3v18M12 3v18M18 3v18" stroke="#2b9e80" stroke-width="1.8" stroke-linecap="round"/><rect x="3.5" y="6" width="5" height="4" rx="1" fill="#CEB06E"/><rect x="9.5" y="13" width="5" height="4" rx="1" fill="#CEB06E"/><rect x="15.5" y="8" width="5" height="4" rx="1" fill="#CEB06E"/></svg>`,
  star: `<svg viewBox="0 0 24 24" fill="none"><defs><linearGradient id="diff-star-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#CEB06E"/><stop offset="1" stop-color="#68E3BE"/></linearGradient></defs><path d="M12 3l2.4 5.6 6 .5-4.6 3.9 1.4 5.9L12 16l-5.2 3.8 1.4-5.9L3.6 9.6l6-.5L12 3Z" fill="url(#diff-star-grad)" fill-opacity="0.78" stroke="#2b9e80" stroke-width="1.8" stroke-linejoin="round"/></svg>`,
};

// Seamless -50% loop.
const ticker = [...floorTicker, ...floorTicker];
// Dotted "silo" lines into the ticker, then a funnel + arrow down to the statement.
const silos = Array.from({ length: 7 }, (_, i) => +(((i + 0.5) / 7) * 100).toFixed(2));
const funnel = Array.from({ length: 9 }, (_, i) => +(((i + 0.5) / 9) * 100).toFixed(2));
---

<section class="home-diff" aria-label="What makes LUCI different">
  <div class="home-diff__inner">
    <p class="home-diff__setup-lead">{setupLead}</p>

    <svg class="home-diff__silos" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {silos.map((x) => (
        <line x1={x} y1="0" x2={x} y2="100" />
      ))}
    </svg>

    <!-- The full list of systems a property runs today -->
    <div class="home-diff__ticker" aria-hidden="true">
      <div class="home-diff__ticker-track">
        {ticker.map((t) => (
          <span class="home-diff__item">
            <span class="home-diff__item-ic" set:html={icons[t.icon]} />
            {t.label}
          </span>
        ))}
      </div>
    </div>

    <!-- many systems → one: lines converge from the ticker, then a bold arrow
         drives the consolidation down into the "With LUCI" statement. The funnel
         fades gold (the diverse systems above) into mint (the single outcome below). -->
    <svg class="home-diff__converge" viewBox="0 0 100 120" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="diff-funnel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#edd086" stop-opacity="0.5" />
          <stop offset="1" stop-color="#68e3be" stop-opacity="0.45" />
        </linearGradient>
      </defs>
      {funnel.map((x) => (
        <line x1={x} y1="0" x2="50" y2="116" stroke="url(#diff-funnel)" />
      ))}
    </svg>

    <div class="home-diff__big-arrow" aria-hidden="true"></div>

    <p class="home-diff__message">
      <span class="home-diff__line2">
        <span class="home-diff__destination">With LUCI</span>, {destinationLead}<em>{line2Accent}</em>{line2Tail}
      </span>
    </p>

    <p class="home-diff__foot">{footBefore}<em>open APIs</em>{footAfter}</p>
  </div>
</section>

<style>
  .home-diff {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--navy);
    color: var(--off-white);
    border-top: 1px solid rgba(var(--mint-rgb), 0.18);
  }

  /* Mint/gold circuit pattern — site standard: single tile, cover (enlarge+crop, no
     seam), lighten blend, 0.22, with the navy veil that fades it behind the content. */
  .home-diff::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: url('/images/textures/texture-circuit-header-mintgold.png');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    mix-blend-mode: lighten;
    opacity: 0.22;
  }
  .home-diff::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(10, 22, 28, 0.86) 16%, rgba(10, 22, 28, 0.86) 84%, transparent 100%);
  }

  .home-diff__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(64px, 10vw, 120px);
    padding-inline: var(--page-pad);
    text-align: center;
  }

  .home-diff__setup-lead {
    margin: 0 0 clamp(10px, 1.4vw, 14px);
    font-family: var(--font-head);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgba(245, 248, 250, 0.82);
  }

  .home-diff__silos {
    display: block;
    width: min(700px, 80%);
    height: clamp(22px, 3.6vw, 40px);
    margin: 0 auto 4px;
  }

  .home-diff__silos line {
    stroke: rgba(245, 248, 250, 0.28);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    vector-effect: non-scaling-stroke;
  }

  /* ---- Scrolling ticker of property systems ---- */
  .home-diff__ticker {
    overflow: hidden;
    border-top: 1px solid rgba(var(--mint-rgb), 0.2);
    border-bottom: 1px solid rgba(var(--mint-rgb), 0.2);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .home-diff__ticker-track {
    display: flex;
    align-items: center;
    gap: clamp(28px, 4vw, 52px);
    width: max-content;
    padding: clamp(14px, 1.8vw, 20px) 0;
    animation: home-diff-tick 34s linear infinite;
  }

  @keyframes home-diff-tick {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .home-diff__ticker:hover .home-diff__ticker-track {
    animation-play-state: paused;
  }

  .home-diff__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-head);
    font-size: clamp(15px, 1.7vw, 19px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgba(245, 248, 250, 0.82);
  }

  /* Duotone icons inline on the dark ticker — no tile (the tiles overtook the page).
     Same Commitments duotone palette (mint-dark + gold + soft mint fill), scaled
     up so the duotone reads on its own without a container. */
  .home-diff__item-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: clamp(26px, 2.8vw, 32px);
    height: clamp(26px, 2.8vw, 32px);
  }
  .home-diff__item-ic :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Converging funnel from the ticker down toward the statement */
  .home-diff__converge {
    display: block;
    width: min(760px, 100%);
    height: clamp(64px, 8vw, 92px);
    margin: 6px auto -2px;
    overflow: visible;
  }
  .home-diff__converge line {
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Bold consolidation arrow: thick shaft + large head, mint with a glow —
     the unambiguous "everything above funnels into LUCI" signal. */
  .home-diff__big-arrow {
    position: relative;
    width: clamp(30px, 3.2vw, 42px);
    margin: 2px auto 0;
  }
  .home-diff__big-arrow::before {
    content: '';
    display: block;
    width: clamp(7px, 0.85vw, 10px);
    height: clamp(34px, 5vw, 56px);
    margin: 0 auto;
    background: var(--mint);
    border-radius: 4px;
    box-shadow: 0 0 20px rgba(var(--mint-rgb), 0.55);
  }
  .home-diff__big-arrow::after {
    content: '';
    display: block;
    width: 0;
    height: 0;
    margin: 0 auto;
    border-left: clamp(15px, 1.6vw, 21px) solid transparent;
    border-right: clamp(15px, 1.6vw, 21px) solid transparent;
    border-top: clamp(20px, 2.2vw, 28px) solid var(--mint);
    filter: drop-shadow(0 6px 12px rgba(var(--mint-rgb), 0.5));
  }

  .home-diff__message {
    margin: 0 auto;
    max-width: 1040px;
    font-family: var(--font-head);
    letter-spacing: -0.02em;
  }

  .home-diff__line2 {
    display: block;
    max-width: 24ch;
    margin: 0 auto;
    font-size: clamp(32px, 5.6vw, 60px);
    font-weight: 700;
    line-height: 1.08;
    color: var(--off-white);
  }
  .home-diff__line2 em {
    font-style: normal;
    color: var(--mint);
  }

  .home-diff__destination {
    position: relative;
    display: inline-block;
    color: var(--off-white);
    text-shadow: 0 0 20px rgba(var(--mint-rgb), 0.26);
  }

  .home-diff__destination::after {
    content: '';
    position: absolute;
    left: 0.05em;
    right: 0.05em;
    bottom: -0.08em;
    height: 0.08em;
    background: var(--mint);
    box-shadow: 0 0 14px rgba(var(--mint-rgb), 0.5);
  }

  .home-diff__foot {
    margin: clamp(20px, 2.5vw, 28px) auto 0;
    font-size: 12.5px;
    font-style: italic;
    color: rgba(245, 248, 250, 0.5);
  }
  .home-diff__foot em {
    font-style: italic;
    color: var(--gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-diff__ticker-track { animation: none; transform: translateX(0); }
    .home-diff__ticker { -webkit-mask-image: none; mask-image: none; }
  }
</style>
