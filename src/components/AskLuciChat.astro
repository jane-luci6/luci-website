---
/*
 * AskLuciChat — AI site-search chat for the LUCI website.
 *
 * UI-only build (backend wired by the tech team later). Works TODAY in MOCK mode
 * (canned, voice-safe answers with real source links) and is ready to point at a
 * live backend.
 *
 * ── API contract for the tech team ────────────────────────────────────────────
 *   POST  ASK_LUCI_ENDPOINT            (default: /api/ask)
 *   Content-Type: application/json
 *   Body: {
 *     question: string,
 *     history: Array<{ role: 'user' | 'assistant', content: string }>  // optional
 *   }
 *   Response (JSON, 200):
 *   {
 *     answer:  string,                                  // plain text (no raw HTML)
 *     sources: Array<{ title: string, url: string }>    // pages the answer came from
 *   }
 *
 *   Streaming upgrade (optional, not required for v1):
 *     respond with text/event-stream; event: token { delta } / event: sources / event: done.
 *     Set ASK_LUCI_STREAM=true below to consume SSE instead of JSON.
 *
 * ── Voice guardrail (bake into the system prompt) ─────────────────────────────
 *   Answer in LUCI's voice: "engine, not layer"; always "A/V" (never "AV");
 *   institutions not adjectives; lead with subtraction; no client names in
 *   public materials; no percentage claims; cite sources with links. If a
 *   question is outside LUCI's scope, decline and offer /contact.
 */
const ASK_LUCI_ENDPOINT = '/api/ask';   // tech team implements this server endpoint
const ASK_LUCI_MOCK = true;             // true = client-side canned answers (no backend yet)
const ASK_LUCI_STREAM = false;          // true = consume SSE stream; false = JSON response
---

<div class="luci-chat" data-open="false" aria-hidden="true">
  <button class="luci-chat__fab" type="button" aria-label="Ask LUCI AI — instant answers from the site" aria-expanded="false">
    <span class="luci-chat__fab-pulse" aria-hidden="true"></span>
    <svg class="luci-chat__fab-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z" />
    </svg>
    <span class="luci-chat__fab-label">Ask LUCI</span>
    <span class="luci-chat__fab-ai" aria-hidden="true">AI</span>
  </button>

  <section class="luci-chat__panel" role="dialog" aria-modal="true" aria-labelledby="luci-chat-title">
    <header class="luci-chat__head">
      <div class="luci-chat__head-id">
        <span class="luci-chat__head-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z"/></svg>
        </span>
        <div>
          <div class="luci-chat__title-row">
            <h2 id="luci-chat-title" class="luci-chat__title">Ask LUCI</h2>
            <span class="luci-chat__ai-pill" aria-hidden="true">AI · Instant</span>
          </div>
          <p class="luci-chat__status" data-state="idle">Instant answers from across the LUCI site — no waiting, no forms</p>
        </div>
      </div>
      <button class="luci-chat__close" type="button" aria-label="Close chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>

    <div class="luci-chat__thread" id="luci-chat-thread" aria-live="polite">
      <div class="luci-chat__intro" data-intro>
        <p class="luci-chat__intro-line">What do you want to know about LUCI?</p>
        <p class="luci-chat__intro-sub">I search every page on the LUCI site and answer instantly — with sources you can open. No waiting, no forms.</p>
        <ul class="luci-chat__suggestions" role="list">
          <li><button class="luci-chip" type="button" data-q="What does LUCI do?">What does LUCI do?</button></li>
          <li><button class="luci-chip" type="button" data-q="What industries does LUCI serve?">What industries does LUCI serve?</button></li>
          <li><button class="luci-chip" type="button" data-q="How does LUCI deploy onto an existing property?">How does LUCI deploy?</button></li>
          <li><button class="luci-chip" type="button" data-q="How do I see LUCI on my floor?">How do I see LUCI on my floor?</button></li>
        </ul>
      </div>
    </div>

    <form class="luci-chat__form" id="luci-chat-form">
      <label class="luci-chat__field">
        <span class="luci-sr-only">Ask LUCI anything</span>
        <textarea
          class="luci-chat__input"
          id="luci-chat-input"
          rows="1"
          placeholder="Ask LUCI anything…"
          autocomplete="off"
          spellcheck="true"
        ></textarea>
      </label>
      <button class="luci-chat__send" type="submit" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
      </button>
    </form>
  </section>
</div>

<style>
  .luci-chat {
    --chat-radius: 18px;
    --chat-mint: var(--mint);
    --chat-mint-rgb: var(--mint-rgb);
    position: fixed;
    z-index: 1000;
    right: clamp(16px, 3vw, 28px);
    bottom: clamp(16px, 3vw, 28px);
    font-family: var(--font-body);
    color: var(--off-white);
  }

  .luci-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* ── Floating button ─────────────────────────────────────────── */
  .luci-chat__fab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px 0 14px;
    height: 52px;
    border: 1px solid rgba(var(--chat-mint-rgb), 0.4);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(16, 35, 45, 0.92), rgba(10, 22, 28, 0.92));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--off-white);
    cursor: pointer;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.25s ease, box-shadow 0.25s ease, opacity 0.25s ease;
  }
  .luci-chat__fab:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--chat-mint-rgb), 0.7);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(var(--chat-mint-rgb), 0.2) inset;
  }
  .luci-chat__fab:active { transform: translateY(0); }
  .luci-chat__fab:focus-visible { outline: 2px solid var(--chat-mint); outline-offset: 3px; }

  .luci-chat__fab-pulse {
    position: absolute;
    left: 9px;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--chat-mint);
    box-shadow: 0 0 10px rgba(var(--chat-mint-rgb), 0.6);
  }
  .luci-chat__fab-pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 1px solid rgba(var(--chat-mint-rgb), 0.5);
    animation: luci-ping 2.6s ease-out infinite;
  }
  @keyframes luci-ping {
    0%   { opacity: 0.8; transform: scale(0.6); }
    70%  { opacity: 0; transform: scale(1.8); }
    100% { opacity: 0; transform: scale(1.8); }
  }
  .luci-chat__fab-icon { width: 22px; height: 22px; color: var(--chat-mint); }
  .luci-chat__fab-label {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .luci-chat__fab-ai {
    font-family: var(--font-head);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy-deep);
    background: var(--chat-mint);
    padding: 3px 6px;
    border-radius: 999px;
    line-height: 1;
  }

  @media (max-width: 380px) {
    .luci-chat__fab-label { display: none; }
    .luci-chat__fab { padding: 0 14px; }
  }

  /* ── Slide-in panel ─────────────────────────────────────────── */
  .luci-chat__panel {
    position: fixed;
    right: clamp(16px, 3vw, 28px);
    bottom: clamp(16px, 3vw, 28px);
    width: min(420px, calc(100vw - 32px));
    height: min(620px, calc(100dvh - 32px));
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, rgba(16, 35, 45, 0.96), rgba(10, 22, 28, 0.98));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(var(--chat-mint-rgb), 0.22);
    border-radius: var(--chat-radius);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transform-origin: bottom right;
    pointer-events: none;
    transition: opacity 0.28s ease, transform 0.32s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .luci-chat[data-open='true'] .luci-chat__panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .luci-chat[data-open='true'] .luci-chat__fab { opacity: 0; transform: scale(0.9); pointer-events: none; }

  /* ── Header ────────────────────────────────────────────────── */
  .luci-chat__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid rgba(var(--chat-mint-rgb), 0.16);
    flex-shrink: 0;
  }
  .luci-chat__head-id { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .luci-chat__head-mark {
    width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--chat-mint);
    background: radial-gradient(circle at 35% 30%, rgba(var(--chat-mint-rgb), 0.35), rgba(var(--chat-mint-rgb), 0.08));
    border: 1px solid rgba(var(--chat-mint-rgb), 0.4);
    box-shadow: 0 0 14px rgba(var(--chat-mint-rgb), 0.25);
  }
  .luci-chat__head-mark svg { width: 18px; height: 18px; }
  .luci-chat__title-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .luci-chat__title {
    margin: 0;
    font-family: var(--font-head);
    font-size: 16px; font-weight: 700; letter-spacing: -0.01em;
    color: var(--off-white);
  }
  .luci-chat__ai-pill {
    font-family: var(--font-head);
    font-size: 9px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; line-height: 1;
    color: var(--chat-mint);
    background: rgba(var(--chat-mint-rgb), 0.12);
    border: 1px solid rgba(var(--chat-mint-rgb), 0.35);
    padding: 4px 7px;
    border-radius: 999px;
  }
  .luci-chat__status {
    margin: 2px 0 0;
    font-size: 12px; font-weight: 500;
    color: rgba(245, 248, 250, 0.55);
  }
  .luci-chat__status[data-state='thinking'] { color: var(--chat-mint); }
  .luci-chat__status[data-state='error'] { color: #ff9d9d; }
  .luci-chat__close {
    flex-shrink: 0; width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(245, 248, 250, 0.7);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .luci-chat__close:hover {
    color: var(--off-white);
    border-color: rgba(var(--chat-mint-rgb), 0.4);
    background: rgba(var(--chat-mint-rgb), 0.08);
  }
  .luci-chat__close svg { width: 16px; height: 16px; }

  /* ── Thread ────────────────────────────────────────────────── */
  .luci-chat__thread {
    flex: 1 1 auto; min-height: 0; overflow-y: auto;
    padding: 18px;
    display: flex; flex-direction: column; gap: 14px;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--chat-mint-rgb), 0.4) transparent;
  }
  .luci-chat__thread::-webkit-scrollbar { width: 8px; }
  .luci-chat__thread::-webkit-scrollbar-thumb { background: rgba(var(--chat-mint-rgb), 0.35); border-radius: 999px; }
  .luci-chat__thread::-webkit-scrollbar-track { background: transparent; }

  .luci-chat__intro { margin: auto 0; text-align: left; }
  .luci-chat__intro-line {
    margin: 0;
    font-family: var(--font-head);
    font-size: 19px; font-weight: 700; letter-spacing: -0.015em; line-height: 1.25;
    color: var(--off-white);
  }
  .luci-chat__intro-sub {
    margin: 8px 0 18px;
    font-size: 13.5px; line-height: 1.5;
    color: rgba(245, 248, 250, 0.6);
  }
  .luci-chat__suggestions {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 8px;
  }

  .luci-chip {
    width: fit-content;
    padding: 9px 14px;
    border-radius: 999px;
    border: 1px solid rgba(var(--chat-mint-rgb), 0.28);
    background: rgba(var(--chat-mint-rgb), 0.06);
    color: rgba(245, 248, 250, 0.85);
    font-family: var(--font-body);
    font-size: 13px; font-weight: 500;
    text-align: left; cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .luci-chip:hover {
    border-color: rgba(var(--chat-mint-rgb), 0.55);
    background: rgba(var(--chat-mint-rgb), 0.12);
    color: var(--off-white);
    transform: translateX(2px);
  }
  .luci-chip:focus-visible { outline: 2px solid var(--chat-mint); outline-offset: 2px; }

  /* ── Message bubbles ───────────────────────────────────────── */
  .luci-msg { display: flex; flex-direction: column; max-width: 88%; }
  .luci-msg--user { align-self: flex-end; align-items: flex-end; }
  .luci-msg--assistant { align-self: flex-start; align-items: flex-start; max-width: 94%; }

  .luci-msg__bubble {
    padding: 11px 15px;
    border-radius: 14px;
    font-size: 14px; line-height: 1.55;
    white-space: pre-wrap; word-break: break-word;
  }
  .luci-msg--user .luci-msg__bubble {
    background: rgba(var(--chat-mint-rgb), 0.16);
    border: 1px solid rgba(var(--chat-mint-rgb), 0.32);
    color: var(--off-white);
    border-bottom-right-radius: 5px;
  }
  .luci-msg--assistant .luci-msg__bubble {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(245, 248, 250, 0.92);
    border-bottom-left-radius: 5px;
  }

  .luci-msg__sources {
    margin-top: 8px;
    display: flex; flex-wrap: wrap; gap: 6px;
    align-items: center;
  }
  .luci-msg__sources-label {
    width: 100%;
    margin-bottom: 2px;
    font-family: var(--font-head);
    font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 248, 250, 0.42);
  }
  .luci-msg__source {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(var(--chat-mint-rgb), 0.28);
    background: rgba(var(--chat-mint-rgb), 0.05);
    color: rgba(245, 248, 250, 0.78);
    font-family: var(--font-head);
    font-size: 11px; font-weight: 600; letter-spacing: 0.01em;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .luci-msg__source:hover {
    border-color: rgba(var(--chat-mint-rgb), 0.55);
    background: rgba(var(--chat-mint-rgb), 0.12);
    color: var(--off-white);
  }
  .luci-msg__source svg { width: 11px; height: 11px; color: var(--chat-mint); }

  /* ── Typing indicator ──────────────────────────────────────── */
  .luci-typing { display: inline-flex; align-items: center; gap: 5px; padding: 13px 15px; }
  .luci-typing__dot {
    width: 7px; height: 7px; border-radius: 999px;
    background: rgba(var(--chat-mint-rgb), 0.6);
    animation: luci-bounce 1.3s ease-in-out infinite;
  }
  .luci-typing__dot:nth-child(2) { animation-delay: 0.18s; }
  .luci-typing__dot:nth-child(3) { animation-delay: 0.36s; }
  @keyframes luci-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
    40% { transform: translateY(-4px); opacity: 1; }
  }

  /* ── Form ──────────────────────────────────────────────────── */
  .luci-chat__form {
    flex-shrink: 0;
    display: flex; align-items: flex-end; gap: 8px;
    padding: 12px 14px 14px;
    border-top: 1px solid rgba(var(--chat-mint-rgb), 0.16);
  }
  .luci-chat__field { flex: 1 1 auto; min-width: 0; }
  .luci-chat__input {
    width: 100%;
    max-height: 120px;
    resize: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--off-white);
    font-family: var(--font-body);
    font-size: 14px; line-height: 1.5;
    padding: 10px 13px;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .luci-chat__input::placeholder { color: rgba(245, 248, 250, 0.4); }
  .luci-chat__input:focus {
    border-color: rgba(var(--chat-mint-rgb), 0.5);
    background: rgba(var(--chat-mint-rgb), 0.06);
  }
  .luci-chat__send {
    flex-shrink: 0;
    width: 40px; height: 40px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid rgba(var(--chat-mint-rgb), 0.4);
    border-radius: 12px;
    background: rgba(var(--chat-mint-rgb), 0.14);
    color: var(--chat-mint);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .luci-chat__send:hover { background: rgba(var(--chat-mint-rgb), 0.24); border-color: rgba(var(--chat-mint-rgb), 0.6); transform: translateY(-1px); }
  .luci-chat__send:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
  .luci-chat__send svg { width: 17px; height: 17px; }
  .luci-chat__send:focus-visible { outline: 2px solid var(--chat-mint); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .luci-chat__fab-pulse::after,
    .luci-typing__dot { animation: none !important; }
  }
</style>

<script is:inline define:vars={{ ASK_LUCI_ENDPOINT, ASK_LUCI_MOCK, ASK_LUCI_STREAM }}>
  (function () {
    const ENDPOINT = ASK_LUCI_ENDPOINT;
    const MOCK = ASK_LUCI_MOCK;
    const STREAM = ASK_LUCI_STREAM;

    const root = document.querySelector('.luci-chat');
    if (!root) return;
    const fab = root.querySelector('.luci-chat__fab');
    const closeBtn = root.querySelector('.luci-chat__close');
    const panel = root.querySelector('.luci-chat__panel');
    const thread = root.querySelector('.luci-chat__thread');
    const intro = thread.querySelector('[data-intro]');
    const form = root.querySelector('.luci-chat__form');
    const input = root.querySelector('.luci-chat__input');
    const sendBtn = root.querySelector('.luci-chat__send');
    const statusEl = root.querySelector('.luci-chat__status');

    let history = [];
    let busy = false;

    /* ── Mock knowledge base (voice-safe, real source links) ──── */
    const MOCK_KB = [
      {
        match: /\b(do|what is|what's|about)\b.*\bluci\b/i,
        answer: "LUCI is the orchestration engine for enterprise multimedia — one interface to control, automate, and execute the entire guest experience. It consolidates screens, audio, signage, and A/V systems across a whole property into one platform, run by an embedded team that stays.",
        sources: [{ title: 'Platform', url: '/platform' }, { title: 'Overview', url: '/' }]
      },
      {
        match: /\b(industries|sectors|who do you serve|verticals)\b/i,
        answer: "LUCI runs the A/V for casinos and gaming, sports venues and arenas, resorts and hotels, airports and transportation, and conference and convention centers — anywhere a complex multimedia environment has to run 24/7 with zero tolerance for downtime.",
        sources: [{ title: 'Industries', url: '/industries' }]
      },
      {
        match: /\b(deploy|deployment|rollout|install|how does it get on)\b/i,
        answer: "LUCI deploys in phases on your budget and timeline, onto your existing network. An embedded team hangs, wires, trains, and stays on — standardizing the environment rather than ripping everything out. The Field Activation Guide documents every step from assessment to handoff.",
        sources: [{ title: 'Field Activation Guide', url: '/resources/field-activation-guide' }]
      },
      {
        match: /\b(field activation guide|fag|guide)\b/i,
        answer: "The Field Activation Guide is the document that walks through how LUCI deploys onto your existing environment — in phases, on your budget and timeline. Every step from assessment to handoff, documented.",
        sources: [{ title: 'Field Activation Guide', url: '/resources/field-activation-guide' }]
      },
      {
        match: /\b(demo|see luci|my floor|talk to|contact|request)\b/i,
        answer: "Request a demo. Tell us what you're running and what you'd like to stop managing, and we'll show you LUCI on your environment.",
        sources: [{ title: 'Contact', url: '/contact' }]
      }
    ];
    const MOCK_FALLBACK = {
      answer: "I can answer questions about LUCI's platform, the industries it serves, and how it deploys — try one of the suggestions above, or ask something more specific. If you'd rather talk to the team, you can request a demo.",
      sources: [{ title: 'Industries', url: '/industries' }, { title: 'Platform', url: '/platform' }, { title: 'Contact', url: '/contact' }]
    };

    function mockAnswer(q) {
      for (const e of MOCK_KB) if (e.match.test(q)) return e;
      return MOCK_FALLBACK;
    }

    /* ── Open / close ─────────────────────────────────────────── */
    function open(prefill) {
      root.setAttribute('data-open', 'true');
      root.setAttribute('aria-hidden', 'false');
      fab.setAttribute('aria-expanded', 'true');
      setTimeout(() => input.focus(), 280);
      if (prefill) { input.value = prefill; autoGrow(); }
    }
    function close() {
      root.setAttribute('data-open', 'false');
      root.setAttribute('aria-hidden', 'true');
      fab.setAttribute('aria-expanded', 'false');
    }
    fab.addEventListener('click', () => open());
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    /* Hero / any element can open the chat: dispatch 'luci-ask-open' */
    document.addEventListener('luci-ask-open', (e) => {
      const q = (e.detail && e.detail.question) || '';
      open(q);
      if (q.trim()) setTimeout(() => submit(q.trim()), 320);
    });

    /* ── Rendering ────────────────────────────────────────────── */
    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function scrollDown() { thread.scrollTop = thread.scrollHeight; }

    function addUser(text) {
      if (intro) intro.remove();
      const m = document.createElement('div');
      m.className = 'luci-msg luci-msg--user';
      m.innerHTML = '<div class="luci-msg__bubble"></div>';
      m.querySelector('.luci-msg__bubble').textContent = text;
      thread.appendChild(m);
      scrollDown();
    }

    function addAssistantShell() {
      const m = document.createElement('div');
      m.className = 'luci-msg luci-msg--assistant';
      m.innerHTML = '<div class="luci-msg__bubble"><span class="luci-typing"><span class="luci-typing__dot"></span><span class="luci-typing__dot"></span><span class="luci-typing__dot"></span></span></div><div class="luci-msg__sources"></div>';
      thread.appendChild(m);
      scrollDown();
      return { bubble: m.querySelector('.luci-msg__bubble'), sources: m.querySelector('.luci-msg__sources') };
    }

    function renderSources(box, sources) {
      if (!sources || !sources.length) return;
      const ext = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/200/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>');
      const lbl = document.createElement('span');
      lbl.className = 'luci-msg__sources-label';
      lbl.textContent = 'Sources';
      box.appendChild(lbl);
      sources.forEach((s) => {
        const a = document.createElement('a');
        a.className = 'luci-msg__source';
        a.href = s.url;
        const isExt = /^https?:\/\//.test(s.url);
        if (isExt) { a.target = '_blank'; a.rel = 'noopener'; }
        a.innerHTML = '<span>' + escapeHtml(s.title) + '</span><img src="' + ext + '" alt="" aria-hidden="true">';
        box.appendChild(a);
      });
    }

    function setStatus(state, text) {
      statusEl.setAttribute('data-state', state);
      if (text) statusEl.textContent = text;
    }

    /* Progressive type-out so a JSON answer still feels streaming */
    function typeOut(bubble, text, done) {
      let i = 0;
      const step = Math.max(2, Math.round(text.length / 90));
      (function tick() {
        if (i >= text.length) { bubble.textContent = text; done(); return; }
        bubble.textContent = text.slice(0, i + step);
        i += step;
        scrollDown();
        setTimeout(tick, 16);
      })();
    }

    /* ── Submit ──────────────────────────────────────────────── */
    async function submit(text) {
      if (busy || !text.trim()) return;
      busy = true;
      sendBtn.disabled = true;
      input.value = '';
      autoGrow();
      addUser(text);
      history.push({ role: 'user', content: text });
      const shell = addAssistantShell();
      setStatus('thinking', 'Searching the site…');

      let result;
      try {
        if (MOCK) {
          await new Promise((r) => setTimeout(r, 650));
          result = mockAnswer(text);
        } else if (STREAM) {
          result = await streamAnswer(text, shell);
        } else {
          const res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: text, history })
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          result = await res.json();
        }
      } catch (err) {
        shell.bubble.textContent = '';
        setStatus('error', 'Having trouble reaching the assistant');
        const m = document.createElement('div');
        m.className = 'luci-msg__bubble';
        m.textContent = "I can't reach the assistant right now. Try again, or request a demo and the team will help directly.";
        shell.bubble.replaceWith(m);
        busy = false; sendBtn.disabled = false;
        history.push({ role: 'assistant', content: m.textContent });
        return;
      }

      shell.bubble.textContent = '';
      setStatus('idle', 'Ask about the platform, industries, or deployment');
      typeOut(shell.bubble, result.answer || '', () => {
        renderSources(shell.sources, result.sources || []);
        scrollDown();
      });
      history.push({ role: 'assistant', content: result.answer || '' });
      busy = false; sendBtn.disabled = false;
      setTimeout(() => input.focus(), 100);
    }

    async function streamAnswer(text, shell) {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'text/event-stream' },
        body: JSON.stringify({ question: text, history })
      });
      if (!res.ok || !res.body) throw new Error('HTTP ' + res.status);
      const reader = res.body.getReader();
      const dec = new TextDecoder();
      let buf = '', answer = '', sources = [];
      shell.bubble.textContent = '';
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop();
        for (const line of lines) {
          if (!line.startsWith('data:')) continue;
          try {
            const d = JSON.parse(line.slice(5).trim());
            if (d.delta) { answer += d.delta; shell.bubble.textContent = answer; scrollDown(); }
            if (d.sources) sources = d.sources;
          } catch (e) {}
        }
      }
      return { answer, sources };
    }

    /* ── Form wiring ─────────────────────────────────────────── */
    function autoGrow() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    }
    input.addEventListener('input', autoGrow);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); submit(input.value); });

    /* Suggestion chips */
    thread.querySelectorAll('.luci-chip').forEach((chip) => {
      chip.addEventListener('click', () => submit(chip.dataset.q));
    });
  })();
</script>
