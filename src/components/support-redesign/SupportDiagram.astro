---
interface Props {
  points: { head: string; detail: string }[];
}
const { points } = Astro.props;
const M = '#68E3BE';
const G = '#CEB06E';
const INK = '#F5F8FA';
const FAINT = 'rgba(245,248,250,0.62)';
const LINE = 'rgba(255,255,255,0.16)';
---

<div class="sup-diag">
  <div class="sup-diag__art">
    <svg viewBox="0 0 860 470" role="img" aria-label="One platform: a shared property map, per-zone schedule lanes, and one connected team">
      <!-- Layer 1 — Map -->
      <rect x="128" y="34" width="600" height="104" rx="10" fill="rgba(104,227,190,0.05)" stroke={M} stroke-width="1.5"/>
      <line x1="328" y1="34" x2="328" y2="138" stroke="rgba(104,227,190,0.4)" stroke-width="1.5" stroke-dasharray="4 5"/>
      <line x1="528" y1="34" x2="528" y2="138" stroke="rgba(104,227,190,0.4)" stroke-width="1.5" stroke-dasharray="4 5"/>
      <text x="228" y="64" text-anchor="middle" fill={FAINT} font-family="Space Grotesk, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="2">ZONE A</text>
      <text x="428" y="64" text-anchor="middle" fill={FAINT} font-family="Space Grotesk, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="2">ZONE B</text>
      <text x="628" y="64" text-anchor="middle" fill={FAINT} font-family="Space Grotesk, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="2">ZONE C</text>
      <circle cx="200" cy="104" r="4" fill={G}/>
      <circle cx="232" cy="104" r="4" fill={M}/>
      <circle cx="400" cy="104" r="4" fill={M}/>
      <circle cx="432" cy="104" r="4" fill={G}/>
      <circle cx="464" cy="104" r="4" fill={M}/>
      <circle cx="600" cy="104" r="4" fill={M}/>
      <circle cx="632" cy="104" r="4" fill={M}/>
      <g><circle cx="92" cy="86" r="15" fill={M}/><text x="92" y="92" text-anchor="middle" fill="#0a161c" font-family="Space Grotesk, Arial, sans-serif" font-size="15" font-weight="700">1</text></g>

      <!-- connectors map -> schedule -->
      <line x1="228" y1="138" x2="228" y2="196" stroke={LINE} stroke-width="1.5"/>
      <line x1="428" y1="138" x2="428" y2="232" stroke={LINE} stroke-width="1.5"/>
      <line x1="628" y1="138" x2="628" y2="268" stroke={LINE} stroke-width="1.5"/>

      <!-- Layer 2 — Schedule lanes -->
      <rect x="168" y="196" width="520" height="22" rx="11" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
      <rect x="168" y="232" width="520" height="22" rx="11" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
      <rect x="168" y="268" width="520" height="22" rx="11" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
      <text x="158" y="211" text-anchor="end" fill={FAINT} font-family="Space Grotesk, Arial, sans-serif" font-size="11" font-weight="700">A</text>
      <text x="158" y="247" text-anchor="end" fill={FAINT} font-family="Space Grotesk, Arial, sans-serif" font-size="11" font-weight="700">B</text>
      <text x="158" y="283" text-anchor="end" fill={FAINT} font-family="Space Grotesk, Arial, sans-serif" font-size="11" font-weight="700">C</text>
      <circle cx="300" cy="207" r="6" fill={G}/>
      <circle cx="440" cy="243" r="6" fill={G}/>
      <circle cx="560" cy="279" r="6" fill={M}/>
      <g><circle cx="92" cy="234" r="15" fill={M}/><text x="92" y="240" text-anchor="middle" fill="#0a161c" font-family="Space Grotesk, Arial, sans-serif" font-size="15" font-weight="700">2</text></g>

      <!-- connectors schedule -> team -->
      <line x1="228" y1="218" x2="250" y2="352" stroke={LINE} stroke-width="1.5"/>
      <line x1="428" y1="254" x2="430" y2="334" stroke={LINE} stroke-width="1.5"/>
      <line x1="628" y1="290" x2="610" y2="352" stroke={LINE} stroke-width="1.5"/>

      <!-- Layer 3 — One team -->
      <path d="M250 372 L430 358 L610 372" stroke="rgba(104,227,190,0.55)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
      <line x1="250" y1="404" x2="610" y2="404" stroke="rgba(206,176,110,0.4)" stroke-width="2" stroke-linecap="round"/>
      <g transform="translate(250 372)"><circle r="20" fill="rgba(104,227,190,0.1)" stroke={M} stroke-width="1.8"/><circle cy="-5" r="5" fill={M}/><path d="M-10 9 Q0 0 10 9" stroke={M} stroke-width="2" fill="none" stroke-linecap="round"/></g>
      <g transform="translate(430 358)"><circle r="24" fill="rgba(206,176,110,0.18)" stroke={G} stroke-width="2"/><circle cy="-6" r="6" fill={G}/><path d="M-12 11 Q0 0 12 11" stroke={G} stroke-width="2.2" fill="none" stroke-linecap="round"/></g>
      <g transform="translate(610 372)"><circle r="20" fill="rgba(104,227,190,0.1)" stroke={M} stroke-width="1.8"/><circle cy="-5" r="5" fill={M}/><path d="M-10 9 Q0 0 10 9" stroke={M} stroke-width="2" fill="none" stroke-linecap="round"/></g>
      <g><circle cx="92" cy="372" r="15" fill={M}/><text x="92" y="378" text-anchor="middle" fill="#0a161c" font-family="Space Grotesk, Arial, sans-serif" font-size="15" font-weight="700">3</text></g>
    </svg>
  </div>

  <ol class="sup-diag__legend" role="list">
    {points.map((p, i) => (
      <li class="sup-diag__item">
        <span class="sup-diag__num">{i + 1}</span>
        <div>
          <h3 class="sup-diag__head">{p.head}</h3>
          <p class="sup-diag__detail">{p.detail}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .sup-diag {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 44px);
    max-width: var(--content-wide);
  }
  .sup-diag__art {
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
  }
  .sup-diag__art :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .sup-diag__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2.6vw, 32px);
  }
  @media (min-width: 760px) {
    .sup-diag__legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .sup-diag__item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .sup-diag__num {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9999px;
    background: rgba(104, 227, 190, 0.14);
    box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.4);
    color: var(--mint);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
  }
  .sup-diag__head {
    margin: 0 0 8px;
    font-family: var(--font-body);
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
  }
  .sup-diag__detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.15vw, 15px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.76);
  }
</style>
