---
import { supportIcons } from './icons';

interface Props {
  points: { head: string; detail: string }[];
}
const { points } = Astro.props;
---

<div class="sup-cols">
  {points.map((p, i) => (
    <div class="sup-cols__col">
      <span class="sup-cols__icon" set:html={supportIcons[i % supportIcons.length]} />
      <h3 class="sup-cols__head">{p.head}</h3>
      <p class="sup-cols__detail">{p.detail}</p>
    </div>
  ))}
</div>

<style>
  .sup-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 48px);
    max-width: var(--content-wide);
  }
  @media (min-width: 760px) {
    .sup-cols {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(40px, 5vw, 72px);
    }
  }
  .sup-cols__col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
  }
  .sup-cols__col + .sup-cols__col::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(20px, 2.5vw, 36px));
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: rgba(255, 255, 255, 0.08);
  }
  @media (max-width: 759px) {
    .sup-cols__col + .sup-cols__col::before {
      left: 0;
      top: calc(-1 * clamp(14px, 2vw, 24px));
      bottom: auto;
      right: 0;
      height: 1px;
      width: auto;
    }
  }
  .sup-cols__icon {
    display: grid;
    place-items: center;
    width: clamp(56px, 6vw, 68px);
    height: clamp(56px, 6vw, 68px);
    border-radius: 16px;
    color: var(--mint);
    background: rgba(104, 227, 190, 0.1);
    box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.24);
  }
  .sup-cols__icon :global(svg) {
    width: 60%;
    height: 60%;
    display: block;
  }
  .sup-cols__head {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
  }
  .sup-cols__detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.2vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.78);
    max-width: 38ch;
  }
</style>
