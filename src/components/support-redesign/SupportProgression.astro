---
import { supportIcons } from './icons';

interface Props {
  points: { head: string; detail: string }[];
}
const { points } = Astro.props;

const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<ol class="sup-prog">
  {points.map((p, i) => (
    <li class="sup-prog__step">
      <span class="sup-prog__stepnum">Step {i + 1}</span>
      <span class="sup-prog__icon" set:html={supportIcons[i % supportIcons.length]} />
      <h3 class="sup-prog__head">{p.head}</h3>
      <p class="sup-prog__detail">{p.detail}</p>
      {i < points.length - 1 && (
        <span class="sup-prog__arrow" aria-hidden="true" set:html={arrow} />
      )}
    </li>
  ))}
</ol>

<style>
  .sup-prog {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 40px);
    max-width: var(--content-wide);
  }
  @media (min-width: 860px) {
    .sup-prog {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
    }
  }
  .sup-prog__step {
    position: relative;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 2.6vw, 32px);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .sup-prog__stepnum {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .sup-prog__icon {
    display: grid;
    place-items: center;
    width: clamp(52px, 5.5vw, 64px);
    height: clamp(52px, 5.5vw, 64px);
    border-radius: 14px;
    color: var(--mint);
    background: rgba(104, 227, 190, 0.1);
    box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.24);
  }
  .sup-prog__icon :global(svg) {
    width: 60%;
    height: 60%;
    display: block;
  }
  .sup-prog__head {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
  }
  .sup-prog__detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.15vw, 15px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.76);
  }

  /* Flow connector arrow between steps */
  .sup-prog__arrow {
    display: none;
  }
  @media (min-width: 860px) {
    .sup-prog__arrow {
      display: grid;
      place-items: center;
      width: 44px;
      align-self: center;
      color: var(--mint);
      position: relative;
    }
    .sup-prog__arrow::before {
      content: '';
      position: absolute;
      left: -10px;
      right: -10px;
      top: 50%;
      height: 4px;
      transform: translateY(-50%);
      background: linear-gradient(90deg, rgba(206, 176, 110, 0.5), rgba(104, 227, 190, 0.5));
      border-radius: 4px;
      z-index: 0;
    }
    .sup-prog__arrow :global(svg) {
      position: relative;
      z-index: 1;
      width: 22px;
      height: 22px;
      background: var(--navy-deep, #0a161c);
      border-radius: 9999px;
      padding: 2px;
      box-sizing: content-box;
    }
  }
  @media (max-width: 859px) {
    .sup-prog__arrow {
      display: block;
      width: 28px;
      height: 28px;
      margin: -8px auto;
      color: var(--mint);
      transform: rotate(90deg);
    }
    .sup-prog__arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: -10px;
      bottom: -10px;
      width: 4px;
      transform: translateX(-50%);
      background: linear-gradient(180deg, rgba(206, 176, 110, 0.5), rgba(104, 227, 190, 0.5));
      border-radius: 4px;
      z-index: 0;
    }
    .sup-prog__arrow {
      position: relative;
    }
    .sup-prog__arrow :global(svg) {
      position: relative;
      z-index: 1;
      width: 20px;
      height: 20px;
      background: var(--navy-deep, #0a161c);
      border-radius: 9999px;
      padding: 2px;
      box-sizing: content-box;
      display: block;
      margin: 0 auto;
    }
  }
</style>
