---
const heading = 'Go deeper';
const items = [
  {
    label: 'Case studies',
    descriptor: 'How LUCI ships on real floors — Ameristar and what came next.',
    href: '/resources/case-studies',
  },
  {
    label: 'Blog',
    descriptor: 'Variable reduction, capability deep dives, and the engagement cycle.',
    href: '/blog',
  },
  {
    label: 'Resource hub',
    descriptor: 'Everything in one place — studies, articles, and the support portal.',
    href: '/resources',
  },
];
---

<section class="home-resources" aria-labelledby="home-resources-title">
  <div class="home-resources__inner container container--wide">
    <h2 id="home-resources-title" class="home-resources__heading">{heading}</h2>
    <ul class="home-resources__grid" role="list">
      {items.map((item) => (
        <li class="home-resources__item">
          <a class="home-resources__link" href={item.href}>
            <span class="home-resources__label">{item.label}</span>
            <span class="home-resources__descriptor">{item.descriptor}</span>
            <span class="home-resources__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-resources {
    position: relative;
    background: var(--sand);
    color: var(--ink);
    overflow: hidden;
  }

  .home-resources::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/patterns/pattern-7-light.svg');
    background-size: cover;
    background-position: center;
    opacity: 0.3;
    pointer-events: none;
    z-index: 0;
  }

  .home-resources__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(48px, 6vw, 72px);
  }

  .home-resources__heading {
    margin: 0 0 clamp(24px, 3vw, 36px);
    font-family: var(--font-body);
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink-strong);
  }

  .home-resources__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule-light);
    border-top: 1px solid var(--rule-light);
  }

  .home-resources__item {
    background: var(--sand);
  }

  .home-resources__link {
    display: block;
    height: 100%;
    padding: clamp(22px, 2.6vw, 30px) clamp(20px, 2.2vw, 28px);
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease-out;
  }

  .home-resources__link:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  .home-resources__label {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }

  .home-resources__descriptor {
    display: block;
    max-width: 32ch;
    font-size: clamp(14px, 1.3vw, 16px);
    line-height: 1.5;
    color: rgba(53, 79, 92, 0.78);
  }

  .home-resources__arrow {
    display: inline-block;
    margin-top: clamp(14px, 2vw, 20px);
    font-size: 17px;
    font-weight: 600;
    color: var(--accent-light);
    transition: transform 0.18s ease-out;
  }

  .home-resources__link:hover .home-resources__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .home-resources__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
