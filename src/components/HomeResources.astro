---
import { ameristarCaseStudy, tachiCaseStudy } from '../data/site';

const lede = 'See LUCI on real floors — and what is coming next.';

const cards = [
  {
    href: `/resources/case-studies/${ameristarCaseStudy.slug}`,
    poster: null,
    logo: ameristarCaseStudy.cardMedia,
    logoAlt: `${ameristarCaseStudy.property} logo`,
    kicker: 'Case Study',
    title: ameristarCaseStudy.title,
    meta: `${ameristarCaseStudy.property} · ${ameristarCaseStudy.location}`,
    cta: 'Read the story',
  },
  {
    href: `/resources/case-studies/${tachiCaseStudy.slug}`,
    poster: tachiCaseStudy.poster,
    logo: null,
    logoAlt: '',
    kicker: 'Case Study',
    title: tachiCaseStudy.title,
    meta: `${tachiCaseStudy.property} · ${tachiCaseStudy.location}`,
    cta: 'Read the story',
  },
  {
    href: '/resources/field-activation-guide-prospect.pdf',
    poster: null,
    logo: '/images/logos/luci-full-mintmark-white.png',
    logoAlt: 'LUCI logo',
    kicker: 'Field Guide',
    title: 'The Field Activation Guide',
    meta: 'How LUCI rolls out on your floor',
    cta: 'Download the guide',
    download: true,
  },
];
---

<section class="home-resources" aria-labelledby="home-resources-title">
  <div class="home-resources__inner container container--wide">
    <header class="home-resources__head">
      <h2 id="home-resources-title" class="home-resources__heading">Go <em>deeper</em></h2>
      <p class="home-resources__lede">{lede}</p>
    </header>
    <ul class="home-resources__grid" role="list">
      {cards.map((card) => (
        <li class={`rsc-card${card.placeholder ? ' rsc-card--placeholder' : ''}`}>
          <a class="rsc-card__link" href={card.href} target={card.download ? '_blank' : undefined} rel={card.download ? 'noopener' : undefined} download={card.download ? '' : undefined}>
            <span class="rsc-card__media">
              {card.poster ? (
                <img src={card.poster} alt="" loading="lazy" decoding="async" />
              ) : card.placeholder ? (
                <span class="rsc-card__soon">Coming soon</span>
              ) : (
                <span class="rsc-card__logo-panel">
                  <img src={card.logo} alt={card.logoAlt} loading="lazy" decoding="async" />
                </span>
              )}
            </span>
            <span class="rsc-card__body">
              <span class="rsc-card__kicker"><span>{card.kicker}</span></span>
              <span class="rsc-card__title">{card.title}</span>
              <span class="rsc-card__meta">{card.meta}</span>
              <span class="rsc-card__cta">{card.cta} <span aria-hidden="true">&#8594;</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-resources {
    background: #2f3f4b;
    color: var(--off-white);
  }

  .home-resources__inner {
    padding-block: clamp(56px, 7vw, 88px);
  }

  .home-resources__head {
    max-width: 60ch;
    margin-bottom: clamp(28px, 3vw, 40px);
  }

  .home-resources__heading {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(28px, 3.4vw, 42px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--off-white);
  }

  .home-resources__heading em {
    font-style: normal;
    color: var(--gold);
  }

  .home-resources__lede {
    margin: 14px 0 0;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.72);
  }

  .home-resources__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
  }

  .rsc-card {
    background: #fff;
    border: 1px solid var(--rule-light);
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .rsc-card:hover {
    border-color: rgba(43, 158, 128, 0.45);
    box-shadow: 0 24px 48px rgba(26, 43, 51, 0.12);
    transform: translateY(-3px);
  }

  .rsc-card--placeholder {
    border-style: dashed;
    border-color: rgba(104, 227, 190, 0.45);
    background: rgba(255, 255, 255, 0.5);
  }

  .rsc-card--placeholder:hover {
    border-color: rgba(104, 227, 190, 0.65);
  }

  .rsc-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .rsc-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy-deep);
    position: relative;
  }

  .rsc-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .rsc-card:hover .rsc-card__media img {
    transform: scale(1.04);
  }

  .rsc-card__logo-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--navy-deep);
    background-image: url('/images/textures/texture-circuit-navy-steel-print-dark.jpg');
    background-size: cover;
    background-position: center;
  }

  .rsc-card__logo-panel img {
    width: 60%;
    max-width: 280px;
    height: auto;
    object-fit: contain;
  }

  .rsc-card__soon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--navy-deep);
    background-image: url('/images/textures/texture-circuit-navy-steel-print-dark.jpg');
    background-size: cover;
    background-position: center;
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(104, 227, 190, 0.7);
  }

  .rsc-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(22px, 2.4vw, 28px);
    flex: 1;
  }

  .rsc-card__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 2px;
  }

  .rsc-card__kicker::before {
    content: '';
    width: 24px;
    height: 2px;
    background: var(--accent-light);
  }

  .rsc-card__kicker span {
    font-family: var(--font-head);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .rsc-card__title {
    font-family: var(--font-head);
    font-size: clamp(19px, 2vw, 22px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }

  .rsc-card__meta {
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    opacity: 0.72;
  }

  .rsc-card__cta {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--rule-light);
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-light);
  }

  .rsc-card__cta span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .rsc-card__link:hover .rsc-card__cta span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .home-resources__grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
