---
import { tachiCaseStudy } from '../data/site';
import { tachiCaseStudyDetail as cs } from '../data/caseStudyTachi';

const { dek, logoSrc } = tachiCaseStudy;
---

<article class="cs-page">
  <div class="cs-page__sheet">
    <header class="cs-hero">
      <div class="cs-hero__kicker"><span>Case Study</span></div>
      <h1 class="cs-hero__title">
        <span class="cs-hero__leadin">{cs.heroLeadin}</span>
        <em>{cs.heroDisplay}</em>
      </h1>
      <p class="cs-hero__dek">{dek}</p>
      <div class="cs-hero__actions">
        <a class="cs-download" href={cs.pdfHref} download={cs.pdfFilename}>
          <span class="cs-download__icon" aria-hidden="true">↓</span>
          Download PDF
        </a>
      </div>
      <p class="cs-hero__property">
        {cs.property}
        <span>{cs.propertyMeta}</span>
      </p>
    </header>

    <section class="cs-glance" aria-label="At a glance">
      <div class="cs-glance__logo">
        <img src={logoSrc} alt={cs.property} width="220" height="64" />
      </div>
      <div class="cs-facts">
        {cs.facts.map((fact) => (
          <div>
            <p class="cs-facts__label">{fact.label}</p>
            <p class="cs-facts__value">{fact.value}</p>
          </div>
        ))}
      </div>
      <ul class="cs-inventory" aria-label="Bingo hall scope under management">
        {cs.inventory.map((item) => (
          <li class="cs-inventory__item">
            <p class="cs-inventory__num">{item.value}</p>
            <p class="cs-inventory__label">{item.label}</p>
          </li>
        ))}
      </ul>
      <div class="cs-summary">
        {cs.summary.map((cell) => (
          <div class="cs-summary__cell">
            <p class="cs-summary__label">{cell.label}</p>
            <p class="cs-summary__text">{cell.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="cs-reel" aria-label="Highlight reel">
      <video class="cs-reel__video" controls playsinline preload="metadata" poster={cs.reel.poster}>
        <source src={cs.reel.src} type="video/mp4" />
      </video>
      <p class="cs-reel__caption">{cs.reel.caption}</p>
    </section>

    <section class="cs-photo-band" aria-labelledby="cs-room-title">
      <img class="cs-photo-band__img" src={cs.challenge.photo.src} alt={cs.challenge.photo.alt} width="1600" height="900" loading="lazy" />
      <div class="cs-photo-band__scrim" aria-hidden="true"></div>
      <div class="cs-photo-band__content">
        <h2 id="cs-room-title" class="cs-sec__title">{cs.challenge.titleBefore}<span class="cs-sec__title-accent">{cs.challenge.titleAccent}</span></h2>
        <div class="cs-copy">
          {cs.challenge.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="cs-sec cs-sec--mid">
      <h2 class="cs-sec__title">{cs.approach.titleBefore}<span class="cs-sec__title-accent">{cs.approach.titleAccent}</span></h2>
      <div class="cs-copy">
        {cs.approach.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="cs-crew">
        {cs.approach.crewPhotos.map((photo) => (
          <figure><img src={photo.src} alt={photo.alt} loading="lazy" /></figure>
        ))}
      </div>
      <ul class="cs-scope">
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="8" height="6" rx="1" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <rect x="13" y="3" width="8" height="6" rx="1" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <rect x="3" y="12" width="8" height="6" rx="1" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <rect x="13" y="12" width="8" height="6" rx="1" stroke="#68E3BE" stroke-width="1.8"/>
            <circle cx="17" cy="15" r="1" fill="#EDD086"/>
          </svg>
          <span>{cs.approach.scope[0]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="3" width="16" height="5" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <rect x="4" y="10" width="16" height="5" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <rect x="4" y="17" width="16" height="4" rx="1.5" stroke="#68E3BE" stroke-width="1.8"/>
            <circle cx="7.5" cy="5.5" r="1" fill="#EDD086"/>
            <circle cx="7.5" cy="12.5" r="1" fill="#EDD086"/>
          </svg>
          <span>{cs.approach.scope[1]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="1.5" fill="#68E3BE" fill-opacity="0.14" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M7 10l3 2.2L7 14.4" fill="none" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="12" y1="14.5" x2="16.5" y2="14.5" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>{cs.approach.scope[2]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 9v6h3l5 4V5L7 9H4z" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M15.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M18 6a8 8 0 0 1 0 12" fill="none" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>{cs.approach.scope[3]}</span>
        </li>
      </ul>
    </section>

    <section class="cs-sec cs-sec--white">
      <h2 class="cs-sec__title">{cs.oneInterface.titleBefore}<span class="cs-sec__title-accent">{cs.oneInterface.titleAccent}</span></h2>
      <div class="cs-copy">
        {cs.oneInterface.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <figure class="cs-inline-photo">
        <img src={cs.oneInterface.photo.src} alt={cs.oneInterface.photo.alt} width="1600" height="900" loading="lazy" />
      </figure>
    </section>

    <section class="cs-consolidation-band" aria-labelledby="cs-consolidation-title">
      <img class="cs-consolidation-band__img" src={cs.consolidation.photo.src} alt={cs.consolidation.photo.alt} width="1600" height="900" loading="lazy" />
      <div class="cs-consolidation-band__scrim" aria-hidden="true"></div>
      <div class="cs-consolidation-band__content">
        <header class="cs-consolidation__header">
          <h2 id="cs-consolidation-title" class="cs-consolidation__title">Consolidation you can see</h2>
        </header>
        <ul class="cs-consolidation__list">
          {cs.consolidation.items.map((item) => (
            <li class="cs-consolidation__item">
              <p class="cs-consolidation__item-title">{item.title}</p>
              <p class="cs-consolidation__item-text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="cs-quote">
      <blockquote class="cs-quote__text">&ldquo;{cs.quote.text}&rdquo;</blockquote>
      <p class="cs-quote__attrib">
        <span>{cs.quote.role}</span>
        <span>{cs.quote.org}</span>
      </p>
    </section>

    <section class="cs-sec cs-sec--dark cs-results-block">
      <h2 class="cs-sec__title">{cs.results.titleBefore}<span class="cs-sec__title-accent">{cs.results.titleAccent}</span></h2>
      <div class="cs-ba" aria-label="Before and after">
        <div class="cs-ba__slider" data-cs-slider>
          <img class="cs-ba__img cs-ba__img--after" src={cs.beforeAfter.afterSrc} alt={cs.beforeAfter.afterAlt} width="1600" height="900" />
          <div class="cs-ba__before">
            <img class="cs-ba__img" src={cs.beforeAfter.beforeSrc} alt={cs.beforeAfter.beforeAlt} width="1600" height="900" />
          </div>
          <div class="cs-ba__divider" aria-hidden="true"><span class="cs-ba__handle"></span></div>
          <span class="cs-ba__tag cs-ba__tag--before">Before</span>
          <span class="cs-ba__tag cs-ba__tag--after">After</span>
          <input class="cs-ba__range" type="range" min="0" max="100" value="50" aria-label="Drag to reveal the finished bingo hall" />
        </div>
        <p class="cs-ba__caption">{cs.beforeAfter.caption}</p>
      </div>
      <ul class="cs-results">
        {cs.results.bullets.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="cs-scope-story" aria-labelledby="cs-scope-story-title">
      <h2 id="cs-scope-story-title" class="cs-scope-story__title">{cs.scopeStory.titleBefore}<em>{cs.scopeStory.titleAccent}</em></h2>
      <ul class="cs-scope-stats" aria-label="Property scope managed through LUCI">
        {cs.scopeStory.stats.map((stat) => (
          <li class="cs-scope-stat">
            <p class="cs-scope-stat__value">{stat.value}</p>
            <p class="cs-scope-stat__label">{stat.label}</p>
          </li>
        ))}
      </ul>
      <svg class="cs-scope-converge" viewBox="0 0 100 120" preserveAspectRatio="none" aria-hidden="true">
        <defs><linearGradient id="cs-funnel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#edd086" stop-opacity="0.75"/><stop offset="1" stop-color="#68e3be" stop-opacity="0.7"/></linearGradient></defs>
        <line x1="10" y1="0" x2="50" y2="116" stroke="url(#cs-funnel)"/>
        <line x1="30" y1="0" x2="50" y2="116" stroke="url(#cs-funnel)"/>
        <line x1="50" y1="0" x2="50" y2="116" stroke="#68e3be" stroke-width="2"/>
        <line x1="70" y1="0" x2="50" y2="116" stroke="url(#cs-funnel)"/>
        <line x1="90" y1="0" x2="50" y2="116" stroke="url(#cs-funnel)"/>
      </svg>
      <div class="cs-scope-arrow" aria-hidden="true"></div>
      <div class="cs-scope-dest">
        <span class="cs-scope-dest-rule" aria-hidden="true"></span>
        <p class="cs-scope-story__outcome">{cs.scopeStory.outcomeBefore}<em>{cs.scopeStory.outcomeAccent}</em>{cs.scopeStory.outcomeAfter}</p>
        <p class="cs-scope-story__dek">{cs.scopeStory.dek}</p>
      </div>
    </section>

    <section class="cs-sec cs-sec--light">
      <h2 class="cs-sec__title">{cs.whatsNext.titleBefore}<span class="cs-sec__title-accent">{cs.whatsNext.titleAccent}</span></h2>
      <div class="cs-copy">
        <p>{cs.whatsNext.intro}</p>
        <ul class="cs-plan">
          {cs.whatsNext.plans.map((item) => (
            <li><span><strong>{item.title}</strong> {item.body}</span></li>
          ))}
        </ul>
        <p class="cs-bottom-line">{cs.whatsNext.bottomLine}</p>
      </div>
    </section>

    <section class="cs-cta">
      <p class="cs-cta__body">Curious what this looks like for your property? <span class="cs-sec__title-accent">Let's talk.</span></p>
      <div class="cs-cta__actions">
        <a class="cs-cta-btn" href="/contact">Talk to LUCI<span class="cs-cta-btn__arrow" aria-hidden="true">→</span></a>
        <a class="cs-cta-btn cs-cta-btn--secondary" href={cs.pdfHref} download={cs.pdfFilename}>
          <span class="cs-download__icon" aria-hidden="true">↓</span>Download PDF
        </a>
      </div>
      <div class="cs-cta__about">
        <p class="cs-cta__about-label">{cs.cta.aboutLabel}</p>
        <p class="cs-cta__statement">{cs.cta.aboutStatement}</p>
      </div>
    </section>
  </div>
</article>

<script>
  document.querySelectorAll('[data-cs-slider]').forEach(function (el) {
    var range = el.querySelector('.cs-ba__range');
    if (!range) return;
    function set(v) {
      el.style.setProperty('--pos', v + '%');
      var tBefore = el.querySelector('.cs-ba__tag--before');
      var tAfter = el.querySelector('.cs-ba__tag--after');
      if (tBefore) tBefore.style.opacity = v > 6 ? 1 : 0;
      if (tAfter) tAfter.style.opacity = v < 94 ? 1 : 0;
    }
    set(range.value);
    range.addEventListener('input', function () { set(range.value); });
    function pointTo(clientX) {
      var r = el.getBoundingClientRect();
      var pct = Math.min(100, Math.max(0, ((clientX - r.left) / r.width) * 100));
      range.value = pct; set(pct);
    }
    el.addEventListener('pointerdown', function (e) { pointTo(e.clientX); try { el.setPointerCapture(e.pointerId); } catch (err) {} });
    el.addEventListener('pointermove', function (e) { if (e.buttons === 1) pointTo(e.clientX); });
  });
</script>

<style>
  .cs-page { background: var(--navy-deep); padding-bottom: clamp(48px, 8vw, 96px); }
  .cs-page__sheet { max-width: 880px; margin: 0 auto; background: #fff; }

  .cs-hero {
    background-color: var(--navy-deep);
    background-image:
      linear-gradient(to right, rgba(8,18,24,0.86) 0%, rgba(8,18,24,0.80) 48%, rgba(8,18,24,0.42) 78%, rgba(8,18,24,0.10) 100%),
      url('/images/mesh/luci-bg-hero-1920x1080.svg');
    background-size: cover; background-position: center; background-repeat: no-repeat;
    padding: clamp(40px, 8vw, 84px) clamp(28px, 6vw, 64px) clamp(40px, 7vw, 72px);
    overflow: hidden; position: relative;
  }
  .cs-hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: linear-gradient(to right, var(--mint) 0 62%, var(--gold) 62% 100%); }
  .cs-hero__kicker { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
  .cs-hero__kicker::before { content: ''; width: 28px; height: 2px; background: var(--mint); }
  .cs-hero__kicker span { font-family: var(--font-display); font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--mint); }
  .cs-hero__title { margin: 0 0 26px; font-family: var(--font-head); font-weight: 700; font-size: clamp(34px, 6.5vw, 60px); line-height: 1.04; letter-spacing: -0.03em; color: var(--off-white); max-width: 16ch; }
  .cs-hero__title :global(em) { display: block; font-family: var(--font-display); font-style: normal; font-size: clamp(24px, 4.8vw, 44px); line-height: 1.2; color: var(--mint); text-transform: uppercase; max-width: 12ch; }
  .cs-hero__leadin { display: block; font-family: var(--font-head); font-size: clamp(17px, 2.2vw, 24px); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(235,245,248,0.82); margin-bottom: 14px; }
  .cs-hero__dek { margin: 0 0 30px; font-size: clamp(17px, 2.2vw, 20px); line-height: 1.6; color: rgba(235,245,248,0.82); max-width: 58ch; }
  .cs-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 30px; }
  .cs-download { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; letter-spacing: 0.04em; text-decoration: none; color: var(--mint); border: 1px solid rgba(104,227,190,0.45); padding: 12px 20px; transition: background 0.15s, border-color 0.15s; }
  .cs-download:hover { background: rgba(104,227,190,0.08); border-color: var(--mint); }
  .cs-download__icon { font-size: 16px; line-height: 1; }
  .cs-hero__property { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 0; padding-top: 24px; border-top: 1px solid rgba(104,227,190,0.15); font-size: 13px; font-weight: 600; letter-spacing: 0.04em; color: var(--gold); }
  .cs-hero__property span { color: rgba(165,179,188,0.7); font-weight: 500; }

  .cs-glance { background: var(--off-white); padding: clamp(32px, 5vw, 48px) clamp(28px, 6vw, 64px); border-bottom: 1px solid var(--rule-light); }
  .cs-glance__logo { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--rule-light); }
  .cs-glance__logo img { height: 72px; width: auto; display: block; }
  .cs-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 32px; }
  @media (max-width: 620px) { .cs-facts { grid-template-columns: repeat(2, 1fr); gap: 20px 24px; } }
  .cs-facts__label { margin: 0 0 8px; font-family: var(--font-display); font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-light); }
  .cs-facts__value { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.3; color: var(--navy); }

  .cs-inventory { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--rule-light); border: 1px solid var(--rule-light); margin-bottom: 28px; list-style: none; padding: 0; }
  @media (max-width: 620px) { .cs-inventory { grid-template-columns: repeat(2, 1fr); } }
  .cs-inventory__item { background: #fff; padding: 18px 16px; text-align: left; }
  .cs-inventory__num { margin: 0 0 6px; font-family: var(--font-head); font-size: clamp(28px, 4vw, 36px); font-weight: 700; line-height: 1; letter-spacing: -0.03em; color: var(--accent-light); }
  .cs-inventory__label { margin: 0; font-size: 13px; line-height: 1.35; color: var(--ink); font-weight: 500; }

  .cs-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule-light); border: 1px solid var(--rule-light); }
  @media (max-width: 620px) { .cs-summary { grid-template-columns: 1fr; } }
  .cs-summary__cell { background: #fff; padding: 22px; }
  .cs-summary__label { margin: 0 0 10px; font-family: var(--font-display); font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-light); }
  .cs-summary__text { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink); }

  .cs-reel { background: var(--navy-deep); padding: clamp(32px, 5vw, 56px) clamp(28px, 6vw, 64px); border-bottom: 1px solid rgba(104,227,190,0.12); }
  .cs-reel__video { display: block; width: 100%; max-width: 760px; margin: 0 auto; aspect-ratio: 16/9; background: #000; border: 1px solid rgba(104,227,190,0.15); }
  .cs-reel__caption { margin: 14px auto 0; max-width: 760px; font-size: 13px; letter-spacing: 0.04em; color: rgba(235,245,248,0.7); text-align: center; }

  .cs-sec { padding: clamp(44px, 6vw, 72px) clamp(28px, 6vw, 64px); border-bottom: 1px solid var(--rule-light); }
  .cs-sec--white { background: #fff; }
  .cs-sec--light { background: var(--off-white); }
  .cs-sec--mid { position: relative; isolation: isolate; background-color: var(--navy-mid); border-bottom-color: rgba(0,0,0,0.2); overflow: hidden; }
  .cs-sec--mid::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse 95% 100% at 0% 35%, rgba(104,227,190,0.28) 0%, transparent 68%), radial-gradient(ellipse 60% 75% at 15% 100%, rgba(104,227,190,0.14) 0%, transparent 58%); }
  .cs-sec--mid > * { position: relative; z-index: 1; }
  .cs-sec--dark { background: var(--navy); border-bottom-color: rgba(0,0,0,0.3); }
  .cs-sec__title { margin: 0 0 22px; font-family: var(--font-head); font-weight: 700; font-size: clamp(24px, 4vw, 34px); line-height: 1.12; letter-spacing: -0.025em; max-width: 24ch; }
  .cs-sec--white .cs-sec__title, .cs-sec--light .cs-sec__title { color: var(--navy); }
  .cs-sec--mid .cs-sec__title, .cs-sec--dark .cs-sec__title { color: var(--off-white); }
  .cs-sec__title-accent { color: var(--gold); }
  .cs-sec--white .cs-sec__title-accent, .cs-sec--light .cs-sec__title-accent { color: var(--accent-light); }
  .cs-copy p { margin: 0 0 18px; font-size: 17px; line-height: 1.72; max-width: 64ch; }
  .cs-copy p:last-child { margin-bottom: 0; }
  .cs-sec--white .cs-copy p, .cs-sec--light .cs-copy p { color: var(--ink); }
  .cs-sec--mid .cs-copy p { color: rgba(235,245,248,0.88); }
  .cs-sec--dark .cs-copy p { color: rgba(235,245,248,0.92); }

  .cs-photo-band { position: relative; overflow: hidden; min-height: clamp(380px, 52vw, 520px); border-bottom: none; }
  .cs-photo-band__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; display: block; }
  .cs-photo-band__scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(to right, rgba(245,248,250,0.96) 0%, rgba(245,248,250,0.92) 38%, rgba(245,248,250,0.62) 58%, rgba(245,248,250,0.18) 78%, rgba(245,248,250,0) 100%); }
  .cs-photo-band__content { position: relative; z-index: 2; padding: clamp(44px, 6vw, 72px) clamp(28px, 6vw, 64px); max-width: 38ch; }
  .cs-photo-band .cs-sec__title { color: var(--navy); }
  .cs-photo-band .cs-sec__title-accent { color: var(--accent-light); }
  .cs-photo-band .cs-copy p { color: var(--ink); }
  @media (max-width: 640px) { .cs-photo-band { min-height: 420px; } .cs-photo-band__scrim { background: linear-gradient(to bottom, rgba(245,248,250,0.96) 0%, rgba(245,248,250,0.88) 48%, rgba(245,248,250,0.35) 72%, rgba(245,248,250,0) 100%); } .cs-photo-band__content { max-width: none; } }

  .cs-inline-photo { margin: 28px 0 0; max-width: 100%; }
  .cs-inline-photo img { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; object-position: center; }

  .cs-crew { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; margin: 24px 0 28px; max-width: 64ch; overflow: hidden; border-radius: 14px; background: var(--navy-deep); }
  .cs-crew figure { margin: 0; }
  .cs-crew img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
  @media (max-width: 900px) { .cs-crew { grid-template-columns: 1fr 1fr; } }

  .cs-scope { list-style: none; margin: 28px 0 0; padding: 0; max-width: 64ch; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
