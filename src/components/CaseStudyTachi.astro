---
import { tachiCaseStudy } from '../data/site';
import { tachiCaseStudyDetail as cs } from '../data/caseStudyTachi';

const { dek, logoSrc } = tachiCaseStudy;
---

<article class="cs-page">
  <div class="cs-page__sheet">
    <header class="cs-hero">
      <div class="cs-hero__kicker"><span>Case Study</span></div>
      <h1 class="cs-hero__title">
        <span class="cs-hero__leadin">{cs.heroLeadin}</span>
        <em>{cs.heroDisplay}</em>
      </h1>
      <p class="cs-hero__dek">{dek}</p>
      <div class="cs-hero__actions">
        <a class="cs-download" href={cs.pdfHref} download={cs.pdfFilename}>
          <span class="cs-download__icon" aria-hidden="true">↓</span>
          Download PDF
        </a>
      </div>
      <p class="cs-hero__property">
        {cs.property}
        <span>{cs.propertyMeta}</span>
      </p>
    </header>

    <section class="cs-glance" aria-label="At a glance">
      <div class="cs-glance__logo">
        <img src={logoSrc} alt="Tachi Palace Casino Resort" width="220" height="64" />
      </div>

      <div class="cs-facts">
        {cs.facts.map((fact) => (
          <div>
            <p class="cs-facts__label">{fact.label}</p>
            <p class="cs-facts__value">{fact.value}</p>
          </div>
        ))}
      </div>

      <div class="cs-summary">
        {cs.summary.map((cell) => (
          <div class="cs-summary__cell">
            <p class="cs-summary__label">{cell.label}</p>
            <p class="cs-summary__text">{cell.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="cs-reel" aria-label="Highlight reel">
      <video
        class="cs-reel__video"
        controls
        playsinline
        preload="metadata"
        poster={cs.reel.poster}
      >
        <source src={cs.reel.src} type="video/mp4" />
      </video>
      <p class="cs-reel__caption">{cs.reel.caption}</p>
    </section>

    <section class="cs-sec cs-sec--white">
      <h2 class="cs-sec__title">Bring the <span class="cs-sec__title-accent">bingo hall alive</span></h2>
      <div class="cs-copy">
        {cs.challenge.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="cs-sec cs-sec--mid">
      <h2 class="cs-sec__title">A week of <span class="cs-sec__title-accent">hands-on work</span></h2>
      <div class="cs-copy">
        {cs.approach.paragraphs.map((p) => <p>{p}</p>)}
      </div>
          <div class="cs-crew">
        <figure>
          <img src="/images/case-studies/tachi/03-install-genie-lift-web.jpg" alt="LUCI technicians on a lift mounting LED panels" loading="lazy" />
        </figure>
        <figure>
          <img src="/images/case-studies/tachi/03c-config-web.jpg" alt="LUCI team configuring the system on site" loading="lazy" />
        </figure>
        <figure>
          <img src="/images/case-studies/tachi/03b-install-detail-web.jpg" alt="Technician wiring the back of an LED wall" loading="lazy" />
        </figure>
        <figure>
          <img src="/images/case-studies/tachi/03d-config-backroom-web.jpg" alt="LUCI engineer configuring the system on site" loading="lazy" />
        </figure>
      </div>
      <ul class="cs-scope">
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="8" height="6" rx="1" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
              <rect x="13" y="3" width="8" height="6" rx="1" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
              <rect x="3" y="12" width="8" height="6" rx="1" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
              <rect x="13" y="12" width="8" height="6" rx="1" stroke="#68E3BE" stroke-width="1.8"/>
              <circle cx="17" cy="15" r="1" fill="#EDD086"/>
            </svg>
            <span>{cs.approach.scope[0]}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="4" y="3" width="16" height="5" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
              <rect x="4" y="10" width="16" height="5" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
              <rect x="4" y="17" width="16" height="4" rx="1.5" stroke="#68E3BE" stroke-width="1.8"/>
              <circle cx="7.5" cy="5.5" r="1" fill="#EDD086"/>
              <circle cx="7.5" cy="12.5" r="1" fill="#EDD086"/>
            </svg>
            <span>{cs.approach.scope[1]}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="1.5" fill="#68E3BE" fill-opacity="0.14" stroke="#68E3BE" stroke-width="1.8"/>
              <path d="M7 10l3 2.2L7 14.4" fill="none" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="12" y1="14.5" x2="16.5" y2="14.5" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>{cs.approach.scope[2]}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 9v6h3l5 4V5L7 9H4z" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M15.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M18 6a8 8 0 0 1 0 12" fill="none" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>{cs.approach.scope[3]}</span>
          </li>
        </ul>
    </section>

    <section class="cs-ba" aria-label="Before and after">
      <div class="cs-ba__slider" data-cs-slider>
        <img class="cs-ba__img cs-ba__img--after" src="/images/case-studies/tachi/slider-after-web.jpg" alt="Tachi Palace bingo hall after the refresh: both LED walls lit with the BINGO graphic, mint cove glow, and the room brought to life" width="1600" height="900" />
        <div class="cs-ba__before">
          <img class="cs-ba__img" src="/images/case-studies/tachi/slider-before-web.jpg" alt="Tachi Palace bingo hall before the refresh: LED walls not yet installed, flat dull lighting" width="1600" height="900" />
        </div>
        <div class="cs-ba__divider" aria-hidden="true"><span class="cs-ba__handle"></span></div>
        <span class="cs-ba__tag cs-ba__tag--before">Before</span>
        <span class="cs-ba__tag cs-ba__tag--after">After</span>
        <input class="cs-ba__range" type="range" min="0" max="100" value="50" aria-label="Drag to reveal the finished bingo hall" />
      </div>
      <p class="cs-ba__caption">Drag to see the room come alive.</p>
    </section>

    <section class="cs-quote">
      <blockquote class="cs-quote__text">&ldquo;{cs.quote.text}&rdquo;</blockquote>
      <p class="cs-quote__attrib">
        <span>{cs.quote.role}</span>
        <span>{cs.quote.org}</span>
      </p>
    </section>

    <section class="cs-sec cs-sec--dark">
      <h2 class="cs-sec__title">What Tachi Palace <span class="cs-sec__title-accent">runs now</span></h2>
      <ul class="cs-results">
        {cs.results.bullets.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="cs-sec cs-sec--light">
      <h2 class="cs-sec__title">Built for <span class="cs-sec__title-accent">the moves ahead</span></h2>
      <div class="cs-copy">
        <p>{cs.whatsNext.intro}</p>
        <ul class="cs-plan">
          {cs.whatsNext.plans.map((item) => (
            <li>
              <span>
                <strong>{item.title}</strong> {item.body}
              </span>
            </li>
          ))}
        </ul>
        <p class="cs-bottom-line">{cs.whatsNext.bottomLine}</p>
      </div>
    </section>

    <section class="cs-cta">
      <p class="cs-cta__body">Curious what this looks like for your property? <span class="cs-sec__title-accent">Let's talk.</span></p>
      <div class="cs-cta__actions">
        <a class="cs-cta-btn" href="/contact">
          Talk to LUCI
          <span class="cs-cta-btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="cs-cta-btn cs-cta-btn--secondary" href={cs.pdfHref} download={cs.pdfFilename}>
          <span class="cs-download__icon" aria-hidden="true">↓</span>
          Download PDF
        </a>
      </div>
      <div class="cs-cta__about">
        <p class="cs-cta__about-label">{cs.cta.aboutLabel}</p>
        <p class="cs-cta__statement">{cs.cta.aboutStatement}</p>
      </div>
    </section>
  </div>
</article>

<style>
  .cs-page {
    background: var(--navy-deep);
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .cs-page__sheet {
    max-width: 880px;
    margin: 0 auto;
    background: #fff;
  }

  /* Hero */
  .cs-hero {
    background-color: var(--navy-deep);
    background-image: url('/images/textures/texture-circuit-navy-steel-print-dark.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: clamp(40px, 8vw, 84px) clamp(28px, 6vw, 64px) clamp(40px, 7vw, 72px);
    overflow: hidden;
    position: relative;
  }

  .cs-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: linear-gradient(to right, var(--mint) 0 62%, var(--gold) 62% 100%);
  }

  .cs-hero__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }

  .cs-hero__kicker::before {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--mint);
  }

  .cs-hero__kicker span {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mint);
  }

  .cs-hero__title {
    margin: 0 0 26px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(34px, 6.5vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--off-white);
    max-width: 16ch;
  }

  .cs-hero__title :global(em) {
    font-family: var(--font-display);
    font-style: normal;
    color: var(--mint);
    text-transform: uppercase;
  }

  .cs-hero__leadin {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(17px, 2.2vw, 24px);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(235, 245, 248, 0.82);
    margin-bottom: 14px;
  }

  .cs-hero__dek {
    margin: 0 0 30px;
    font-size: clamp(17px, 2.2vw, 20px);
    line-height: 1.6;
    color: rgba(235, 245, 248, 0.82);
    max-width: 58ch;
  }

  .cs-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 30px;
  }

  .cs-download {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--mint);
    border: 1px solid rgba(104, 227, 190, 0.45);
    padding: 12px 20px;
    transition: background 0.15s, border-color 0.15s;
  }

  .cs-download:hover {
    background: rgba(104, 227, 190, 0.08);
    border-color: var(--mint);
  }

  .cs-download__icon {
    font-size: 16px;
    line-height: 1;
  }

  .cs-hero__property {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid rgba(104, 227, 190, 0.15);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--gold);
  }

  .cs-hero__property span {
    color: rgba(165, 179, 188, 0.7);
    font-weight: 500;
  }

  /* Glance */
  .cs-glance {
    background: var(--off-white);
    padding: clamp(32px, 5vw, 48px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid var(--rule-light);
  }

  .cs-glance__logo {
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule-light);
  }

  .cs-glance__logo img {
    height: 88px;
    width: auto;
    display: block;
  }

  .cs-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 36px;
  }

  @media (max-width: 620px) {
    .cs-facts {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 24px;
    }
  }

  .cs-facts__label {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .cs-facts__value {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy);
  }

  .cs-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule-light);
    border: 1px solid var(--rule-light);
  }

  @media (max-width: 620px) {
    .cs-summary {
      grid-template-columns: 1fr;
    }
  }

  .cs-summary__cell {
    background: #fff;
    padding: 22px;
  }

  .cs-summary__label {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .cs-summary__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }

  /* Reel — web only */
  .cs-reel {
    background: var(--navy-deep);
    padding: clamp(32px, 5vw, 56px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid rgba(104, 227, 190, 0.12);
  }

  .cs-reel__video {
    display: block;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid rgba(104, 227, 190, 0.15);
  }

  .cs-reel__caption {
    margin: 14px auto 0;
    max-width: 760px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: rgba(235, 245, 248, 0.7);
    text-align: center;
  }

  /* Sections */
  .cs-sec {
    padding: clamp(44px, 6vw, 72px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid var(--rule-light);
  }

  .cs-sec--white {
    background: #fff;
  }

  .cs-sec--light {
    background: var(--off-white);
  }

  .cs-sec--mid {
    background-color: var(--navy-mid);
    background-image: url('/images/textures/texture-circuit-navy-steel-print-mid.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-bottom-color: rgba(0, 0, 0, 0.2);
  }

  .cs-sec--dark {
    background: var(--navy);
    border-bottom-color: rgba(0, 0, 0, 0.3);
  }

  .cs-sec__title {
    margin: 0 0 22px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(24px, 4vw, 34px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 24ch;
  }

  .cs-sec--white .cs-sec__title,
  .cs-sec--light .cs-sec__title {
    color: var(--navy);
  }

  .cs-sec--mid .cs-sec__title,
  .cs-sec--dark .cs-sec__title {
    color: var(--off-white);
  }

  .cs-sec__title-accent {
    color: var(--gold);
  }

  .cs-sec--white .cs-sec__title-accent,
  .cs-sec--light .cs-sec__title-accent {
    color: var(--accent-light);
  }

  .cs-copy p {
    margin: 0 0 18px;
    font-size: 17px;
    line-height: 1.72;
    max-width: 64ch;
  }

  .cs-copy p:last-child {
    margin-bottom: 0;
  }

  .cs-sec--white .cs-copy p,
  .cs-sec--light .cs-copy p {
    color: var(--ink);
  }

  .cs-sec--mid .cs-copy p {
    color: rgba(235, 245, 248, 0.88);
  }

  .cs-sec--dark .cs-copy p {
    color: rgba(235, 245, 248, 0.92);
  }

  .cs-scope {
    list-style: none;
    margin: 6px 0 22px;
    padding: 0;
    max-width: 64ch;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .cs-scope li {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    color: rgba(235, 245, 248, 0.9);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(104, 227, 190, 0.4);
    border-radius: 14px;
  }

  .cs-scope li svg {
    display: block;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  @media (max-width: 620px) {
    .cs-scope {
      grid-template-columns: 1fr;
    }
  }

  /* Crew photo strip — quiet imagery, no card chrome */
  .cs-crew {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: 24px 0 28px;
    max-width: 64ch;
    overflow: hidden;
    border-radius: 14px;
  }
  .cs-crew figure {
    margin: 0;
  }
  .cs-crew img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 900px) {
    .cs-crew {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Before/after slider */
  .cs-ba {
    background: var(--navy-deep);
    padding: clamp(36px, 6vw, 60px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid rgba(104, 227, 190, 0.12);
  }
  .cs-ba__slider {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    user-select: none;
    touch-action: none;
    border-radius: 14px;
    border: 1px solid rgba(104, 227, 190, 0.18);
    --pos: 50%;
  }
  .cs-ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cs-ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .cs-ba__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--mint);
    transform: translateX(-1px);
    pointer-events: none;
  }
  .cs-ba__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    background: var(--mint);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
    display: grid;
    place-items: center;
  }
  .cs-ba__handle::before {
    content: "\2039\2003\203A";
    color: var(--navy);
    font-weight: 700;
    font-size: 16px;
  }
  .cs-ba__tag {
    position: absolute;
    top: 16px;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--off-white);
    background: rgba(10, 22, 28, 0.6);
    padding: 4px 10px;
  }
  .cs-ba__tag--before {
    left: 16px;
  }
  .cs-ba__tag--after {
    right: 16px;
  }
  .cs-ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .cs-ba__slider:focus-within .cs-ba__handle {
    outline: 3px solid var(--off-white);
    outline-offset: 2px;
  }
  .cs-ba__caption {
    margin: 14px 0 0;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: rgba(235, 245, 248, 0.7);
    text-align: center;
  }

  .cs-results {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(104, 227, 190, 0.18);
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    counter-reset: cs-result;
  }

  @media (max-width: 620px) {
    .cs-results {
      grid-template-columns: 1fr;
    }
  }

  .cs-results li {
    background: var(--navy);
    padding: 22px 20px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--off-white);
  }

  .cs-results li::before {
    content: counter(cs-result, decimal-leading-zero);
    counter-increment: cs-result;
    display: block;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gold);
    margin-bottom: 10px;
  }

  .cs-plan {
    list-style: none;
    margin: 22px 0 26px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 64ch;
  }

  .cs-plan li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink);
  }

