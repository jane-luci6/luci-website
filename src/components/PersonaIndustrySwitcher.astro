---
import type { PersonaIndustryStake } from '../data/personaDetails';

interface Props {
  stakes: PersonaIndustryStake[];
  kicker?: string;
}

const { stakes, kicker = 'What a failure costs here' } = Astro.props;
const tabs = stakes;
---

<div class="pis" data-pis>
  <div class="pis__tabs" role="tablist" aria-label="Industries">
    {tabs.map((t, i) => (
      <button
        class:list={['pis__tab', i === 0 && 'is-on']}
        role="tab"
        id={`pis-tab-${t.slug}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`pis-panel-${t.slug}`}
        data-pis-tab={t.slug}
      >{t.name}</button>
    ))}
  </div>

  <div class="pis__panels">
    {tabs.map((t, i) => (
      <div
        class:list={['pis__panel', i === 0 && 'is-on']}
        role="tabpanel"
        id={`pis-panel-${t.slug}`}
        aria-labelledby={`pis-tab-${t.slug}`}
        data-pis-panel={t.slug}
        hidden={i !== 0}
      >
        <a class="pis__hit" href={`/industries/${t.slug}`}>
          <div class="pis__media">
            <img
              class="pis__img"
              src={`${t.image}?v=1`}
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              width="1280"
              height="853"
            />
            <span class="pis__scrim" aria-hidden="true"></span>
            <p class="pis__kicker">{kicker}</p>
          </div>
          <div class="pis__body">
            <p class="pis__name">{t.name}</p>
            <p class="pis__callout">{t.callout}</p>
            <div class="pis__emphasis">
              <span class="pis__emphasis-k">How LUCI shows up</span>
              <p class="pis__emphasis-text">{t.emphasis}</p>
            </div>
            <span class="pis__cta">
              Explore {t.name}
              <span class="pis__cta-arrow" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </div>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector('[data-pis]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll('[data-pis-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-pis-panel]'));
    const select = (slug) => {
      tabs.forEach((tb) => {
        const on = tb.dataset.pisTab === slug;
        tb.classList.toggle('is-on', on);
        tb.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => {
        const on = p.dataset.pisPanel === slug;
        p.classList.toggle('is-on', on);
        if (on) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    };
    tabs.forEach((tb) => tb.addEventListener('click', () => select(tb.dataset.pisTab || '')));
  }
</script>

<style>
  .pis { display: flex; flex-direction: column; gap: clamp(20px, 2.5vw, 28px); }
  .pis__tabs { display: flex; flex-wrap: wrap; gap: 10px; }
  .pis__tab {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 9999px;
    border: 1px solid rgba(245, 248, 250, 0.15);
    background: transparent;
    color: rgba(245, 248, 250, 0.6);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .pis__tab:hover { color: var(--off-white); border-color: rgba(245, 248, 250, 0.3); }
  .pis__tab.is-on { background: var(--mint); color: var(--navy-deep); border-color: var(--mint); font-weight: 700; }
  .pis__panels { position: relative; }
  .pis__panel { display: none; }
  .pis__panel.is-on { display: block; }
  .pis__hit {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    border: 1px solid rgba(var(--gold-rgb), 0.28);
    border-radius: 14px;
    overflow: hidden;
    background: var(--navy-deep);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .pis__hit:hover {
    border-color: rgba(var(--gold-rgb), 0.55);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
  }
  .pis__hit:focus-visible {
    outline: 2px solid var(--accent-light);
    outline-offset: 3px;
  }
  .pis__media { position: relative; min-height: clamp(220px, 30vw, 320px); }
  .pis__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .pis__hit:hover .pis__img { transform: scale(1.03); }
  .pis__scrim { position: absolute; inset: 0; background: linear-gradient(160deg, rgba(10,22,28,0.55) 0%, rgba(10,22,28,0.2) 45%, rgba(10,22,28,0.65) 100%); }
  .pis__kicker {
    position: absolute; left: 22px; bottom: 18px; z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gold);
  }
  .pis__body { padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 18px; background: var(--navy-deep); }
  .pis__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700; letter-spacing: -0.02em;
    color: var(--off-white);
  }
  .pis__callout {
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.78);
  }
  .pis__emphasis { border-left: 3px solid var(--gold); padding: 4px 0 4px 18px; }
  .pis__emphasis-k {
    display: block; margin-bottom: 6px;
    font-family: var(--font-display); font-size: 9.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--gold);
  }
  .pis__emphasis-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14.5px; font-weight: 500; line-height: 1.5;
    color: var(--off-white);
  }
  .pis__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--mint);
  }
  .pis__cta-arrow {
    transition: transform 0.18s ease;
  }
  .pis__hit:hover .pis__cta-arrow { transform: translateX(4px); }
  @media (max-width: 820px) {
    .pis__hit { grid-template-columns: 1fr; }
    .pis__media { min-height: 200px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pis__img,
    .pis__cta-arrow { transition: none; }
    .pis__hit:hover .pis__img { transform: none; }
  }
</style>
