---
import type { PersonaIndustryStake } from '../data/personaDetails';

interface Props {
  stakes: PersonaIndustryStake[];
  kicker?: string;
}

const { stakes, kicker = 'What a failure costs here' } = Astro.props;
const tabs = stakes;
---

<div class="pis" data-pis>
  <div class="pis__tabs" role="tablist" aria-label="Industries">
    {tabs.map((t, i) => (
      <button
        class:list={['pis__tab', i === 0 && 'is-on']}
        role="tab"
        id={`pis-tab-${t.slug}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`pis-panel-${t.slug}`}
        data-pis-tab={t.slug}
      >{t.name}</button>
    ))}
  </div>

  <div class="pis__panels">
    {tabs.map((t, i) => (
      <div
        class:list={['pis__panel', i === 0 && 'is-on']}
        role="tabpanel"
        id={`pis-panel-${t.slug}`}
        aria-labelledby={`pis-tab-${t.slug}`}
        data-pis-panel={t.slug}
        hidden={i !== 0}
      >
        <div class="pis__media">
          <img class="pis__img" src={`${t.image}?v=1`} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" width="1280" height="853" />
          <span class="pis__scrim" aria-hidden="true"></span>
          <p class="pis__kicker">{kicker}</p>
        </div>
        <div class="pis__body">
          <p class="pis__name">{t.name}</p>
          <p class="pis__callout">{t.callout}</p>
          <div class="pis__emphasis">
            <span class="pis__emphasis-k">How LUCI shows up</span>
            <p class="pis__emphasis-text">{t.emphasis}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-pis]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pis-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-pis-panel]'));
    const select = (slug: string) => {
      tabs.forEach((tb) => {
        const on = tb.dataset.pisTab === slug;
        tb.classList.toggle('is-on', on);
        tb.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => {
        const on = p.dataset.pisPanel === slug;
        p.classList.toggle('is-on', on);
        if (on) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    };
    tabs.forEach((tb) => tb.addEventListener('click', () => select(tb.dataset.pisTab || '')));
  }
</script>

<style>
  .pis { display: flex; flex-direction: column; gap: clamp(20px, 2.5vw, 28px); }
  .pis__tabs { display: flex; flex-wrap: wrap; gap: 10px; }
  .pis__tab {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 9999px;
    border: 1px solid var(--rule-light);
    background: transparent;
    color: var(--navy-muted);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .pis__tab:hover { color: var(--ink-strong); border-color: var(--navy-muted); }
  .pis__tab.is-on { background: var(--accent-light); color: #fff; border-color: var(--accent-light); font-weight: 700; }
  .pis__panels { position: relative; }
  .pis__panel { display: none; }
  .pis__panel.is-on { display: grid; grid-template-columns: 1.1fr 1fr; gap: 0; border: 1px solid rgba(var(--gold-rgb), 0.28); border-radius: 14px; overflow: hidden; background: #fff; }
  .pis__media { position: relative; min-height: clamp(220px, 30vw, 320px); }
  .pis__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pis__scrim { position: absolute; inset: 0; background: linear-gradient(160deg, rgba(10,22,28,0.55) 0%, rgba(10,22,28,0.2) 45%, rgba(10,22,28,0.65) 100%); }
  .pis__kicker {
    position: absolute; left: 22px; bottom: 18px; z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gold);
  }
  .pis__body { padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 18px; background: #fff; }
  .pis__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700; letter-spacing: -0.02em;
    color: var(--ink-strong);
  }
  .pis__callout {
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.55;
    color: var(--ink);
  }
  .pis__emphasis { margin-top: auto; border-left: 3px solid var(--gold-deep); padding: 4px 0 4px 18px; }
  .pis__emphasis-k {
    display: block; margin-bottom: 6px;
    font-family: var(--font-display); font-size: 9.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--gold-deep);
  }
  .pis__emphasis-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14.5px; font-weight: 500; line-height: 1.5;
    color: var(--ink-strong);
  }
  @media (max-width: 820px) {
    .pis__panel.is-on { grid-template-columns: 1fr; }
    .pis__media { min-height: 200px; }
  }
</style>
