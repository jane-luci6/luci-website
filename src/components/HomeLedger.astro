---
import { homeLedger } from '../data/site';

const { kicker, headingLead, headingAccent, lede, ctaLabel, ctaHref } = homeLedger;

const ledgerAlt =
  'Consolidation ledger: today four or more multimedia systems, five or more equipment racks, fifteen or more receivers, and one hundred plus hardware devices, forty gig AV-over-IP links, thousands per change, and locked code. With LUCI: one interface, one equipment rack, one gig consolidated network, changes included in service, and code that is yours.';
---

<section class="home-ledger" aria-labelledby="home-ledger-title">
  <div class="container container--wide">
    <div class="home-ledger__layout">
      <header class="home-ledger__rail">
        <p class="home-ledger__kicker">{kicker}</p>
        <h2 id="home-ledger-title" class="home-ledger__heading">{headingLead}<em class="home-ledger__heading-accent">{headingAccent}</em></h2>
        <p class="home-ledger__lede">{lede}</p>
        <a class="home-ledger__cta btn btn--primary" href={ctaHref}>{ctaLabel}</a>
      </header>

      <figure class="home-ledger__fig">
        <img
          src="/images/diagrams/luci-consolidation-ledger.svg?v=1"
          alt={ledgerAlt}
          width="720"
          height="680"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .home-ledger {
    background: var(--navy);
    color: rgba(245, 248, 250, 0.92);
  }

  .home-ledger .container {
    padding-top: clamp(40px, 5vw, 64px);
    padding-bottom: clamp(12px, 1.5vw, 20px);
    max-width: 1180px;
  }

  .home-ledger__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.7fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .home-ledger__rail {
    max-width: none;
  }

  .home-ledger__kicker {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mint);
  }

  .home-ledger__heading {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-body);
    font-size: clamp(28px, 3.2vw, 38px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--off-white);
  }
  .home-ledger__heading-accent {
    font-style: normal;
    color: var(--gold);
  }

  .home-ledger__lede {
    margin: 16px 0 24px;
    max-width: 34ch;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.72);
  }

  .home-ledger__cta {
    align-self: start;
    background: var(--mint);
    color: var(--navy-deep);
  }
  .home-ledger__cta:hover {
    background: #7aebc8;
    color: var(--navy-deep);
  }

  .home-ledger__fig {
    margin: 0;
    width: 100%;
  }

  .home-ledger__fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    box-shadow: 0 24px 48px rgba(10, 22, 28, 0.35);
  }

  @media (max-width: 900px) {
    .home-ledger__layout {
      grid-template-columns: 1fr;
      gap: clamp(28px, 5vw, 40px);
      align-items: stretch;
    }
    .home-ledger__heading { max-width: 22ch; }
    .home-ledger__lede { max-width: 60ch; }
  }

  @media (max-width: 720px) {
    .home-ledger__rail {
      text-align: center;
    }
    .home-ledger__kicker,
    .home-ledger__heading,
    .home-ledger__lede {
      margin-inline: auto;
    }
    .home-ledger__cta {
      align-self: center;
    }
  }
</style>
