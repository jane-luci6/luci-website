---
/**
 * Four-up resource index grid. Same breakpoints as the case-studies index:
 * 4 columns from 1200px, 2 on tablet, 1 on a phone.
 */
---

<ul class="resource-index">
  <slot />
</ul>

<style>
  .resource-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 1199px) {
    .resource-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 700px) {
    .resource-index {
      grid-template-columns: minmax(0, 1fr);
      max-width: 480px;
      margin-inline: auto;
      gap: 16px;
    }
  }
</style>
