---
// Industry floorplan — modernized: aurora-glow glass stage, gradient
// signal-trace leader lines with a traveling pulse, radar-ping zone nodes,
// glass callout cards with numbered badges, and a clickable tab rail. Reveal
// is a one-shot sequence (settles once all are visible); tabs let a visitor
// re-highlight any zone afterward. Data-driven: pass image, zones, aria label.
export interface FloorplanLine { x1: number; y1: number; x2: number; y2: number; }
export interface FloorplanZone {
  label: string;
  desc: string;
  plate: { side: 'left' | 'right'; left?: string; right?: string; top: string };
  delay: number;
  lines: FloorplanLine[];
}
interface Props {
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  imageWidthPct?: number;
  zones: FloorplanZone[];
  ariaLabel?: string;
}
const {
  image,
  imageAlt,
  imageWidth = 790,
  imageHeight = 1024,
  imageWidthPct = 65.83,
  zones,
  ariaLabel = 'Zones LUCI orchestrates',
} = Astro.props;
const delaysMs = zones.map((z) => z.delay * 1000);
---
<div class="fp-stage" data-fp-animate data-delays={JSON.stringify(delaysMs)} style={`--img-w:${imageWidthPct}%`}>
  <div class="fp-mount">
    <div class="fp-mount__clip">
      <img
        class="fp-mount__img"
        src={image}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        width={imageWidth}
        height={imageHeight}
      />
      <div class="fp-scan" aria-hidden="true"></div>
    </div>

    <svg class="fp-overlay" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="fp-leadgrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#edd086" />
          <stop offset="100%" stop-color="#68e3be" />
        </linearGradient>
        <radialGradient id="fp-dotgrad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#eafff6" />
          <stop offset="100%" stop-color="#68e3be" />
        </radialGradient>
      </defs>

      {zones.map((z, i) => (
        <g class="fp-callout" data-zone={i} style={`--d:${z.delay}s`}>
          {z.lines.map((ln) => (
            <g>
              <path
                class="fp-lead"
                d={`M ${ln.x1} ${ln.y1} L ${ln.x2} ${ln.y2}`}
                vector-effect="non-scaling-stroke"
                pathLength="1"
              />
              <circle
                class="fp-pulse"
                r="0.9"
                cx={ln.x1}
                cy={ln.y1}
                style={`offset-path: path('M ${ln.x1} ${ln.y1} L ${ln.x2} ${ln.y2}')`}
              />
              <circle class="fp-ring" cx={ln.x2} cy={ln.y2} r="1" />
              <circle class="fp-ring fp-ring--b" cx={ln.x2} cy={ln.y2} r="1" />
              <circle class="fp-dot" cx={ln.x2} cy={ln.y2} r="0.6" />
            </g>
          ))}
        </g>
      ))}
    </svg>

    <div class="fp-plates">
      {zones.map((z, i) => (
        <div
          class={`fp-plate fp-plate--${z.plate.side}`}
          data-zone={i}
          style={`--d:${z.delay}s; --left:${z.plate.left ?? 'auto'}; --right:${z.plate.right ?? 'auto'}; --top:${z.plate.top};`}
        >
          <span class="fp-plate__label">{z.label}</span>
          <span class="fp-plate__desc">{z.desc}</span>
        </div>
      ))}
    </div>
  </div>
</div>
<script>
  const stage = document.querySelector<HTMLElement>('[data-fp-animate]');
  if (stage) {
    const plates = Array.from(stage.querySelectorAll<HTMLElement>('.fp-plate'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const delaysAttr = stage.getAttribute('data-delays');
    const delaysMs: number[] = delaysAttr ? JSON.parse(delaysAttr) : plates.map((_, i) => i * 3500);

    // Before reveal the cards read as greyed-out placeholders (CSS default).
    // The reveal flips each one to full, one-by-one on its delay; after the
    // sequence they all stay fully viewable. Hover/focus any not-yet-revealed
    // card to preview it at full strength.
    function reveal() {
      stage!.classList.add('is-visible');
      delaysMs.forEach((ms, i) => {
        window.setTimeout(() => plates[i]?.classList.add('is-shown'), reduce ? 0 : ms);
      });
    }

    if (reduce || !('IntersectionObserver' in window)) {
      reveal();
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              reveal();
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      io.observe(stage);
    }
  }
</script>
<style>
  /* ---------- Outer stage: aurora glass card (matches PlatformOrbit) ---------- */
  .fp-stage {
    position: relative;
    border-radius: 20px;
    /* Generous inset so the floorplan and cards both breathe inside the
       aurora box; cards overhang the edges without crowding the plan. */
    padding: clamp(40px, 5vw, 64px) clamp(28px, 4vw, 48px);
    background: radial-gradient(120% 90% at 50% 0%, #123040 0%, var(--navy) 42%, var(--navy-deep) 100%);
    border: 1px solid rgba(var(--mint-rgb), 0.16);
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.55);
    overflow: visible;
  }
  .fp-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background:
      radial-gradient(40% 50% at 18% 22%, rgba(var(--mint-rgb), 0.14), transparent 70%),
      radial-gradient(38% 46% at 88% 84%, rgba(var(--gold-rgb), 0.1), transparent 70%);
    filter: blur(40px);
    animation: fp-aurora 22s ease-in-out infinite alternate;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes fp-aurora {
    0% { transform: translate3d(-4%, -2%, 0) scale(1); }
    100% { transform: translate3d(5%, 3%, 0) scale(1.08); }
  }

  /* ---------- Image mount ---------- */
  .fp-mount {
    position: relative;
    /* No z-index / isolation: we WANT the inverted image to screen-blend
       with the stage's aurora background (so its black bg drops out and the
       floorplan dissolves into the same glow as the surrounding box). */
  }
  .fp-mount__clip {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
  }
  .fp-mount__img {
    position: relative;
    display: block;
    margin-inline: auto;
    width: var(--img-w, 65.83%);
    height: auto;
    filter: invert(1);
    mix-blend-mode: screen;
    /* No hard rectangle edge + soft feather so the floorplan melts into the
       aurora stage instead of reading as a pasted-on slab. */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
    mask-composite: intersect;
  }

  /* One-shot light sweep down the floorplan on reveal */
  .fp-scan {
    position: absolute;
    left: calc((100% - var(--img-w, 65.83%)) / 2);
    right: calc((100% - var(--img-w, 65.83%)) / 2);
    top: 0;
    height: 40%;
    background: linear-gradient(180deg, rgba(104, 227, 190, 0.5), transparent);
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .fp-stage.is-visible .fp-scan {
    animation: fp-scan-sweep 1.1s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  @keyframes fp-scan-sweep {
    0% { opacity: 0; transform: translateY(-20%); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translateY(220%); }
  }

  /* ---------- SVG overlay: signal-trace lines + radar nodes ---------- */
  .fp-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .fp-lead {
    fill: none;
    stroke: url(#fp-leadgrad);
    stroke-width: 1.6;
    stroke-linecap: round;
    /* Hide with opacity (not dasharray) — dasharray + pathLength +
       non-scaling-stroke is inconsistent across browsers and can leave a
       stub of the line visible from load. Opacity is bulletproof. */
    opacity: 0;
    transition: opacity 0.5s ease;
    transition-delay: var(--d, 0s);
  }
  .fp-stage.is-visible .fp-callout .fp-lead { opacity: 1; }

  .fp-pulse {
    fill: #eafff6;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .fp-stage.is-visible .fp-callout .fp-pulse {
    animation: fp-pulse-travel 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes fp-pulse-travel {
    0% { offset-distance: 0%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  .fp-dot {
    fill: url(#fp-dotgrad);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
    transition-delay: calc(var(--d, 0s) + 0.55s);
  }
  .fp-stage.is-visible .fp-callout .fp-dot { transform: scale(1); opacity: 1; }

  /* Radar-ping rings around each node, staggered */
  .fp-ring {
    fill: none;
    stroke: var(--mint);
    stroke-width: 0.5;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }
  .fp-stage.is-visible .fp-callout .fp-ring {
    animation: fp-ring-ping 2.6s ease-out infinite;
    animation-delay: calc(var(--d, 0s) + 0.75s);
  }
  .fp-stage.is-visible .fp-callout .fp-ring--b {
    animation-delay: calc(var(--d, 0s) + 2.05s);
  }
  @keyframes fp-ring-ping {
    0% { transform: scale(0.6); opacity: 0.5; }
    100% { transform: scale(3.4); opacity: 0; }
  }

  /* Click-to-replay pulse flash on a zone's line/dot/rings */
  .fp-callout.is-pulsing .fp-dot {
    animation: fp-dot-flash 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .fp-callout.is-pulsing .fp-ring {
    animation: fp-ring-ping 0.9s ease-out;
  }
  @keyframes fp-dot-flash {
    0% { transform: scale(1); }
    40% { transform: scale(1.8); }
    100% { transform: scale(1); }
  }
  /* ---------- Callout plates: frosted glass cards ---------- */
  .fp-plates {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .fp-plate {
    position: absolute;
    left: var(--left, auto);
    right: var(--right, auto);
    top: var(--top);
    transform: translateY(-50%) scale(0.97);
    width: 19%;
    min-width: 210px;
    padding: 22px 24px 20px;
    background: rgba(16, 35, 45, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(var(--mint-rgb), 0.28);
    border-radius: 14px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 20px rgba(var(--mint-rgb), 0.12);
    overflow: hidden;
    /* Default = greyed-out placeholder, visible before the reveal. */
    opacity: 0.4;
    filter: saturate(0.5) brightness(0.82);
    pointer-events: auto;
    cursor: pointer;
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.4s ease,
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }
  .fp-plate:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 3px;
  }
  .fp-plate::before {
    content: '';
    position: absolute;
    top: 0;
    left: 16px;
    right: 16px;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), var(--mint));
  }
  .fp-plate__label {
    position: relative;
    display: block;
    font-family: var(--font-head);
    font-size: clamp(16px, 1.7vw, 20px);
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.15;
    color: var(--mint);
  }
  .fp-plate__desc {
    position: relative;
    display: block;
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: clamp(13px, 1.35vw, 15px);
    font-weight: 400;
    line-height: 1.45;
    color: rgba(245, 248, 250, 0.78);
  }
  /* Reveal flips each card from greyed placeholder to full, one-by-one on its
     delay (JS adds .is-shown). After the sequence they all stay full. */
  .fp-plate.is-shown {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    filter: none;
  }
  /* Before a card is revealed, hover/focus previews it at full strength. */
  .fp-plate:not(.is-shown):hover,
  .fp-plate:not(.is-shown):focus {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    filter: none;
    border-color: rgba(var(--mint-rgb), 0.5);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 30px rgba(var(--mint-rgb), 0.38);
  }
  .fp-plate.is-pulsing {
    animation: fp-plate-flash 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes fp-plate-flash {
    0% { box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 20px rgba(var(--mint-rgb), 0.12); }
    40% { box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 36px rgba(var(--mint-rgb), 0.55); transform: translateY(-50%) scale(1.03); }
    100% { box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 20px rgba(var(--mint-rgb), 0.12); transform: translateY(-50%) scale(1); }
  }

  /* ---------- Narrow screens: stack, drop absolute overlay ---------- */
  @media (max-width: 900px) {
    .fp-stage { padding: clamp(14px, 3vw, 20px); }
    .fp-mount { display: flex; flex-direction: column; }
    .fp-mount__img { width: 100%; }
    .fp-scan { left: 0; right: 0; }
    .fp-overlay { display: none; }
    .fp-plates {
      position: static;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 14px;
    }
    .fp-plate {
      position: static;
      left: auto;
      right: auto;
      top: auto;
      transform: none;
      width: auto;
      min-width: 0;
      opacity: 1;
      filter: none;
      animation: none !important;
      transition: none !important;
    }
    /* On mobile all four cards read at full strength — no dim/current. */
    .fp-plate.is-dim { opacity: 1; filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-stage::before { animation: none; }
    .fp-scan { display: none; }
    .fp-lead { transition: none; opacity: 1; }
    .fp-pulse { display: none; }
    .fp-dot { transition: none; transform: scale(1); opacity: 1; }
    .fp-ring { animation: none !important; opacity: 0; }
    .fp-plate { transition: none !important; opacity: 1; transform: translateY(-50%); }
    .fp-plate.is-pulsing { animation: none; }
  }
</style>
