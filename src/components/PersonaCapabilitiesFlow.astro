---
import type { PersonaCapability } from '../data/personaDetails';
interface Props { capabilities: PersonaCapability[]; lead?: string; }
const { capabilities, lead } = Astro.props;
const hubIcon = `<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="24" r="9" fill="#CEB06E" fill-opacity="0.85"/><path d="M16 52c0-9.94 8.06-18 16-18s16 8.06 16 18"/></svg>`;
---

<div class="pcf">
  {lead && <p class="pcf__lead">{lead}</p>}

  <div class="pcf__stage">
    <svg class="pcf__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M50,50 L14,14" /><path d="M50,50 L86,14" /><path d="M50,50 L14,86" /><path d="M50,50 L86,86" />
    </svg>

    <div class="pcf__hub">
      <span class="pcf__hub-rings" aria-hidden="true"></span>
      <span class="pcf__hub-icon" set:html={hubIcon} />
      <p class="pcf__hub-kicker">The guest experience</p>
      <h3 class="pcf__hub-title">Every control lands here</h3>
      <p class="pcf__hub-sub">The one thing you&rsquo;re actually judged on.</p>
    </div>

    {capabilities.map((c, i) => (
      <button class="pcf__card" type="button" aria-label={`Use case ${i + 1}: ${c.front}. Hover to see how it works.`}>
        <span class="pcf__card-inner">
          <span class="pcf__face pcf__face--front">
            <span class="pcf__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="pcf__front">{c.front}</span>
            <span class="pcf__flip">How it works &rarr;</span>
          </span>
          <span class="pcf__face pcf__face--back">
            <span class="pcf__num pcf__num--back">{String(i + 1).padStart(2, '0')}</span>
            <span class="pcf__back">{c.back}</span>
          </span>
        </span>
      </button>
    ))}
  </div>
</div>

<script>
  // Hover + keyboard flip the card via CSS. On touch (no hover), fall back to tap-to-flip.
  if (window.matchMedia('(hover: none)').matches) {
    document.querySelectorAll('.pcf__card').forEach((card) => {
      card.addEventListener('click', () => card.classList.toggle('is-flipped'));
    });
  }
</script>

<style>
  .pcf { display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .pcf__lead { max-width: 62ch; margin: 0; font-family: var(--font-body); font-size: clamp(17px, 1.5vw, 20px); line-height: 1.6; color: rgba(245, 248, 250, 0.84); }

  .pcf__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: clamp(56px, 9vw, 104px) clamp(150px, 26vw, 280px);
    width: 100%;
    padding-block: clamp(24px, 4vw, 48px);
  }

  .pcf__lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; overflow: visible; }
  .pcf__lines path { fill: none; stroke: rgba(104, 227, 190, 0.32); stroke-width: 1; stroke-dasharray: 3 6; vector-effect: non-scaling-stroke; }

  .pcf__hub {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    text-align: center; width: clamp(180px, 16vw, 230px);
  }
  .pcf__hub-rings { position: absolute; inset: -28% -14%; z-index: -1; border-radius: 9999px; border: 1px solid rgba(var(--mint-rgb), 0.18); box-shadow: 0 0 0 1px rgba(var(--mint-rgb), 0.08), 0 0 60px rgba(var(--mint-rgb), 0.14); }
  .pcf__hub-rings::before { content: ''; position: absolute; inset: 14%; border-radius: 9999px; border: 1px solid rgba(var(--mint-rgb), 0.14); }
  .pcf__hub-icon { width: clamp(40px, 4vw, 52px); height: clamp(40px, 4vw, 52px); color: var(--mint); }
  .pcf__hub-icon :global(svg) { width: 100%; height: 100%; display: block; }
  .pcf__hub-kicker { margin: 0; font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--mint); }
  .pcf__hub-title { margin: 0; font-family: var(--font-body); font-size: clamp(20px, 2.4vw, 30px); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; color: var(--off-white); }
  .pcf__hub-sub { margin: 0; font-family: 'Inter', system-ui, sans-serif; font-size: clamp(13px, 1.1vw, 15px); line-height: 1.45; color: rgba(245, 248, 250, 0.66); }

  .pcf__card {
    position: relative; perspective: 1400px; cursor: pointer;
    min-height: clamp(180px, 20vw, 260px);
    background: none; border: 0; padding: 0; text-align: left; font: inherit; color: inherit;
  }
  .pcf__card:focus-visible { outline: 2px solid var(--mint); outline-offset: 4px; border-radius: 14px; }
  .pcf__face {
    position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    display: flex; flex-direction: column; gap: 12px;
    padding: clamp(18px, 1.8vw, 26px);
    border-radius: 14px;
    background: linear-gradient(160deg, rgba(10, 22, 28, 0.72) 0%, rgba(10, 22, 28, 0.5) 100%);
    box-shadow: inset 0 0 0 1px rgba(var(--mint-rgb), 0.22), 0 18px 40px rgba(0, 0, 0, 0.28);
  }
  .pcf__card-inner { display: block; position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1); }
  .pcf__card.is-flipped .pcf__card-inner { transform: rotateY(180deg); }
  @media (hover: hover) {
    .pcf__card:hover .pcf__card-inner,
    .pcf__card:focus-visible .pcf__card-inner,
    .pcf__card:focus-within .pcf__card-inner { transform: rotateY(180deg); }
  }
  .pcf__face--back { transform: rotateY(180deg); justify-content: center; }

  .pcf__num { display: block; font-family: var(--font-display); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mint); }
  .pcf__front { font-family: var(--font-body); font-weight: 700; font-size: clamp(17px, 1.6vw, 22px); line-height: 1.22; letter-spacing: -0.015em; color: var(--off-white); }
  .pcf__flip { margin-top: auto; font-family: 'Inter', system-ui, sans-serif; font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em; color: var(--mint); }

  .pcf__back { font-family: 'Inter', system-ui, sans-serif; font-size: clamp(14px, 1.2vw, 16px); line-height: 1.5; color: rgba(245, 248, 250, 0.84); }

  @media (max-width: 899px) {
    .pcf__stage { grid-template-columns: 1fr; grid-template-rows: auto; gap: 16px; }
    .pcf__lines { display: none; }
    .pcf__hub { position: static; transform: none; width: auto; padding: 24px 0; }
    .pcf__hub-rings { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .pcf__card-inner { transition: none; } }
</style>
