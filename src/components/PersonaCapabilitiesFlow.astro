---
import type { PersonaCapability } from '../data/personaDetails';
interface Props {
  capabilities: PersonaCapability[];
  lead?: string;
  takeaway?: string;
  hubLabel?: string;
  hubSub?: string;
}
const {
  capabilities,
  lead,
  takeaway = '',
  hubLabel = 'The Guest Experience',
  hubSub = '',
} = Astro.props;
const hubIcon = `<svg viewBox="0 0 16 16" fill="none"><path fill-rule="evenodd" d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" fill="#CEB06E" fill-opacity="0.92"/><path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1z" fill="currentColor"/></svg>`;
---

<div class="pcf">
  {lead && <p class="pcf__lead">{lead}</p>}

  <div class="pcf__stage">
    <svg class="pcf__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="pcf__spoke" /><path class="pcf__spoke" /><path class="pcf__spoke" /><path class="pcf__spoke" />
    </svg>

    <div class="pcf__hub">
      <span class="pcf__hub-rings" aria-hidden="true"></span>
      <span class="pcf__hub-icon" set:html={hubIcon} />
      <p class="pcf__hub-label">{hubLabel}</p>
      {hubSub && <p class="pcf__hub-sub">{hubSub}</p>}
    </div>

    {capabilities.map((c, i) => (
      <button class="pcf__card" type="button" aria-label={`Use case ${i + 1}: ${c.front}. Hover to see how it works.`}>
        <span class="pcf__card-inner">
          <span class="pcf__face pcf__face--front">
            <span class="pcf__watermark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="pcf__front">{c.front}</span>
            <span class="pcf__flip">How it works &rarr;</span>
          </span>
          <span class="pcf__face pcf__face--back">
            <span class="pcf__back-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="pcf__back">{c.back}</span>
          </span>
        </span>
      </button>
    ))}
  </div>

  {takeaway && <p class="pcf__takeaway" set:html={takeaway} />}
</div>

<script>
  // Hover + keyboard flip the card via CSS. On touch (no hover), fall back to tap-to-flip.
  if (window.matchMedia('(hover: none)').matches) {
    document.querySelectorAll('.pcf__card').forEach((card) => {
      card.addEventListener('click', () => card.classList.toggle('is-flipped'));
    });
  }

  // Draw spoke paths from each card toward the hub, stopping at the gold inner ring.
  function updateSpokes() {
    const stage = document.querySelector('.pcf__stage');
    const hub = document.querySelector('.pcf__hub');
    const svg = document.querySelector('.pcf__lines');
    if (!stage || !hub || !svg) return;
    if (window.matchMedia('(max-width: 899px)').matches) return;

    const stageRect = stage.getBoundingClientRect();
    const hubRect = hub.getBoundingClientRect();
    const w = stageRect.width;
    const h = stageRect.height;
    if (w < 1 || h < 1) return;

    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);

    const hubCx = hubRect.left + hubRect.width / 2 - stageRect.left;
    const hubCy = hubRect.top + hubRect.height / 2 - stageRect.top;
    // Gold inner ring is inset 20% → radius is 40% of hub diameter = 80% of outer radius
    const hubR = (hubRect.width / 2) * 0.8;

    // Exit point where the ray from card center → hub crosses the card's outer edge
    const edgeTowardHub = (r) => {
      const left = r.left - stageRect.left;
      const top = r.top - stageRect.top;
      const right = left + r.width;
      const bottom = top + r.height;
      const cx = left + r.width / 2;
      const cy = top + r.height / 2;
      const dx = hubCx - cx;
      const dy = hubCy - cy;
      let t = Infinity;
      if (dx > 0) t = Math.min(t, (right - cx) / dx);
      else if (dx < 0) t = Math.min(t, (left - cx) / dx);
      if (dy > 0) t = Math.min(t, (bottom - cy) / dy);
      else if (dy < 0) t = Math.min(t, (top - cy) / dy);
      return { x: cx + dx * t, y: cy + dy * t };
    };

    const cards = stage.querySelectorAll('.pcf__card');
    const paths = svg.querySelectorAll('.pcf__spoke');
    cards.forEach((card, i) => {
      const path = paths[i];
      if (!path) return;
      const start = edgeTowardHub(card.getBoundingClientRect());
      const dx = hubCx - start.x;
      const dy = hubCy - start.y;
      const dist = Math.hypot(dx, dy) || 1;
      const endX = hubCx - (dx / dist) * hubR;
      const endY = hubCy - (dy / dist) * hubR;
      path.setAttribute('d', `M${start.x},${start.y} L${endX},${endY}`);
    });
  }

  updateSpokes();
  window.addEventListener('resize', updateSpokes);
  if (document.fonts?.ready) document.fonts.ready.then(updateSpokes);
</script>

<style>
  .pcf { display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .pcf__lead { max-width: 62ch; margin: 0; font-family: var(--font-body); font-size: clamp(17px, 1.5vw, 20px); line-height: 1.6; color: rgba(245, 248, 250, 0.84); }

  .pcf__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: clamp(72px, 11vw, 132px) clamp(220px, 34vw, 380px);
    width: 100%;
    padding-block: clamp(24px, 4vw, 48px);
  }

  .pcf__lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; overflow: visible; }
  .pcf__spoke {
    fill: none;
    stroke: rgba(104, 227, 190, 0.42);
    stroke-width: 1.5;
    stroke-dasharray: 5 10;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    animation: pcf-flow 1.6s linear infinite;
  }
  @keyframes pcf-flow {
    to { stroke-dashoffset: -30; }
  }

  .pcf__hub {
    --pcf-hub-size: clamp(260px, 30vw, 340px);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1vw, 14px);
    box-sizing: border-box;
    width: var(--pcf-hub-size);
    height: var(--pcf-hub-size);
    max-width: var(--pcf-hub-size);
    max-height: var(--pcf-hub-size);
    aspect-ratio: 1 / 1;
    padding: 22%;
    overflow: hidden;
    text-align: center;
  }
  .pcf__hub-rings {
    position: absolute; inset: 0; z-index: -1; border-radius: 50%;
    border: 1px solid rgba(var(--mint-rgb), 0.24);
    box-shadow: 0 0 0 1px rgba(var(--mint-rgb), 0.08), 0 0 72px rgba(var(--mint-rgb), 0.2);
    animation: pcf-pulse 2.8s ease-in-out infinite;
  }
  .pcf__hub-rings::before { content: ''; position: absolute; inset: 9%; border-radius: 50%; border: 1px solid rgba(var(--mint-rgb), 0.16); }
  .pcf__hub-rings::after { content: ''; position: absolute; inset: 20%; border-radius: 50%; border: 1px solid rgba(var(--gold-rgb), 0.28); }
  .pcf__hub-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(36px, 4vw, 48px);
    flex: none;
    color: var(--mint);
  }
  .pcf__hub:has(.pcf__hub-sub) {
    --pcf-hub-size: clamp(288px, 33vw, 372px);
    gap: clamp(4px, 0.6vw, 8px);
  }
  .pcf__hub:has(.pcf__hub-sub) .pcf__hub-icon {
    width: clamp(28px, 3.2vw, 40px);
  }
  .pcf__hub:has(.pcf__hub-sub) .pcf__hub-label {
    font-size: clamp(15px, 1.55vw, 19px);
    max-width: 10ch;
  }
  .pcf__hub-icon :global(svg) { width: 100%; height: auto; display: block; }
  .pcf__hub-label {
    margin: 0;
    max-width: 11ch;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--mint);
    text-align: center;
    text-wrap: balance;
  }
  .pcf__hub-sub {
    margin: 0;
    max-width: 16ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(11px, 0.95vw, 13px);
    line-height: 1.35;
    color: rgba(245, 248, 250, 0.72);
    text-align: center;
    text-wrap: balance;
  }
  .pcf__takeaway {
    margin: 0 auto;
    max-width: 48ch;
    text-align: center;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.82);
  }
  .pcf__takeaway :global(strong) {
    color: var(--gold);
    font-weight: 600;
  }

  @keyframes pcf-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 1px rgba(var(--mint-rgb), 0.08), 0 0 56px rgba(var(--mint-rgb), 0.16);
      border-color: rgba(var(--mint-rgb), 0.2);
    }
    50% {
      transform: scale(1.045);
      box-shadow: 0 0 0 1px rgba(var(--mint-rgb), 0.18), 0 0 96px rgba(var(--mint-rgb), 0.42);
      border-color: rgba(var(--mint-rgb), 0.4);
    }
  }

  .pcf__card {
    position: relative; perspective: 1400px; cursor: pointer;
    min-height: clamp(168px, 17vw, 224px);
    background: none; border: 0; padding: 0; text-align: left; font: inherit; color: inherit;
  }
  .pcf__card:focus-visible { outline: 2px solid var(--mint); outline-offset: 4px; border-radius: 14px; }
  .pcf__face {
    position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    display: flex; flex-direction: column; gap: 12px;
    padding: clamp(16px, 1.6vw, 24px);
    border-radius: 14px;
    background: linear-gradient(160deg, rgba(10, 22, 28, 0.72) 0%, rgba(10, 22, 28, 0.5) 100%);
    box-shadow: inset 0 0 0 1px rgba(var(--gold-rgb), 0.18), 0 18px 40px rgba(0, 0, 0, 0.28);
  }
  .pcf__card-inner { display: block; position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1); }
  .pcf__card.is-flipped .pcf__card-inner { transform: rotateY(180deg); }
  @media (hover: hover) {
    .pcf__card:hover .pcf__card-inner,
    .pcf__card:focus-visible .pcf__card-inner,
    .pcf__card:focus-within .pcf__card-inner { transform: rotateY(180deg); }
  }
  .pcf__face--back { transform: rotateY(180deg); justify-content: center; }

  .pcf__watermark { position: absolute; right: clamp(8px, 1.2vw, 16px); bottom: -0.16em; font-family: var(--font-display); font-size: clamp(88px, 9vw, 120px); font-weight: 700; line-height: 1; color: rgba(206, 176, 110, 0.14); pointer-events: none; z-index: 0; }
  .pcf__front { position: relative; z-index: 1; font-family: var(--font-body); font-weight: 700; font-size: clamp(16px, 1.5vw, 21px); line-height: 1.22; letter-spacing: -0.015em; color: var(--off-white); }
  .pcf__flip { position: relative; z-index: 1; margin-top: auto; font-family: 'Inter', system-ui, sans-serif; font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em; color: var(--gold); }

  .pcf__back-index { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; color: var(--gold); }
  .pcf__back { font-family: 'Inter', system-ui, sans-serif; font-size: clamp(14px, 1.2vw, 16px); line-height: 1.5; color: rgba(245, 248, 250, 0.84); }

  @media (max-width: 899px) {
    .pcf__stage { grid-template-columns: 1fr; grid-template-rows: auto; gap: 16px; }
    .pcf__lines { display: none; }
    .pcf__hub {
      position: static;
      transform: none;
      width: auto;
      height: auto;
      max-width: none;
      max-height: none;
      aspect-ratio: auto;
      padding: 28px 0;
      overflow: visible;
    }
    .pcf__hub-rings { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pcf__card-inner { transition: none; }
    .pcf__spoke,
    .pcf__hub-rings { animation: none; }
  }
</style>
