---
import type { PersonaCapability } from '../data/personaDetails';

interface Props {
  capabilities: PersonaCapability[];
  lead?: string;
}

const { capabilities, lead } = Astro.props;
---

<div class="pcf">
  {lead && <p class="pcf__lead">{lead}</p>}

  <div class="pcf__stage">
    <ul class="pcf__actions" role="list">
      {capabilities.map((c, i) => (
        <li class="pcf__row">
          <span class="pcf__row-marker" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="pcf__row-text">
            <span class="pcf__action">{c.action}</span>
            <span class="pcf__arrow-inline" aria-hidden="true">→</span>
            <span class="pcf__outcome">{c.outcome}</span>
          </p>
        </li>
      ))}
    </ul>

    <div class="pcf__flow" aria-hidden="true">
      <svg class="pcf__flow-svg" viewBox="0 0 120 100" preserveAspectRatio="none" focusable="false">
        <defs>
          <linearGradient id="pcfFlow" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#68e3be" stop-opacity="0.2" />
            <stop offset="0.6" stop-color="#68e3be" stop-opacity="0.9" />
            <stop offset="1" stop-color="#ceb06e" stop-opacity="0.9" />
          </linearGradient>
        </defs>
        <path d="M0,15 C60,15 60,50 114,50" />
        <path d="M0,38 C60,38 60,50 114,50" />
        <path d="M0,62 C60,62 60,50 114,50" />
        <path d="M0,85 C60,85 60,50 114,50" />
        <path d="M114,50 l-7,-4 m7,4 l-7,4" class="pcf__flow-head" />
      </svg>
    </div>

    <div class="pcf__guest">
      <p class="pcf__guest-label">The guest experience</p>
      <div class="pcf__guest-figure">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="32" cy="22" r="10" />
          <path d="M14 54c0-9.94 8.06-18 18-18s18 8.06 18 18" />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .pcf {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }
  .pcf__lead {
    max-width: 62ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.84);
  }

  .pcf__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(56px, 6vw, 96px) minmax(240px, 50%);
    align-items: center;
    gap: 0;
  }

  .pcf__actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.6vw, 22px);
  }
  .pcf__row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: clamp(14px, 1.6vw, 20px) 0;
    border-top: 1px solid rgba(var(--mint-rgb), 0.18);
  }
  .pcf__row:first-child {
    border-top: none;
    padding-top: 0;
  }
  .pcf__row-marker {
    flex: 0 0 auto;
    min-width: 2.4em;
    margin-top: 2px;
    font-family: var(--font-body);
    font-size: clamp(13px, 1.1vw, 15px);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--mint);
  }
  .pcf__row-text {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    font-family: var(--font-body);
    line-height: 1.35;
  }
  .pcf__action {
    font-weight: 700;
    font-size: clamp(17px, 1.5vw, 20px);
    letter-spacing: -0.01em;
    color: var(--off-white);
  }
  .pcf__arrow-inline {
    color: var(--mint);
    font-weight: 700;
  }
  .pcf__outcome {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.72);
  }

  .pcf__flow {
    position: relative;
    height: 100%;
    min-height: 220px;
  }
  .pcf__flow-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .pcf__flow-svg path {
    fill: none;
    stroke: url(#pcfFlow);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 6 8;
    animation: pcfFlow 1.6s linear infinite;
  }
  .pcf__flow-head {
    stroke: var(--gold-deep);
    stroke-width: 2;
    stroke-dasharray: none;
    animation: none;
  }
  @keyframes pcfFlow {
    to { stroke-dashoffset: -28; }
  }

  .pcf__guest {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .pcf__guest-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mint);
    text-align: center;
  }
  .pcf__guest-figure {
    display: grid;
    place-items: center;
    width: clamp(200px, 24vw, 300px);
    height: clamp(200px, 24vw, 300px);
    border-radius: 9999px;
    color: var(--mint);
    background:
      radial-gradient(circle at 50% 40%, rgba(104, 227, 190, 0.22) 0%, rgba(104, 227, 190, 0) 60%),
      linear-gradient(160deg, rgba(206, 176, 110, 0.16) 0%, rgba(8, 17, 22, 0.4) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(var(--mint-rgb), 0.4),
      0 0 48px rgba(var(--mint-rgb), 0.18);
  }
  .pcf__guest-figure svg {
    width: 58%;
    height: 58%;
  }

  @media (max-width: 899px) {
    .pcf__stage {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .pcf__flow {
      min-height: 0;
      height: 40px;
    }
    .pcf__flow-svg {
      transform: rotate(90deg);
      transform-origin: center;
    }
    .pcf__guest {
      order: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcf__flow-svg path {
      animation: none;
    }
  }
</style>
