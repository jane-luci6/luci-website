---
import { site } from '../data/site';
import FloorControlStage from './FloorControlStage.astro';

interface Props {
  headline?: string;
  headlineAccent?: string;
  taglineDisplay?: typeof site.taglineDisplay;
}

const {
  headline = 'CONTROL THE',
  headlineAccent = 'WHOLE FLOOR.',
  taglineDisplay = site.taglineDisplay,
} = Astro.props;
---

<section class="home-entry" aria-labelledby="home-hero-title">
  <div class="home-entry__glow" aria-hidden="true"></div>
  <div class="home-entry__layout">
    <div class="home-entry__copy">
      <h1 id="home-hero-title" class="home-entry__title">
        {headline}<br />
        <em>{headlineAccent}</em>
      </h1>
      <p class="home-entry__tagline">
        {taglineDisplay.lead}<em>{taglineDisplay.accent}</em>{taglineDisplay.tail}
      </p>
    </div>
    <div class="home-entry__visual">
      <div class="home-entry__stage">
        <FloorControlStage fill eager />
      </div>
    </div>
  </div>
</section>

<style>
  .home-entry {
    --entry-header-offset: 96px;
    position: relative;
    height: calc(100dvh - var(--entry-header-offset));
    height: calc(100svh - var(--entry-header-offset));
    max-height: calc(100dvh - var(--entry-header-offset));
    background: var(--navy-deep);
    color: var(--off-white);
    overflow: hidden;
    isolation: isolate;
  }

  .home-entry__glow {
    position: absolute;
    inset: -15% -10% auto;
    height: 65%;
    background: radial-gradient(
      ellipse 60% 50% at 28% 0%,
      rgba(var(--mint-rgb), 0.1) 0%,
      rgba(var(--mint-rgb), 0.03) 50%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  .home-entry__layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-3) var(--page-pad);
    box-sizing: border-box;
  }

  .home-entry__copy {
    flex-shrink: 0;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .home-entry__title {
    margin: 0;
    max-width: 11ch;
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--off-white);
  }

  .home-entry__title em {
    font-style: normal;
    color: var(--mint);
    display: block;
  }

  .home-entry__tagline {
    margin: var(--space-3) 0 0;
    max-width: 26ch;
    font-family: var(--font-body);
    font-size: clamp(18px, 2.3vw, 24px);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: rgba(245, 248, 250, 0.82);
  }

  .home-entry__tagline em {
    font-style: normal;
    font-weight: 700;
    color: var(--gold);
  }

  .home-entry__visual {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: stretch;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .home-entry__stage {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
  }

  /* Side-by-side: copy left, map right (variant C) */
  @media (min-width: 768px) {
    .home-entry__layout {
      flex-direction: row;
      align-items: center;
      gap: clamp(24px, 3vw, 48px);
      padding: var(--space-3) 0 var(--space-3) var(--page-pad);
    }

    .home-entry__copy {
      flex: 0 0 38%;
      width: 38%;
      max-width: 420px;
      align-self: center;
    }

    .home-entry__title {
      font-size: clamp(44px, 5.2vw, 64px);
      max-width: 12ch;
    }

    .home-entry__tagline {
      margin-top: var(--space-4);
      font-size: clamp(20px, 1.9vw, 26px);
      max-width: 26ch;
    }

    .home-entry__visual {
      flex: 1 1 62%;
      height: calc(100dvh - var(--entry-header-offset) - var(--space-6));
      height: calc(100svh - var(--entry-header-offset) - var(--space-6));
      justify-content: center;
      padding-right: var(--page-pad);
    }

    .home-entry__stage {
      max-height: min(78vh, 660px);
      align-self: center;
    }
  }
</style>
