---
import { yaamavaCaseStudy } from '../data/site';
import { yaamavaCaseStudyDetail as cs } from '../data/caseStudyYaamava';

const { dek, logoSrc } = yaamavaCaseStudy;
---

<article class="cs-page">
  <div class="cs-page__sheet">
    <header class="cs-hero">
      <div class="cs-hero__kicker"><span>Case Study</span></div>
      <h1 class="cs-hero__title">
        <span class="cs-hero__leadin">{cs.heroLeadIn}</span>
        <em>{cs.heroDisplay}</em>
      </h1>
      <p class="cs-hero__dek">{dek}</p>
      <p class="cs-hero__property">
        {cs.property}
        <span>{cs.propertyMeta}</span>
      </p>
    </header>

    <section class="cs-glance" aria-label="At a glance">
      <div class="cs-glance__logo">
        <img src={logoSrc} alt={cs.property} width="541" height="669" />
      </div>
      <div class="cs-facts">
        {cs.facts.map((fact) => (
          <div>
            <p class="cs-facts__label">{fact.label}</p>
            <p class="cs-facts__value">{fact.value}</p>
          </div>
        ))}
      </div>
      <ul class="cs-inventory" aria-label="Property scope under management">
        {cs.inventory.map((item) => (
          <li class="cs-inventory__item">
            <p class="cs-inventory__num">{item.value}</p>
            <p class="cs-inventory__label">{item.label}</p>
          </li>
        ))}
      </ul>
      <div class="cs-summary">
        {cs.summary.map((cell) => (
          <div class="cs-summary__cell">
            <p class="cs-summary__label">{cell.label}</p>
            <p class="cs-summary__text">{cell.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="cs-sec cs-sec--white">
      <h2 class="cs-sec__title">{cs.challenge.titleBefore}<span class="cs-sec__title-accent">{cs.challenge.titleAccent}</span></h2>
      <div class="cs-copy">
        {cs.challenge.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <figure class="cs-figure">
      <img src={cs.floorFigure.src} alt={cs.floorFigure.alt} width="1600" height="900" loading="lazy" />
      <figcaption>{cs.floorFigure.caption}</figcaption>
    </figure>

    <section class="cs-sec cs-sec--mid">
      <h2 class="cs-sec__title">{cs.approach.titleBefore}<span class="cs-sec__title-accent">{cs.approach.titleAccent}</span></h2>
      <div class="cs-copy">
        {cs.approach.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="cs-crew">
        {cs.approach.crew.map((shot) => (
          <figure><img src={shot.src} alt={shot.alt} loading="lazy" /></figure>
        ))}
      </div>
      <ul class="cs-scope" aria-label="What came onto the platform">
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M10 9l6 3-6 3V9Z" fill="#EDD086"/>
          </svg>
          <span>{cs.approach.scope[0]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="3" width="16" height="11" rx="1.5" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M12 14v6M8 20h8" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M7 7h6" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>{cs.approach.scope[1]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="1.5" fill="#68E3BE" fill-opacity="0.14" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M7 10l3 2.2L7 14.4" fill="none" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="12" y1="14.5" x2="16.5" y2="14.5" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>{cs.approach.scope[2]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 9v6h3l5 4V5L7 9H4z" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M15.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M18 6a8 8 0 0 1 0 12" fill="none" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>{cs.approach.scope[3]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M3 9h18M3 15h18M9 3v18M15 3v18" stroke="#68E3BE" stroke-width="1.3"/>
            <rect x="9" y="9" width="6" height="6" fill="#EDD086" fill-opacity="0.9"/>
          </svg>
          <span>{cs.approach.scope[4]}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="6" width="19" height="9" rx="1" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/>
            <path d="M8 19h8M12 15v4" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M6 9.5h4M6 12h7" stroke="#EDD086" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span>{cs.approach.scope[5]}</span>
        </li>
      </ul>
    </section>

    <section class="cs-sec cs-sec--white">
      <h2 class="cs-sec__title">{cs.oneInterface.titleBefore}<span class="cs-sec__title-accent">{cs.oneInterface.titleAccent}</span></h2>
      <div class="cs-copy">
        {cs.oneInterface.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="cs-sec cs-sec--light cs-consolidation" aria-labelledby="cs-consolidation-title">
      <header class="cs-consolidation__header">
        <span class="cs-consolidation__rule" aria-hidden="true"></span>
        <h2 id="cs-consolidation-title" class="cs-consolidation__title">Consolidation you can see</h2>
      </header>
      <ul class="cs-consolidation__list">
        {cs.consolidation.map((item) => (
          <li class="cs-consolidation__item">
            <p class="cs-consolidation__item-title">{item.title}</p>
            <p class="cs-consolidation__item-text">{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="cs-quote">
      <blockquote class="cs-quote__text">&ldquo;{cs.quote.text}&rdquo;</blockquote>
      <p class="cs-quote__attrib">
        <span>{cs.quote.name}</span>
        {cs.quote.role}
      </p>
    </section>

    <section class="cs-sec cs-sec--dark">
      <h2 class="cs-sec__title">{cs.results.titleBefore}<span class="cs-sec__title-accent">{cs.results.titleAccent}</span></h2>
      <ul class="cs-results">
        {cs.results.bullets.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <figure class="cs-figure">
      <div class="cs-figure__pair">
        {cs.ledFigure.pair.map((img) => (
          <img src={img.src} alt={img.alt} width="1600" height="900" loading="lazy" />
        ))}
      </div>
      <figcaption>{cs.ledFigure.caption}</figcaption>
    </figure>

    <section class="cs-ledger" aria-labelledby="cs-ledger-title">
      <h2 id="cs-ledger-title" class="cs-ledger__title">{cs.ledger.titleBefore}<em>{cs.ledger.titleAccent}</em></h2>

      <div class="cs-ledger__ticker">
        <ul class="cs-ledger__stats" aria-label="Property scope managed through LUCI">
          {cs.ledger.stats.map((stat) => (
            <li>
              <span class="cs-ledger__ic" aria-hidden="true">
                {stat.icon === 'display' && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="4" width="18" height="13" rx="2" fill="#68E3BE" fill-opacity="0.20" stroke="#68E3BE" stroke-width="1.8"/>
                    <path d="M9 21h6M12 17v4" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
                    <circle cx="17.5" cy="8" r="1.5" fill="#EDD086"/>
                  </svg>
                )}
                {stat.icon === 'audio' && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 9v6h3l5 4V5L7 9H4Z" fill="#68E3BE" fill-opacity="0.20" stroke="#68E3BE" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M15 8.5c1.5 2 1.5 5 0 7M17.5 6c2.5 3 2.5 9 0 12" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                )}
                {stat.icon === 'channel' && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="5" width="18" height="14" rx="2" fill="#68E3BE" fill-opacity="0.20" stroke="#68E3BE" stroke-width="1.8"/>
                    <path d="M10 9l6 3-6 3V9Z" fill="#EDD086"/>
                  </svg>
                )}
                {stat.icon === 'signage' && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="4" y="3" width="16" height="11" rx="1.5" fill="#68E3BE" fill-opacity="0.20" stroke="#68E3BE" stroke-width="1.8"/>
                    <path d="M12 14v6M8 20h8" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M7 7h6" stroke="#EDD086" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                )}
                {stat.icon === 'grid' && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="3" width="18" height="18" rx="2" fill="#68E3BE" fill-opacity="0.18" stroke="#68E3BE" stroke-width="1.8"/>
                    <path d="M3 9h18M3 15h18M9 3v18M15 3v18" stroke="#68E3BE" stroke-width="1.4"/>
                    <rect x="9" y="9" width="6" height="6" fill="#EDD086" fill-opacity="0.9"/>
                  </svg>
                )}
              </span>
              <span class="cs-ledger__num">{stat.value}</span>
              <span class="cs-ledger__label">{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <svg class="cs-ledger__converge" viewBox="0 0 100 120" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="yaamava-funnel" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#edd086" stop-opacity="0.75"/>
            <stop offset="1" stop-color="#68e3be" stop-opacity="0.7"/>
          </linearGradient>
        </defs>
        <line x1="10" y1="0" x2="50" y2="116" stroke="url(#yaamava-funnel)"/>
        <line x1="30" y1="0" x2="50" y2="116" stroke="url(#yaamava-funnel)"/>
        <line x1="50" y1="0" x2="50" y2="116" stroke="#68e3be" stroke-width="2"/>
        <line x1="70" y1="0" x2="50" y2="116" stroke="url(#yaamava-funnel)"/>
        <line x1="90" y1="0" x2="50" y2="116" stroke="url(#yaamava-funnel)"/>
      </svg>
      <div class="cs-ledger__arrow" aria-hidden="true"></div>
      <div class="cs-ledger__dest">
        <span class="cs-ledger__dest-rule" aria-hidden="true"></span>
        <p class="cs-ledger__dest-head">{cs.ledger.outcomeBefore}<em>{cs.ledger.outcomeAccent}</em>{cs.ledger.outcomeAfter}</p>
        <p class="cs-ledger__dest-sub">{cs.ledger.dek}</p>
      </div>
    </section>

    <section class="cs-sec cs-sec--light">
      <h2 class="cs-sec__title">{cs.whatsNext.titleBefore}<span class="cs-sec__title-accent">{cs.whatsNext.titleAccent}</span></h2>
      <div class="cs-copy">
        <ul class="cs-plan">
          {cs.whatsNext.plans.map((item) => (
            <li>
              <span>
                <strong>{item.title}</strong> {item.body}
              </span>
            </li>
          ))}
        </ul>
        <p class="cs-bottom-line">{cs.whatsNext.bottomLine}</p>
      </div>
    </section>

    <section class="cs-cta">
      <p class="cs-cta__body">Curious what this looks like for your property? <span class="cs-sec__title-accent">Let's talk.</span></p>
      <div class="cs-cta__actions">
        <a class="cs-cta-btn" href="/contact">
          Talk to LUCI
          <span class="cs-cta-btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="cs-cta__about">
        <p class="cs-cta__about-label">{cs.cta.aboutLabel}</p>
        <p class="cs-cta__statement">{cs.cta.aboutStatement}</p>
      </div>
    </section>
  </div>
</article>

<style>
  .cs-page { background: var(--navy-deep); padding-bottom: clamp(48px, 8vw, 96px); }
  .cs-page__sheet { max-width: 880px; margin: 0 auto; background: #fff; }

  /* Hero — mesh stays vivid at the right edge; a scrim mutes it behind the
     left-aligned title, dek, and property line so the type stays legible. */
  .cs-hero {
    background-color: var(--navy-deep);
    background-image:
      linear-gradient(to right,
        rgba(8, 18, 24, 0.86) 0%,
        rgba(8, 18, 24, 0.80) 48%,
        rgba(8, 18, 24, 0.42) 78%,
        rgba(8, 18, 24, 0.10) 100%),
      url('/images/mesh/luci-bg-hero-1920x1080.svg');
    background-size: cover; background-position: center; background-repeat: no-repeat;
    padding: clamp(40px, 8vw, 84px) clamp(28px, 6vw, 64px) clamp(40px, 7vw, 72px);
    overflow: hidden; position: relative;
  }
  .cs-hero::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px;
    background: linear-gradient(to right, var(--mint) 0 62%, var(--gold) 62% 100%);
  }
  .cs-hero__kicker { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
  .cs-hero__kicker::before { content: ''; width: 28px; height: 2px; background: var(--mint); }
  .cs-hero__kicker span {
    font-family: var(--font-display); font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--mint);
  }
  .cs-hero__title {
    margin: 0 0 26px; font-family: var(--font-head); font-weight: 700;
    font-size: clamp(34px, 6.5vw, 60px); line-height: 1.04; letter-spacing: -0.03em;
    color: var(--off-white); max-width: 16ch;
  }
  .cs-hero__leadin {
    display: block; font-family: var(--font-head);
    font-size: clamp(17px, 2.2vw, 24px); font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(235, 245, 248, 0.82); margin-bottom: 14px;
  }
  .cs-hero__title :global(em) {
    display: block; font-family: var(--font-display); font-style: normal;
    font-size: clamp(26px, 5.2vw, 48px); line-height: 1.16; letter-spacing: 0;
    color: var(--mint); text-transform: uppercase; max-width: 12ch;
  }
  .cs-hero__dek {
    margin: 0 0 30px; font-size: clamp(17px, 2.2vw, 20px); line-height: 1.6;
    color: rgba(235, 245, 248, 0.82); max-width: 58ch;
  }
  .cs-hero__property {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 0;
    padding-top: 24px; border-top: 1px solid rgba(104, 227, 190, 0.15);
    font-family: var(--font-head); font-size: 13px; font-weight: 600;
    letter-spacing: 0.04em; color: var(--gold);
  }
  .cs-hero__property span { color: rgba(165, 179, 188, 0.7); font-weight: 500; }

  /* Glance */
  .cs-glance {
    background: var(--off-white);
    padding: clamp(32px, 5vw, 48px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid var(--rule-light);
  }
  .cs-glance__logo { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--rule-light); }
  .cs-glance__logo img { height: 124px; width: auto; display: block; }
  .cs-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 32px; }
  @media (max-width: 620px) { .cs-facts { grid-template-columns: repeat(2, 1fr); gap: 20px 24px; } }
  .cs-facts__label {
    margin: 0 0 8px; font-family: var(--font-display); font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-light);
  }
  .cs-facts__value { margin: 0; font-family: var(--font-head); font-size: 17px; font-weight: 600; line-height: 1.3; color: var(--navy); }

  /* Scope inventory (denominator) */
  .cs-inventory {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--rule-light); border: 1px solid var(--rule-light);
    margin-bottom: 28px; list-style: none; padding: 0; margin-left: 0; margin-right: 0;
  }
  @media (max-width: 620px) { .cs-inventory { grid-template-columns: repeat(2, 1fr); } }
  .cs-inventory__item { background: #fff; padding: 18px 16px; text-align: left; }
  .cs-inventory__num {
    margin: 0 0 6px; font-family: var(--font-head); font-size: clamp(26px, 3.6vw, 34px);
    font-weight: 700; line-height: 1; letter-spacing: -0.03em; color: var(--accent-light);
  }
  .cs-inventory__label {
    margin: 0; font-size: 13px; line-height: 1.35; color: var(--ink); font-weight: 500;
  }

  .cs-summary {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--rule-light); border: 1px solid var(--rule-light);
  }
  @media (max-width: 620px) { .cs-summary { grid-template-columns: 1fr; } }
  .cs-summary__cell { background: #fff; padding: 22px; }
  .cs-summary__label {
    margin: 0 0 10px; font-family: var(--font-display); font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-light);
  }
  .cs-summary__text { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink); }

  /* Sections */
  .cs-sec { padding: clamp(44px, 6vw, 72px) clamp(28px, 6vw, 64px); border-bottom: 1px solid var(--rule-light); }
  .cs-sec--white { background: #fff; }
  .cs-sec--light { background: var(--off-white); }
  /* Flat slate — the longest reading passage in the piece, kept calm. */
  .cs-sec--mid {
    background-color: var(--navy-mid);
    border-bottom-color: rgba(0, 0, 0, 0.2);
  }
  .cs-sec--dark { background: var(--navy); border-bottom-color: rgba(0, 0, 0, 0.3); }
  .cs-sec__title {
    margin: 0 0 22px; font-family: var(--font-head); font-weight: 700;
    font-size: clamp(24px, 4vw, 34px); line-height: 1.12; letter-spacing: -0.025em; max-width: 24ch;
  }
  .cs-sec--white .cs-sec__title, .cs-sec--light .cs-sec__title { color: var(--navy); }
  .cs-sec--mid .cs-sec__title, .cs-sec--dark .cs-sec__title { color: var(--off-white); }
  .cs-sec__title-accent { color: var(--gold); }
  .cs-sec--white .cs-sec__title-accent, .cs-sec--light .cs-sec__title-accent { color: var(--accent-light); }
  .cs-copy p { margin: 0 0 18px; font-size: 17px; line-height: 1.72; max-width: 64ch; }
  .cs-copy p:last-child { margin-bottom: 0; }
  .cs-sec--white .cs-copy p, .cs-sec--light .cs-copy p { color: var(--ink); }
  .cs-sec--mid .cs-copy p { color: rgba(235, 245, 248, 0.88); }
  .cs-sec--dark .cs-copy p { color: rgba(235, 245, 248, 0.92); }

  .cs-scope {
    list-style: none; margin: 6px 0 0; padding: 0; max-width: 64ch;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
  }
  .cs-scope li {
    display: flex; flex-direction: row; align-items: flex-start; gap: 14px;
    padding: 16px 18px; font-size: 15px; line-height: 1.5; margin: 0;
    color: rgba(235, 245, 248, 0.9); background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(104, 227, 190, 0.4); border-radius: 14px;
  }
  .cs-scope li svg { display: block; width: 28px; height: 28px; flex-shrink: 0; }
  @media (max-width: 620px) { .cs-scope { grid-template-columns: 1fr; } }

  /* Install photo strip — quiet imagery, no card chrome */
  .cs-crew {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    margin: 26px 0 28px; max-width: 64ch; overflow: hidden; border-radius: 14px;
  }
  .cs-crew figure { margin: 0; }
  .cs-crew img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  @media (max-width: 900px) { .cs-crew { grid-template-columns: 1fr 1fr; } }

  /* Full-bleed property photo band */
  .cs-figure {
    margin: 0; background: var(--navy-deep);
    padding: clamp(36px, 6vw, 60px) clamp(28px, 6vw, 64px);
    border-bottom: 1px solid rgba(104, 227, 190, 0.12);
  }
  .cs-figure img {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block;
    border-radius: 14px; border: 1px solid rgba(104, 227, 190, 0.18);
  }
  .cs-figure__pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 1.6vw, 18px); }
  @media (max-width: 620px) { .cs-figure__pair { grid-template-columns: 1fr; } }
  .cs-figure figcaption {
    margin: 14px 0 0; font-size: 13px; letter-spacing: 0.02em;
    line-height: 1.5; color: rgba(235, 245, 248, 0.7); text-align: center;
  }

  .cs-results {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: rgba(104, 227, 190, 0.18); list-style: none; margin: 0; padding: 0; counter-reset: cs-result;
  }
  @media (max-width: 620px) { .cs-results { grid-template-columns: 1fr; } }
  .cs-results li { background: var(--navy); padding: 22px 20px; font-size: 15px; font-weight: 600; line-height: 1.45; color: var(--off-white); }
  .cs-results li::before {
    content: counter(cs-result, decimal-leading-zero); counter-increment: cs-result; display: block;
