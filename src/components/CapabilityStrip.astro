---
import { capabilityItems } from '../data/zones';

interface Props {
  /** Render without outer section — for use inside ZoneSection */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

{
  embedded ? (
    <ul class="cap-strip__list">
      {
        capabilityItems.map((item) => (
          <li>
            <p class="cap-strip__label">{item.label}</p>
            <p class="cap-strip__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  ) : (
    <section class="cap-strip" aria-label="Key capabilities">
      <div class="container container--wide">
        <ul class="cap-strip__list">
          {
            capabilityItems.map((item) => (
              <li>
                <p class="cap-strip__label">{item.label}</p>
                <p class="cap-strip__body">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  )
}

<style>
  .cap-strip {
    background: var(--off-white);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--rule-light);
  }

  .cap-strip__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .cap-strip__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }

  .cap-strip__label {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-light);
    margin-bottom: var(--space-1);
  }

  .cap-strip__body {
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
    max-width: 28ch;
  }
</style>
