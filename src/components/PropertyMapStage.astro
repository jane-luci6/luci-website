---
import { propertyMap, propertyMapLabels, propertyMapZones } from '../data/propertyMap';

interface Props {
  fill?: boolean;
  eager?: boolean;
  zones?: boolean;
}

const { fill = false, eager = false, zones = false } = Astro.props;

const SLOT = 2.8;
const CYCLE = +(propertyMapZones.length * SLOT).toFixed(2);
---

<div class:list={['pm-stage', { 'pm-stage--fill': fill }]}>
  <div class="pm-frame" style={`--cycle:${CYCLE}s;--slot:${SLOT}s`}>
    <img
      class="pm-frame__img"
      src={propertyMap.src}
      alt={propertyMap.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width="1024"
      height="1348"
    />

    <div class="pm-frame__scrim" aria-hidden="true"></div>

    {propertyMapZones.map((z) => (
      <span
        class="pm-zone"
        style={`left:${z.left}%;top:${z.top}%;width:${z.w}%;height:${z.h}%;--d:${(z.delay * SLOT).toFixed(2)}s`}
        aria-hidden="true"
      />
    ))}

    {propertyMapLabels.map((l) => (
      <span
        class:list={['pm-label', { 'pm-label--secondary': l.priority === 'secondary' }]}
        style={`left:${l.left}%;top:${l.top}%`}
      >
        {l.name}
      </span>
    ))}

    {!zones && <span class="pm-note">For illustrative purposes only.</span>}
  </div>
</div>

<style>
  /* ── Stage: the outer container ────────────────────────────── */
  .pm-stage {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    background: var(--navy-deep);
    aspect-ratio: 1024 / 1348;
    box-shadow: 0 24px 48px rgba(10, 22, 28, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Fill the parent box (hero) — stage becomes a full-bleed container */
  .pm-stage--fill {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    box-shadow: none;
  }

  /* ── Frame: matches the image aspect ratio, holds image + overlays ──
     In fill mode the frame is letterboxed inside the wider stage so the
     full property shows without cropping. Labels position as % of the
     frame, which maps 1:1 to % of the image. */
  .pm-frame {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 1024 / 1348;
    overflow: hidden;
    border-radius: 0;
  }

  .pm-stage--fill .pm-frame {
    /* Fit the image's aspect ratio inside the stage without cropping */
    width: auto;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: 1024 / 1348;
  }

  .pm-frame__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pm-frame__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      120% 90% at 55% 45%,
      rgba(10, 22, 28, 0.1) 0%,
      rgba(10, 22, 28, 0.42) 100%
    );
    pointer-events: none;
  }

  .pm-zone {
    position: absolute;
    z-index: 3;
    border: 1.5px solid rgba(104, 227, 190, 0.55);
    border-radius: 0;
    background: rgba(104, 227, 190, 0.08);
    box-shadow: 0 0 0 1px rgba(104, 227, 190, 0.12), 0 0 24px rgba(104, 227, 190, 0.12);
    opacity: 0;
    pointer-events: none;
    animation: pmZonePulse var(--cycle) linear infinite;
    animation-delay: var(--d);
  }

  @keyframes pmZonePulse {
    0%,
    4% {
      opacity: 0;
      transform: scale(0.96);
    }
    8%,
    18% {
      opacity: 1;
      transform: scale(1);
    }
    24%,
    100% {
      opacity: 0;
      transform: scale(1.02);
    }
  }

  .pm-label {
    position: absolute;
    z-index: 5;
    transform: translate(-50%, -50%);
    padding: 5px 10px;
    border-radius: 0;
    background: rgba(10, 22, 28, 0.88);
    border: 1px solid rgba(104, 227, 190, 0.28);
    font-family: var(--font-body, 'Space Grotesk', sans-serif);
    font-size: clamp(10px, 1.05vw, 12px);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: #f5f8fa;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 8px 20px rgba(10, 22, 28, 0.35);
  }

  .pm-label--secondary {
    border-color: rgba(245, 248, 250, 0.14);
    color: rgba(245, 248, 250, 0.72);
    background: rgba(10, 22, 28, 0.72);
  }

  .pm-note {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 8;
    max-width: 240px;
    padding: 4px 9px;
    background: rgba(10, 22, 28, 0.5);
    font-size: clamp(9px, 0.95vw, 11px);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.3;
    font-style: italic;
    text-align: right;
    color: rgba(245, 248, 250, 0.55);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-zone {
      animation: none;
      opacity: 0.45;
    }
  }
</style>
