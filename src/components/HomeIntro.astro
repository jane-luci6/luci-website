---
import { homeIntroCopy } from '../data/homeIntro';

interface Props {
  headline?: string;
  photoSrc?: string;
  photoAlt?: string;
}

const {
  headline = homeIntroCopy.headline,
  photoSrc = homeIntroCopy.photoSrc,
  photoAlt = homeIntroCopy.photoAlt,
} = Astro.props;

const { headlineLead, headlineAccent, headlineTail, steps } = homeIntroCopy;
const showVisual = Boolean(photoSrc);

// The frame is 16:11; an SVG with viewBox 0 0 160 110 + uniform scaling overlays it 1:1,
// so arrowheads stay round. Convert % → viewBox units.
const VW = 160;
const VH = 110;
const vb = (x: number, y: number) => `${+(x * VW / 100).toFixed(1)} ${+(y * VH / 100).toFixed(1)}`;
const vx = (x: number) => +(x * VW / 100).toFixed(1);
const vy = (y: number) => +(y * VH / 100).toFixed(1);

// Flatten leader lines (origin → each target) for the steps that have targets.
const leaders = steps.flatMap((s) =>
  (s.targets ?? []).map((t) => ({ ox: vx(s.origin!.x), oy: vy(s.origin!.y), tx: vx(t.x), ty: vy(t.y) })),
);
const roomStep = steps.find((s) => s.room);
const roomOrigin = roomStep?.origin ? { x: vx(roomStep.origin.x), y: vy(roomStep.origin.y) } : null;
const cardStyle = (s: (typeof steps)[number]) =>
  Object.entries(s.pos).map(([k, v]) => `${k}:${v}`).join(';');
---

<section id="home-intro" class="home-intro" aria-labelledby="home-intro-title">
  <div class="home-intro__inner container container--wide">
    <header class="home-intro__header">
      <h2 id="home-intro-title" class="home-intro__headline">
        {headlineLead}<em class="home-intro__headline-accent">{headlineAccent}</em>{headlineTail}
      </h2>
    </header>

    {showVisual && (
      <figure class="home-intro__stage">
        <div class="home-intro__frame">
          <img src={photoSrc} alt={photoAlt} loading="lazy" decoding="async" width="1280" height="800" />
          <div class="home-intro__scrim" aria-hidden="true"></div>

          <!-- Leader lines + whole-room brackets -->
          <svg class="home-intro__arrows" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <defs>
              <marker id="hi-arrowhead" markerWidth="7" markerHeight="7" refX="5.2" refY="3" orient="auto">
                <path d="M0 0L6 3L0 6Z" fill="var(--mint)" />
              </marker>
            </defs>
            {leaders.map((l) => (
              <Fragment>
                <line class="home-intro__leader" x1={l.ox} y1={l.oy} x2={l.tx} y2={l.ty} marker-end="url(#hi-arrowhead)" />
                <circle class="home-intro__origin" cx={l.ox} cy={l.oy} r="1.2" />
                <circle class="home-intro__target" cx={l.tx} cy={l.ty} r="1.6" />
              </Fragment>
            ))}
            {roomOrigin && (
              <g class="home-intro__bracket">
                <path class="home-intro__room-leader" d={`M${roomOrigin.x} ${roomOrigin.y} H155 V87`} />
                <path d="M5 23 L5 5 L23 5" />
                <path d="M137 5 L155 5 L155 23" />
                <path d="M5 87 L5 105 L23 105" />
              </g>
            )}
          </svg>

          <!-- Step cards pinned to people-free zones -->
          {steps.map((step) => (
            <div class:list={["home-intro__card", `home-intro__card--${step.align}`]} style={cardStyle(step)}>
              <span class="home-intro__card-head">
                <span class="home-intro__card-num">{step.num}</span>
                <span class="home-intro__card-verb">{step.verb}</span>
              </span>
              <p class="home-intro__card-body">{step.body}</p>
            </div>
          ))}
        </div>

        <!-- Stacked fallback (mobile / reduced clutter) -->
        <div class="home-intro__steps">
          {steps.map((step) => (
            <div class="home-intro__step">
              <span class="home-intro__step-num">{step.num}</span>
              <span class="home-intro__step-verb">{step.verb}</span>
              <p class="home-intro__step-body">{step.body}</p>
            </div>
          ))}
        </div>
      </figure>
    )}

    <figure class="home-quote">
      <blockquote class="home-quote__text">
        <span class="home-quote__mark" aria-hidden="true">“</span>LUCI provides us with a comprehensive IP A/V solution that has limitless capabilities of distributing A/V content to any portion of our facility — from our casino floor to our state-of-the-art concert venue.<span class="home-quote__close" aria-hidden="true">”</span>
      </blockquote>
      <figcaption class="home-quote__attr">
        <span class="home-quote__rule" aria-hidden="true"></span>
        CIO · Casino Resort
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .home-intro {
    position: relative;
    background: var(--navy-mid);
    color: var(--off-white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .home-intro__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(48px, 8vw, 80px);
  }

  /* Headline as section head — full-width, gold accent phrase */
  .home-intro__header {
    max-width: none;
  }

  .home-intro__headline {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-head);
    font-size: clamp(28px, 4.4vw, 46px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--off-white);
  }

  /* Gold accent as gold text. On this dark surface, bright --gold reads cleanly
     (gold-on-dark passes contrast); gold is dark-surface-only for text. */
  .home-intro__headline-accent {
    font-style: normal;
    color: var(--gold);
  }

  /* Stage = full-width photo, annotated with the three steps */
  .home-intro__stage {
    position: relative;
    margin: clamp(28px, 4vw, 44px) 0 0;
  }

  .home-intro__frame {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 16 / 11;
    background: var(--navy);
  }

  .home-intro__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Corner darkening behind each card; lower-center (the guests) stays clear */
  .home-intro__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(8, 17, 22, 0.5) 0%, rgba(8, 17, 22, 0) 22%),
      radial-gradient(60% 45% at 14% 92%, rgba(8, 17, 22, 0.6) 0%, rgba(8, 17, 22, 0) 100%),
      radial-gradient(55% 45% at 86% 12%, rgba(8, 17, 22, 0.55) 0%, rgba(8, 17, 22, 0) 100%);
  }

  /* Leader lines + brackets overlay */
  .home-intro__arrows {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(0 0 2px rgba(8, 17, 22, 0.9));
  }
  .home-intro__leader {
    stroke: var(--mint);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    opacity: 0.92;
  }
  .home-intro__target {
    fill: var(--mint);
    stroke: rgba(8, 17, 22, 0.6);
    stroke-width: 0.6;
  }
  .home-intro__origin {
    fill: var(--mint);
    stroke: rgba(8, 17, 22, 0.7);
    stroke-width: 0.5;
  }
  .home-intro__bracket path {
    fill: none;
    stroke: var(--mint);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    opacity: 0.75;
  }
  .home-intro__bracket .home-intro__room-leader {
    stroke-width: 1.6;
    stroke-dasharray: 4 4;
    opacity: 0.9;
  }

  /* Step cards — dark glass, pinned to safe zones */
  .home-intro__card {
    position: absolute;
    z-index: 2;
    width: clamp(244px, 31vw, 340px);
    max-width: 52%;
    padding: clamp(15px, 1.8vw, 22px) clamp(17px, 2vw, 24px);
    background: rgba(10, 22, 28, 0.84);
    backdrop-filter: blur(8px) saturate(1.1);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);
    border-left: 4px solid var(--mint);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }
  .home-intro__card--right { border-left: none; border-right: 4px solid var(--mint); text-align: right; }

  .home-intro__card-head {
    display: flex;
    align-items: baseline;
    gap: 11px;
  }
  .home-intro__card--right .home-intro__card-head { flex-direction: row-reverse; }

  .home-intro__card-num {
    font-size: clamp(27px, 3vw, 35px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--mint);
  }
  .home-intro__card-verb {
    font-size: clamp(20px, 2.3vw, 25px);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--off-white);
  }
  .home-intro__card-body {
    margin: 9px 0 0;
    font-size: clamp(14px, 1.55vw, 16.5px);
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.86);
  }

  /* Stacked list — hidden on desktop (annotation does the work), shown on mobile */
  .home-intro__steps { display: none; }

  .home-intro__step-num {
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: rgba(245, 248, 250, 0.22);
  }

  .home-intro__step-verb {
    font-size: clamp(15px, 1.7vw, 18px);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--off-white);
  }

  .home-intro__step-body {
    grid-column: 2;
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.8);
  }

  /* Mobile: drop the photo annotation; stack the steps below the clean photo */
  @media (max-width: 760px) {
    .home-intro__frame {
      aspect-ratio: 16 / 10;
    }

    .home-intro__arrows,
    .home-intro__card,
    .home-intro__scrim {
      display: none;
    }

    .home-intro__steps {
      display: grid;
      grid-template-columns: 1fr;
      padding-top: clamp(24px, 6vw, 32px);
    }

    .home-intro__step {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      column-gap: 10px;
      align-content: start;
      padding: var(--space-3) 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .home-intro__step:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .home-intro__step-num { grid-row: 1 / 3; }
    .home-intro__step-verb { align-self: end; }
  }

  /* ---------- CIO pull-quote (replaces the CTA button row) ---------- */
  .home-quote {
    margin: var(--space-6) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .home-quote__text {
    margin: 0;
    max-width: 40ch;
    font-family: var(--font-body);
    font-size: clamp(18px, 2.4vw, 24px);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--off-white);
  }
  .home-quote__mark {
    font-family: var(--font-head);
    font-size: 1.7em;
    font-weight: 700;
    line-height: 0;
    color: var(--mint);
    margin-right: 0.04em;
  }
  .home-quote__close {
    color: var(--mint);
  }
  .home-quote__attr {
    margin: 20px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mint);
  }
  .home-quote__rule {
    width: 40px;
    height: 3px;
    background: var(--mint);
    border-radius: 2px;
  }
</style>
