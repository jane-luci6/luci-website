---
import { whoWeServe } from '../../data/whoWeServe';
import { hasPersonaDetail } from '../../data/personaDetails';

const short: Record<string, string> = {
  marketing: 'Marketing',
  operations: 'Operations',
  technology: 'Technology',
  finance: 'Finance',
  facilities: 'Facilities',
  leadership: 'Leadership',
};

// Scattered, asymmetric positions (percent) — a loose cluster, not a perfect ring.
const positions = [
  { x: 18, y: 22, s: 1.0 },
  { x: 78, y: 16, s: 0.85 },
  { x: 88, y: 58, s: 1.1 },
  { x: 66, y: 86, s: 0.9 },
  { x: 22, y: 82, s: 1.0 },
  { x: 10, y: 50, s: 0.8 },
];

const teams = whoWeServe.teams.map((t, i) => ({
  ...t,
  i,
  x: positions[i].x,
  y: positions[i].y,
  scale: positions[i].s,
  short: short[t.id] ?? t.label,
  linked: hasPersonaDetail(t.id as any),
}));
---

<div class="trc" data-teams-constellation>
  <div class="trc__stage">
    <svg class="trc__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {teams.map((t) => (
        <line class="trc__line" data-line={t.i} x1="50" y1="50" x2={t.x} y2={t.y} />
      ))}
    </svg>

    <div class="trc__core" aria-hidden="true">
      <span class="trc__core-glyph">
        <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s-7-4.6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.4-7 10-7 10z" fill="rgba(104,227,190,0.16)" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 11h6M12 8v6" stroke="#CEB06E" stroke-width="1.6" stroke-linecap="round"/></svg>
      </span>
      <span class="trc__core-label">Guest experience</span>
    </div>

    {teams.map((t) => (
      <button
        type="button"
        class:list={['trc__node', t.i === 0 && 'is-active']}
        data-node={t.i}
        style={`left:${t.x}%;top:${t.y}%;--s:${t.scale}`}
        aria-pressed={t.i === 0 ? 'true' : 'false'}
        aria-label={`${t.label} — ${t.role}`}
      >
        <span class="trc__node-badge" set:html={t.icon} />
        <span class="trc__node-label">{t.short}</span>
      </button>
    ))}
  </div>

  <div class="trc__detail">
    {teams.map((t) => (
      <div class:list={['trc__entry', t.i === 0 && 'is-active']} data-entry={t.i}>
        <p class="trc__entry-role">{t.role}</p>
        <h3 class="trc__entry-label">{t.label}</h3>
        <p class="trc__entry-line">{t.line}</p>
        {t.linked ? (
          <a class="trc__entry-link" href={`/who-we-serve/${t.id}`}>
            View this role
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        ) : (
          <span class="trc__entry-soon">Coming soon</span>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .trc { width: 100%; max-width: 720px; margin-inline: auto; }
  .trc__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-width: 560px;
    margin: 0 auto clamp(28px, 4vw, 40px);
    border-radius: 20px;
    background: radial-gradient(120% 90% at 50% 0%, #123040 0%, var(--navy) 46%, var(--navy-deep) 100%);
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  .trc__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .trc__line { stroke: rgba(245, 248, 250, 0.14); stroke-width: 0.35; vector-effect: non-scaling-stroke; transition: stroke 0.25s ease, stroke-width 0.25s ease; }
  .trc__line.is-active { stroke: var(--mint); stroke-width: 0.7; }

  .trc__core {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    text-align: center; pointer-events: none; z-index: 2;
  }
  .trc__core-glyph {
    display: flex; align-items: center; justify-content: center;
    width: clamp(56px, 11vw, 76px); height: clamp(56px, 11vw, 76px);
    border-radius: 9999px; color: var(--mint);
    background: rgba(104, 227, 190, 0.12);
    border: 1px solid rgba(104, 227, 190, 0.45);
    box-shadow: 0 0 32px rgba(104, 227, 190, 0.3);
  }
  .trc__core-glyph svg { width: 46%; height: 46%; }
  .trc__core-label {
    font-family: var(--font-body); font-size: clamp(10px, 1.4vw, 12px); font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--off-white); max-width: 12ch;
  }

  .trc__node {
    position: absolute; transform: translate(-50%, -50%) scale(var(--s, 1));
    z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 6px;
    background: none; border: 0; padding: 0; cursor: pointer; color: var(--off-white);
  }
  .trc__node-badge {
    display: flex; align-items: center; justify-content: center;
    width: clamp(40px, 8vw, 54px); height: clamp(40px, 8vw, 54px);
    border-radius: 9999px;
    background: rgba(16, 35, 45, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(245, 248, 250, 0.8);
    transition: all 0.2s ease;
  }
  .trc__node-badge :global(svg) { width: 46%; height: 46%; }
  .trc__node.is-active .trc__node-badge,
  .trc__node:hover .trc__node-badge,
  .trc__node:focus-visible .trc__node-badge {
    background: rgba(104, 227, 190, 0.2);
    border-color: var(--mint);
    color: var(--mint);
    box-shadow: 0 0 18px rgba(104, 227, 190, 0.32);
  }
  .trc__node-label {
    font-family: var(--font-body); font-size: 9px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: rgba(245, 248, 250, 0.68);
    white-space: nowrap;
  }
  .trc__node.is-active .trc__node-label { color: var(--mint); }

  .trc__detail { text-align: center; min-height: 150px; }
  .trc__entry { display: none; }
  .trc__entry.is-active { display: block; animation: trc-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes trc-pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .trc__entry-role { margin: 0 0 6px; font-family: var(--font-display); font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mint); }
  .trc__entry-label { margin: 0 0 10px; font-family: var(--font-body); font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; color: var(--off-white); }
  .trc__entry-line { margin: 0 auto 16px; max-width: 46ch; font-family: var(--font-body); font-size: 15px; line-height: 1.55; color: rgba(245, 248, 250, 0.78); }
  .trc__entry-link { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-body); font-size: 13px; font-weight: 700; color: var(--mint); text-decoration: none; }
  .trc__entry-link svg { width: 16px; height: 16px; transition: transform 0.15s ease; }
  .trc__entry-link:hover svg { transform: translateX(3px); }
  .trc__entry-soon { display: inline-block; padding: 5px 10px; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(245, 248, 250, 0.55); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 9999px; }

  @media (max-width: 640px) {
    .trc__stage { aspect-ratio: 1 / 1; }
    .trc__node-label { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-teams-constellation]').forEach((root) => {
    const nodes = Array.from(root.querySelectorAll<HTMLButtonElement>('.trc__node'));
    const entries = Array.from(root.querySelectorAll<HTMLElement>('[data-entry]'));
    const lines = Array.from(root.querySelectorAll<SVGLineElement>('[data-line]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0, pinned = false, timer: number | undefined;
    function set(i: number) {
      active = i;
      nodes.forEach((n) => n.classList.toggle('is-active', n.getAttribute('data-node') === String(i)));
      entries.forEach((e) => e.classList.toggle('is-active', e.getAttribute('data-entry') === String(i)));
      lines.forEach((l) => l.classList.toggle('is-active', l.getAttribute('data-line') === String(i)));
    }
    function start() { if (reduce || pinned) return; stop(); timer = window.setInterval(() => set((active + 1) % nodes.length), 4500); }
    function stop() { if (timer) window.clearInterval(timer); }
    nodes.forEach((n) => {
      const i = Number(n.getAttribute('data-node'));
      n.addEventListener('click', () => { pinned = true; stop(); set(i); });
      n.addEventListener('mouseenter', () => { stop(); set(i); });
      n.addEventListener('mouseleave', start);
    });
    set(0);
    if (!reduce) start();
  });
</script>
