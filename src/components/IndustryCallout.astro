---
interface Props {
  label: string;
  quote: string;
  attribution?: string;
}

const { label, quote, attribution } = Astro.props;
---

<aside class="ind-callout" data-reveal-callout>
  <p class="ind-callout__label">{label}</p>
  <blockquote class="ind-callout__quote">
    <p>{quote}</p>
    {attribution && <cite>{attribution}</cite>}
  </blockquote>
</aside>

<script>
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.ind-callout[data-reveal-callout]');

  if (!targets.length) {
    // no-op
  } else if (prefersReduce || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -6% 0px' }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

<noscript>
  <style>
    .ind-callout[data-reveal-callout] {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style>
  .ind-callout {
    margin-top: clamp(48px, 6vw, 64px);
    max-width: var(--content-wide);
    padding: clamp(28px, 3.5vw, 40px);
    border-left: 4px solid var(--gold);
    background: rgba(104, 227, 190, 0.06);
    border-radius: 0 16px 16px 0;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ind-callout.is-in {
    opacity: 1;
    transform: none;
  }

  .ind-callout__label {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .ind-callout__quote {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ind-callout__quote p {
    margin: 0 0 12px;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 22px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    color: var(--off-white);
    max-width: 52ch;
  }

  .ind-callout__quote cite {
    font-family: var(--font-body);
    font-size: 14px;
    font-style: normal;
    color: rgba(245, 248, 250, 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .ind-callout {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
