---
import { ameristarCaseStudy } from '../data/site';

const {
  homeHeadline,
  homeStat,
  homeCta,
  homeBandKicker,
  slug,
  logoSrcDark,
} = ameristarCaseStudy;

const headlineRest = homeHeadline.replace(/^Three days\s*/, '');
---

<section class="home-proof-band" aria-labelledby="home-proof-band-title">
  <div class="home-proof-band__inner container container--wide">
    <div class="home-proof-band__brand">
      <img
        class="home-proof-band__logo"
        src={logoSrcDark}
        alt="Ameristar Council Bluffs"
        width="180"
        height="36"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="home-proof-band__copy">
      <p class="home-proof-band__kicker">{homeBandKicker}</p>
      <h2 id="home-proof-band-title" class="home-proof-band__headline">
        <span>Three days</span> {headlineRest}.
      </h2>
      <p class="home-proof-band__dek">
        {homeStat.label} — {homeStat.value} at Ameristar Council Bluffs.
      </p>
    </div>

    <a class="btn btn--mint home-proof-band__cta" href={`/resources/case-studies/${slug}`}>
      {homeCta}
      <span class="home-proof-band__cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .home-proof-band {
    background: linear-gradient(
      90deg,
      rgba(104, 227, 190, 0.1) 0%,
      rgba(104, 227, 190, 0.04) 42%,
      rgba(16, 35, 45, 0.98) 100%
    );
    border-top: 1px solid rgba(104, 227, 190, 0.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--off-white);
  }

  .home-proof-band__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 3vw, 32px);
    padding-block: clamp(28px, 3.5vw, 40px);
  }

  .home-proof-band__logo {
    display: block;
    height: clamp(28px, 3vw, 36px);
    width: auto;
  }

  .home-proof-band__kicker {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mint);
  }

  .home-proof-band__headline {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    max-width: 28ch;
  }

  .home-proof-band__headline span {
    color: var(--gold);
  }

  .home-proof-band__dek {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: rgba(245, 248, 250, 0.68);
    max-width: 48ch;
  }

  .home-proof-band__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .home-proof-band__cta-arrow {
    font-size: 18px;
    line-height: 1;
    transition: transform 0.18s ease-out;
  }

  .home-proof-band__cta:hover .home-proof-band__cta-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .home-proof-band__inner {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .home-proof-band__brand {
      display: none;
    }

    .home-proof-band__cta {
      justify-self: start;
    }
  }
</style>
