---
interface Props {
  lead: string;
  rest?: string;
  sub?: string;
  tone?: 'dark' | 'light';
  as?: 'h1' | 'h2' | 'h3';
  hero?: boolean;
  id?: string;
}
const { lead, rest = '', sub = '', tone = 'dark', as = 'h2', hero = false, id } = Astro.props;
const Tag = as;
---

<header class:list={["wss-header", `wss-header--${tone}`, hero && 'wss-header--hero']} id={id} data-reveal>
  <Tag class="wss-header__head"><span class="wss-header__accent">{lead}</span>{rest}</Tag>
  {sub && <p class="wss-header__sub">{sub}</p>}
</header>

<style>
  .wss-header { display: block; max-width: 64ch; }
  .wss-header__head {
    font-family: var(--font-body);
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 0;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .wss-header__sub {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 400;
    line-height: 1.55;
    margin: 14px 0 0;
    max-width: 56ch;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease 0.12s, transform 0.5s ease 0.12s;
  }
  .wss-header.is-in .wss-header__head,
  .wss-header.is-in .wss-header__sub { opacity: 1; transform: none; }

  .wss-header--dark .wss-header__head { color: var(--off-white); }
  .wss-header--dark .wss-header__sub { color: rgba(245, 248, 250, 0.72); }
  .wss-header--dark .wss-header__accent { color: var(--mint); }
  .wss-header--light .wss-header__head { color: var(--ink-strong); }
  .wss-header--light .wss-header__sub { color: var(--navy-muted); }
  .wss-header--light .wss-header__accent { color: var(--accent-light); }

  .wss-header--hero .wss-header__head { font-size: clamp(34px, 5.5vw, 56px); max-width: 18ch; }
  .wss-header--hero .wss-header__sub { font-size: clamp(17px, 1.7vw, 20px); max-width: 52ch; margin-top: 18px; }

  @media (prefers-reduced-motion: reduce) {
    .wss-header__head, .wss-header__sub { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.wss-header[data-reveal]').forEach((el) => {
    if (reduce || !('IntersectionObserver' in window)) { el.classList.add('is-in'); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { el.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.3 });
    io.observe(el);
  });
</script>
