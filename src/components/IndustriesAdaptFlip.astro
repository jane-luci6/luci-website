---
import { industriesHub } from '../data/industriesHub';

interface Props {
  points?: { kicker?: string; head: string; detail: string }[];
}

const { points = industriesHub.adaptPoints } = Astro.props;

const flipGlyph = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>`;
---

<ul class="ind-adapt" role="list">
  {points.map((point) => (
    <li class="ind-adapt__item" tabindex="0">
      <div class="ind-adapt__card">
        <div class="ind-adapt__face ind-adapt__face--front">
          <div class="ind-adapt__top">
            {point.kicker && <p class="ind-adapt__kicker">{point.kicker}</p>}
            <p class="ind-adapt__head">{point.head}</p>
          </div>
          <span class="ind-adapt__flip" aria-hidden="true" set:html={flipGlyph} />
        </div>
        <div class="ind-adapt__face ind-adapt__face--back">
          <p class="ind-adapt__back-head">{point.head}</p>
          <p class="ind-adapt__detail">{point.detail}</p>
          <span class="ind-adapt__flip ind-adapt__flip--back" aria-hidden="true" set:html={flipGlyph} />
        </div>
      </div>
    </li>
  ))}
</ul>

<script>
  document.querySelectorAll('.ind-adapt').forEach((section) => {
    if (window.matchMedia('(hover: none)').matches) {
      section.querySelectorAll('.ind-adapt__item').forEach((item) => {
        item.addEventListener('click', () => item.classList.toggle('is-flipped'));
      });
    }
  });
</script>

<style>
  .ind-adapt {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2.6vw, 32px);
    max-width: var(--content-wide);
  }

  @media (min-width: 760px) {
    .ind-adapt {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ind-adapt__item {
    position: relative;
    height: clamp(244px, 26vw, 296px);
    perspective: 1400px;
    transition: transform 0.3s ease;
  }

  @media (hover: hover) {
    .ind-adapt__item:hover,
    .ind-adapt__item:focus-within {
      transform: translateY(-6px);
    }

    .ind-adapt__item:hover .ind-adapt__face--front,
    .ind-adapt__item:focus-within .ind-adapt__face--front {
      box-shadow:
        0 28px 56px rgba(10, 22, 28, 0.5),
        inset 0 0 0 1px rgba(104, 227, 190, 0.42),
        inset 0 0 90px rgba(104, 227, 190, 0.12);
    }
  }

  .ind-adapt__item:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 4px;
    border-radius: 18px;
  }

  .ind-adapt__card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  @media (hover: hover) {
    .ind-adapt__item:hover .ind-adapt__card,
    .ind-adapt__item:focus-within .ind-adapt__card {
      transform: rotateY(180deg);
    }
  }

  .ind-adapt__item.is-flipped .ind-adapt__card {
    transform: rotateY(180deg);
  }

  .ind-adapt__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.6vw, 32px);
    border-radius: 14px;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 16px 32px rgba(10, 22, 28, 0.3);
  }

  .ind-adapt__face--front {
    justify-content: space-between;
    background:
      radial-gradient(circle at 88% 100%, rgba(104, 227, 190, 0.38) 0%, rgba(104, 227, 190, 0) 46%),
      radial-gradient(circle at 12% 100%, rgba(206, 176, 110, 0.42) 0%, rgba(206, 176, 110, 0) 46%),
      linear-gradient(160deg, #0e1f29 0%, #0a161c 54%, #08131a 100%);
    box-shadow:
      0 18px 36px rgba(10, 22, 28, 0.42),
      inset 0 0 0 1px rgba(104, 227, 190, 0.24),
      inset 0 0 70px rgba(104, 227, 190, 0.06);
  }

  /* A soft moving sheen that keeps the card feeling live. */
  .ind-adapt__face--front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(245, 248, 250, 0.10) 48%, transparent 66%);
    background-size: 220% 100%;
    background-position: 130% 0;
    opacity: 0;
    transition: opacity 0.35s ease, background-position 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  @media (hover: hover) {
    .ind-adapt__item:hover .ind-adapt__face--front::after,
    .ind-adapt__item:focus-within .ind-adapt__face--front::after {
      opacity: 1;
      background-position: -30% 0;
    }
  }

  .ind-adapt__top {
    position: relative;
    z-index: 1;
  }

  .ind-adapt__kicker {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mint);
  }

  .ind-adapt__head {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-body);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--off-white);
  }

  .ind-adapt__flip {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    color: var(--mint);
    background: rgba(104, 227, 190, 0.14);
    box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.42);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s ease;
  }

  .ind-adapt__flip :global(svg) {
    width: 18px;
    height: 18px;
    display: block;
  }

  @media (hover: hover) {
    .ind-adapt__item:hover .ind-adapt__flip,
    .ind-adapt__item:focus-within .ind-adapt__flip {
      transform: rotate(180deg) scale(1.06);
      background: rgba(104, 227, 190, 0.26);
      box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.6), 0 0 18px rgba(104, 227, 190, 0.28);
    }
  }

  .ind-adapt__face--back {
    transform: rotateY(180deg);
    justify-content: flex-start;
    gap: 10px;
    background:
      radial-gradient(circle at 50% 0%, rgba(104, 227, 190, 0.18) 0%, rgba(104, 227, 190, 0) 55%),
      radial-gradient(circle at 88% 92%, rgba(206, 176, 110, 0.14) 0%, rgba(206, 176, 110, 0) 50%),
      linear-gradient(160deg, #0c1a22 0%, #08131a 100%);
    box-shadow:
      0 18px 36px rgba(10, 22, 28, 0.42),
      inset 0 0 0 1px rgba(104, 227, 190, 0.3);
    border-top: 3px solid var(--mint);
  }

  .ind-adapt__back-head {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--off-white);
  }

  .ind-adapt__detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.25vw, 16px);
    font-weight: 400;
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.84);
  }

  .ind-adapt__flip--back {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 480px) {
    .ind-adapt__item {
      height: clamp(264px, 34vw, 300px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ind-adapt__card,
    .ind-adapt__flip {
      transition: none;
    }
  }
</style>
