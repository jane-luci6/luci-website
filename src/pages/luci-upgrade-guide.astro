  .ug-headers--alt :global(.section--white) :global(.header-lockup__name) {
    color: var(--ink-strong);
  }
  .ug-headers--alt :global(.section--light) :global(.header-lockup__name em),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__name em) {
    color: var(--accent-light);
    border-bottom: none;
  }
  /* Jane 2026-10-01: no accent bars under section headers (!important beats SectionBlock). */
  .ug-headers--alt :global(.header-lockup__rule),
  .ug-headers--alt :global(.header-lockup.is-in .header-lockup__rule),
  .ug-headers--alt :global(.section--light) :global(.header-lockup__rule),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__rule),
  .ug-headers--alt :global(.section--deep) :global(.header-lockup__rule),
  .ug-headers--alt :global(.section--mid) :global(.header-lockup__rule) {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    margin: 0 !important;
    background: none !important;
    transform: none !important;
  }
  .ug-headers--alt :global(.section--deep) :global(.header-lockup__name em),
  .ug-headers--alt :global(.section--mid) :global(.header-lockup__name em) {
    color: var(--gold);
  }
  .ug-headers--alt :global(.header-lockup__name:not(:has(em)))::after,
  .ug-headers--alt :global(.header-lockup__name)::after {
    content: none !important;
    display: none !important;
  }



  @media (prefers-reduced-motion: reduce) {
    .ug-feature__chev, .ug-back-to-top { transition: none; }
  }
</style>


<style>
  /* ===== Asset mock chrome only (live UG styles preserved above) ===== */
  .ug-asset-nav {
    position: sticky;
    top: 0;
    z-index: 120;
    background: rgba(245, 248, 250, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(10, 26, 36, 0.1);
  }
  .ug-asset-nav__inner {
    /* Match hero/thesis .container--wide column (do not override to full page width). */
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--content-wide);
    min-height: 84px;
    padding-block: 14px;
  }
  .ug-asset-nav__chapters { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
  .ug-asset-nav__menu { position: relative; }
  .ug-asset-nav__chapter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 32px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-strong, #0a1a24);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: 0;
    text-decoration: none;
    cursor: pointer;
  }
  .ug-asset-nav__chapter:hover,
  .ug-asset-nav__chapter:focus-visible { background: rgba(10, 26, 36, 0.05); }
  .ug-asset-nav__chapter.is-active {
    background: rgba(10, 26, 36, 0.08);
    border-color: rgba(10, 26, 36, 0.12);
  }
  .ug-asset-nav__chapter--trigger[aria-expanded="true"] { background: rgba(10, 26, 36, 0.08); }
  .ug-asset-nav__chev { width: 22px; height: 22px; opacity: 0.7; transition: transform 0.15s ease; }
  .ug-asset-nav__chapter--trigger[aria-expanded="true"] .ug-asset-nav__chev { transform: rotate(180deg); }
  .ug-asset-nav__panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: min(340px, 92vw);
    max-height: min(70vh, 480px);
    overflow: auto;
    padding: 10px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(10, 26, 36, 0.12);
    box-shadow: 0 16px 40px rgba(10, 26, 36, 0.14);
    z-index: 130;
  }
  .ug-asset-nav__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .ug-asset-nav__item {
    display: block;
    padding: 14px 16px;
    border-radius: 8px;
    color: var(--ink-strong, #0a1a24);
    text-decoration: none;
    font-size: 17px;
    line-height: 1.35;
  }
  .ug-asset-nav__item:hover,
  .ug-asset-nav__item:focus-visible { background: rgba(10, 26, 36, 0.05); }
  .ug-asset-nav__item.is-active { background: rgba(127, 227, 187, 0.22); }
  .ug-asset-nav__item-name { font-weight: 600; }

  /* Open feature sections: no card chrome — sit flush on the light section bg.
     Keep the split-rail grid intact (do not force display:block on the
     feature or body, which would collapse the two-column rail). */
  .ug-feature--open {
    border: none;
    border-radius: 0;
    background: transparent;
    overflow: visible;
  }
  .ug-feature--open > .ug-feature__rail {
    cursor: default;
    list-style: none;
  }
  .ug-feature--open > .ug-feature__rail::-webkit-details-marker { display: none; }
  .ug-feature--open .ug-feature__chev { display: none; }
  .ug-feature--open .ug-feature__body {
    display: flex;
    flex-direction: column;
  }

  #ug-hero, #ug-thesis, #ug-pillars, #ug-features,
  #ug-technical, #ug-upgrade, #ug-faq, #ug-cta,
  [id^="ug-feature-"], [id^="ug-tech-"], [id^="ug-faq-"], [id^="ug-pillar-"] {
    scroll-margin-top: 100px;
  }
  @media (max-width: 640px) {
    #ug-hero, #ug-thesis, #ug-pillars, #ug-features,
    #ug-technical, #ug-upgrade, #ug-faq, #ug-cta,
    [id^="ug-feature-"], [id^="ug-tech-"], [id^="ug-faq-"], [id^="ug-pillar-"] {
      scroll-margin-top: 88px;
    }
    .ug-asset-nav__panel {
      position: fixed;
      left: 12px;
      right: 12px;
      width: auto;
      min-width: 0;
    }
  }
</style>


<script is:inline>
  (function () {
    var reduceMo = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var nav = document.querySelector('[data-ug-asset-nav]');
    if (!nav) return;

    var triggers = Array.prototype.slice.call(nav.querySelectorAll('[data-ug-menu-trigger]'));
    var menus = Array.prototype.slice.call(nav.querySelectorAll('[data-ug-menu]'));
    var chapterLinks = Array.prototype.slice.call(nav.querySelectorAll('[data-ug-chapter]'));
    var featLinks = Array.prototype.slice.call(nav.querySelectorAll('[data-ug-feat]'));
    var techJumpLinks = Array.prototype.slice.call(nav.querySelectorAll('[data-ug-tech-jump]'));

    function navH() { return Math.ceil(nav.getBoundingClientRect().height) || 52; }

    function closeAll(except) {
      menus.forEach(function (menu) {
        if (except && menu === except) return;
        var btn = menu.querySelector('[data-ug-menu-trigger]');
        var panel = menu.querySelector('[data-ug-menu-panel]');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      });
    }
    function openMenu(menu) {
      closeAll(menu);
      var btn = menu.querySelector('[data-ug-menu-trigger]');
      var panel = menu.querySelector('[data-ug-menu-panel]');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      if (panel) panel.hidden = false;
    }

    triggers.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var menu = btn.closest('[data-ug-menu]');
        if (btn.getAttribute('aria-expanded') === 'true') closeAll();
        else openMenu(menu);
      });
    });
    document.addEventListener('click', function (e) { if (!nav.contains(e.target)) closeAll(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });

    function jumpTo(id, updateHash) {
      var el = document.getElementById(id);
      if (!el) return;
      var pid = pillarOfTarget(id);
      if (pid) activateTab(pid);
      var details = el.closest('details') || (el.tagName === 'DETAILS' ? el : null);
      if (details && !details.open) details.open = true;
      var top = el.getBoundingClientRect().top + window.scrollY - navH() - 8;
      window.scrollTo({ top: top, behavior: reduceMo ? 'auto' : 'smooth' });
      if (updateHash !== false) history.replaceState(null, '', '#' + id);
      closeAll();
    }

    featLinks.forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); jumpTo(a.getAttribute('data-ug-feat'), true); });
    });
    techJumpLinks.forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); jumpTo(a.getAttribute('data-ug-tech-jump'), true); });
    });
    chapterLinks.forEach(function (a) {
      if (a.tagName !== 'A') return;
      a.addEventListener('click', function (e) { e.preventDefault(); jumpTo(a.getAttribute('data-ug-chapter'), true); });
    });

    Array.prototype.slice.call(document.querySelectorAll('a.ug-pill[data-feature], a.ug-pill[href^="#ug-feature-"]')).forEach(function (pill) {
      pill.addEventListener('click', function (e) {
        var href = pill.getAttribute('href') || '';
        var fid = pill.getAttribute('data-feature');
        var id = fid ? ('ug-feature-' + fid) : href.replace(/^#/, '');
        if (!id) return;
        e.preventDefault();
        jumpTo(id, true);
      });
    });

    function setChapterActive(id) {
      chapterLinks.forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-ug-chapter') === id);
      });
    }
    function setFeatActive(id) {
      featLinks.forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-ug-feat') === id);
      });
    }

    var chapterSecs = ['ug-thesis', 'ug-pillars', 'ug-features', 'ug-upgrade', 'ug-faq']
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean);
    var featSecs = Array.prototype.slice.call(document.querySelectorAll('[id^="ug-feature-"]'));

    function onScrollSpy() {
      var offset = navH() + 24;
      var activeChapter = null;
      chapterSecs.forEach(function (sec) {
        if (sec.getBoundingClientRect().top <= offset) activeChapter = sec.id;
      });
      if (activeChapter) setChapterActive(activeChapter);
      var activeFeat = null;
      featSecs.forEach(function (sec) {
        if (sec.getBoundingClientRect().top <= offset + 8) activeFeat = sec.id;
      });
      if (activeFeat) setFeatActive(activeFeat);
    }
    window.addEventListener('scroll', onScrollSpy, { passive: true });
    onScrollSpy();

    var btt = document.querySelector('[data-ug-back-to-top]');
    if (btt) {
      var onScroll = function () {
        if (window.scrollY > window.innerHeight * 0.6) btt.classList.add('is-visible');
        else btt.classList.remove('is-visible');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      btt.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: reduceMo ? 'auto' : 'smooth' });
      });
      onScroll();
    }

    function adjustHash() {
      var id = location.hash.slice(1);
      if (id && document.getElementById(id)) jumpTo(id, false);
    }
    if (document.readyState === 'complete') adjustHash();
    else window.addEventListener('load', adjustHash);
    setTimeout(adjustHash, 200);

    /* ── Pillar tabs — click a theme header to reveal that pillar's features.
       Nav links to a feature or pillar inside a hidden panel activate
       that tab first (handled in jumpTo above). No-JS fallback:
       all panels stay visible. */
    var tabBtns = Array.prototype.slice.call(document.querySelectorAll('[data-pillar-tab]'));
    var tabPanels = Array.prototype.slice.call(document.querySelectorAll('[data-pillar-panel]'));
    function pillarOfTarget(id) {
      var el = document.getElementById(id);
      if (!el) return null;
      var panel = el.closest('[data-pillar-panel]');
      return panel ? panel.getAttribute('data-pillar-panel') : null;
    }
    function activateTab(pillarId) {
      tabBtns.forEach(function (btn) {
        var on = btn.getAttribute('data-pillar-tab') === pillarId;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.setAttribute('tabindex', on ? '0' : '-1');
      });
      tabPanels.forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-pillar-panel') !== pillarId;
      });
      onScrollSpy();
    }
    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var pillarId = btn.getAttribute('data-pillar-tab');
        activateTab(pillarId);
        history.replaceState(null, '', '#ug-pillar-' + pillarId);
      });
    });
    (function initTabs() {
      var hashId = location.hash.slice(1);
      var initPillar = pillarOfTarget(hashId) || (tabBtns[0] && tabBtns[0].getAttribute('data-pillar-tab'));
      if (initPillar) activateTab(initPillar);
    })();
  })();
</script>
