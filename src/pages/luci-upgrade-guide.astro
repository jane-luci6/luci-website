  @media (prefers-reduced-motion: reduce) {
    .ug-feature__chev, .ug-back-to-top { transition: none; }
  }
</style>

<script>
  (function () {
    var reduceMo = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Expand / Collapse all per pillar ---- */
    var toggles = Array.prototype.slice.call(document.querySelectorAll('.ug-expand-toggle'));
    toggles.forEach(function (toggle) {
      var pillarId = toggle.getAttribute('data-pillar');
      var group = document.getElementById('ug-pillar-' + pillarId);
      if (!group) return;
      var items = Array.prototype.slice.call(group.querySelectorAll('details.ug-feature'));
      var label = toggle.querySelector('.ug-expand-toggle__label');

      function sync() {
        var allOpen = items.length > 0 && items.every(function (d) { return d.hasAttribute('open'); });
        toggle.setAttribute('aria-expanded', allOpen ? 'true' : 'false');
        if (label) label.textContent = allOpen ? 'Collapse all' : 'Expand all';
      }

      toggle.addEventListener('click', function () {
        var allOpen = items.every(function (d) { return d.hasAttribute('open'); });
        items.forEach(function (d) {
          if (allOpen) d.removeAttribute('open');
          else d.setAttribute('open', '');
        });
        sync();
      });

      items.forEach(function (d) {
        d.addEventListener('toggle', sync);
      });
      sync();
    });

    /* ---- Pillar pill → scroll to feature and open it ---- */
    var pills = Array.prototype.slice.call(document.querySelectorAll('.ug-pill[data-feature]'));
    pills.forEach(function (pill) {
      pill.addEventListener('click', function (e) {
        var fid = pill.getAttribute('data-feature');
        var target = document.getElementById('ug-feature-' + fid);
        if (!target) return;
        e.preventDefault();
        if (!target.hasAttribute('open')) target.setAttribute('open', '');
        var top = target.getBoundingClientRect().top + window.scrollY - 156;
        window.scrollTo({ top: top, behavior: reduceMo ? 'auto' : 'smooth' });
        history.replaceState(null, '', '#ug-feature-' + fid);
      });
    });

    /* ---- Back-to-top ---- */
    var btt = document.querySelector('[data-ug-back-to-top]');
    if (btt) {
      var onScroll = function () {
        if (window.scrollY > window.innerHeight * 0.6) btt.classList.add('is-visible');
        else btt.classList.remove('is-visible');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      btt.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: reduceMo ? 'auto' : 'smooth' });
      });
      onScroll();
    }

  })();
</script>


