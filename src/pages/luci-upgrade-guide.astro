     (same horizontal margins as body copy). White/blackbar paths removed.
     Scope: section lockups only (#ug-thesis … #ug-cta). Hero untouched.
     ============================================================ */

  /* Shared: lockup em reads as duo accent */
  .ug-headers :global(.header-lockup__name em) {
    font-style: normal;
  }

  /* MINT WASH — soft mint band; ink + accent-light; split rule under name.
     Band is full-bleed; content padded to match container--wide column. */
  .ug-headers--alt :global(.section--light) :global(.header-lockup),
  .ug-headers--alt :global(.section--white) :global(.header-lockup) {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-bottom: var(--space-5);
    /* Horizontal inset matches .container--wide: page-pad, plus extra when
       viewport exceeds content-wide so lockup type lines up with body copy. */
    padding-top: 26px;
    padding-bottom: 28px;
    padding-left: max(var(--page-pad), calc(50vw - var(--content-wide) / 2 + var(--page-pad)));
    padding-right: max(var(--page-pad), calc(50vw - var(--content-wide) / 2 + var(--page-pad)));
    box-sizing: border-box;
    background:
      linear-gradient(180deg, rgba(var(--mint-rgb), 0.14) 0%, rgba(var(--mint-rgb), 0.06) 100%),
      var(--off-white);
    border-bottom: 1px solid rgba(var(--mint-rgb), 0.28);
  }
  .ug-headers--alt :global(.section--light) :global(.header-lockup__name),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__name) {
    color: var(--ink-strong);
  }
  .ug-headers--alt :global(.section--light) :global(.header-lockup__name em),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__name em) {
    color: var(--accent-light);
    border-bottom: none;
  }
  /* Hide default mint rule; replace with split mint|gold rule */
  .ug-headers--alt :global(.section--light) :global(.header-lockup__rule),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__rule) {
    width: 72px;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--accent-light) 0 40px,
      transparent 40px 44px,
      var(--gold-deep, #CEB06E) 44px 72px
    );
    border-radius: 0;
  }
  .ug-headers--alt :global(.section--deep) :global(.header-lockup__name em),
  .ug-headers--alt :global(.section--mid) :global(.header-lockup__name em) {
    color: var(--gold);
  }
  .ug-headers--alt :global(.section--deep) :global(.header-lockup__rule),
  .ug-headers--alt :global(.section--mid) :global(.header-lockup__rule) {
    width: 72px;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--mint) 0 40px,
      transparent 40px 44px,
      var(--gold) 44px 72px
    );
  }
  .ug-headers--alt :global(.header-lockup__name:not(:has(em)))::after {
    content: '';
    display: block;
