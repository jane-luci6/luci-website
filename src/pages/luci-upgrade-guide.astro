---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import PlatformChapterNav from '../components/PlatformChapterNav.astro';
import { upgradeGuide } from '../data/upgradeGuide';
import { breadcrumb } from '../data/seo';

const { meta, hero, thesis, pillars, supportSpotlight, features, technical, upgradePath, faq, cta, openFlags } =
  upgradeGuide;

const chapters = [
  { id: 'ug-hero', label: 'Release' },
  { id: 'ug-thesis', label: 'Thesis' },
  { id: 'ug-pillars', label: 'Pillars' },
  { id: 'ug-features', label: 'Features' },
  { id: 'ug-technical', label: 'Technical' },
  { id: 'ug-upgrade', label: 'Upgrade' },
  { id: 'ug-faq', label: 'FAQ' },
  { id: 'ug-cta', label: 'Contact' },
];

const featuresByPillar = (pillarId: string) => features.filter((f) => f.pillarId === pillarId);

/** Duo-color accent spans for section lockups (same words; brochure-style emphasis).
 *  Accent phrase wraps only — no body-copy rewrite. Hero left untouched. */
const duoLockups = {
  thesis: 'The only A/V that scales and improves <em>just got better</em>',
  pillars: 'What the release puts <em>in your hands</em>',
  features: 'Feature <em>deep-dive</em>',
  technical: 'Technical <em>detail</em>',
  upgrade: 'Your path to the <em>new LUCI</em>',
  faq: 'Questions',
  cta: 'The <em>new version</em> of LUCI',
} as const;

const breadcrumbLd = breadcrumb([
  { name: 'Home', path: '/' },
  { name: 'New LUCI Upgrade Guide', path: meta.path },
]);
---

<BaseLayout
  title={meta.title.replace(' | LUCI Systems', '')}
  description={meta.description}
  canonicalPath={meta.path}
  noindex
  jsonLd={breadcrumbLd}
  darkHeader
>
  <h1 class="ug-sr-only">{meta.title}</h1>
  <PlatformChapterNav chapters={chapters} contextLabel="Upgrade Guide" />

  <div class="ug-headers ug-headers--alt">

  {/* ───────── 1. HERO — dark masthead + mesh ───────── */}
  <section id="ug-hero" class="ug-hero">
    <span class="ug-hero__mesh" aria-hidden="true"></span>
    <span class="ug-hero__plan" aria-hidden="true"></span>
    <span class="ug-hero__scrim" aria-hidden="true"></span>
    <div class="ug-hero__inner container container--wide">
      <p class="ug-hero__eyebrow">{hero.eyebrow}</p>
      <h2 class="ug-hero__headline">
        {hero.headline.leading}<span class="ug-hero__accent">{hero.headline.mintAccent}</span>{hero.headline.trailing}
      </h2>
      <div class="ug-hero__release">
        <span class="ug-hero__rlabel">Release date</span>
        <span class="ug-hero__date">{hero.date}</span>
      </div>
      <div class="ug-hero__ctas">
        {hero.ctas.map((c) => (
          <a
            class:list={['btn', c.audience === 'prospects' ? 'btn--mint' : 'btn--mint-outline']}
            href={c.href}
          >
            {c.label}
          </a>
        ))}
      </div>
    </div>
    <span class="ug-hero__bar" aria-hidden="true"></span>
  </section>

  {/* ───────── 2. THESIS ───────── */}
  <SectionBlock
    id="ug-thesis"
    lockupName={duoLockups.thesis}
    tone="light"
    wide
  >
    {thesis.paragraphs.map((para) => (
      <p class="ug-thesis">{para}</p>
    ))}
  </SectionBlock>

  {/* ───────── 3. PILLARS OVERVIEW ───────── */}
  <SectionBlock
    id="ug-pillars"
    lockupName={duoLockups.pillars}
    tone="light"
    wide
  >
    <div class="ug-pillars">
      {pillars.map((p) => (
        <article class="ug-pillar">
          <div class="ug-pillar__head">
            <span class="ug-pillar__num" aria-hidden="true">{p.number}</span>
            <h3 class="ug-pillar__name" set:html={p.name.replace('control', '<span class="ug-pillar__ctrl">control</span><br>')} />
          </div>
          <p class="ug-pillar__summary">{p.summary}</p>
          <ul class="ug-pillar__pills" role="list">
            {p.featurePills.map((pill) => (
              <li>
                <a class="ug-pill" href={`#ug-feature-${pill.id}`} data-feature={pill.id}>
                  <span class="ug-pill__name">{pill.name}</span>
                  <span class="ug-pill__liner">{pill.oneLiner}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    {/* In-product support spotlight — full-width row under the 3-col grid
        (two-pager .p2-spotlight pattern). Pulled out of the security pillar
        (undo fold-in); links to the deep-dive feature if it remains. */}
    <a class="ug-support-spotlight" href={`#ug-feature-${supportSpotlight.featureId}`}>
      <span class="ug-support-spotlight__plus">Plus</span>
      <span class="ug-support-spotlight__name">{supportSpotlight.title}</span>
      <span class="ug-support-spotlight__liner">{supportSpotlight.oneLiner}</span>
      <span class="ug-support-spotlight__arrow" aria-hidden="true">&rarr;</span>
    </a>
  </SectionBlock>

  {/* ───────── 4. FEATURE DEEP-DIVE ───────── */}
  <SectionBlock
    id="ug-features"
    lockupName={duoLockups.features}
    lockupRole="Click a feature to open its detail"
    tone="deep"
    wide
  >
    <div class="ug-deepdive">
      {pillars.map((pillar) => (
        <div class="ug-pillar-group" id={`ug-pillar-${pillar.id}`}>
          <div class="ug-pillar-group__head">
            <h3 class="ug-pillar-group__title">
              <span class="ug-pillar-group__num">{pillar.number}</span>
              {pillar.name}
            </h3>
            <button
              class="ug-expand-toggle"
              type="button"
              aria-expanded="false"
              data-pillar={pillar.id}
            >
              <span class="ug-expand-toggle__label">Expand all</span>
            </button>
          </div>
          <div class="ug-features">
            {featuresByPillar(pillar.id).map((f) => (
              <details class="ug-feature" id={`ug-feature-${f.id}`} data-pillar={pillar.id}>
                <summary class="ug-feature__summary">
                  <span class="ug-feature__name">{f.name}</span>
                  <span class="ug-feature__liner">{f.oneLiner}</span>
                  <span class="ug-feature__chev" aria-hidden="true"></span>
                </summary>
                <div class="ug-feature__body">
                  {f.scenarios && f.scenarios.length > 0 ? (
                    <div class="ug-feature-deep">
                      <section class="ug-feature-deep__section">
                        <p class="ug-feature-deep__label">What it is</p>
                        {f.paragraph.split(/\n\n+/).map((para) => (
                          <p class="ug-feature__paragraph">{para}</p>
                        ))}
                      </section>
                      <section class="ug-feature-deep__section">
                        <p class="ug-feature-deep__label">{f.scenariosSubsectionLabel ?? 'Use cases on your property'}</p>
                        <div class="ug-feature-scenarios">
                          {f.scenarios.map((s) => (
                            <div class="ug-feature-scenario">
                              {s.image && (
                                <img
                                  class="ug-feature-scenario__img"
                                  src={s.image}
                                  alt=""
                                  width="640"
                                  height="853"
                                  loading="lazy"
                                  decoding="async"
                                  style={s.imagePosition ? `object-position: ${s.imagePosition}` : undefined}
                                />
                              )}
                              <span class="ug-feature-scenario__scrim" aria-hidden="true"></span>
                              <div class="ug-feature-scenario__copy">
                                <p class="ug-feature-scenario__title">{s.label}</p>
                                <p class="ug-feature-scenario__line">{s.line}</p>
                              </div>
                            </div>
                          ))}
                        </div>
                      </section>
                      {f.limits && f.limits.length > 0 && (
                        <section class="ug-feature-deep__section">
                          <p class="ug-feature-deep__label">Limits &amp; controls</p>
                          <ul class="ug-feature-limits" role="list">
                            {f.limits.map((l) => (
                              <li>{l}</li>
                            ))}
                          </ul>
                        </section>
                      )}
                      {/* Media slot — reserved at bottom of open detail (after limits, adjacent to IT jump).
                          Hidden while media.kind === 'placeholder'. A future real media kind renders
                          here in .ug-feature-media. NOT a Thesis 3 sticky side rail. */}
                      {f.media && f.media.kind !== 'placeholder' && (
                        <div class="ug-feature-media" data-feature-media-kind={f.media.kind}>
                          {/* future real media kind renders here at bottom */}
                        </div>
                      )}
                      {f.technicalJumpId && (
                        <a class="ug-feature-itlink" href={`#ug-tech-item-${f.technicalJumpId}`}>
                          Technical detail &rarr;
                        </a>
                      )}
                    </div>
                  ) : (
                    <>
                      <p class="ug-feature__paragraph">{f.paragraph}</p>
                      <ul class="ug-feature__benefits" role="list">
                        {f.benefits.map((b) => (
                          <li>{b}</li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </SectionBlock>


  {/* ───────── 6. TECHNICAL DETAIL ───────── */}
  <SectionBlock
    id="ug-technical"
    lockupName={duoLockups.technical}
    lockupRole="For the IT or A/V lead"
    tone="light"
    wide
  >
    <p class="ug-thesis">{technical.intro}</p>
    <div class="ug-technical">
      {technical.groups.map((group) => (
        <div class="ug-tech-group" id={`ug-tech-${group.id}`}>
          <h3 class="ug-tech-group__title">{group.heading}</h3>
          <p class="ug-tech-group__intro">{group.intro}</p>
          <div class="ug-tech-items">
            {group.items.map((item) => (
              <details class="ug-tech-item" id={`ug-tech-item-${item.id}`}>
                <summary class="ug-tech-item__summary">
                  <span class="ug-tech-item__name">{item.name}</span>
                  {item.summary && <span class="ug-tech-item__summary-text">{item.summary}</span>}
                  <span class="ug-feature__chev" aria-hidden="true"></span>
                </summary>
                <ul class="ug-tech-item__details" role="list">
                  {item.details.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </SectionBlock>

  {/* ───────── 7. UPGRADE PATH ───────── */}
  <SectionBlock
    id="ug-upgrade"
    lockupName={duoLockups.upgrade}
    lockupRole="For existing LUCI clients"
    tone="light"
    wide
  >
    <p class="ug-thesis">{upgradePath.intro}</p>

    <div class="ug-upgrade">
      <div class="ug-upgrade__timing" role="group" aria-label="Upgrade timing">
        <div class="ug-upgrade__timing-cell">
          <span class="ug-upgrade__timing-label">{upgradePath.timing.releaseLabel}</span>
          <span class="ug-upgrade__timing-value ug-upgrade__timing-value--date">{upgradePath.timing.releaseDate}</span>
        </div>
        <div class="ug-upgrade__timing-cell">
          <span class="ug-upgrade__timing-label">Pace</span>
          <span class="ug-upgrade__timing-value">{upgradePath.timing.paceLine}</span>
        </div>
      </div>
      <p class="ug-upgrade__rollout-note">{upgradePath.timing.rolloutNote}</p>

      <div class="ug-upgrade__how">
        <h3 class="ug-upgrade__subhead">{upgradePath.whatIsInvolved.heading}</h3>
        <p class="ug-upgrade__how-intro">{upgradePath.whatIsInvolved.paragraph}</p>
        <ol class="ug-upgrade__steps" role="list">
          {upgradePath.whatIsInvolved.steps.map((s) => (
            <li class="ug-upgrade__step">
              <span class="ug-upgrade__step-num">{s.number}</span>
              <div class="ug-upgrade__step-copy">
                <p class="ug-upgrade__step-title">{s.title}</p>
                <p class="ug-upgrade__step-body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <a class="ug-upgrade__path-cta" href="#ug-cta">
        Talk to your account team about timing
        <span class="ug-upgrade__path-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </SectionBlock>

  {/* ───────── 8. FAQ ───────── */}
  <SectionBlock
    id="ug-faq"
    lockupName={duoLockups.faq}
    lockupRole="Straight answers"
    tone="light"
    wide
  >
    <div class="ug-faq">
      {faq.map((f) => (
        <details class="ug-faq__item">
          <summary class="ug-faq__q">{f.question}</summary>
          <p class="ug-faq__a">{f.answer}</p>
        </details>
      ))}
    </div>
  </SectionBlock>

  {/* ───────── 9. CTA ───────── */}
  <SectionBlock id="ug-cta" lockupName={duoLockups.cta} lockupRole={cta.heading} tone="deep" wide>
    <p class="ug-cta__body">{cta.body}</p>
    <p class="ug-cta__contact">
      <strong>{cta.contact.name}</strong> · {cta.contact.role}<br />
      <a href={`mailto:${cta.contact.email}`}>{cta.contact.email}</a> · {cta.contact.phone}
    </p>
    <div class="ug-cta__actions">
      {cta.actions.map((a) => (
        <a
          class:list={['btn', a.audience === 'prospects' ? 'btn--mint' : 'btn--mint-outline']}
          href={a.href}
        >
          {a.label}
        </a>
      ))}
    </div>
  </SectionBlock>

  {/* ───────── Back-to-top ───────── */}
  <button class="ug-back-to-top" type="button" aria-label="Back to top" data-ug-back-to-top>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15" />
    </svg>
  </button>

  </div>{/* /ug-headers mint wash + pillar none */}

  {/* ───────── Open flags for Jane review (collapsed by default) ───────── */}
  <aside class="ug-flags" aria-label="Open flags for Jane review">
    <details>
      <summary>Open flags for Jane review ({openFlags.length})</summary>
      <ul>
        {openFlags.map((flag) => (
          <li>{flag}</li>
        ))}
      </ul>
    </details>
  </aside>
</BaseLayout>

<style>
  .ug-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Section scroll offset for sticky nav + header */
  #ug-hero, #ug-thesis, #ug-pillars, #ug-features,
  #ug-technical, #ug-upgrade, #ug-faq, #ug-cta {
    scroll-margin-top: 156px;
  }
  @media (max-width: 640px) {
    #ug-hero, #ug-thesis, #ug-pillars, #ug-features,
    #ug-technical, #ug-upgrade, #ug-faq, #ug-cta {
      scroll-margin-top: 132px;
    }
  }

  /* ---------- 1. HERO — dark masthead + mesh ---------- */
  .ug-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #081318;
    color: var(--off-white);
    padding-block: clamp(56px, 9vw, 112px) clamp(40px, 6vw, 72px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .ug-hero__mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Flow C family — mesh + floorplan (with-plan), self-transparent over navy.
       No mix-blend-mode: the asset carries its own transparency; screen would
       blow out the floorplan raster. Scrim handles type legibility.
       Crop restored to pre-zoom/Y-shift (b61bc19): center / cover. Dual-color
       mint date + gold underline kept. */
    background: url('/images/mesh/luci-bg-hero-with-plan-transparent-1920x1080.svg') center / cover no-repeat;
    opacity: 0.82;
  }
  /* Right-column floorplan extension: short heroes match asset width under
     cover, so X-position alone cannot shift plan into the post-text gutter.
     Keep mesh framing locked; pin a plan layer to the right after the copy. */
  .ug-hero__plan {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(64%, 880px);
    z-index: 0;
    pointer-events: none;
    /* Dedicated right-panel crop of the plan texture (dense upper band,
       empty far-edge trimmed). Mesh stays center/cover; this layer only
       extends floorplan into the post-headline column. */
    background: url('/images/mesh/luci-plan-right-panel.png') center top / cover no-repeat;
    opacity: 0.88;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.15) 8%,
      rgba(0, 0, 0, 0.65) 22%,
      #000 38%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.15) 8%,
      rgba(0, 0, 0, 0.65) 22%,
      #000 38%
    );
  }
  .ug-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Radial cloud behind the headline/CTAs — denser than the lines-only pass
       (with-plan is denser), but still a cloud, not an opaque left panel, so
       mesh + floorplan read through on the right. */
    background: radial-gradient(
      ellipse 74% 72% at 36% 44%,
      rgba(7, 15, 20, 0.82) 0%,
      rgba(7, 15, 20, 0.52) 34%,
      rgba(7, 15, 20, 0.20) 60%,
      transparent 86%
    );
  }
  .ug-hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content-wide);
  }
  .ug-hero__eyebrow {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mint);
    margin: 0 0 14px;
  }
  .ug-hero__headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--off-white);
    margin: 0 0 28px;
    max-width: 18ch;
  }
  .ug-hero__accent { color: var(--mint); }
  .ug-hero__release {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 32px;
  }
  .ug-hero__rlabel {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(235, 245, 248, 0.5);
  }
  .ug-hero__date {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--mint);
    position: relative;
    display: inline-block;
    padding-bottom: 10px;
  }
  /* Flow C house dual-color: gold underline/plate under release date
     (mint already carries eyebrow + headline accent + bottom structural bar). */
  .ug-hero__date::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 56px;
    height: 2px;
    background: var(--gold);
  }
  .ug-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ug-hero__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: var(--mint);
    z-index: 1;
  }

  /* ---------- 2. THESIS ---------- */
  .ug-thesis {
    max-width: 64ch;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink);
  }
  .ug-thesis + .ug-thesis {
    margin-top: 1em;
  }

  /* ---------- 3. PILLARS OVERVIEW ---------- */
  .ug-pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2.4vw, 32px);
    max-width: var(--content-wide);
  }
  @media (min-width: 820px) {
    .ug-pillars { grid-template-columns: repeat(3, 1fr); }
  }
  .ug-pillar {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    padding: clamp(20px, 2.4vw, 28px);
    /* Two-pager .p1-pill / .p2-card fills, applied to the whole pillar box
       per .ug-pillar nth-child (not paraphrases). */
  }
  .ug-pillars .ug-pillar:nth-child(1) {
    background: linear-gradient(155deg, #E8EEF2 0%, #F3F6F8 100%);
  }
  .ug-pillars .ug-pillar:nth-child(2) {
    background: linear-gradient(155deg, #EBF9F4 0%, #F4FCF9 100%);
  }
  .ug-pillars .ug-pillar:nth-child(3) {
    background: linear-gradient(155deg, #D4EFE4 0%, #E8F6EF 100%);
  }
  /* ============================================================
     PILLAR TABLE HEADERS — none (locked)
     #ug-pillars: no filled boxes; type + mint hairline;
     large ghost .ug-pillar__num watermarks behind titles for presence.
     ============================================================ */
  .ug-pillar__head {
    background: transparent;
    border-radius: 0;
    padding: 18px 0 14px;
    margin-bottom: 16px;
    position: relative;
    overflow: visible;
    box-shadow: none;
    border-bottom: 1px solid rgba(var(--mint-rgb), 0.28);
  }
  .ug-pillar__num {
    position: absolute;
    top: -6px;
    right: -4px;
    left: auto;
    font-family: var(--font-head);
    font-size: 100px;
    font-weight: 700;
    color: #10232d0d;
    line-height: 1;
    letter-spacing: -3px;
    pointer-events: none;
    user-select: none;
    text-align: right;
  }
  .ug-pillar__name {
    position: relative;
    z-index: 1;
    font-family: var(--font-head);
    font-size: 27px;
    font-weight: 700;
    color: var(--ink-strong);
    line-height: 1.22;
    margin: 0;
  }
  .ug-pillar__name :global(.ug-pillar__ctrl) { color: var(--accent-light); }

  .ug-pillar__summary {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--navy-muted);
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .ug-pillar__pills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ug-pill {
    display: flex;
    flex-direction: column;
    gap: 4px;
    /* Nested pill on a light pillar-fill: translucent white reads on all
       three pillar gradients (cool gray, light mint, deeper mint) without
       inventing new pill copy. Keeps the mint left accent. */
    background: rgba(255, 255, 255, 0.72);
    border-left: 3px solid var(--accent-light);
    border-radius: 8px;
    padding: 14px 16px;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .ug-pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(43, 158, 128, 0.18);
