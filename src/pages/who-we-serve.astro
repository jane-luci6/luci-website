---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import PersonaHeroStage from '../components/PersonaHeroStage.astro';
import TeamsFilmstrip from '../components/teams-redesign/TeamsFilmstrip.astro';
import IndustriesAdaptFlip from '../components/IndustriesAdaptFlip.astro';
import { whoWeServe } from '../data/whoWeServe';
import { site } from '../data/site';

const h = whoWeServe.hero;
---

<BaseLayout title="Who We Serve" description={h.lockupRole} darkHeader>
  <h1 class="wss-sr-only">Who we serve — {h.lockupName}</h1>

  <PersonaHeroStage
    sectionId="wss-hero"
    heroImage="/images/who-we-serve/who-we-serve-hero.jpg"
    heroAlt="A venue operations team at a unified control surface — tablets and screens coordinating a property"
    lockupName={h.lockupName}
    lockupRole={h.lockupRole}
  />

  <SectionBlock
    id="wss-support"
    lockupName={whoWeServe.support.lockupName}
    deck={whoWeServe.support.deck}
    tone="deep"
    wide
    pattern
  >
    <IndustriesAdaptFlip points={whoWeServe.support.points as any} />
  </SectionBlock>

  <SectionBlock
    id="wss-teams"
    lockupName={whoWeServe.personasLockup.lockupName}
    tone="deep"
    wide
  >
    <TeamsFilmstrip variant="cinema" />
  </SectionBlock>

  <SectionBlock id="wss-cta" tone="deep">
    <div class="wss-cta">
      <p class="display-label wss-cta__kicker">Next step</p>
      <h2 class="wss-cta__title" set:html={whoWeServe.ctaTitle} />
      <p class="wss-cta__sub">Your teams are already on the floor. LUCI puts them on the same platform.</p>
      <div class="btn-row">
        <a class="btn btn--mint-outline" href="/contact">{site.ctaPrimary}</a>
        <a class="btn btn--ghost" href="/platform">Explore the platform</a>
      </div>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .wss-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #wss-teams,
  #wss-support,
  #wss-cta {
    scroll-margin-top: 120px;
  }

  /* ---------- CTA — content styles (mesh band + sizing live in global.css) ---------- */
  .wss-cta {
    max-width: 64ch;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .wss-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }
  .wss-cta__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
    max-width: none;
  }
  .wss-cta__title :global(em) {
    font-style: normal;
    color: var(--gold);
  }
  .wss-cta__sub {
    max-width: 52ch;
    margin: 0 0 var(--space-4);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.78);
  }
</style>
