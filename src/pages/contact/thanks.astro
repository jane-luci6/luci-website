---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import { seoPages } from '../../data/seo';
---

<BaseLayout
  title={seoPages['/contact/thanks'].title}
  description={seoPages['/contact/thanks'].description}
  canonicalPath="/contact/thanks"
  noindex
>
  <PageHero
    kicker="Contact"
    title="Message received."
    lead="Someone from the LUCI team will follow up shortly to schedule your demo."
    deep
  />

  <SectionBlock tone="light">
    <p class="measure contact-thanks__body">
      In the meantime, here&rsquo;s more on how LUCI runs a property end to end.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/platform">Explore the platform</a>
      <a class="btn btn--outline" href="/resources/case-studies">See it in action</a>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .contact-thanks__body {
    color: var(--ink);
  }
</style>
