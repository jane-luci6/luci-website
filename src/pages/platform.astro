---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import PlatformChapterNav from '../components/PlatformChapterNav.astro';
import PlatformHeroStage from '../components/PlatformHeroStage.astro';
import PlatformArchitectureStage from '../components/PlatformArchitectureStage.astro';
import PlatformOrbit from '../components/PlatformOrbit.astro';
import { site, oneOffering } from '../data/site';
import { features } from '../data/features';
import { seoPages } from '../data/seo';

const chapters = [
  { id: 'platform-thesis', label: 'Overview' },
  { id: 'what-luci-is', label: 'What LUCI is' },
  { id: 'features', label: 'Capabilities' },
  { id: 'embedded-operation', label: 'Systems' },
  { id: 'platform', label: 'Architecture' },
  { id: 'platform-faq', label: 'FAQ' },
  { id: 'platform-cta', label: 'Next step' },
];

const archCallouts = [
  {
    svg: `<svg viewBox="0 0 24 24" fill="none"><path d="M4 9h16M4 15h16M9 4v16M15 4v16" stroke="#68E3BE" stroke-width="1.5" stroke-opacity="0.55"/><rect x="3" y="3" width="18" height="18" rx="2" stroke="#68E3BE" stroke-width="1.8"/><circle cx="12" cy="12" r="2" fill="#68E3BE" fill-opacity="0.2" stroke="#68E3BE" stroke-width="1.8"/><path d="M12 10V7" stroke="#CEB06E" stroke-width="1.8" stroke-linecap="round"/></svg>`,
    title: 'Standard network',
    body: 'Runs over your existing property network — no parallel infrastructure to build or maintain.',
  },
  {
    svg: `<svg viewBox="0 0 24 24" fill="none"><path d="M9 3v4M15 3v4" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/><rect x="6.5" y="7" width="11" height="6" rx="2" fill="#68E3BE" fill-opacity="0.18" stroke="#68E3BE" stroke-width="1.8"/><path d="M12 13v4M8 21h8" stroke="#68E3BE" stroke-width="1.8" stroke-linecap="round"/><circle cx="18" cy="17" r="1.6" fill="#CEB06E"/></svg>`,
    title: 'Open APIs',
    body: 'Documented, open interfaces integrate the systems and content sources you already run.',
  },
  {
    svg: `<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14" height="17" rx="2" fill="#68E3BE" fill-opacity="0.16" stroke="#68E3BE" stroke-width="1.8"/><path d="M8 8h8M8 12h8M8 16h5" stroke="#68E3BE" stroke-width="1.5" stroke-opacity="0.6"/><circle cx="16" cy="16" r="1.5" fill="#CEB06E"/></svg>`,
    title: 'Minimal head end',
    body: 'One standardized rack replaces racks of single-purpose boxes — less to power and refresh.',
  },
];

const featureImages = [
  '/images/features/feature-map-dashboard.svg',
  '/images/features/feature-open-integration.svg',
  '/images/features/feature-pin-control.svg?v=2',
  '/images/features/feature-monitoring.svg',
  '/images/features/feature-presets.svg',
  '/images/features/feature-automation.svg?v=2',
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'LUCI Orchestration Engine',
  serviceType: 'Enterprise multimedia orchestration',
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  description: seoPages['/platform'].description,
  areaServed: 'US',
};

const faqs = [
  {
    q: 'What is LUCI?',
    a: 'LUCI is the orchestration engine for enterprise multimedia — one interface to control, automate, and execute A/V, signage, and building systems across a property. It runs every display, source, audio zone, and connected system from one platform on standard network infrastructure.',
  },
  {
    q: 'Who does LUCI serve?',
    a: 'LUCI serves leadership, operations, technology, finance, marketing, and facilities teams at casinos, hotels, sports venues, airports, convention centers, and corporate campuses — one platform and one accountable team across every endpoint.',
  },
  {
    q: 'What does LUCI replace?',
    a: 'LUCI doesn\'t replace existing technology; it organizes and orchestrates it. LUCI gives you control of standalone platforms, signage CMSes, external media players, and more from one interface. We do typically enable our clients to remove redundant head-ends, hardware, unnecessary licenses, and vendors because, with LUCI, they are no longer needed.',
  },
  {
    q: 'Does LUCI replace our A/V team?',
    a: 'No. LUCI gives your team one interface to run the property, and an embedded team to support you. Your staff keeps control; LUCI removes the systems and workflows that made their job unnecessarily difficult.',
  },
  {
    q: 'How is LUCI different from a control system?',
    a: 'A control system programs one room. LUCI orchestrates the whole property — every endpoint, zone, and system — over the network you already run, with a team that stays. The unit of work is the property, not the room.',
  },
  {
    q: 'What infrastructure does LUCI need?',
    a: 'Standard network infrastructure you already run. No parallel cabling, no proprietary hardware, and no specialist programming per room. One standardized rack replaces racks of single-purpose boxes.',
  },
  {
    q: 'How do we get started with LUCI?',
    a: 'It starts with a live demo and runs through five steps.',
    steps: [
      { title: 'Demo', body: 'See LUCI running on a property like yours.' },
      { title: 'Discovery', body: 'We learn your systems, zones, and goals.' },
      { title: 'Scope', body: 'We map exactly what to orchestrate.' },
      { title: 'Proposal', body: 'A clear plan, timeline, and price.' },
      { title: 'Decision', body: 'You approve; we mobilize the team.' },
    ],
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={seoPages['/platform'].title}
  description={seoPages['/platform'].description}
  canonicalPath="/platform"
  jsonLd={[serviceLd, faqLd]}
  darkHeader
>
  <h1 class="platform-sr-only">Platform — {site.tagline}</h1>
  <PlatformChapterNav chapters={chapters} />

  <PlatformHeroStage
    lockupName="Platform"
    lockupRole="The Orchestration Engine"
    deck={site.subTagline}
  />

  <SectionBlock
    id="what-luci-is"
    lockupName="What LUCI is"
    lockupRole="Two forces working as one"
    deck={oneOffering.summary}
    tone="deep"
    wide
  >
    <figure class="diagram-block diagram-block--parent diagram-reveal">
      <img
        src="/images/diagrams/luci-what-luci-is.dark.svg?v=1"
        alt="What LUCI is: LUCI, the orchestration platform — one A/V equipment rack plus the control platform on any device — plus Systems, the embedded operation that runs it."
        width="560"
        height="300"
        loading="eager"
        decoding="async"
      />
    </figure>
  </SectionBlock>

  <SectionBlock
    id="features"
    kicker="01 · The platform"
    lockupName="LUCI"
    lockupRole="The Orchestration Platform"
    deck="Every capability below lives inside one interface — standard across every property on the platform, regardless of the systems behind it."
    tone="mid"
    wide
  >
    <ul class="feature-grid" role="list">
      {features.map((f, i) => (
        <li class="feature-card" style={`--i:${i}`}>
          <div class="feature-card__inner" data-tilt>
            <div class="feature-card__media">
              <img src={featureImages[i]} alt={f.title} width="320" height="180" loading="lazy" decoding="async" />
            </div>
            <div class="feature-card__copy">
              <p class="feature-card__title">{f.title}</p>
              <p class="feature-card__body">{f.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </SectionBlock>

  <SectionBlock
    id="embedded-operation"
    kicker="02 · The embedded team"
    lockupName="Systems"
    lockupRole="The Embedded Operation"
    deck="One accountable team gets you live, then stays — operating and refining LUCI for the life of the relationship."
    tone="deep"
    wide
  >
    <PlatformOrbit />
  </SectionBlock>

  <SectionBlock
    id="platform"
    lockupName="How LUCI connects"
    lockupRole="The System Architecture"
    deck="Orchestrated from one standardized rack, over the network you already run, operable from any browser."
    tone="sand"
    wide
  >
    <PlatformArchitectureStage />
    <ul class="callout-grid">
      {archCallouts.map((c) => (
        <li class="callout">
          <span class="callout__icon" aria-hidden="true" set:html={c.svg} />
          <div>
            <p class="callout__title">{c.title}</p>
            <p class="callout__body">{c.body}</p>
          </div>
        </li>
      ))}
    </ul>
    <a class="platform-arch-link" href="/integrations">See all integrations <span aria-hidden="true">→</span></a>
  </SectionBlock>

  <SectionBlock
    id="platform-faq"
    lockupName="Questions"
    lockupRole="Straight answers"
    deck="What leadership, operations, and technology teams ask before they bring LUCI onto a property."
    tone="deep"
    wide
  >
    <div class="faq">
      {faqs.map((f) => (
    <details class="faq__item">
      <summary class="faq__q">{f.q}</summary>
      <p class="faq__a">{f.a}</p>
      {f.steps && (
        <ol class="faq__steps">
          {f.steps.map((s) => (
            <li class="faq__step">
              <div class="faq__step-copy">
                <p class="faq__step-title">{s.title}</p>
                <p class="faq__step-body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      )}
    </details>
      ))}
    </div>
  </SectionBlock>

  <SectionBlock id="platform-cta" tone="deep">
    <div class="platform-cta">
      <p class="display-label platform-cta__kicker">Next step</p>
      <h2 class="platform-cta__title">See LUCI on <em>your floor</em>.</h2>
      <p class="platform-cta__deck">Let us show you what LUCI looks like on a property like yours.</p>
      <a class="btn btn--mint-outline platform-cta__btn" href="/contact">{site.ctaPrimary}</a>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .platform-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #platform-thesis,
  #what-luci-is,
  #features,
  #embedded-operation,
  #platform,
  #platform-faq,
  #platform-cta {
    scroll-margin-top: 156px;
  }

  @media (max-width: 640px) {
    #platform-thesis,
    #what-luci-is,
    #features,
    #embedded-operation,
    #platform,
    #platform-faq,
    #platform-cta {
      scroll-margin-top: 132px;
    }
  }

  /* ---------- What LUCI is (deep, wide) — scene entry ---------- */
  #what-luci-is {
    padding-block: clamp(32px, 5vw, 64px) clamp(48px, 8vw, 96px);
  }
  .diagram-block--parent {
    width: 100%;
    max-width: 860px;
  }
  .diagram-block--parent img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Architecture callouts (sand) ---------- */
  .platform-arch-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-5);
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--accent-light);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }
  .platform-arch-link:hover {
    gap: 10px;
    color: var(--mint);
  }
  .callout-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-5);
    max-width: var(--content-wide);
  }
  @media (min-width: 760px) {
    .callout-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .callout {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    align-items: start;
    padding: var(--space-3);
    background: linear-gradient(155deg, #E6F5EF 0%, #F3FAF8 100%);
    box-shadow: inset 0 0 0 1px rgba(43, 158, 128, 0.14);
  }
  .callout__icon {
    display: flex;
  }
  .callout__icon :global(svg) {
    width: 30px;
    height: 30px;
    display: block;
  }
  .callout__title {
    font-weight: 700;
    color: var(--ink-strong);
    font-size: 16px;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .callout__body {
    color: var(--navy-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  /* ---------- FAQ (deep) — de-boxed stacked Q&A ---------- */
  .faq {
    max-width: 760px;
  }
  .faq__item {
    border-bottom: 1px solid rgba(104, 227, 190, 0.16);
  }
  .faq__item:first-child {
    border-top: 1px solid rgba(104, 227, 190, 0.16);
  }
  .faq__q {
    list-style: none;
    cursor: pointer;
    padding: clamp(18px, 2.4vw, 26px) 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--off-white);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after {
    content: '+';
    flex: none;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 22px;
    line-height: 1;
    color: var(--mint);
  }
  .faq__item[open] .faq__q::after { content: '\2212'; }
  .faq__a {
    margin: 0 0 clamp(18px, 2.4vw, 26px);
    max-width: 64ch;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: rgba(245, 248, 250, 0.78);
  }

  /* ---------- Get-started step list (deep) ---------- */
  .faq__steps {
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 4px 0 8px;
    padding: 0;
    counter-reset: step;
  }
  .faq__steps::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: rgba(104, 227, 190, 0.3);
  }
  .faq__step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    counter-increment: step;
  }
  .faq__step::before {
    content: counter(step);
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    border: 1px solid rgba(104, 227, 190, 0.55);
    background: var(--navy);
    color: var(--mint);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 13px;
    z-index: 1;
  }
  .faq__step-copy { padding-top: 2px; }
  .faq__step-title {
    margin: 0 0 2px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--off-white);
  }
  .faq__step-body {
    margin: 0;
    max-width: 44ch;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.72);
  }
  @media (min-width: 760px) {
    .faq__steps {
      flex-direction: row;
      gap: clamp(10px, 1.4vw, 18px);
    }
    .faq__steps::before {
      left: 14px;
      right: 14px;
      top: 14px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .faq__step {
      flex: 1 1 0;
      min-width: 0;
      flex-direction: column;
      align-items: flex-start;
    }
    .faq__step-copy { padding-top: 12px; }
    .faq__step-body { max-width: none; }
  }

  /* ---------- Diagram reveal (deep) ---------- */
  .diagram-reveal {
    opacity: 0;
    transform: translateY(14px) scale(0.985);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .diagram-reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ---------- Features (deep) ---------- */
  #features {
    position: relative;
    overflow: hidden;
  }
  /* Drifting mint aurora — depth without noise. */
  #features::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 140%;
    background:
      radial-gradient(40% 30% at 18% 22%, rgba(104, 227, 190, 0.1), transparent 70%),
      radial-gradient(38% 28% at 82% 78%, rgba(206, 176, 110, 0.07), transparent 70%);
    filter: blur(22px);
    pointer-events: none;
    z-index: 0;
    animation: feature-aurora 18s ease-in-out infinite alternate;
  }
  @keyframes feature-aurora {
    0% { transform: translate3d(-2%, 0, 0); }
    100% { transform: translate3d(2%, 1%, 0); }
  }
  #features > .container { position: relative; z-index: 1; }
  .feature-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2.4vw, 32px);
    max-width: var(--content-wide);
  }
  @media (min-width: 620px) {
    .feature-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1040px) {
    .feature-grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* Cell carries the scroll-bloom (opacity + translate) + supplies the 3D
     perspective for the inner's tilt. */
  .feature-card {
    perspective: 900px;
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .feature-card.is-in {
    opacity: 1;
    transform: none;
  }
  /* Inner carries the 3D tilt (JS owns transform here). */
  .feature-card__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: linear-gradient(180deg, rgba(104, 227, 190, 0.06), rgba(104, 227, 190, 0.02));
    border: 1px solid rgba(104, 227, 190, 0.14);
    border-radius: 16px;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: transform 0.2s ease-out, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .feature-card__inner:hover {
    border-color: rgba(104, 227, 190, 0.34);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.34);
  }
  .feature-card__media {
    aspect-ratio: 320 / 180;
    background: #0A1A24;
    border-bottom: 1px solid rgba(104, 227, 190, 0.14);
    transform: translateZ(40px);
  }
  .feature-card__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .feature-card__copy {
    padding: clamp(18px, 2vw, 24px);
    transform: translateZ(20px);
  }
  .feature-card__title {
    font-weight: 700;
    color: var(--off-white);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .feature-card__body {
    color: rgba(245, 248, 250, 0.78);
    font-size: 14px;
    line-height: 1.55;
  }

  /* ---------- End CTA (deep) ---------- */
  :global(#platform-cta.section) {
    border-top: 2px solid var(--mint);
    padding-block: clamp(36px, 5vw, 48px);
  }
  .platform-cta {
    max-width: 64ch;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .platform-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }
  .platform-cta__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
  }
  .platform-cta__title :global(em) {
    font-style: normal;
    color: var(--gold);
  }
  .platform-cta__deck {
    max-width: 52ch;
    margin: 0 0 var(--space-4);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.78);
  }
  .platform-cta__btn {
    margin-top: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-reveal,
    .feature-card {
      transition: none;
      opacity: 1;
      transform: none;
    }
    #features::before { animation: none; }
  }
</style>

<style is:global>
  /* ============================================================
     Mesh/floorplan wash for the 1st & 3rd content sections (What
     LUCI is, Systems) — replaces the circuit `pattern` so the page
     owns one texture language. Both sections now share the deep
     navy tone, so the veil + mesh opacity are unified. Mesh reads
     only at the left/right margins. Matches the about.astro
     worldview treatment.
     ============================================================ */
  #what-luci-is.section,
  #embedded-operation.section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  #what-luci-is.section::before,
  #embedded-operation.section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-1920x1080.svg?v=1') center / cover no-repeat;
    mix-blend-mode: screen;
    opacity: 0.7;
  }
  #what-luci-is.section::after,
  #embedded-operation.section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(16, 35, 45, 0.86) 16%,
      rgba(16, 35, 45, 0.86) 84%,
      transparent 100%
    );
  }
  #what-luci-is.section > .container,
  #embedded-operation.section > .container {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 720px) {
    #what-luci-is.section::before,
    #embedded-operation.section::before { opacity: 0.45; }
    #what-luci-is.section::after,
    #embedded-operation.section::after {
      background: linear-gradient(
        90deg,
        rgba(16, 35, 45, 0.55) 0%,
        rgba(16, 35, 45, 0.9) 18%,
        rgba(16, 35, 45, 0.9) 82%,
        rgba(16, 35, 45, 0.55) 100%
      );
    }
  }
</style>

<noscript>
  <style>
    .diagram-reveal,
    .feature-card {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<script>
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = window.matchMedia('(hover: hover)').matches && !prefersReduce;

  // Scroll bloom — fade + rise the diagram and each feature cell on enter.
  const bloomTargets = document.querySelectorAll<HTMLElement>('.diagram-reveal, .feature-card');
  if (prefersReduce || !('IntersectionObserver' in window)) {
    bloomTargets.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const i = Number(el.style.getPropertyValue('--i') || '0');
          el.style.transitionDelay = `${Math.min(i, 5) * 80}ms`;
          el.classList.add('is-in');
          io.unobserve(el);
        });
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
    );
    bloomTargets.forEach((el) => io.observe(el));
  }

  // Subtle 3D tilt on feature cards (pointer-follow parallax).
  if (canHover) {
    const MAX = 6;
    const cards = document.querySelectorAll<HTMLElement>('[data-tilt]');
    cards.forEach((card) => {
      let raf = 0;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          card.style.transform =
            `rotateX(${(-py * MAX).toFixed(2)}deg) rotateY(${(px * MAX).toFixed(2)}deg)`;
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        card.style.transform = '';
      });
    });
  }
</script>
