---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MeshHero from '../../components/MeshHero.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import ResourceCardGrid from '../../components/ResourceCardGrid.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import { getCollection } from 'astro:content';
import { seoPages, breadcrumb } from '../../data/seo';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateLabel = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoPages['/blog'].title}
  description={seoPages['/blog'].description}
  canonicalPath="/blog"
  jsonLd={breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ])}
  darkHeader
>
  <MeshHero
    id="blog-hero"
    kicker="The LUCI blog"
    title="Blog"
    deck="Variable reduction, platform depth, and field learnings."
    label="LUCI blog"
  />

  <SectionBlock id="blog-index" lockupName="Latest articles" tone="white" wide>
    {posts.length > 0 ? (
      <ResourceCardGrid>
        {posts.map((post) => {
          const href = `/blog/${post.id}/`;
          const hasHero = Boolean(post.data.heroImage);
          return (
            <ResourceCard
              href={href}
              title={post.data.title}
              dek={post.data.description}
              cta="Read the article"
              imageSrc={hasHero ? post.data.heroImage : undefined}
              imageAlt={hasHero ? (post.data.heroAlt ?? `${post.data.title} hero image`) : undefined}
              logoSrc={hasHero ? undefined : '/images/logos/luci-full-mintmark-white.png'}
              logoAlt={hasHero ? undefined : 'LUCI'}
              meta={dateLabel(post.data.pubDate)}
            />
          );
        })}
      </ResourceCardGrid>
    ) : (
      <p class="scaffold-note">No posts yet.</p>
    )}
  </SectionBlock>
</BaseLayout>

<style>
  :global(#blog-hero > .container.container--wide),
  :global(#blog-index > .container.container--wide) {
    max-width: 1360px;
  }
</style>
