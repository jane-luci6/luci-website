---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import PersonaHeroStage from '../../components/PersonaHeroStage.astro';
import IndustriesAdaptFlip from '../../components/IndustriesAdaptFlip.astro';
import IndustriesBento from '../../components/IndustriesBento.astro';
import { industriesHub } from '../../data/industriesHub';
import { site } from '../../data/site';
---

<BaseLayout title="Industries" description={industriesHub.deck} darkHeader>
  <h1 class="ind-hub-sr-only">Industries — {industriesHub.lockupName}</h1>

  <PersonaHeroStage
    sectionId="industries-overview"
    heroImage="/images/industries/industries-hero.jpg"
    heroAlt="A venue property at a glance — screens, signage, and a unified control surface spanning the floor"
    lockupName={industriesHub.lockupName}
    lockupRole={industriesHub.lockupRole}
    deck={industriesHub.deck}
  />

  <SectionBlock
    lockupName={industriesHub.adaptLockupName}
    tone="deep"
    wide
    pattern
  >
    <IndustriesAdaptFlip />
  </SectionBlock>

  <section class="ind-hub-bento" aria-labelledby="ind-hub-explore-title">
    <div class="ind-hub-bento__inner container container--wide">
      <div class="header-lockup is-in" data-reveal>
        <h2 id="ind-hub-explore-title" class="header-lockup__name">{industriesHub.exploreLockupName}</h2>
      </div>
      <IndustriesBento />
    </div>
  </section>

  <SectionBlock id="industries-cta" tone="deep">
    <div class="ind-hub-cta">
      <p class="display-label ind-hub-cta__kicker">Next step</p>
      <h2 class="ind-hub-cta__title" set:html={industriesHub.ctaTitle} />
      <div class="btn-row">
        <a class="btn btn--mint-outline" href="/contact">{site.ctaPrimary}</a>
        <a class="btn btn--ghost" href="/platform">Explore the platform</a>
      </div>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .ind-hub-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #industries-overview {
    padding-block: clamp(32px, 5vw, 64px) clamp(48px, 8vw, 96px);
  }

  /* Bento stage — plain dark band (pattern reserved for the first section only). */
  .ind-hub-bento {
    position: relative;
    background: var(--navy-mid);
    color: var(--off-white);
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ind-hub-bento__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(56px, 8vw, 88px);
  }

  /* Lockup styles mirrored from SectionBlock for the bento band. */
  .ind-hub-bento .header-lockup {
    display: block;
    margin-bottom: var(--space-5);
  }

  .ind-hub-bento .header-lockup__name {
    font-family: var(--font-head);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin: 0;
  }

  .ind-hub-bento .header-lockup__rule {
    display: block;
    width: 40px;
    height: 3px;
    margin: 14px 0 12px;
    background: var(--mint);
    border-radius: 2px;
  }

  .ind-hub-bento .header-lockup__role {
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 1.35;
    color: var(--mint);
    margin: 0;
  }

  .ind-hub-cta {
    max-width: 64ch;
    padding-block: clamp(24px, 4vw, 40px);
  }

  .ind-hub-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }

  .ind-hub-cta__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
    max-width: none;
  }
  .ind-hub-cta__title :global(em) {
    font-style: normal;
    color: var(--gold);
  }
</style>
