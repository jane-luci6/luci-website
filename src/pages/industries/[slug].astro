---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import PlatformChapterNav from '../../components/PlatformChapterNav.astro';
import IndustryHeroStage from '../../components/IndustryHeroStage.astro';
import IndustryChallenges from '../../components/IndustryChallenges.astro';
import IndustryProblemSolution from '../../components/IndustryProblemSolution.astro';
import IndustryBeforeAfter from '../../components/IndustryBeforeAfter.astro';
import CasinoFloorplan from '../../components/CasinoFloorplan.astro';
import CasinoTicker from '../../components/CasinoTicker.astro';
import IndustryAutomationShowcase from '../../components/IndustryAutomationShowcase.astro';
import IndustryCapabilityCards from '../../components/IndustryCapabilityCards.astro';
import HomeProof from '../../components/HomeProof.astro';
import { industries } from '../../data/industries';
import { getIndustryDetail } from '../../data/industryDetails';
import { pillars } from '../../data/pillars';
import { ameristarCaseStudy, site } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
if (!industry) return Astro.redirect('/404');

const detail = getIndustryDetail(industry.slug);
---

<BaseLayout
  title={industry.name}
  description={detail?.thesis.deck ?? industry.teaser}
  darkHeader={!!detail}
>
  {detail ? (
    <div data-page={industry.slug}>
      <h1 class="ind-page-sr-only">{industry.name} — {detail.thesis.lockupRole}</h1>
      <PlatformChapterNav chapters={detail.chapters} contextLabel={industry.name} />

      <IndustryHeroStage
        lockupName={detail.thesis.lockupName}
        lockupRole={detail.thesis.lockupRole}
        deck={detail.thesis.deck}
        videoSrc={detail.heroVideo}
        posterSrc={detail.heroPoster}
        imageSrc={detail.heroImage}
      />

      {industry.slug === 'casinos-gaming' && <CasinoTicker />}

      {industry.slug === 'casinos-gaming' && (
        <SectionBlock
          id="industry-floorplan"
          lockupName="Create purposeful moments that <em>drive spend</em>"
          lockupRole="The business beyond the floor"
          deck="Gaming isn't the whole business anymore — non-gaming amenities drive the revenue, and your multimedia is what moves guests toward them. Set the tone at arrival, drive the floor, and celebrate the jackpot the instant it hits."
          tone="deep"
          wide
        >
          <div class="ind-fp-wrap">
            <CasinoFloorplan />
          </div>
        </SectionBlock>
      )}

      {industry.slug === 'casinos-gaming' ? (
        <SectionBlock
          id="industry-before-after"
          lockupName="What LUCI <em>changes</em>"
          lockupRole="Each problem, paired with its fix"
          tone="deep"
          wide
          pattern
        >
          <IndustryBeforeAfter challenges={detail.challenges} solutions={detail.solutions} />
        </SectionBlock>
      ) : (
        <>
          <SectionBlock
            id="industry-challenges"
            lockupName={detail.challengesLockup.lockupName}
            tone="deep"
            wide
            pattern
          >
            <IndustryChallenges challenges={detail.challenges} />
          </SectionBlock>

          <SectionBlock
            id="industry-solutions"
            lockupName={detail.solutionsLockup.lockupName}
            tone="deep"
            wide
          >
            <IndustryProblemSolution solutions={detail.solutions} />
          </SectionBlock>
        </>
      )}

      <HomeProof />

      <SectionBlock
        id="industry-automation"
        lockupName={detail.automationLockup.lockupName}
        lockupRole={detail.automationLockup.lockupRole}
        tone="deep"
        wide
      >
        {industry.slug === 'casinos-gaming' ? (
          <IndustryCapabilityCards automations={detail.automations} />
        ) : (
          <IndustryAutomationShowcase automations={detail.automations} />
        )}
      </SectionBlock>

      <SectionBlock id="industry-cta" tone="deep">
        <div class="ind-page-cta">
          <p class="display-label ind-page-cta__kicker">Next step</p>
          <h2 class="ind-page-cta__title" set:html={detail.ctaTitle} />
          <a class="btn btn--mint-outline ind-page-cta__btn" href="/contact">{site.ctaPrimary}</a>
        </div>
      </SectionBlock>
    </div>
  ) : (
    <>
      <PageHero title={industry.name} lead={industry.teaser} deep />

      <SectionBlock lockupName="Vertical challenges">
        <p class="measure scaffold-note">Vertical-specific pain points — TBD per industry</p>
      </SectionBlock>

      <SectionBlock lockupName="How LUCI fits" tone="sand">
        <p class="rows__title">{pillars[2].title}</p>
        <p class="measure" style="margin-top: 0.5rem">{pillars[2].body}</p>
      </SectionBlock>

      <SectionBlock lockupName="Proof">
        <div class="callout">
          <p class="rows__title">{ameristarCaseStudy.title}</p>
          <p>{ameristarCaseStudy.dek}</p>
        </div>
        <div class="visual-placeholder" style="margin-top: 1.5rem">Vertical logo subset</div>
      </SectionBlock>

      <SectionBlock tone="deep">
        <a class="btn btn--mint-outline" href="/contact">{site.ctaPrimary}</a>
      </SectionBlock>
    </>
  )}
</BaseLayout>

<style>
  .ind-page-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #industry-thesis,
  #industry-challenges,
  #industry-solutions,
  #industry-automation,
  #industry-cta {
    scroll-margin-top: 156px;
  }

  #industry-floorplan {
    scroll-margin-top: 156px;
  }

  /* Constrain the portrait floorplan + callouts inside the wide section.
     Wide enough that the 16%-width callout plates sit in the side gutters
     (outside the floorplan drawing) without overlapping it. */
  .ind-fp-wrap {
    max-width: 1280px;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    #industry-thesis,
    #industry-challenges,
    #industry-solutions,
    #industry-automation,
    #industry-cta {
      scroll-margin-top: 132px;
    }
  }

  #industry-challenges,
  #industry-solutions {
    padding-block: clamp(48px, 8vw, 96px);
  }

  :global(#industry-cta.section) {
    border-top: 2px solid var(--mint);
    padding-block: clamp(36px, 5vw, 48px);
  }
  .ind-page-cta {
    max-width: 64ch;
    padding-block: clamp(24px, 4vw, 40px);
  }

  .ind-page-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }

  .ind-page-cta__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
  }
  .ind-page-cta__title :global(em) {
    font-style: normal;
    color: var(--gold);
  }
  .ind-page-cta__btn {
    margin-top: 0;
  }
</style>

<style is:global>
  /* ============================================================
     Casino page — mesh line-work underlay on three sections.
     Transparent mesh SVGs screen-blended onto each section's own
     navy background, with a soft mask + navy pocket so the line
     work reads at the edges and drops out behind text. Scoped to
     the casino page via [data-page="casinos-gaming"].
     ============================================================ */

  /* Floorplan section — extend the mesh beyond the aurora box */
  [data-page="casinos-gaming"] #industry-floorplan.section {
    position: relative;
    isolation: isolate;
  }
  [data-page="casinos-gaming"] #industry-floorplan.section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-mesh-lines-1920x1080.svg') center / cover no-repeat;
    mix-blend-mode: screen;
    opacity: 0.42;
    /* Clear behind the header lockup (upper-center); line work reads in the side gutters + below the box */
    -webkit-mask-image: radial-gradient(
      ellipse 62% 46% at 50% 26%,
      transparent 0%,
      rgba(0, 0, 0, 0.22) 34%,
      rgba(0, 0, 0, 0.6) 58%,
      #000 80%
    );
    mask-image: radial-gradient(
      ellipse 62% 46% at 50% 26%,
      transparent 0%,
      rgba(0, 0, 0, 0.22) 34%,
      rgba(0, 0, 0, 0.6) 58%,
      #000 80%
    );
  }
  [data-page="casinos-gaming"] #industry-floorplan > .container {
    position: relative;
    z-index: 1;
  }

  /* Case study callout (HomeProof) — mesh lines, faded behind the copy */
  [data-page="casinos-gaming"] .home-proof-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  [data-page="casinos-gaming"] .home-proof-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-mesh-lines-1920x1080.svg') center / cover no-repeat;
    mix-blend-mode: screen;
    opacity: 0.4;
    -webkit-mask-image: radial-gradient(
      ellipse 70% 90% at 48% 50%,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 35%,
      rgba(0, 0, 0, 0.65) 62%,
      #000 85%
    );
    mask-image: radial-gradient(
      ellipse 70% 90% at 48% 50%,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 35%,
      rgba(0, 0, 0, 0.65) 62%,
      #000 85%
    );
  }
  [data-page="casinos-gaming"] .home-proof-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 72% 95% at 48% 50%,
      rgba(7, 15, 20, 0.72) 0%,
      rgba(7, 15, 20, 0.45) 40%,
      rgba(7, 15, 20, 0.18) 65%,
      transparent 85%
    );
  }
  [data-page="casinos-gaming"] .home-proof-band__inner {
    position: relative;
    z-index: 1;
  }

  /* CTA — wide mesh band, faded behind the centered content */
  [data-page="casinos-gaming"] #industry-cta.section {
    position: relative;
    isolation: isolate;
  }
  [data-page="casinos-gaming"] #industry-cta.section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-wide-2560x800.svg') center / cover no-repeat;
    mix-blend-mode: screen;
    opacity: 0.6;
  }
  [data-page="casinos-gaming"] #industry-cta.section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(7, 15, 20, 0.65) 30%, rgba(7, 15, 20, 0.65) 44%, transparent 90%);
  }
  [data-page="casinos-gaming"] #industry-cta > .container {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 720px) {
    [data-page="casinos-gaming"] #industry-cta.section::after {
      background: linear-gradient(180deg, transparent 0%, rgba(7, 15, 20, 0.65) 34%, rgba(7, 15, 20, 0.65) 60%, transparent 100%);
    }
  }
</style>
