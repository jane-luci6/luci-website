---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import PlatformChapterNav from '../../components/PlatformChapterNav.astro';
import IndustryHeroStage from '../../components/IndustryHeroStage.astro';
import IndustryChallenges from '../../components/IndustryChallenges.astro';
import IndustryProblemSolution from '../../components/IndustryProblemSolution.astro';
import IndustryBeforeAfter from '../../components/IndustryBeforeAfter.astro';
import IndustryFloorplan from '../../components/IndustryFloorplan.astro';
import IndustryTicker from '../../components/IndustryTicker.astro';
import IndustryAutomationShowcase from '../../components/IndustryAutomationShowcase.astro';
import IndustryCapabilityCards from '../../components/IndustryCapabilityCards.astro';
import HomeProof from '../../components/HomeProof.astro';
import IndustryFagCallout from '../../components/IndustryFagCallout.astro';
import { industries } from '../../data/industries';
import { getIndustryDetail } from '../../data/industryDetails';
import { pillars } from '../../data/pillars';
import { ameristarCaseStudy, site } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
if (!industry) return Astro.redirect('/404');

const detail = getIndustryDetail(industry.slug);
const hasFloorplan = !!(detail && detail.floorplan && detail.floorplanLockup);
---

<BaseLayout
  title={industry.name}
  description={detail?.thesis.deck ?? industry.teaser}
  darkHeader={!!detail}
>
  {detail ? (
    <div data-page={industry.slug}>
      <h1 class="ind-page-sr-only">{industry.name} — {detail.thesis.lockupRole}</h1>
      <PlatformChapterNav chapters={detail.chapters} contextLabel={industry.name} />

      <IndustryHeroStage
        lockupName={detail.thesis.lockupName}
        lockupRole={detail.thesis.lockupRole}
        deck={detail.thesis.deck}
        videoSrc={detail.heroVideo}
        posterSrc={detail.heroPoster}
        imageSrc={detail.heroImage}
      />

      {hasFloorplan && detail!.tickerLocations && (
        <IndustryTicker locations={detail!.tickerLocations} ariaLabel={`${industry.name} zones LUCI orchestrates`} />
      )}

      {hasFloorplan && (
        <SectionBlock
          id="industry-floorplan"
          lockupName={detail!.floorplanLockup!.lockupName}
          lockupRole={detail!.floorplanLockup!.lockupRole}
          deck={detail!.floorplanLockup!.deck}
          tone="deep"
          wide
        >
          <div class="ind-fp-wrap">
            <IndustryFloorplan
              image={detail!.floorplan!.image}
              imageAlt={detail!.floorplan!.imageAlt}
              imageWidth={detail!.floorplan!.imageWidth}
              imageHeight={detail!.floorplan!.imageHeight}
              imageWidthPct={detail!.floorplan!.imageWidthPct}
              zones={detail!.floorplan!.zones}
              ariaLabel={detail!.floorplan!.ariaLabel}
            />
          </div>
        </SectionBlock>
      )}

      {hasFloorplan ? (
        <SectionBlock
          id="industry-before-after"
          lockupName="What LUCI <em>changes</em>"
          lockupRole="Each problem, paired with its fix"
          tone="deep"
          wide
        >
          <IndustryBeforeAfter challenges={detail.challenges} solutions={detail.solutions} />
        </SectionBlock>
      ) : (
        <>
          <SectionBlock
            id="industry-challenges"
            lockupName={detail.challengesLockup.lockupName}
            tone="deep"
            wide
            pattern
          >
            <IndustryChallenges challenges={detail.challenges} />
          </SectionBlock>

          <SectionBlock
            id="industry-solutions"
            lockupName={detail.solutionsLockup.lockupName}
            tone="deep"
            wide
          >
            <IndustryProblemSolution solutions={detail.solutions} />
          </SectionBlock>
        </>
      )}

      {(industry.slug === 'casinos-gaming' || industry.slug === 'hotels-resorts') && <HomeProof />}

      {!(industry.slug === 'casinos-gaming' || industry.slug === 'hotels-resorts') && hasFloorplan && <IndustryFagCallout />}

      <SectionBlock
        id="industry-automation"
        lockupName={detail.automationLockup.lockupName}
        lockupRole={detail.automationLockup.lockupRole}
        tone="deep"
        wide
      >
        {hasFloorplan ? (
          <IndustryCapabilityCards automations={detail.automations} />
        ) : (
          <IndustryAutomationShowcase automations={detail.automations} />
        )}
      </SectionBlock>

      <SectionBlock id="industry-cta" tone="deep">
        <div class="ind-page-cta">
          <p class="display-label ind-page-cta__kicker">Next step</p>
          <h2 class="ind-page-cta__title" set:html={detail.ctaTitle} />
          <a class="btn btn--mint-outline ind-page-cta__btn" href="/contact">{site.ctaPrimary}</a>
        </div>
      </SectionBlock>
    </div>
  ) : (
    <>
      <PageHero title={industry.name} lead={industry.teaser} deep />

      <SectionBlock lockupName="Vertical challenges">
        <p class="measure scaffold-note">Vertical-specific pain points — TBD per industry</p>
      </SectionBlock>

      <SectionBlock lockupName="How LUCI fits" tone="sand">
        <p class="rows__title">{pillars[2].title}</p>
        <p class="measure" style="margin-top: 0.5rem">{pillars[2].body}</p>
      </SectionBlock>

      <SectionBlock lockupName="Proof">
        <div class="callout">
          <p class="rows__title">{ameristarCaseStudy.title}</p>
          <p>{ameristarCaseStudy.dek}</p>
        </div>
        <div class="visual-placeholder" style="margin-top: 1.5rem">Vertical logo subset</div>
      </SectionBlock>

      <SectionBlock tone="deep">
        <a class="btn btn--mint-outline" href="/contact">{site.ctaPrimary}</a>
      </SectionBlock>
    </>
  )}
</BaseLayout>

<style>
  .ind-page-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #industry-thesis,
  #industry-challenges,
  #industry-solutions,
  #industry-automation,
  #industry-cta {
    scroll-margin-top: 156px;
  }

  #industry-floorplan {
    scroll-margin-top: 156px;
  }

  /* Constrain the portrait floorplan + callouts inside the wide section.
     Wide enough that the 16%-width callout plates sit in the side gutters
     (outside the floorplan drawing) without overlapping it. */
  .ind-fp-wrap {
    max-width: 1280px;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    #industry-thesis,
    #industry-challenges,
    #industry-solutions,
    #industry-automation,
    #industry-cta {
      scroll-margin-top: 132px;
    }
  }

  #industry-challenges,
  #industry-solutions {
    padding-block: clamp(48px, 8vw, 96px);
  }

  :global(#industry-cta.section) {
    border-top: 2px solid var(--mint);
    padding-block: clamp(36px, 5vw, 48px);
  }
  .ind-page-cta {
    max-width: 64ch;
    padding-block: clamp(24px, 4vw, 40px);
  }

  .ind-page-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }

  .ind-page-cta__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
  }
  .ind-page-cta__title :global(em) {
    font-style: normal;
    color: var(--gold);
  }
  .ind-page-cta__btn {
    margin-top: 0;
  }
</style>

<style is:global>
  /* ============================================================
     Industry pages — mesh line-work underlay on the Before/After
     section (What LUCI changes) and the closing CTA (global).
     Before/After uses the horizontal navy veil (the circuit-
     pattern logic) so the mesh reads only at the far left/right
     margins and drops out behind the centered content column.
     The floorplan, case study callout, and Capabilities sections
     stay plain so the mesh never competes with the hero or reads
     busy. Scoped to every industry detail page via [data-page].
     ============================================================ */

  /* Case study callout (HomeProof) — plain navy, no mesh. */
  [data-page] .home-proof-band { position: relative; isolation: isolate; }

  /* Section 2 (Before/After) — mesh lines with the horizontal
     navy veil (the circuit-pattern logic), so the mesh reads
     only at the far left/right margins and drops out behind the
     centered content column. */
  [data-page] #industry-before-after.section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  [data-page] #industry-before-after.section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-1920x1080.png') center / cover no-repeat;
    mix-blend-mode: screen;
    opacity: 0.5;
  }
  [data-page] #industry-before-after.section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(10, 22, 28, 0.86) 16%,
      rgba(10, 22, 28, 0.86) 84%,
      transparent 100%
    );
  }
  @media (max-width: 720px) {
    [data-page] #industry-before-after.section::after {
      background: linear-gradient(
        90deg,
        rgba(10, 22, 28, 0.55) 0%,
        rgba(10, 22, 28, 0.9) 18%,
        rgba(10, 22, 28, 0.9) 82%,
        rgba(10, 22, 28, 0.55) 100%
      );
    }
  }
  [data-page] #industry-before-after > .container {
    position: relative;
    z-index: 1;
  }
</style>
