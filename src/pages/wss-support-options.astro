---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import SupportColumns from '../components/support-redesign/SupportColumns.astro';
import SupportProgression from '../components/support-redesign/SupportProgression.astro';
import SupportDiagram from '../components/support-redesign/SupportDiagram.astro';
import { whoWeServe } from '../data/whoWeServe';

const s = whoWeServe.support;
const pts = s.points as { head: string; detail: string }[];

const variants = [
  { id: 'opt-columns', label: 'A — Always-visible icon columns', C: SupportColumns },
  { id: 'opt-progression', label: 'B — Stepped progression (Map → Schedule → Team)', C: SupportProgression },
  { id: 'opt-diagram', label: 'D — One custom diagram', C: SupportDiagram },
];
---

<BaseLayout title="How LUCI supports — options" description="Flip card visual options" darkHeader>
  <div class="opts">
    <div class="opts__intro container container--wide">
      <p class="display-label">Options</p>
      <h1 class="h1">How LUCI supports — three directions</h1>
      <p class="measure">No flip cards. Each section below carries the circuit pattern background. Pick A, B, or D.</p>
    </div>

    {variants.map((v) => {
      const Cv = v.C;
      return (
        <SectionBlock id={v.id} lockupName={s.lockupName} lockupRole={s.lockupRole} deck={s.deck} tone="deep" wide pattern>
          <p class="opts__tag">{v.label}</p>
          <Cv points={pts} />
        </SectionBlock>
      );
    })}
  </div>
</BaseLayout>

<style>
  .opts__intro {
    padding-block: clamp(48px, 7vw, 80px) clamp(24px, 3vw, 36px);
  }
  .opts__intro .h1 {
    margin: var(--space-2) 0 var(--space-3);
  }
  .opts__intro .measure {
    color: var(--navy-muted);
    max-width: var(--measure);
  }
  .opts__tag {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-deep, #CEB06E);
  }
</style>
