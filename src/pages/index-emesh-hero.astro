---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeDifferentiator from '../components/HomeDifferentiator.astro';
import HomeLedger from '../components/HomeLedger.astro';
import HomeIndustries from '../components/HomeIndustries.astro';
import HomeIntro from '../components/HomeIntro.astro';
import HomeTrustBar from '../components/HomeTrustBar.astro';
import HomeProof from '../components/HomeProof.astro';
import HomePersonas from '../components/HomePersonas.astro';
import HomeResources from '../components/HomeResources.astro';
import HomeWhyItMatters from '../components/HomeWhyItMatters.astro';
import SectionBlock from '../components/SectionBlock.astro';
import { site } from '../data/site';
---

<BaseLayout title="Home — E-mesh Mockup" description={site.subTagline} darkHeader>
  <div class="mockup-banner">
    <span class="mockup-banner__dot"></span>
    <span>Intro energy — compare directions:</span>
    <nav class="mockup-banner__variants" aria-label="Intro variants">
      <a href="?intro=d#home-intro" data-intro="d">D · No header</a>
      <a href="?intro=a#home-intro" data-intro="a">A · Punch + deep navy</a>
      <a href="?intro=b#home-intro" data-intro="b">B · Image-led</a>
      <a href="?intro=c#home-intro" data-intro="c">C · Atmosphere</a>
    </nav>
  </div>

  <HomeHero variant="none" zones />

  <HomeDifferentiator />
  <HomeIntro photoSrc="/images/venue-guest-experience-casual-v2.jpg?v=1" />
  <HomeLedger />
  <HomeWhyItMatters />
  <HomeIndustries />
  <HomeProof />
  <HomePersonas />
  <HomeTrustBar />

  <SectionBlock id="home-cta" tone="deep">
    <div class="home-cta">
      <p class="display-label home-cta__kicker">Next step</p>
      <h2 class="home-cta__title">See LUCI on <em>your floor</em>.</h2>
      <p class="home-cta__deck">Let us show you what LUCI looks like on a property like yours.</p>
      <a class="btn btn--mint-outline home-cta__btn" href="/contact">{site.ctaPrimary}</a>
    </div>
  </SectionBlock>

  <HomeResources />
</BaseLayout>

<style is:global>
  /* ============================================================
     HERO VARIANTS — 3 directions, toggleable via URL hash.
     #a = Subtle network: mesh-only lines/nodes, flipped so the
          dense part sits behind the text, faded. No floorplan.
     #b = Floorplan forward: mesh behind text + floorplan
          texture brought into the lower-right blank area.
     #c = Full flow: full hero SVG (mesh+floorplan) full-bleed,
          composition flows across the whole hero, faded behind text.
     CTA + footer are unchanged from the approved mockup.
     ============================================================ */

  /* Shared hero base — kill the component's mesh bg, use pseudo-elements */
  .home-entry { background: var(--navy-deep) !important; }

  /* All variants: mesh on ::before (screen-blended), fade on ::after */
  .home-entry::before, .home-entry::after {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  }
  .home-entry::after {
    background: linear-gradient(90deg, transparent 0%, rgba(7,15,20,0.65) 30%, rgba(7,15,20,0.65) 44%, transparent 80%);
  }

  /* Variant A — Subtle network (mesh-only, flipped, no floorplan) */
  .home-entry.hero-a::before {
    background: url('/images/mesh/luci-bg-hero-mesh-only-1920x1080.svg') right center / cover no-repeat;
    transform: scaleX(-1);
    mix-blend-mode: screen; opacity: 0.45;
  }

  /* Variant B — Floorplan forward (mesh behind text + floorplan in blank area) */
  .home-entry.hero-b::before {
    background:
      url('/images/mesh/luci-bg-hero-mesh-only-1920x1080.svg') right center / cover no-repeat,
      url('/images/mesh/luci-plan-texture-1920x1080.png') right bottom / 55% auto no-repeat;
    transform: scaleX(-1);
    mix-blend-mode: screen; opacity: 0.5;
  }

  /* Variant C — floorplan texture LEFT only (clipped in SVG); mesh lines
     everywhere. Screen-blend so dark navy stays dark and only the mint
     lines/plan texture lift. Opacity is the single visibility dial —
     raised so we can see the composition with the words; dial back next. */
  .home-entry.hero-c {
    background: var(--navy-deep) !important;
  }
  .home-entry.hero-c::before {
    background: url('/images/mesh/luci-bg-hero-split-1920x1080.svg') center / cover no-repeat;
    mix-blend-mode: screen;
    opacity: 1;
    /* Soften pattern behind the words only — left side keeps texture +
       line work; core is reduced (not erased) so bright strokes ease off. */
    -webkit-mask-image: radial-gradient(
      ellipse 52% 68% at 20% 42%,
      rgba(0,0,0,0.28) 0%,
      rgba(0,0,0,0.45) 35%,
      rgba(0,0,0,0.75) 58%,
      #000 80%
    );
    mask-image: radial-gradient(
      ellipse 52% 68% at 20% 42%,
      rgba(0,0,0,0.28) 0%,
      rgba(0,0,0,0.45) 35%,
      rgba(0,0,0,0.75) 58%,
      #000 80%
    );
  }
  .home-entry.hero-c::after {
    /* Soft navy pocket — readable text, pattern still around the words */
    background: radial-gradient(
      ellipse 55% 70% at 20% 42%,
      rgba(7,15,20,0.78) 0%,
      rgba(7,15,20,0.55) 32%,
      rgba(7,15,20,0.25) 55%,
      transparent 78%
    );
  }

  /* Extra feathered pocket tight to the words */
  .home-entry.hero-c .home-entry__copy {
    isolation: isolate;
  }
  .home-entry.hero-c .home-entry__copy::before {
    content: '';
    position: absolute;
    inset: -56px -72px -48px -48px;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 72% 68% at 38% 42%,
      rgba(7,15,20,0.72) 0%,
      rgba(7,15,20,0.5) 35%,
      rgba(7,15,20,0.2) 58%,
      transparent 82%
    );
  }

  /* Keep glow above mesh, below content */
  .home-entry__glow { z-index: 0; opacity: 0.6; }
  .home-entry__layout { z-index: 1; }

  /* ============================================================
     PAGE MESH — static per-section underlays (not fixed/scrolling).
     Uses mesh-LINES only (transparent SVG — no navy wash baked in),
     so we layer just the line work on each section's own background.
     Interest bands get denser opacity. Fade behind text comes later.
     ============================================================ */

  /* Differentiator — no mesh / no line continuations */
  .home-diff::before,
  .home-diff::after {
    content: none !important;
    background: none !important;
    opacity: 0 !important;
    display: none !important;
  }

  /* ============================================================
     INTRO ENERGY VARIANTS — toggle via ?intro=a|b|c|d
     D = No header — photo continues from “run them all”
     A = Punchy short head + deep navy (stay in the dark ribbon)
     B = Image-led: tiny lockup, photo owns the section
     C = Tightened copy + whisper mesh atmosphere
     ============================================================ */

  /* Default kill flat mid-slate circuit leftovers; variants set surface */
  .home-intro::before {
    content: none;
    display: none;
  }

  /* --- D · Full-bleed photo, overlaid header, scattered cards within margins --- */
  .home-intro.intro-d {
    position: relative;
    isolation: isolate;
    background: var(--navy) !important;
    border-bottom-color: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  body:has(.home-intro.intro-d) .home-diff {
    border-bottom: none !important;
  }
  .home-intro.intro-d::before {
    content: none !important;
    display: none !important;
  }
  /* Header removed from view — kept in DOM for screen readers */
  .home-intro.intro-d .home-intro__header {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
    pointer-events: none !important;
  }
  /* Full-bleed photo — break out of the content container */
  .home-intro.intro-d .home-intro__inner.container {
    position: relative;
    z-index: 1;
    max-width: none !important;
    width: 100% !important;
    padding-inline: 0 !important;
    padding-block: 0 clamp(32px, 5vw, 52px) !important;
  }
  .home-intro.intro-d .home-intro__stage {
    margin-top: 0 !important;
    width: 100%;
  }
  .home-intro.intro-d .home-intro__frame {
    border-radius: 0 !important;
    aspect-ratio: 21 / 9 !important;
    width: 100% !important;
    max-height: 64vh;
  }
  .home-intro.intro-d .home-intro__frame img {
    object-position: center 15% !important;
  }
  /* Side gradients on the photo — fade edges into the section bg, guide eye to center */
  .home-intro.intro-d .home-intro__scrim {
    background:
      linear-gradient(90deg, rgba(10, 22, 28, 0.72) 0%, rgba(10, 22, 28, 0.18) 14%, rgba(10, 22, 28, 0) 26%, rgba(10, 22, 28, 0) 74%, rgba(10, 22, 28, 0.18) 86%, rgba(10, 22, 28, 0.72) 100%) !important,
      linear-gradient(to bottom, rgba(8, 17, 22, 0.55) 0%, rgba(8, 17, 22, 0) 18%, rgba(8, 17, 22, 0) 70%, rgba(8, 17, 22, 0.5) 100%) !important;
  }
  /* Scattered cards within content-wide margins (not at the 2.5% edges).
     Control = top-left, Automate = top-right, Execute = bottom-left (diagonal scatter). */
  .home-intro.intro-d .home-intro__card {
    --bleed-inset: max(var(--page-pad), calc((100% - var(--content-wide)) / 2));
    width: clamp(244px, 26vw, 320px) !important;
    max-width: min(46%, 340px) !important;
    z-index: 3;
  }
  /* Control (top-left) — inline style has "top" */
  .home-intro.intro-d .home-intro__card--left[style*="top"] {
    left: var(--bleed-inset) !important;
    top: 10% !important;
  }
  /* Automate (top-right) */
  .home-intro.intro-d .home-intro__card--right[style*="top"] {
    right: var(--bleed-inset) !important;
    top: 10% !important;
  }
  /* Execute (bottom-left) — inline style has "bottom" */
  .home-intro.intro-d .home-intro__card--left[style*="bottom"] {
    left: var(--bleed-inset) !important;
    top: auto !important;
    bottom: 7% !important;
  }
  /* Hide the server-rendered arrows (calibrated for the 16:11 crop) —
     JS draws a fresh overlay calibrated for the 21:9 crop + scattered cards. */
  .home-intro.intro-d .home-intro__arrows {
    display: none !important;
  }
  .home-intro.intro-d .home-intro__arrows-d {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    filter: drop-shadow(0 0 2px rgba(8, 17, 22, 0.9));
  }
  .home-intro.intro-d .home-intro__arrows-d line {
    stroke: var(--mint);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    opacity: 0.92;
  }
  .home-intro.intro-d .home-intro__arrows-d circle.origin {
    fill: var(--mint);
    stroke: rgba(8, 17, 22, 0.7);
    stroke-width: 0.5;
  }
  .home-intro.intro-d .home-intro__arrows-d circle.target {
    fill: var(--mint);
    stroke: rgba(8, 17, 22, 0.6);
    stroke-width: 0.6;
  }
  .home-intro.intro-d .home-intro__arrows-d .room path {
    fill: none;
    stroke: var(--mint);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    opacity: 0.75;
  }
  .home-intro.intro-d .home-intro__arrows-d .room .room-leader {
    stroke-width: 1.6;
    stroke-dasharray: 4 4;
    opacity: 0.9;
  }
  .home-intro.intro-d .home-intro__actions {
    padding-inline: var(--page-pad);
  }
  .home-intro.intro-d .home-intro__steps {
    padding-inline: var(--page-pad);
  }
  @media (max-width: 760px) {
    .home-intro.intro-d .home-intro__frame {
      aspect-ratio: 16 / 10 !important;
      max-height: none;
    }
  }

  /* --- A · Punch + deep navy --- */
  .home-intro.intro-a {
    background: var(--navy-deep) !important;
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  .home-intro.intro-a .home-intro__inner {
    padding-block: clamp(40px, 6vw, 64px) !important;
  }
  .home-intro.intro-a .home-intro__headline {
    max-width: 18ch !important;
    font-size: clamp(30px, 4.6vw, 48px) !important;
    letter-spacing: -0.03em !important;
  }
  .home-intro.intro-a .home-intro__stage {
    margin-top: clamp(24px, 3vw, 36px) !important;
  }

  /* --- B · Image-led --- */
  .home-intro.intro-b {
    background: var(--navy-deep) !important;
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  .home-intro.intro-b .home-intro__inner {
    padding-block: clamp(32px, 4vw, 48px) !important;
  }
  .home-intro.intro-b .home-intro__header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 0;
  }
  .home-intro.intro-b .home-intro__header::before {
    content: 'One interface';
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .home-intro.intro-b .home-intro__headline {
    max-width: 22ch !important;
    font-size: clamp(22px, 2.8vw, 30px) !important;
    font-weight: 600 !important;
    letter-spacing: -0.02em !important;
    color: rgba(245, 248, 250, 0.88) !important;
  }
  .home-intro.intro-b .home-intro__headline-accent {
    color: var(--gold) !important;
  }
  .home-intro.intro-b .home-intro__stage {
    margin-top: clamp(16px, 2vw, 24px) !important;
  }

  /* --- C · Atmosphere + tightened copy --- */
  .home-intro.intro-c {
    position: relative;
    isolation: isolate;
    background: var(--navy) !important;
    border-bottom-color: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .home-intro.intro-c::before {
    content: '' !important;
    display: block !important;
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-mesh-lines-1920x1080.svg') center / cover no-repeat !important;
    mix-blend-mode: screen !important;
    opacity: 0.32 !important;
    -webkit-mask-image: radial-gradient(
      ellipse 68% 72% at 42% 38%,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 34%,
      rgba(0, 0, 0, 0.6) 58%,
      #000 82%
    );
    mask-image: radial-gradient(
      ellipse 68% 72% at 42% 38%,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 34%,
      rgba(0, 0, 0, 0.6) 58%,
      #000 82%
    );
  }
  .home-intro.intro-c::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 70% 75% at 40% 36%,
      rgba(7, 15, 20, 0.72) 0%,
      rgba(7, 15, 20, 0.45) 40%,
      rgba(7, 15, 20, 0.15) 65%,
      transparent 85%
    );
  }
  .home-intro.intro-c .home-intro__inner {
    padding-block: clamp(40px, 6vw, 64px) !important;
  }
  .home-intro.intro-c .home-intro__headline {
    max-width: 20ch !important;
    font-size: clamp(28px, 4vw, 42px) !important;
  }
  .home-intro.intro-c .home-intro__stage {
    margin-top: clamp(24px, 3vw, 36px) !important;
  }

  /* Kill circuit fill on resource card panels */
  .rsc-card__logo-panel,
  .rsc-card__soon {
    background-image: none !important;
  }

  /* Static line-work underlay — mesh lines only by default.
     Split on Consolidation + Why. Proof keeps mesh with copy fade.
     Industries / Personas / Go Deeper — no mesh. */
  .home-ledger,
  .home-why,
  .home-proof-band {
    position: relative;
    isolation: isolate;
  }
  .home-proof-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-mesh-lines-1920x1080.svg') center / cover no-repeat !important;
    mix-blend-mode: screen !important;
    opacity: 0.4 !important;
  }

  /* Industries, Personas, Go Deeper — no mesh */
  .home-industries::before,
  .home-industries::after,
  .home-personas::before,
  .home-personas::after,
  .home-resources::before,
  .home-resources::after {
    content: none !important;
    background: none !important;
    opacity: 0 !important;
    display: none !important;
  }

  /* Consolidation — same technique as hero-c: one soft mask on the mesh
     layer + soft navy ::after + tight pockets on rail/fig.
     Center of the mask is fully clear (not just dimmed) so the pattern
     actually drops out behind the words and the ledger graphic. */
  .home-ledger {
    background: var(--navy-deep) !important;
    overflow: hidden;
  }
  .home-ledger::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-split-1920x1080.svg') center / cover no-repeat !important;
    mix-blend-mode: screen !important;
    opacity: 1 !important;
    /* Soft clear behind the content band — same idea as hero-c, but
       the core goes fully clear so bright screen-blend lines actually
       drop out (hero's 0.28 floor was too visible on this denser crop). */
    -webkit-mask-image: radial-gradient(
      ellipse 72% 70% at 45% 44%,
      transparent 0%,
      rgba(0, 0, 0, 0.18) 30%,
      rgba(0, 0, 0, 0.55) 55%,
      #000 78%
    );
    mask-image: radial-gradient(
      ellipse 72% 70% at 45% 44%,
      transparent 0%,
      rgba(0, 0, 0, 0.18) 30%,
      rgba(0, 0, 0, 0.55) 55%,
      #000 78%
    );
  }
  .home-ledger::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Soft navy pocket — same color stops as hero-c::after */
    background: radial-gradient(
      ellipse 78% 72% at 48% 46%,
      rgba(7, 15, 20, 0.78) 0%,
      rgba(7, 15, 20, 0.55) 32%,
      rgba(7, 15, 20, 0.25) 55%,
      transparent 78%
    );
  }

  .home-ledger .container {
    position: relative;
    z-index: 1 !important;
  }

  .home-ledger__rail,
  .home-ledger__fig {
    position: relative;
    isolation: isolate;
  }
  .home-ledger__rail::before,
  .home-ledger__fig::before {
    content: '';
    position: absolute;
    inset: -56px -72px -48px -48px;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 72% 68% at 38% 42%,
      rgba(7, 15, 20, 0.72) 0%,
      rgba(7, 15, 20, 0.5) 35%,
      rgba(7, 15, 20, 0.2) 58%,
      transparent 82%
    );
  }
  .home-ledger__fig::before {
    background: radial-gradient(
      ellipse 72% 68% at 50% 50%,
      rgba(7, 15, 20, 0.72) 0%,
      rgba(7, 15, 20, 0.5) 35%,
      rgba(7, 15, 20, 0.2) 58%,
      transparent 82%
    );
  }
  .home-ledger__rail > *,
  .home-ledger__fig > * {
    position: relative;
    z-index: 1;
  }

  /* Why it matters — no mesh (Consolidation keeps the split; this band
     looked odd with the underlay). Plain navy behind the arrow + flip cards. */
  .home-why {
    background: var(--navy-deep) !important;
  }
  .home-why::before,
  .home-why::after {
    content: none !important;
    background: none !important;
    opacity: 0 !important;
    display: none !important;
    -webkit-mask-image: none !important;
    mask-image: none !important;
  }
  .home-why__item::before {
    content: none !important;
    display: none !important;
  }
  /* Keep opaque card faces so they don't depend on a mesh underlay */
  .home-why__face--front {
    background:
      radial-gradient(circle at 78% 88%, rgba(104, 227, 190, 0.22) 0%, rgba(104, 227, 190, 0) 55%),
      linear-gradient(155deg, rgba(104, 227, 190, 0.08) 0%, rgba(104, 227, 190, 0.02) 100%),
      var(--navy) !important;
  }
  .home-why__face--back {
    background: var(--navy-deep) !important;
  }

  /* Ameristar callout — keep mesh, fade behind headers + body copy */
  .home-proof-band {
    overflow: hidden;
  }
  .home-proof-band::before {
    opacity: 0.45 !important;
    -webkit-mask-image: radial-gradient(
      ellipse 70% 90% at 48% 50%,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 35%,
      rgba(0, 0, 0, 0.65) 62%,
      #000 85%
    );
    mask-image: radial-gradient(
      ellipse 70% 90% at 48% 50%,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 35%,
      rgba(0, 0, 0, 0.65) 62%,
      #000 85%
    );
  }
  .home-proof-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 72% 95% at 48% 50%,
      rgba(7, 15, 20, 0.72) 0%,
      rgba(7, 15, 20, 0.45) 40%,
      rgba(7, 15, 20, 0.18) 65%,
      transparent 85%
    );
  }
  .home-proof-band__copy {
    position: relative;
    isolation: isolate;
    z-index: 1;
  }
  .home-proof-band__copy::before {
    content: '';
    position: absolute;
    inset: -40px -56px -36px -48px;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 72% 68% at 40% 45%,
      rgba(7, 15, 20, 0.78) 0%,
      rgba(7, 15, 20, 0.5) 35%,
      rgba(7, 15, 20, 0.2) 58%,
      transparent 82%
    );
  }
  .home-proof-band__copy > * {
    position: relative;
    z-index: 1;
  }

  /* Keep section content above the underlay */
  .home-diff__inner,
  .home-intro__inner,
  .home-ledger .container,
  .home-why__inner,
  .home-industries__inner,
  .home-proof-band__inner,
  .home-personas__inner,
  .home-resources__inner {
    position: relative;
    z-index: 1;
  }

  /* 2 · CTA BAND — denser wide mesh (approved). Fade kept for readability. */
  #home-cta.section {
    position: relative;
    isolation: isolate;
    background-color: var(--navy-deep) !important;
    border-top: 2px solid var(--mint);
  }
  #home-cta.section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-wide-2560x800.svg') center / 125% auto no-repeat;
    mix-blend-mode: screen;
    opacity: 0.6;
  }
  #home-cta.section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(7,15,20,0.65) 30%, rgba(7,15,20,0.65) 44%, transparent 90%);
  }
  #home-cta .container {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 720px) {
    #home-cta.section::after {
      background: linear-gradient(180deg, transparent 0%, rgba(7,15,20,0.65) 34%, rgba(7,15,20,0.65) 60%, transparent 100%);
    }
  }

  /* 3 · FOOTER — shallow low-opacity mesh crop.
     The footer is a thin strip; a full mesh would overwhelm it.
     A low-opacity wide mesh, faded behind the nav, adds just
     enough brand atmosphere to bookend the page. */
  .site-footer {
    background: var(--navy-deep) url('/images/mesh/luci-bg-wide-2560x800.svg') center top / cover no-repeat !important;
    position: relative;
    isolation: isolate;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(7, 15, 20, 0.78) 0%,
      rgba(7, 15, 20, 0.92) 100%
    );
  }
  .site-footer > .container {
    position: relative;
    z-index: 1;
  }

  /* ---- Mockup banner ---- */
  .mockup-banner {
    position: relative;
    z-index: 9999;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    padding: 8px var(--page-pad);
    background: var(--navy);
    border-bottom: 1px solid rgba(104, 227, 190, 0.3);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--mint);
  }
  .mockup-banner__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--mint);
    box-shadow: 0 0 8px rgba(var(--mint-rgb), 0.5);
    flex-shrink: 0;
  }
  .mockup-banner__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-left: auto;
  }
  .mockup-banner__variants a {
    padding: 4px 10px;
    border: 1px solid rgba(104, 227, 190, 0.35);
    color: rgba(245, 248, 250, 0.75);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .mockup-banner__variants a:hover {
    color: var(--off-white);
    border-color: rgba(104, 227, 190, 0.7);
  }
  .mockup-banner__variants a.is-active {
    color: var(--navy-deep);
    background: var(--mint);
    border-color: var(--mint);
  }

  /* ---- CTA band styles (copied from index.astro) ---- */
  :global(#home-cta.section) {
    padding-block: clamp(36px, 5vw, 48px);
  }
  .home-cta {
    max-width: 64ch;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .home-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }
  .home-cta__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
  }
  .home-cta__title em {
    font-style: normal;
    color: var(--gold);
  }
  .home-cta__deck {
    max-width: 52ch;
    margin: 0 0 var(--space-4);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.78);
  }
  .home-cta__btn {
    margin-top: 0;
  }

  /* Go Deeper — keep 3-up horizontal cards, much smaller vertical footprint */
  .home-resources__inner {
    padding-block: clamp(28px, 3.5vw, 40px) !important;
  }
  .home-resources__head {
    margin-bottom: 16px !important;
  }
  .home-resources__heading {
    font-size: clamp(18px, 2vw, 22px) !important;
  }
  .home-resources__lede {
    margin-top: 6px !important;
    font-size: 14px !important;
    line-height: 1.4 !important;
  }
  .home-resources__grid {
    gap: 12px !important;
  }
  .home-resources .rsc-card {
    border-radius: 10px !important;
  }
  .home-resources .rsc-card__media {
    aspect-ratio: auto !important;
    height: 72px !important;
  }
  .home-resources .rsc-card__logo-panel img {
    width: 42% !important;
    max-width: 140px !important;
  }
  .home-resources .rsc-card__soon {
    font-size: 11px !important;
    letter-spacing: 0.14em !important;
  }
  .home-resources .rsc-card__body {
    gap: 4px !important;
    padding: 12px 14px 14px !important;
  }
  .home-resources .rsc-card__kicker {
    margin: 0 !important;
    gap: 8px !important;
  }
  .home-resources .rsc-card__kicker::before {
    width: 16px !important;
  }
  .home-resources .rsc-card__title {
    font-size: 15px !important;
    line-height: 1.25 !important;
  }
  .home-resources .rsc-card__meta {
    font-size: 11px !important;
  }
  .home-resources .rsc-card__cta {
    padding-top: 8px !important;
    font-size: 12px !important;
  }
</style>

<script is:inline>
  (function () {
    /* Hero locked to C (approved). Intro variants via ?intro=a|b|c|d */
    var hero = document.querySelector('.home-entry');
    if (hero) hero.classList.add('hero-c');

    var params = new URLSearchParams(location.search);
    var intro = (params.get('intro') || 'd').toLowerCase();
    if (!['a', 'b', 'c', 'd'].includes(intro)) intro = 'd';

    var section = document.querySelector('.home-intro');
    if (section) {
      section.classList.remove('intro-a', 'intro-b', 'intro-c', 'intro-d');
      section.classList.add('intro-' + intro);

      var copy = {
        a: {
          lead: 'One interface. ',
          accent: 'The whole floor.',
          tail: ''
        },
        b: {
          lead: 'Control · Automate · ',
          accent: 'Execute',
          tail: '.'
        },
        c: {
          lead: 'One interface for the ',
          accent: 'guest experience',
          tail: '.'
        },
        d: {
          lead: 'One interface for ',
          accent: 'property-wide A/V',
          tail: ''
        }
      };
      var h = document.getElementById('home-intro-title');
      var c = copy[intro];
      if (h && c) {
        h.innerHTML =
          c.lead +
          '<em class="home-intro__headline-accent">' +
          c.accent +
          '</em>' +
          c.tail;
      }
    }

    document.querySelectorAll('.mockup-banner__variants a').forEach(function (a) {
      a.classList.toggle('is-active', a.getAttribute('data-intro') === intro);
    });

    /* --- Variant D: fresh leader-line overlay calibrated for the 21:9 crop + scattered cards --- */
    if (intro === 'd') {
      var frame = document.querySelector('.home-intro.intro-d .home-intro__frame');
      if (frame) {
        var NS = 'http://www.w3.org/2000/svg';
        var svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('class', 'home-intro__arrows-d');
        svg.setAttribute('viewBox', '0 0 100 100');
        svg.setAttribute('preserveAspectRatio', 'none');
        svg.setAttribute('aria-hidden', 'true');
        var defs = document.createElementNS(NS, 'defs');
        var mk = document.createElementNS(NS, 'marker');
        mk.setAttribute('id', 'hi-arrow-d');
        mk.setAttribute('markerWidth', '7');
        mk.setAttribute('markerHeight', '7');
        mk.setAttribute('refX', '5.2');
        mk.setAttribute('refY', '3');
        mk.setAttribute('orient', 'auto');
        var p = document.createElementNS(NS, 'path');
        p.setAttribute('d', 'M0 0L6 3L0 6Z');
        p.setAttribute('fill', 'var(--mint)');
        mk.appendChild(p);
        defs.appendChild(mk);
        svg.appendChild(defs);
        var gC = document.createElementNS(NS, 'g');
        var gA = document.createElementNS(NS, 'g');
        var gE = document.createElementNS(NS, 'g');
        svg.appendChild(gC); svg.appendChild(gA); svg.appendChild(gE);
        frame.appendChild(svg);

        /* Targets as % of the 21:9 frame, tuned to point to the same image elements as the
           original (TV bank, ceiling lights, speakers, signage pillar, video wall). */
        var targets = {
          control: [
            { x: 15, y: 50 }, { x: 44, y: 6 }, { x: 60, y: 10 }
          ],
          automate: [
            { x: 40, y: 44 }, { x: 70, y: 62 }
          ]
        };

        function clear(g) { while (g.firstChild) g.removeChild(g.firstChild); }

        function edgeOrigin(card, target) {
          var fr = frame.getBoundingClientRect();
          var cr = card.getBoundingClientRect();
          var left = (cr.left - fr.left) / fr.width * 100;
          var right = (cr.right - fr.left) / fr.width * 100;
          var top = (cr.top - fr.top) / fr.height * 100;
          var bottom = (cr.bottom - fr.top) / fr.height * 100;
          var cx = (left + right) / 2;
          var cy = (top + bottom) / 2;
          var tpx = fr.left + target.x / 100 * fr.width;
          var tpy = fr.top + target.y / 100 * fr.height;
          var dL = Math.hypot(tpx - cr.left, tpy - (cr.top + cr.bottom) / 2);
          var dR = Math.hypot(tpx - cr.right, tpy - (cr.top + cr.bottom) / 2);
          var dT = Math.hypot(tpx - (cr.left + cr.right) / 2, tpy - cr.top);
          var dB = Math.hypot(tpx - (cr.left + cr.right) / 2, tpy - cr.bottom);
          var minD = Math.min(dL, dR, dT, dB);
          var ox, oy;
          if (minD === dT) { ox = Math.max(left + 1, Math.min(right - 1, cx + (target.x - cx) * 0.35)); oy = top; }
          else if (minD === dB) { ox = Math.max(left + 1, Math.min(right - 1, cx + (target.x - cx) * 0.35)); oy = bottom; }
          else if (minD === dL) { oy = Math.max(top + 1, Math.min(bottom - 1, cy + (target.y - cy) * 0.35)); ox = left; }
          else { oy = Math.max(top + 1, Math.min(bottom - 1, cy + (target.y - cy) * 0.35)); ox = right; }
          return { x: ox, y: oy };
        }

        function line(g, ox, oy, tx, ty) {
          var l = document.createElementNS(NS, 'line');
          l.setAttribute('x1', String(ox)); l.setAttribute('y1', String(oy));
          l.setAttribute('x2', String(tx)); l.setAttribute('y2', String(ty));
          l.setAttribute('marker-end', 'url(#hi-arrow-d)');
          g.appendChild(l);
          var t = document.createElementNS(NS, 'circle');
          t.setAttribute('class', 'target');
          t.setAttribute('cx', String(tx)); t.setAttribute('cy', String(ty)); t.setAttribute('r', '0.95');
          g.appendChild(t);
        }

        function draw() {
          if (window.matchMedia('(max-width: 760px)').matches) { svg.style.display = 'none'; return; }
          svg.style.display = '';
          var cards = frame.querySelectorAll('.home-intro__card');
          if (cards.length < 3) return;
          var control = cards[0], automate = cards[1], execute = cards[2];
          clear(gC); clear(gA); clear(gE);
        targets.control.forEach(function (t) { var o = edgeOrigin(control, t); line(gC, o.x, o.y, t.x, t.y); });
        targets.automate.forEach(function (t) { var o = edgeOrigin(automate, t); line(gA, o.x, o.y, t.x, t.y); });

          /* Execute: straight dotted leader from card 3 tracing the lower
             portion to the right side. No bracket, no origin dot. */
          var oE = edgeOrigin(execute, { x: 96, y: 92 });
          var room = document.createElementNS(NS, 'g');
          room.setAttribute('class', 'room');
          var leader = document.createElementNS(NS, 'path');
          leader.setAttribute('class', 'room-leader');
          leader.setAttribute('d', 'M' + oE.x + ' ' + oE.y + ' H96');
          room.appendChild(leader);
          gE.appendChild(room);
        }

        /* Wait for layout + image so card rects are real */
        if (document.readyState === 'complete') draw();
        else window.addEventListener('load', draw);
        window.addEventListener('resize', draw);
      }
    }
  })();
</script>
