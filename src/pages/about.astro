---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import HomeCommitments from '../components/HomeCommitments.astro';
import {
  aboutStory,
  variableReduction,
  oneOffering,
  aboutProofLine,
  ameristarCaseStudy,
  leadership,
  site,
} from '../data/site';

const accumulationParas = variableReduction.accumulation.split('\n\n');
---

<BaseLayout title="About LUCI" description={oneOffering.offering}>

  <!-- Hero: Las Vegas origin, full-bleed with navy scrim -->
  <section class="about-hero">
    <div class="about-hero__media">
      <img src="/images/vegas-skyline-dusk.jpg" alt="Las Vegas Strip skyline at dusk" loading="eager" />
    </div>
    <div class="about-hero__scrim" aria-hidden="true"></div>
    <div class="container about-hero__inner">
      <p class="display-label about-hero__kicker">Our company</p>
      <h1 class="about-hero__title">About LUCI</h1>
      <p class="lead about-hero__lead">{aboutStory.heroLead}</p>
    </div>
  </section>

  <!-- Story: full-bleed casino floor + dual scrim + reading overlay -->
  <section class="about-story" aria-labelledby="about-story-title">
    <div class="about-story__media" aria-hidden="true">
      <img
        src="/images/industries/casino/solution-morning-floor.jpg"
        alt=""
        width="1536"
        height="1024"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="about-story__scrim" aria-hidden="true"></div>
    <div class="container about-story__inner">
      <div class="about-story__panel">
        <div class="about-story__lockup">
          <h2 id="about-story-title" class="about-story__name">Our story</h2>
          <span class="about-story__rule" aria-hidden="true"></span>
          <p class="about-story__role">From the casino floor to every property we run</p>
        </div>
        {aboutStory.paragraphs.map((p) => (
          <p class="about-story__p">{p}</p>
        ))}
        <aside class="about-story__callout">{aboutStory.standardCallout}</aside>
      </div>
    </div>
  </section>
  <div class="about-story-industries">
    <div class="container">
      <span class="display-label about-story-industries__label">Industries we serve</span>
      <ul class="about-story-industries__tags" role="list">
        {aboutStory.industries.map((it) => (
          <li class="about-story-industries__tag">{it}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Worldview: reducing variables — dark manifesto band + consolidation ledger -->
  <SectionBlock id="about-worldview" lockupName="Our worldview" lockupRole="Reducing variables" tone="deep" pattern>
    <div class="about-worldview">
      {accumulationParas.map((p) => (
        <p class="measure about-worldview__p">{p}</p>
      ))}
      <p class="measure about-worldview__p">{variableReduction.subtraction}</p>
      <p class="about-worldview__signature">{variableReduction.headline}</p>
      <figure class="about-worldview__ledger">
        <img
          src="/images/diagrams/luci-consolidation-ledger.svg"
          alt="Consolidation ledger: today, four or more multimedia systems, five or more equipment racks, fifteen or more receivers, and one hundred plus hardware devices. With LUCI: one interface, one equipment rack, one consolidated network, and code that is yours."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </SectionBlock>

  <!-- Commitments (values) — reuses the homepage commitments grid -->
  <HomeCommitments />

  <!-- Leadership -->
  <SectionBlock
    lockupName="Leadership"
    lockupRole="The team that builds and supports it"
    deck="Built and operated by the same people — for the life of the relationship."
  >
    <ul class="about-leadership" role="list">
      {leadership.map((person) => (
        <li class="about-leader">
          <div class="about-leader__card">
            <div class="about-leader__photo">
              <img src={person.photo} alt={person.name} loading="lazy" />
            </div>
            <div class="about-leader__copy">
              <p class="about-leader__name">{person.name}</p>
              <p class="about-leader__title">{person.title}</p>
              <p class="about-leader__blurb">{person.blurb}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </SectionBlock>

  <!-- Proof at scale -->
  <SectionBlock lockupName="Proof at scale" lockupRole="Running on live properties" tone="mid" pattern>
    <p class="measure about-proof__line">{aboutProofLine}</p>
    <a class="about-proof__card" href={`/resources/case-studies/${ameristarCaseStudy.slug}`}>
      <span class="display-label about-proof__card-kicker">Case study</span>
      <span class="about-proof__card-title">{ameristarCaseStudy.title}</span>
      <span class="about-proof__card-cta">Read the story →</span>
    </a>
  </SectionBlock>

  <!-- CTA -->
  <SectionBlock id="about-cta" tone="deep" pattern>
    <div class="about-cta">
      <p class="display-label about-cta__kicker">Next step</p>
      <h2 class="about-cta__title">Let&rsquo;s talk about <em>your property</em>.</h2>
      <p class="about-cta__deck">Tell us what you&rsquo;re running &mdash; and what you&rsquo;d like to stop managing.</p>
      <a class="btn btn--primary" href="/contact">{site.ctaPrimary}</a>
    </div>
  </SectionBlock>

</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  /* Title card: skyline as atmosphere, dissolves to solid navy at the bottom so it
     doesn't collide with the story photo stage below. Mint rule marks the beat. */
  .about-hero {
    position: relative;
    background: var(--navy-deep);
    min-height: clamp(320px, 44vh, 480px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 3px solid var(--mint);
  }
  .about-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .about-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  /* Dual scrim — left for title contrast + bottom fade into solid navy (section break). */
  .about-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(10, 22, 28, 0.92) 0%,
        rgba(10, 22, 28, 0.78) 38%,
        rgba(10, 22, 28, 0.35) 70%,
        rgba(10, 22, 28, 0.18) 100%
      ),
      linear-gradient(
        to top,
        rgba(10, 22, 28, 1) 0%,
        rgba(10, 22, 28, 1) 12%,
        rgba(10, 22, 28, 0.92) 28%,
        rgba(10, 22, 28, 0.45) 55%,
        transparent 78%
      );
  }
  .about-hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(48px, 7vw, 80px) clamp(40px, 6vw, 64px);
  }
  .about-hero__kicker {
    color: var(--mint);
    margin-bottom: var(--space-2);
  }
  .about-hero__title {
    margin: 0 0 var(--space-2);
    max-width: 16ch;
    color: var(--off-white);
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .about-hero__lead {
    color: rgba(245, 248, 250, 0.88);
    max-width: 44ch;
  }
  @media (max-width: 720px) {
    .about-hero__scrim {
      background:
        linear-gradient(
          180deg,
          rgba(10, 22, 28, 0.45) 0%,
          rgba(10, 22, 28, 0.82) 50%,
          rgba(10, 22, 28, 1) 100%
        );
    }
  }

  /* ---------- Story (full-bleed photo stage) ---------- */
  .about-story {
    position: relative;
    background: var(--navy-deep);
    min-height: clamp(520px, 70vh, 760px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--off-white);
  }
  .about-story__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .about-story__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }
  /* Dual scrim — deeper left veil for the reading column; photo still peeks right. */
  .about-story__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        105deg,
        rgba(10, 22, 28, 0.96) 0%,
        rgba(10, 22, 28, 0.88) 32%,
        rgba(10, 22, 28, 0.5) 58%,
        rgba(10, 22, 28, 0.22) 100%
      ),
      linear-gradient(
        to top,
        rgba(10, 22, 28, 0.9) 0%,
        rgba(10, 22, 28, 0.4) 40%,
        transparent 70%
      ),
      linear-gradient(
        to bottom,
        rgba(10, 22, 28, 0.55) 0%,
        transparent 18%
      );
  }
  .about-story__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(64px, 10vw, 112px) clamp(48px, 7vw, 80px);
  }
  /* Soft navy panel behind the reading block — readable without killing the photo. */
  .about-story__panel {
    max-width: 64ch;
    padding: clamp(24px, 3vw, 36px) clamp(24px, 3vw, 40px);
    background: linear-gradient(
      160deg,
      rgba(10, 22, 28, 0.78) 0%,
      rgba(10, 22, 28, 0.62) 100%
    );
    box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.12);
    border-radius: 16px;
  }
  .about-story__lockup {
    margin-bottom: var(--space-4);
  }
  .about-story__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--off-white);
  }
  .about-story__rule {
    display: block;
    width: 40px;
    height: 3px;
    margin: 14px 0 12px;
    background: var(--mint);
    border-radius: 2px;
  }
  .about-story__role {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 1.35;
    color: var(--mint);
  }
  .about-story__p {
    margin: 0 0 var(--space-3);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: rgba(245, 248, 250, 0.92);
  }
  .about-story__p:last-of-type {
    margin-bottom: 0;
  }
  .about-story__callout {
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
    color: var(--off-white);
    background: rgba(10, 22, 28, 0.45);
    border-left: 4px solid var(--mint);
    box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.16);
  }
  @media (max-width: 720px) {
    .about-story {
      min-height: clamp(560px, 90vh, 720px);
      align-items: flex-end;
    }
    .about-story__scrim {
      background:
        linear-gradient(
          180deg,
          rgba(10, 22, 28, 0.55) 0%,
          rgba(10, 22, 28, 0.82) 35%,
          rgba(10, 22, 28, 0.95) 100%
        );
    }
    .about-story__panel {
      padding: 20px;
      background: rgba(10, 22, 28, 0.82);
    }
  }

  /* Industries — light strip under the photo stage */
  .about-story-industries {
    background: var(--off-white);
    border-bottom: 1px solid var(--rule-light);
    padding-block: clamp(28px, 4vw, 40px);
  }
  .about-story-industries__label {
    color: var(--accent-light);
    display: block;
    margin-bottom: var(--space-2);
  }
  .about-story-industries__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .about-story-industries__tag {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: -0.005em;
    color: var(--ink-strong);
    padding: 8px 14px;
    background: linear-gradient(155deg, #E6F5EF 0%, #F3FAF8 100%);
    box-shadow: inset 0 0 0 1px rgba(43, 158, 128, 0.2);
    border-radius: 8px;
  }

  /* ---------- Worldview (deep, patterned manifesto band) ---------- */
  /* Match the section bg to the ledger diagram's own navy so the diagram reads as
     part of the section, not a pasted-on rectangle. */
  :global(#about-worldview.section--deep) {
    background: var(--navy-deep);
  }
  .about-worldview__p {
    margin: 0 0 var(--space-3);
    font-size: 17px;
    line-height: 1.65;
    color: rgba(245, 248, 250, 0.82);
  }
  .about-worldview__signature {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin: var(--space-4) 0 var(--space-5);
    padding-left: var(--space-4);
    border-left: 4px solid var(--mint);
    max-width: 26ch;
  }
  /* Consolidation ledger — the visual proof of "reducing variables." Its own navy
     bg matches the section; a hairline + soft lift define it as an exhibit. */
  .about-worldview__ledger {
    margin: var(--space-4) 0 0;
    max-width: 640px;
  }
  .about-worldview__ledger img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px rgba(104, 227, 190, 0.18), 0 24px 56px rgba(0, 0, 0, 0.45);
  }

  /* ---------- Leadership ---------- */
  .about-leadership {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(32px, 5vw, 64px);
  }
  .about-leader__card {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 20px;
    align-items: start;
    padding: clamp(20px, 2.4vw, 28px);
    background: linear-gradient(155deg, #E6F5EF 0%, #F3FAF8 100%);
    box-shadow: inset 0 0 0 1px rgba(43, 158, 128, 0.16);
    border-radius: 20px;
  }
  /* Photo — square frame, image covers it (headshot favors the face). */
  .about-leader__photo {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 132px;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(155deg, #E6F5EF 0%, #F3FAF8 100%);
    box-shadow: inset 0 0 0 1px rgba(43, 158, 128, 0.18);
  }
  .about-leader__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }
  .about-leader__name {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }
  .about-leader__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-light);
  }
  .about-leader__blurb {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: rgba(53, 79, 92, 0.82);
    max-width: 44ch;
  }
  @media (max-width: 720px) {
    .about-leadership {
      grid-template-columns: 1fr;
    }
    .about-leader__card {
      grid-template-columns: 104px 1fr;
    }
    .about-leader__photo {
      width: 104px;
    }
  }

  /* ---------- Proof at scale ---------- */
  .about-proof__line {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.9);
    margin: 0 0 var(--space-5);
  }
  .about-proof__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 520px;
    padding: var(--space-4);
    background: rgba(10, 22, 28, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 4px solid var(--mint);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .about-proof__card:hover {
    border-left-color: var(--gold);
    background: rgba(10, 22, 28, 0.6);
  }
  .about-proof__card-kicker {
    color: var(--mint);
  }
  .about-proof__card-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--off-white);
  }
  .about-proof__card-cta {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    color: var(--mint);
  }

  /* ---------- CTA (deep, patterned) ---------- */
  :global(#about-cta.section) {
    border-top: 2px solid var(--mint);
  }
  .about-cta {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .about-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }
  .about-cta__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(26px, 3.6vw, 38px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--off-white);
  }
  .about-cta__title :global(em) {
    font-style: normal;
    color: var(--gold);
  }
  .about-cta__deck {
    max-width: 52ch;
    margin: 0 auto var(--space-4);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.78);
  }
</style>
