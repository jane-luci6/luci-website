---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import HomeCommitments from '../components/HomeCommitments.astro';
import {
  aboutStory,
  variableReduction,
  oneOffering,
  portfolioLine,
  ameristarCaseStudy,
  leadership,
  site,
} from '../data/site';

const accumulationParas = variableReduction.accumulation.split('\n\n');
---

<BaseLayout title="About LUCI" description={oneOffering.offering}>

  <!-- Hero: Las Vegas origin, full-bleed with navy scrim -->
  <section class="about-hero">
    <div class="about-hero__media">
      <img src="/images/vegas-skyline-dusk.jpg" alt="Las Vegas Strip skyline at dusk" loading="eager" />
    </div>
    <div class="about-hero__scrim" aria-hidden="true"></div>
    <div class="container about-hero__inner">
      <p class="display-label about-hero__kicker">Our company</p>
      <h1 class="about-hero__title">About LUCI</h1>
      <p class="lead about-hero__lead">{aboutStory.heroLead}</p>
    </div>
  </section>

  <!-- Story -->
  <SectionBlock lockupName="Our story" lockupRole="From the casino floor to every property we run">
    <div class="about-story">
      {aboutStory.paragraphs.map((p) => (
        <p class="measure about-story__p">{p}</p>
      ))}
      <div class="about-story__industries">
        <span class="display-label about-story__industries-label">Industries we serve</span>
        <p class="about-story__industries-list">{aboutStory.industries.join(' · ')}</p>
      </div>
    </div>
  </SectionBlock>

  <!-- Worldview: reducing variables -->
  <SectionBlock lockupName="Our worldview" lockupRole="Reducing variables" tone="sand">
    <p class="measure about-worldview__signature">{variableReduction.headline}</p>
    {accumulationParas.map((p) => (
      <p class="measure about-worldview__p">{p}</p>
    ))}
    <p class="measure about-worldview__p">{variableReduction.subtraction}</p>
  </SectionBlock>

  <!-- Commitments (values) — reuses the homepage commitments grid -->
  <HomeCommitments />

  <!-- Leadership -->
  <SectionBlock lockupName="Leadership" lockupRole="The team that builds and supports it">
    <ul class="about-leadership" role="list">
      {leadership.map((person) => (
        <li class="about-leader">
          <div class="about-leader__photo" aria-hidden="true">
            <span class="about-leader__photo-mark" aria-hidden="true"></span>
            <span class="about-leader__photo-label">Photo to come</span>
          </div>
          <div class="about-leader__copy">
            <p class="about-leader__name">{person.name}</p>
            <p class="about-leader__title">{person.title}</p>
            <p class="about-leader__blurb">{person.blurb}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="scaffold-note about-leadership__note">
      Photo placeholders — real headshots to be added.
    </p>
  </SectionBlock>

  <!-- Proof at scale -->
  <SectionBlock lockupName="Proof at scale" lockupRole="Running on live properties" tone="mid">
    <p class="measure about-proof__line">{portfolioLine}</p>
    <a class="about-proof__card" href={`/resources/case-studies/${ameristarCaseStudy.slug}`}>
      <span class="display-label about-proof__card-kicker">Case study</span>
      <span class="about-proof__card-title">{ameristarCaseStudy.title}</span>
      <span class="about-proof__card-cta">Read the story →</span>
    </a>
  </SectionBlock>

  <!-- CTA -->
  <SectionBlock tone="deep">
    <a class="btn btn--primary" href="/contact">{site.ctaPrimary}</a>
  </SectionBlock>

</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .about-hero {
    position: relative;
    background: var(--navy-deep);
    min-height: clamp(360px, 52vh, 560px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .about-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .about-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Navy gradient scrim — opaque on the left where the text sits, transparent right.
     Guarantees WCAG contrast for the overlaid title/lead. */
  .about-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(10, 22, 28, 0.92) 0%,
      rgba(10, 22, 28, 0.78) 38%,
      rgba(10, 22, 28, 0.30) 70%,
      rgba(10, 22, 28, 0.10) 100%
    );
  }
  .about-hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(56px, 9vw, 96px);
  }
  .about-hero__kicker {
    color: var(--mint);
    margin-bottom: var(--space-2);
  }
  .about-hero__title {
    margin: 0 0 var(--space-2);
    max-width: 16ch;
    color: var(--off-white);
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .about-hero__lead {
    color: rgba(245, 248, 250, 0.88);
    max-width: 44ch;
  }
  @media (max-width: 720px) {
    .about-hero__scrim {
      background: linear-gradient(
        180deg,
        rgba(10, 22, 28, 0.35) 0%,
        rgba(10, 22, 28, 0.82) 62%,
        rgba(10, 22, 28, 0.92) 100%
      );
    }
  }

  /* ---------- Story ---------- */
  .about-story__p {
    margin: 0 0 var(--space-3);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink);
  }
  .about-story__p:last-of-type {
    margin-bottom: var(--space-5);
  }
  .about-story__industries {
    border-top: 1px solid var(--rule-light);
    padding-top: var(--space-3);
  }
  .about-story__industries-label {
    color: var(--accent-light);
    display: block;
    margin-bottom: var(--space-1);
  }
  .about-story__industries-list {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(16px, 1.6vw, 19px);
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    line-height: 1.4;
  }

  /* ---------- Worldview ---------- */
  .about-worldview__signature {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
    margin: 0 0 var(--space-5);
    padding-left: var(--space-4);
    border-left: 4px solid var(--accent-light);
  }
  .about-worldview__p {
    margin: 0 0 var(--space-3);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink);
  }

  /* ---------- Leadership ---------- */
  .about-leadership {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(32px, 5vw, 64px);
  }
  .about-leader {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 20px;
    align-items: start;
  }
  /* Photo placeholder — clearly marked so it's obvious a real headshot is needed. */
  .about-leader__photo {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 132px;
    border-radius: 16px;
    background: linear-gradient(155deg, #E6F5EF 0%, #F3FAF8 100%);
    box-shadow: inset 0 0 0 1px rgba(43, 158, 128, 0.18);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .about-leader__photo-mark {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(43, 158, 128, 0.22);
    box-shadow: inset 0 0 0 1px rgba(43, 158, 128, 0.35);
    margin-bottom: 8px;
  }
  .about-leader__photo-label {
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-light);
    text-align: center;
  }
  .about-leader__name {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }
  .about-leader__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-light);
  }
  .about-leader__blurb {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: rgba(53, 79, 92, 0.82);
    max-width: 44ch;
  }
  .about-leadership__note {
    margin-top: var(--space-5);
  }
  @media (max-width: 720px) {
    .about-leadership {
      grid-template-columns: 1fr;
    }
    .about-leader {
      grid-template-columns: 104px 1fr;
    }
    .about-leader__photo {
      width: 104px;
    }
  }

  /* ---------- Proof at scale ---------- */
  .about-proof__line {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.9);
    margin: 0 0 var(--space-5);
  }
  .about-proof__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 520px;
    padding: var(--space-4);
    background: rgba(10, 22, 28, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 4px solid var(--mint);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .about-proof__card:hover {
    border-left-color: var(--gold);
    background: rgba(10, 22, 28, 0.6);
  }
  .about-proof__card-kicker {
    color: var(--mint);
  }
  .about-proof__card-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--off-white);
  }
  .about-proof__card-cta {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    color: var(--mint);
  }
</style>
