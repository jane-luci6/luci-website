---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
---

<BaseLayout title="Hero zone-list — final" description="Final property-zone ticker in the homepage hero" darkHeader>
  <div class="hero-opts">
    <div class="hero-opts__intro">
      <span class="hero-opts__intro-k">Final — Control every + vertical ticker</span>
      <span class="hero-opts__intro-d">A quiet secondary element: “Control every” + a one-line vertical ticker that scrolls up through Lobby, Pool, Parking lot, Wayfinding, Theater, Conference Room, Event Venue. White/gray type (no mint), pinned to the floorplan baseline so it doesn’t compete with the headers. This is now live on the homepage.</span>
    </div>
    <HomeHero variant="i" />
  </div>
</BaseLayout>

<style>
  .hero-opts {
    background: var(--navy-deep);
  }
  .hero-opts__intro {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px var(--page-pad);
    background: var(--navy);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hero-opts__intro-k {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .hero-opts__intro-d {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.72);
    max-width: 70ch;
  }
</style>
