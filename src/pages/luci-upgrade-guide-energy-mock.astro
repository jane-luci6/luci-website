  .ug-headers--alt :global(.section--light) :global(.header-lockup__name),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__name) {
    color: var(--ink-strong);
  }
  .ug-headers--alt :global(.section--light) :global(.header-lockup__name em),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__name em) {
    color: var(--accent-light);
    border-bottom: none;
  }
  .ug-headers--alt :global(.section--light) :global(.header-lockup__rule),
  .ug-headers--alt :global(.section--white) :global(.header-lockup__rule) {
