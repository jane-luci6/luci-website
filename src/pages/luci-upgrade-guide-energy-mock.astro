    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ug-pill {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(255, 255, 255, 0.72);
    border-left: 3px solid var(--accent-light);
