    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-light);
    list-style: none;
  }
  .ug-flags summary::-webkit-details-marker { display: none; }
  .ug-flags summary::before { content: '\25B6 '; font-size: 9px; margin-right: 6px; }
  .ug-flags details[open] summary::before { content: '\25BC '; }
  .ug-flags ul { margin: 12px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .ug-flags li {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--navy-muted);
