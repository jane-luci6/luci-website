  .ug-pillar__name :global(.ug-pillar__ctrl) { color: var(--accent-light); }
  .ug-pillar__summary {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--navy-muted);
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .ug-pillar__pills {
    list-style: none;
