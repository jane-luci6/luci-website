  /* ============================================================
     SECTION LOCKUP HEADERS — mint wash (matches live UG)
     Soft mint wash band + ink/accent-light duo + split mint|gold-deep
     rule. Full-bleed wash band; lockup type shares container--wide inset.
     ============================================================ */
  .ug-headers :global(.header-lockup__name em) { font-style: normal; }

  .ug-headers--alt :global(.section--light) :global(.header-lockup),
  .ug-headers--alt :global(.section--white) :global(.header-lockup) {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-bottom: var(--space-5);
    padding-top: 26px;
    padding-bottom: 28px;
    padding-left: max(var(--page-pad), calc(50vw - var(--content-wide) / 2 + var(--page-pad)));
    padding-right: max(var(--page-pad), calc(50vw - var(--content-wide) / 2 + var(--page-pad)));
    box-sizing: border-box;
    background:
      linear-gradient(180deg, rgba(var(--mint-rgb), 0.14) 0%, rgba(var(--mint-rgb), 0.06) 100%),
      var(--off-white);
    border-bottom: 1px solid rgba(var(--mint-rgb), 0.28);
