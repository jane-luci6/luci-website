  .ug-headers--alt :global(.section--deep) :global(.header-lockup__name em),
  .ug-headers--alt :global(.section--mid) :global(.header-lockup__name em) {
    color: var(--gold);
  }
  .ug-headers--alt :global(.section--deep) :global(.header-lockup__rule),
  .ug-headers--alt :global(.section--mid) :global(.header-lockup__rule) {
    width: 72px;
    height: 3px;
    background: linear-gradient(90deg, var(--mint) 0 40px, transparent 40px 44px, var(--gold) 44px 72px);
  }
  .ug-headers--alt :global(.header-lockup__name:not(:has(em)))::after {
    content: '';
    display: block;
    width: 72px;
    height: 3px;
    margin-top: 12px;
    background: linear-gradient(90deg, var(--accent-light) 0 40px, transparent 40px 44px, var(--gold-deep, #CEB06E) 44px 72px);
  }
  .ug-headers--alt :global(.section--deep) :global(.header-lockup__name:not(:has(em)))::after,
  .ug-headers--alt :global(.section--mid) :global(.header-lockup__name:not(:has(em)))::after {
