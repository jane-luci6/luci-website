  }

  @media (max-width: 640px) {
    .ug-feature__body, .ug-tech-item__details { padding-left: 0 !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ug-back-to-top { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var switcher = document.querySelector('[data-thesis-switcher]');
    if (!switcher) return;
    var btns = Array.prototype.slice.call(switcher.querySelectorAll('[data-thesis-btn]'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.ug-energy-thesis'));

    function activate(id, opts) {
      var o = opts || {};
      var matched = false;
      btns.forEach(function (b) {
        var match = String(b.getAttribute('data-thesis-btn')).toUpperCase() === String(id).toUpperCase();
        if (match) matched = true;
        b.setAttribute('aria-selected', match ? 'true' : 'false');
        b.tabIndex = match ? 0 : -1;
      });
      panels.forEach(function (p) {
        var match = String(p.getAttribute('data-thesis')).toUpperCase() === String(id).toUpperCase();
        if (match) {
          p.removeAttribute('hidden');
          p.classList.add('is-active');
        } else {
          p.setAttribute('hidden', '');
          p.classList.remove('is-active');
        }
      });
      if (!matched) return;
      if (!o.skipHistory) {
        var url = new URL(window.location.href);
        url.searchParams.set('thesis', String(id).toUpperCase());
        window.history.replaceState(null, '', url.toString());
      }
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        activate(b.getAttribute('data-thesis-btn'));
      });
    });

    // Keyboard arrow navigation between tabs
    btns.forEach(function (b, i) {
      b.addEventListener('keydown', function (e) {
        var idx = i;
        if (e.key === 'ArrowRight') { e.preventDefault(); btns[(idx + 1) % btns.length].focus(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); btns[(idx - 1 + btns.length) % btns.length].focus(); }
        else if (e.key === 'Home') { e.preventDefault(); btns[0].focus(); }
        else if (e.key === 'End') { e.preventDefault(); btns[btns.length - 1].focus(); }
      });
    });

    // Deep-link: ?thesis=A|B|C wins; else #thesis-a hash; else default C
    // (Jane lock preference — Release sheet).
    var params = new URLSearchParams(window.location.search);
    var requested = params.get('thesis');
    if (!requested) {
      var hash = window.location.hash.replace(/^#thesis-/, '');
      if (/^[a-c]$/i.test(hash)) requested = hash;
    }
    if (requested && /^[a-c]$/i.test(requested)) {
      activate(requested.toUpperCase(), { skipHistory: true });
    } else {
      activate('C', { skipHistory: true });
    }

    // Back-to-top
    var btt = document.querySelector('[data-ug-back-to-top]');
    if (btt) {
      var onScroll = function () {
        if (window.scrollY > window.innerHeight * 0.6) btt.classList.add('is-visible');
        else btt.classList.remove('is-visible');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      btt.addEventListener('click', function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
      onScroll();
    }
  })();
</script>
