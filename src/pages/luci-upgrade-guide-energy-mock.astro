---
/**
 * UG first-section ENERGY MOCK — preview only.
 *
 * Jane wants to SEE three Upgrade Guide first-section energy theses (A/B/C)
 * before picking. Dedicated preview route:
 *   http://10.10.1.37/luci-upgrade-guide-energy-mock/
 *
 * Live `/luci-upgrade-guide/` is untouched and stays working. This page uses
 * AssetLayout (matches live UG). Only hero + thesis differ across A/B/C;
 * pillars -> CTA are reused from live `upgradeGuide` data + markup so Jane
 * sees each thesis in full-page context.
 *
 * Video = PLACEHOLDER ONLY. The plate is a labeled empty frame. No real video
 * files are created, borrowed, or referenced. Nothing under public/videos/.
 * Play affordance (B only) is a decorative aria-hidden span, pointer-events
 * none — not a button, not focusable, no handler.
 *
 * Mock-specific classes: `.ug-energy-*` (hero/thesis variants) and
 * `.ug-mock-*` (banner/switcher chrome). Live CSS is not polluted.
 *
 * Jane lock (2026-09-28): prefer thesis C. Ghost oversize date watermark
 * moved OUT of hero (too busy / unnoticed) → vertical left margin of the
 * first content section (thesis / mint band). C beats otherwise kept:
 * wider right-bleed media, dashed mint inset, two-cell eyebrow/date row,
 * full-width mint hairline. Placeholder only; GPT recommended copy stays.
 */
import AssetLayout from '../layouts/AssetLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import { breadcrumb } from '../data/seo';
import { upgradeGuide } from '../data/upgradeGuide';
import { upgradeGuideEnergyMock } from '../data/upgradeGuideEnergyMock';

const {
  pillars,
  supportSpotlight,
  features,
  technical,
  upgradePath,
  faq,
  cta,
  openFlags,
} = upgradeGuide;

const { theses, slotLabel } = upgradeGuideEnergyMock;

const featuresByPillar = (pillarId: string) =>
  features.filter((f) => f.pillarId === pillarId);

const meta = {
  path: '/luci-upgrade-guide-energy-mock',
  title: 'Upgrade Guide first-section energy mock (preview) | LUCI Systems',
  description:
    'Preview-only mock of three energy theses for the Upgrade Guide first section. Not a live page.',
};

const breadcrumbLd = breadcrumb([
  { name: 'Home', path: '/' },
  { name: 'New LUCI Upgrade Guide', path: '/luci-upgrade-guide' },
  { name: 'Energy mock (preview)', path: meta.path },
]);

const duoLockups = {
  thesis: 'The only A/V that scales and improves <em>is about to get even better</em>',
  pillars: 'What the release puts <em>in your hands</em>',
  features: 'Feature <em>deep-dive</em>',
  technical: 'Technical <em>detail</em>',
  upgrade: 'Your path to the <em>new LUCI</em>',
  faq: 'Questions',
  cta: 'The <em>new version</em> of LUCI',
} as const;
---

<AssetLayout
  title={meta.title.replace(' | LUCI Systems', '')}
  description={meta.description}
  canonicalPath={meta.path}
  noindex
  theme="light"
>
  <h1 class="ug-sr-only">{meta.title}</h1>

  {/* ───────── PREVIEW BANNER ───────── */}
  <div class="ug-mock-banner" role="status" aria-live="polite">
    <div class="ug-mock-banner__inner container container--wide">
      <span class="ug-mock-banner__tag" aria-hidden="true">PREVIEW MOCK</span>
      <span class="ug-mock-banner__copy">
        <strong>PREVIEW MOCK &mdash; not live.</strong> Pick A/B/C above; live guide untouched.
        <a class="ug-mock-banner__link" href="/luci-upgrade-guide/">Back to live guide &rarr;</a>
      </span>
    </div>
  </div>
  {/* ───────── STICKY A/B/C SWITCHER ───────── */}
  <nav class="ug-mock-switcher" aria-label="Energy thesis switcher" data-thesis-switcher>
    <div class="ug-mock-switcher__inner container container--wide">
      <span class="ug-mock-switcher__title">UG first-section &mdash; energy thesis</span>
      <div class="ug-mock-switcher__btns" role="tablist" aria-label="Pick an energy thesis">
        {theses.map((t, idx) => (
          <button
            type="button"
            class="ug-mock-switcher__btn"
            data-thesis-btn={t.id}
            role="tab"
            aria-selected={t.id === 'C' ? 'true' : 'false'}
            aria-controls={`ug-energy-thesis-${t.id}`}
            id={`ug-energy-tab-${t.id}`}
          >
            <span class="ug-mock-switcher__num">{t.label}</span>
            <span class="ug-mock-switcher__lbl">
              <span class="ug-mock-switcher__name">{t.name}</span>
              <span class="ug-mock-switcher__sub">{t.sublabel}</span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </nav>
  {/* ───────── THREE THESES — one visible at a time (hero + thesis only) ───────── */}
  {theses.map((t, idx) => (
    <div
      class:list={['ug-energy-thesis', `ug-energy-thesis--${t.id.toLowerCase()}`, { 'is-active': t.id === 'C' }]}
      id={`ug-energy-thesis-${t.id}`}
      data-thesis={t.id}
      role="tabpanel"
      aria-labelledby={`ug-energy-tab-${t.id}`}
      hidden={t.id !== 'C'}
    >
      {/* ───────── HERO — dark masthead + mesh (unchanged layers) ───────── */}
      <section id={`ug-energy-hero-${t.id}`} class="ug-energy-hero">
        <span class="ug-energy-hero__mesh" aria-hidden="true"></span>
        <span class="ug-energy-hero__plan" aria-hidden="true"></span>
        <span class="ug-energy-hero__scrim" aria-hidden="true"></span>
        <div class="ug-energy-hero__inner container container--wide">
          {t.id === 'A' && (
            <>
              <span class="ug-energy-hero__rule" aria-hidden="true"></span>
              <p class="ug-energy-hero__eyebrow ug-energy-hero__eyebrow--A">{t.hero.eyebrow}</p>
              <h2 class="ug-energy-hero__headline ug-energy-hero__headline--A">
                {t.hero.headline.leading}<span class="ug-energy-hero__accent">{t.hero.headline.mintAccent}</span>{t.hero.headline.trailing}
              </h2>
              <div class="ug-energy-hero__release ug-energy-hero__release--A">
                <span class="ug-energy-hero__rlabel">Release date</span>
                <span class="ug-energy-hero__date">{t.hero.date}</span>
              </div>
              <div class="ug-energy-hero__ctas">
                {t.hero.ctas.map((c) => (
                  <a class:list={['btn', c.audience === 'prospects' ? 'btn--mint' : 'btn--mint-outline']} href={c.href}>{c.label}</a>
                ))}
              </div>
            </>
          )}

          {t.id === 'B' && (
            <>
              <p class="ug-energy-hero__eyebrow ug-energy-hero__eyebrow--B">
                <span class="ug-energy-hero__chip">{t.hero.eyebrow}</span>
              </p>
              <h2 class="ug-energy-hero__headline ug-energy-hero__headline--B">
                {t.hero.headline.leading}<span class="ug-energy-hero__accent">{t.hero.headline.mintAccent}</span>{t.hero.headline.trailing}
              </h2>
              <div class="ug-energy-hero__release ug-energy-hero__release--B">
                <span class="ug-energy-hero__rlabel">Release date</span>
                <span class="ug-energy-hero__divider" aria-hidden="true"></span>
                <span class="ug-energy-hero__date ug-energy-hero__date--B">{t.hero.date}</span>
              </div>
              <span class="ug-energy-hero__hr" aria-hidden="true"></span>
              <div class="ug-energy-hero__ctas">
                {t.hero.ctas.map((c) => (
                  <a class:list={['btn', c.audience === 'prospects' ? 'btn--mint' : 'btn--mint-outline']} href={c.href}>{c.label}</a>
                ))}
              </div>
            </>
          )}

          {t.id === 'C' && (
            <>
              <div class="ug-energy-hero__specrow">
                <p class="ug-energy-hero__eyebrow ug-energy-hero__eyebrow--C">{t.hero.eyebrow}</p>
                <span class="ug-energy-hero__specrule" aria-hidden="true"></span>
                <p class="ug-energy-hero__speclabel">{t.hero.date}</p>
              </div>
              <h2 class="ug-energy-hero__headline ug-energy-hero__headline--C">
                {t.hero.headline.leading}<span class="ug-energy-hero__accent">{t.hero.headline.mintAccent}</span>{t.hero.headline.trailing}
              </h2>
              <div class="ug-energy-hero__release ug-energy-hero__release--C">
                <span class="ug-energy-hero__rlabel">Release date</span>
                <span class="ug-energy-hero__date">{t.hero.date}</span>
              </div>
              <div class="ug-energy-hero__ctas">
                {t.hero.ctas.map((c) => (
                  <a class:list={['btn', c.audience === 'prospects' ? 'btn--mint' : 'btn--mint-outline']} href={c.href}>{c.label}</a>
                ))}
              </div>
            </>
          )}
        </div>
        <span class={`ug-energy-hero__bar ug-energy-hero__bar--${t.id}`} aria-hidden="true"></span>
      </section>

      {/* ───────── THESIS — text left, framed media right ───────── */}
      {/* C: ghost oversize date moved OUT of hero (Jane: header too busy;
          watermark unnoticed there) → vertical along left margin of this
          mint thesis band, between the upper lockup wash and the lower
          pillars wash. A/B unchanged. */}
      <div class:list={['ug-headers', 'ug-headers--alt', { 'ug-energy-thesis-band--c': t.id === 'C' }]}>
      <SectionBlock
        id={`ug-energy-thesis-section-${t.id}`}
        lockupName={duoLockups.thesis}
        tone="light"
        wide
      >
        <div class={`ug-energy-thesis-grid ug-energy-thesis-grid--${t.id.toLowerCase()}`}>
          {t.id === 'C' && (
            <span class="ug-energy-side-ghostdate" aria-hidden="true">{t.hero.date}</span>
          )}
          <div class="ug-energy-thesis-copy">
            {t.thesis.paragraphs.map((para) => (
              <p class="ug-energy-thesis-para">{para}</p>
            ))}
          </div>
          <div class="ug-energy-media">
            <div class={`ug-energy-media__frame ug-energy-media__frame--${t.id.toLowerCase()}`}>
              <div class={`ug-energy-media__plate ug-energy-media__plate--${t.id.toLowerCase()}`}>
                {t.id === 'B' && (
                  <span class="ug-energy-media__play" aria-hidden="true">
                    <span class="ug-energy-media__play-circle"></span>
                    <span class="ug-energy-media__play-tri"></span>
                  </span>
                )}
                <div class={`ug-energy-media__label ug-energy-media__label--${t.id.toLowerCase()}`}>
                  {t.id === 'A' && (
                    <>
                      <span class="ug-energy-media__dot" aria-hidden="true"></span>
                      <span class="ug-energy-media__label-primary">{slotLabel}</span>
                    </>
                  )}
                  {t.id === 'B' && (
                    <>
                      <span class="ug-energy-media__label-primary">{slotLabel}</span>
                      <span class="ug-energy-media__label-secondary">Video coming soon</span>
                    </>
                  )}
                  {t.id === 'C' && (
                    <>
                      <span class="ug-energy-media__label-primary">{slotLabel}</span>
                      <span class="ug-energy-media__label-secondary">Reserved media slot</span>
                    </>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </SectionBlock>
      </div>{/* /ug-headers mint wash for thesis lockup */}
    </div>
  ))}
  {/* ═══════════════════════════════════════════════════════════════
       SHARED SECTIONS — pillars → CTA (reused from live upgradeGuide data +
       markup). Unchanged across A/B/C. Live CSS patterns copied so the mock
       renders self-contained. In-page feature links point to the live guide
       so anchors stay functional. Video = placeholder only (no real assets).
       ═══════════════════════════════════════════════════════════════ */}
  <div class="ug-headers ug-headers--alt">

    {/* ───────── 3. PILLARS OVERVIEW ───────── */}
    <SectionBlock
      id="ug-energy-pillars"
      lockupName={duoLockups.pillars}
      tone="light"
      wide
    >
      <div class="ug-pillars">
        {pillars.map((p) => (
          <article class="ug-pillar">
            <div class="ug-pillar__head">
              <span class="ug-pillar__num" aria-hidden="true">{p.number}</span>
              <h3 class="ug-pillar__name" set:html={p.name.replace('control', '<span class="ug-pillar__ctrl">control</span><br>')} />
            </div>
            <p class="ug-pillar__summary">{p.summary}</p>
            <ul class="ug-pillar__pills" role="list">
              {p.featurePills.map((pill) => (
                <li>
                  <a class="ug-pill" href={`/luci-upgrade-guide/#ug-feature-${pill.id}`} data-feature={pill.id}>
                    <span class="ug-pill__name">{pill.name}</span>
                    <span class="ug-pill__liner">{pill.oneLiner}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <a class="ug-support-spotlight" href={`/luci-upgrade-guide/#ug-feature-${supportSpotlight.featureId}`}>
        <span class="ug-support-spotlight__plus">Plus</span>
        <span class="ug-support-spotlight__name">{supportSpotlight.title}</span>
        <span class="ug-support-spotlight__liner">{supportSpotlight.oneLiner}</span>
        <span class="ug-support-spotlight__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </SectionBlock>

    {/* ───────── 4. FEATURE DEEP-DIVE ───────── */}
    <SectionBlock
      id="ug-energy-features"
      lockupName={duoLockups.features}
      lockupRole="See the live guide for the full deep-dive"
      tone="deep"
      wide
    >
      <div class="ug-deepdive">
        {pillars.map((pillar) => (
          <div class="ug-pillar-group" id={`ug-energy-pillar-${pillar.id}`}>
            <div class="ug-pillar-group__head">
              <h3 class="ug-pillar-group__title">
                <span class="ug-pillar-group__num">{pillar.number}</span>
                {pillar.name}
              </h3>
            </div>
            <div class="ug-features">
              {featuresByPillar(pillar.id).map((f) => (
                <article class="ug-feature ug-feature--open" id={`ug-energy-feature-${f.id}`} data-pillar={pillar.id}>
                  <header class="ug-feature__summary">
                    <span class="ug-feature__name">{f.name}</span>
                    <span class="ug-feature__liner">{f.oneLiner}</span>
                  </header>
                  <div class="ug-feature__body">
                    {f.scenarios && f.scenarios.length > 0 ? (
                      <div class="ug-feature-deep">
                        <section class="ug-feature-deep__section">
                          <p class="ug-feature-deep__label">What it is</p>
                          {f.paragraph.split(/\n\n+/).map((para) => (
                            <p class="ug-feature__paragraph">{para}</p>
                          ))}
                        </section>
                        <section class="ug-feature-deep__section">
                          <p class="ug-feature-deep__label">{f.scenariosSubsectionLabel ?? 'Use cases on your property'}</p>
                          <div class="ug-feature-scenarios">
                            {f.scenarios.map((s) => (
                              <div class="ug-feature-scenario">
                                {s.image && (
                                  <img
                                    class="ug-feature-scenario__img"
                                    src={s.image}
                                    alt=""
                                    width="640"
                                    height="853"
                                    loading="lazy"
                                    decoding="async"
                                    style={s.imagePosition ? `object-position: ${s.imagePosition}` : undefined}
                                  />
                                )}
                                <span class="ug-feature-scenario__scrim" aria-hidden="true"></span>
                                <div class="ug-feature-scenario__copy">
                                  <p class="ug-feature-scenario__title">{s.label}</p>
                                  <p class="ug-feature-scenario__line">{s.line}</p>
                                </div>
                              </div>
                            ))}
                          </div>
                        </section>
                        {f.limits && f.limits.length > 0 && (
                          <section class="ug-feature-deep__section">
                            <p class="ug-feature-deep__label">Limits &amp; controls</p>
                            <ul class="ug-feature-limits" role="list">
                              {f.limits.map((l) => (<li>{l}</li>))}
                            </ul>
                          </section>
                        )}
                        {f.technicalJumpId && (
                          <a class="ug-feature-itlink" href={`/luci-upgrade-guide/#ug-tech-item-${f.technicalJumpId}`}>
                            Technical detail &rarr;
                          </a>
                        )}
                      </div>
                    ) : (
                      <>
                        <p class="ug-feature__paragraph">{f.paragraph}</p>
                        <ul class="ug-feature__benefits" role="list">
                          {f.benefits.map((b) => (<li>{b}</li>))}
                        </ul>
                      </>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </SectionBlock>

    {/* ───────── 6. TECHNICAL DETAIL ───────── */}
    <SectionBlock
      id="ug-energy-technical"
      lockupName={duoLockups.technical}
      lockupRole="For the IT or A/V lead"
      tone="light"
      wide
    >
      <p class="ug-thesis">{technical.intro}</p>
      <div class="ug-technical">
        {technical.groups.map((group) => (
          <div class="ug-tech-group" id={`ug-energy-tech-${group.id}`}>
            <h3 class="ug-tech-group__title">{group.heading}</h3>
            <p class="ug-tech-group__intro">{group.intro}</p>
            <div class="ug-tech-items">
              {group.items.map((item) => (
                <details class="ug-tech-item" id={`ug-energy-tech-item-${item.id}`}>
                  <summary class="ug-tech-item__summary">
                    <span class="ug-tech-item__name">{item.name}</span>
                    {item.summary && <span class="ug-tech-item__summary-text">{item.summary}</span>}
                    <span class="ug-feature__chev" aria-hidden="true"></span>
                  </summary>
                  <ul class="ug-tech-item__details" role="list">
                    {item.details.map((d) => (<li>{d}</li>))}
                  </ul>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </SectionBlock>

    {/* ───────── 7. UPGRADE PATH ───────── */}
    <SectionBlock
      id="ug-energy-upgrade"
      lockupName={duoLockups.upgrade}
      lockupRole="For existing LUCI clients"
      tone="light"
      wide
    >
      <p class="ug-thesis">{upgradePath.intro}</p>
      <div class="ug-upgrade">
        <div class="ug-upgrade__timing" role="group" aria-label="Upgrade timing">
          <div class="ug-upgrade__timing-cell">
            <span class="ug-upgrade__timing-label">{upgradePath.timing.releaseLabel}</span>
            <span class="ug-upgrade__timing-value ug-upgrade__timing-value--date">{upgradePath.timing.releaseDate}</span>
          </div>
          <div class="ug-upgrade__timing-cell">
            <span class="ug-upgrade__timing-label">Pace</span>
            <span class="ug-upgrade__timing-value">{upgradePath.timing.paceLine}</span>
          </div>
        </div>
        <p class="ug-upgrade__rollout-note">{upgradePath.timing.rolloutNote}</p>
        <div class="ug-upgrade__how">
          <h3 class="ug-upgrade__subhead">{upgradePath.whatIsInvolved.heading}</h3>
          <p class="ug-upgrade__how-intro">{upgradePath.whatIsInvolved.paragraph}</p>
          <ol class="ug-upgrade__steps" role="list">
            {upgradePath.whatIsInvolved.steps.map((s) => (
              <li class="ug-upgrade__step">
                <span class="ug-upgrade__step-num">{s.number}</span>
                <div class="ug-upgrade__step-copy">
                  <p class="ug-upgrade__step-title">{s.title}</p>
                  <p class="ug-upgrade__step-body">{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <a class="ug-upgrade__path-cta" href="/luci-upgrade-guide/#ug-cta">
          Talk to your account team about timing
          <span class="ug-upgrade__path-cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </SectionBlock>

    {/* ───────── 8. FAQ ───────── */}
    <SectionBlock
      id="ug-energy-faq"
      lockupName={duoLockups.faq}
      lockupRole="Straight answers"
      tone="light"
      wide
    >
      <div class="ug-faq">
        {faq.map((f, i) => (
          <details class="ug-faq__item" id={`ug-energy-faq-${i + 1}`}>
            <summary class="ug-faq__q">{f.question}</summary>
            <p class="ug-faq__a">{f.answer}</p>
          </details>
        ))}
      </div>
    </SectionBlock>

    {/* ───────── 9. CTA ───────── */}
    <SectionBlock id="ug-energy-cta" lockupName={duoLockups.cta} lockupRole={cta.heading} tone="deep" wide>
      <p class="ug-cta__body">{cta.body}</p>
      <p class="ug-cta__contact">
        <strong>{cta.contact.name}</strong> &middot; {cta.contact.role}<br />
        <a href={`mailto:${cta.contact.email}`}>{cta.contact.email}</a> &middot; {cta.contact.phone}
      </p>
      <div class="ug-cta__actions">
        {cta.actions.map((a) => (
          <a class:list={['btn', a.audience === 'prospects' ? 'btn--mint' : 'btn--mint-outline']} href={a.href}>{a.label}</a>
        ))}
      </div>
    </SectionBlock>

    {/* ───────── Back-to-top ───────── */}
    <button class="ug-back-to-top" type="button" aria-label="Back to top" data-ug-back-to-top>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15" />
      </svg>
    </button>

  </div>{/* /ug-headers mint wash */}

  {/* ───────── Open flags for Jane review (collapsed by default) ───────── */}
  <aside class="ug-flags" aria-label="Open flags for Jane review">
    <details>
      <summary>Open flags for Jane review ({openFlags.length})</summary>
      <ul>
        {openFlags.map((flag) => (<li>{flag}</li>))}
      </ul>
    </details>
  </aside>

</AssetLayout>

<style>
  /* ───────── sr-only ───────── */
  .ug-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Section scroll offset for sticky switcher */
  #ug-energy-thesis-A, #ug-energy-thesis-B, #ug-energy-thesis-C,
  #ug-energy-pillars, #ug-energy-features, #ug-energy-technical,
  #ug-energy-upgrade, #ug-energy-faq, #ug-energy-cta,
  [id^="ug-energy-feature-"], [id^="ug-energy-tech-"], [id^="ug-energy-pillar-"] {
    scroll-margin-top: 72px;
  }
  @media (max-width: 640px) {
    #ug-energy-thesis-A, #ug-energy-thesis-B, #ug-energy-thesis-C,
    #ug-energy-pillars, #ug-energy-features, #ug-energy-technical,
    #ug-energy-upgrade, #ug-energy-faq, #ug-energy-cta,
    [id^="ug-energy-feature-"], [id^="ug-energy-tech-"], [id^="ug-energy-pillar-"] {
      scroll-margin-top: 64px;
    }
  }

  /* ───────── PREVIEW BANNER ───────── */
  .ug-mock-banner {
    background: #2a1a06;
    color: var(--off-white);
    border-bottom: 1px solid rgba(237, 208, 134, 0.4);
  }
  .ug-mock-banner__inner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px var(--page-pad);
    flex-wrap: wrap;
  }
  .ug-mock-banner__tag {
    font-family: var(--font-head);
