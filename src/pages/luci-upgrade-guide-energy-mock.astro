    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease, background 0.18s, color 0.18s;
  }
  .ug-back-to-top.is-visible { opacity: 1; pointer-events: auto; transform: none; }
  .ug-back-to-top:hover { background: var(--mint); color: var(--navy-deep); border-color: var(--mint); }
  .ug-back-to-top:focus-visible { outline: 2px solid var(--mint); outline-offset: 3px; }
  .ug-back-to-top svg { width: 18px; height: 18px; }

  /* ---------- Open flags (Jane review only) ---------- */
  .ug-flags {
    max-width: var(--content-wide);
