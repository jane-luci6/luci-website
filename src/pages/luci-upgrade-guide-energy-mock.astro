    padding: clamp(20px, 2.4vw, 28px);
  }
  .ug-pillars .ug-pillar:nth-child(1) { background: linear-gradient(155deg, #E8EEF2 0%, #F3F6F8 100%); }
  .ug-pillars .ug-pillar:nth-child(2) { background: linear-gradient(155deg, #EBF9F4 0%, #F4FCF9 100%); }
  .ug-pillars .ug-pillar:nth-child(3) { background: linear-gradient(155deg, #D4EFE4 0%, #E8F6EF 100%); }
  .ug-pillar__head {
