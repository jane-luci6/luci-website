---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudySamsTown from '../../../components/CaseStudySamsTown.astro';
import { samsTownCaseStudy, site } from '../../../data/site';
import { getCaseStudySeo, breadcrumb } from '../../../data/seo';

const slug = samsTownCaseStudy.slug;
const csSeo = getCaseStudySeo(slug);
const canonicalPath = `/resources/case-studies/${slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${samsTownCaseStudy.title} — Sam's Town`,
  description: csSeo.description,
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: `${site.url}${canonicalPath}`,
  ...breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
    { name: 'Case studies', path: '/resources/case-studies' },
    { name: "Sam's Town", path: canonicalPath },
  ]),
};
---

<BaseLayout
  title={csSeo.title}
  description={csSeo.description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <CaseStudySamsTown />
</BaseLayout>
