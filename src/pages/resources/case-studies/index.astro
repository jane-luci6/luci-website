---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionBlock from '../../../components/SectionBlock.astro';
import { ameristarCaseStudy, tachiCaseStudy, portfolioLine } from '../../../data/site';
import { seoPages, breadcrumb } from '../../../data/seo';

const caseStudies = [ameristarCaseStudy, tachiCaseStudy];
---

<BaseLayout
  title={seoPages['/resources/case-studies'].title}
  description={seoPages['/resources/case-studies'].description}
  canonicalPath="/resources/case-studies"
  jsonLd={breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
    { name: 'Case studies', path: '/resources/case-studies' },
  ])}
>
  <PageHero title="Case studies" lead={portfolioLine} deep />

  <SectionBlock lockupName="Featured" tone="light" wide>
    <ul class="cs-index">
      {caseStudies.map((cs) => {
        const href = `/resources/case-studies/${cs.slug}`;
        return (
          <li class="cs-card">
            <a class="cs-card__media" href={href} aria-label={cs.title}>
              {cs.poster ? (
                <img src={cs.poster} alt={`${cs.property} case study`} loading="lazy" />
              ) : cs.cardMedia ? (
                <span class="cs-card__logo-panel">
                  <img src={cs.cardMedia} alt={`${cs.property} logo`} />
                </span>
              ) : (
                <span class="cs-card__logo-panel"></span>
              )}
            </a>
            <div class="cs-card__body">
              <p class="cs-card__kicker"><span>Case Study</span></p>
              <h3 class="cs-card__title"><a href={href}>{cs.title}</a></h3>
              <p class="cs-card__meta">{cs.property} <span>· {cs.location}</span></p>
              <p class="cs-card__dek">{cs.dek}</p>
              <div class="cs-card__links">
                <a class="cs-card__cta" href={href}>Read the full story <span aria-hidden="true">→</span></a>
                <a class="cs-card__pdf" href={cs.pdfHref} target="_blank" rel="noopener noreferrer">Download PDF <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </SectionBlock>
</BaseLayout>

<style>
  .cs-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .cs-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--rule-light);
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .cs-card:hover {
    border-color: rgba(43, 158, 128, 0.45);
    box-shadow: 0 24px 48px rgba(26, 43, 51, 0.12);
    transform: translateY(-3px);
  }

  .cs-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy-deep);
    position: relative;
  }

  .cs-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .cs-card:hover .cs-card__media img {
    transform: scale(1.04);
  }

  .cs-card__logo-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--navy-deep);
    background-image: url('/images/textures/texture-circuit-navy-steel-print-dark.jpg');
    background-size: cover;
    background-position: center;
  }

  .cs-card__logo-panel img {
    width: 62%;
    max-width: 300px;
    height: auto;
    object-fit: contain;
  }

  .cs-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    flex: 1;
  }

  .cs-card__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 2px;
  }

  .cs-card__kicker::before {
    content: '';
    width: 24px;
    height: 2px;
    background: var(--accent-light);
  }

  .cs-card__kicker span {
    font-family: var(--font-head);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .cs-card__title {
    font-family: var(--font-head);
    font-size: clamp(22px, 2.4vw, 26px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .cs-card__title a {
    color: var(--ink-strong);
    text-decoration: none;
  }

  .cs-card__title a:hover {
    color: var(--accent-light);
  }

  .cs-card__meta {
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-strong);
    margin: 0;
  }

  .cs-card__meta span {
    font-weight: 400;
    color: var(--navy-muted);
  }

  .cs-card__dek {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
    flex: 1;
  }

  .cs-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 4px;
    padding-top: 18px;
    border-top: 1px solid var(--rule-light);
  }

  .cs-card__cta {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-light);
    text-decoration: none;
  }

  .cs-card__cta span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .cs-card__cta:hover span {
    transform: translateX(4px);
  }

  .cs-card__pdf {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-muted);
    text-decoration: none;
  }

  .cs-card__pdf:hover {
    color: var(--ink-strong);
  }

  @media (max-width: 760px) {
    .cs-index {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cs-card__body {
      padding: 24px;
    }
  }
</style>
