---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MeshHero from '../../../components/MeshHero.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import ResourceCardGrid from '../../../components/ResourceCardGrid.astro';
import SectionBlock from '../../../components/SectionBlock.astro';
import { ameristarCaseStudy, tachiCaseStudy, samsTownCaseStudy, yaamavaCaseStudy, alianteCaseStudy, portfolioLine } from '../../../data/site';
import { seoPages, breadcrumb } from '../../../data/seo';

const caseStudies = [yaamavaCaseStudy, ameristarCaseStudy, tachiCaseStudy, samsTownCaseStudy, alianteCaseStudy];
---

<BaseLayout
  title={seoPages['/resources/case-studies'].title}
  description={seoPages['/resources/case-studies'].description}
  canonicalPath="/resources/case-studies"
  jsonLd={breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
    { name: 'Case studies', path: '/resources/case-studies' },
  ])}
  darkHeader
>
  <MeshHero
    id="case-studies-hero"
    kicker="Resources"
    title="Case studies"
    deck={portfolioLine}
    label="Case studies"
  />

  <SectionBlock id="cs-index" lockupName="Featured" tone="light" wide>
    <ResourceCardGrid>
      {caseStudies.map((cs) => {
        const href = `/resources/case-studies/${cs.slug}`;
        const poster = 'poster' in cs ? cs.poster : undefined;
        const cardMedia = 'cardMedia' in cs ? cs.cardMedia : undefined;
        return (
          <ResourceCard
            href={href}
            title={cs.title}
            dek={cs.dek}
            kicker="Case Study"
            cta="Read the full story"
            imageSrc={poster}
            imageAlt={poster ? `${cs.property} case study` : undefined}
            logoSrc={!poster && cardMedia ? cardMedia : undefined}
            logoAlt={!poster && cardMedia ? `${cs.property} logo` : undefined}
            meta={cs.property}
            metaNote={cs.location}
            pdfHref={'pdfHref' in cs && cs.pdfHref ? cs.pdfHref : undefined}
          />
        );
      })}
    </ResourceCardGrid>
  </SectionBlock>
</BaseLayout>

<style>
  :global(#case-studies-hero > .container.container--wide),
  :global(#cs-index > .container.container--wide) {
    max-width: 1360px;
  }
</style>
