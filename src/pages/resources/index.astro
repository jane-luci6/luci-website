---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import { ameristarCaseStudy, tachiCaseStudy, samsTownCaseStudy, yaamavaCaseStudy, site } from '../../data/site';
import { seoPages, breadcrumb } from '../../data/seo';

const FAG_PDF = '/resources/field-activation-guide-prospect.pdf';

const caseStudies = [yaamavaCaseStudy, ameristarCaseStudy, tachiCaseStudy, samsTownCaseStudy];

const guides = [
  {
    href: '/resources/field-activation-guide',
    logo: '/images/logos/luci-full-mintmark-white.png',
    logoAlt: 'LUCI logo',
    kicker: 'Field Guide',
    title: 'The Field Activation Guide',
    meta: 'How LUCI rolls out on your floor',
    desc: 'How LUCI deploys onto your existing environment — in phases, on your budget and timeline. Every step from assessment to handoff, documented.',
    cta: 'Read the guide',
    download: false,
  },
];

const newsletter = [
  {
    href: 'https://www.lucisystems.com/the-signal/home',
    logo: '/images/logos/luci-full-mintmark-white.png',
    logoAlt: 'LUCI logo',
    kicker: 'Newsletter',
    title: 'The Signal',
    meta: 'LUCI’s field newsletter',
    desc: 'New platform capabilities, stories from the field, and the people building it — published on lucisystems.com.',
    cta: 'Read the latest issue',
    external: true,
  },
];
---

<BaseLayout
  title={seoPages['/resources'].title}
  description={seoPages['/resources'].description}
  canonicalPath="/resources"
  jsonLd={breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
  ])}
  darkHeader
>
  <h1 class="res-sr-only">Resources</h1>

  <section id="res-hero" class="res-hero" aria-label="LUCI resources">
    <div class="res-hero__mesh" aria-hidden="true"></div>
    <div class="res-hero__inner container container--wide">
      <p class="display-label res-hero__kicker">Resources</p>
      <h2 class="res-hero__title">See LUCI <em>on real floors</em>.</h2>
      <p class="res-hero__deck">
        Case studies, guides, and field documentation — everything you need to understand
        what LUCI looks like on a property like yours, and how it gets there.
      </p>
    </div>
  </section>

  <nav class="res-tabs" aria-label="Resource categories">
    <div class="res-tabs__inner container container--wide">
      <button class="res-tab is-active" data-tab="all" type="button">All</button>
      <button class="res-tab" data-tab="case-studies" type="button">Case Studies</button>
      <button class="res-tab" data-tab="guides" type="button">Guides</button>
      <button class="res-tab" data-tab="video" type="button">Videos</button>
      <button class="res-tab" data-tab="blog" type="button">Blog</button>
      <button class="res-tab" data-tab="newsletter" type="button">Newsletter</button>
    </div>
  </nav>

  <SectionBlock
    id="res-case-studies"
    lockupName="Case Studies"
    deck="Real deployments, real timelines, real outcomes — what LUCI changed and what went away."
    tone="deep"
    wide
  >
    <ul class="res-grid" role="list" data-section="case-studies">
      {caseStudies.map((cs) => {
        const href = `/resources/case-studies/${cs.slug}`;
        return (
          <li class="res-card" data-type="case-studies">
            <a class="res-card__link" href={href}>
              <span class="res-card__media">
                {cs.poster ? (
                  <img src={cs.poster} alt={`${cs.property} case study`} loading="lazy" decoding="async" />
                ) : cs.cardMedia ? (
                  <span class="res-card__logo-panel">
                    <img src={cs.cardMedia} alt={`${cs.property} logo`} loading="lazy" decoding="async" />
                  </span>
                ) : (
                  <span class="res-card__logo-panel"></span>
                )}
              </span>
              <span class="res-card__body">
                <span class="res-card__kicker"><span>Case Study</span></span>
                <span class="res-card__title">{cs.title}</span>
                <span class="res-card__meta">{cs.property} <span>· {cs.location}</span></span>
                <span class="res-card__desc">{cs.dek}</span>
                <span class="res-card__cta">Read the story <span aria-hidden="true">&#8594;</span></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </SectionBlock>

  <SectionBlock
    id="res-guides"
    lockupName="Guides"
    deck="Documentation that walks through how LUCI deploys, operates, and scales on a real property."
    tone="deep"
    wide
  >
    <ul class="res-grid res-grid--guides" role="list" data-section="guides">
      {guides.map((g) => (
        <li class="res-card" data-type="guides">
          <a
            class="res-card__link"
            href={g.href}
            target={g.download ? '_blank' : undefined}
            rel={g.download ? 'noopener' : undefined}
            download={g.download ? '' : undefined}
          >
            <span class="res-card__media">
              <span class="res-card__logo-panel">
                <img src={g.logo} alt={g.logoAlt} loading="lazy" decoding="async" />
              </span>
            </span>
            <span class="res-card__body">
              <span class="res-card__kicker"><span>{g.kicker}</span></span>
              <span class="res-card__title">{g.title}</span>
              <span class="res-card__meta">{g.meta}</span>
              <span class="res-card__desc">{g.desc}</span>
              <span class="res-card__cta">{g.cta} <span aria-hidden="true">&#8594;</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </SectionBlock>

  <!-- VIDEO -->
  <SectionBlock
    id="res-video"
    lockupName="Videos"
    deck="Watch LUCI orchestrate real properties — screens, audio, signage, and A/V under one interface."
    tone="deep"
    wide
  >
    <div class="res-video" data-section="video">
      <div class="res-video__item">
        <p class="res-video__label">LUCI Platform Run</p>
        <video class="res-video__player" controls preload="none" poster="/videos/luci-platform-run-poster.jpg?v=3">
          <source src="/videos/luci-platform-run.mp4?v=4" type="video/mp4" />
        </video>
      </div>
      <div class="res-video__item">
        <p class="res-video__label">Aliante Sportsbook Case Study</p>
        <video class="res-video__player" controls preload="none" poster="/images/case-studies/aliante/wall-finished-wide-web.jpg?v=1">
          <source src="/videos/aliante-reel.mp4?v=1" type="video/mp4" />
        </video>
      </div>
    </div>
  </SectionBlock>

  <!-- BLOG -->
  <SectionBlock
    id="res-blog"
    lockupName="Blog"
    deck="Operational perspectives, deployment stories, and what we're learning from real properties."
    tone="deep"
    wide
  >
    <ul class="res-grid res-grid--blog" role="list" data-section="blog">
      <li class="res-card res-card--placeholder" data-type="blog">
        <span class="res-card__media res-card__soon">Coming soon</span>
        <span class="res-card__body">
          <span class="res-card__kicker"><span>Blog</span></span>
          <span class="res-card__title">Articles from the LUCI team</span>
          <span class="res-card__desc">Operational perspectives, deployment stories, and what we're learning from running real properties on LUCI.</span>
        </span>
      </li>
    </ul>
  </SectionBlock>

  <!-- NEWSLETTER -->
  <SectionBlock
    id="res-newsletter"
    lockupName="Newsletter"
    deck="The Signal — LUCI’s field newsletter. New platform capabilities, stories from the field, and the people building it."
    tone="deep"
    wide
  >
    <ul class="res-grid res-grid--newsletter" role="list" data-section="newsletter">
      {newsletter.map((n) => (
        <li class="res-card" data-type="newsletter">
          <a
            class="res-card__link"
            href={n.href}
            target={n.external ? '_blank' : undefined}
            rel={n.external ? 'noopener' : undefined}
          >
            <span class="res-card__media">
              <span class="res-card__logo-panel">
                <img src={n.logo} alt={n.logoAlt} loading="lazy" decoding="async" />
              </span>
            </span>
            <span class="res-card__body">
              <span class="res-card__kicker"><span>{n.kicker}</span></span>
              <span class="res-card__title">{n.title}</span>
              <span class="res-card__meta">{n.meta}</span>
              <span class="res-card__desc">{n.desc}</span>
              <span class="res-card__cta">{n.cta} <span aria-hidden="true">&#8594;</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </SectionBlock>

  <SectionBlock id="res-cta" tone="deep">
    <div class="res-cta">
      <p class="display-label res-cta__kicker">Next step</p>
      <h2 class="res-cta__title">See LUCI on <em>your floor</em>.</h2>
      <p class="res-cta__deck">Tell us what you're running — and what you'd like to stop managing.</p>
      <a class="btn btn--mint-outline res-cta__btn" href="/contact">{site.ctaPrimary}</a>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .res-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* ---------- HERO ---------- */
  .res-hero {
    position: relative; background: var(--navy-deep);
    overflow: hidden; isolation: isolate;
  }
  .res-hero__mesh {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-1920x1080.svg?v=1') center / cover no-repeat;
    mix-blend-mode: screen; opacity: 0.7;
  }
  .res-hero__mesh::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(10, 22, 28, 0.82) 18%, rgba(10, 22, 28, 0.82) 82%, transparent 100%);
  }
  .res-hero__inner {
    position: relative; z-index: 1;
    padding-block: clamp(64px, 9vw, 112px) clamp(40px, 5vw, 64px);
  }
  .res-hero__kicker { color: var(--mint); margin-bottom: var(--space-3); }
  .res-hero__title {
    margin: 0 0 var(--space-3); max-width: 18ch;
    font-family: var(--font-head); font-size: clamp(38px, 6vw, 64px);
    font-weight: 700; line-height: 1.04; letter-spacing: -0.03em; color: var(--off-white);
  }
  .res-hero__title em { font-style: normal; color: var(--gold); }
  .res-hero__deck {
    max-width: 56ch; font-family: var(--font-body);
    font-size: clamp(17px, 2vw, 20px); line-height: 1.6; color: rgba(245, 248, 250, 0.82);
  }

  /* ---------- TAB RAIL ---------- */
  .res-tabs {
    position: sticky; top: 64px; z-index: 50;
    background: rgba(10, 22, 28, 0.88);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(var(--mint-rgb), 0.16);
  }
  .res-tabs__inner {
    display: flex; gap: 8px; padding-block: 14px; overflow-x: auto; scrollbar-width: none;
  }
  .res-tabs__inner::-webkit-scrollbar { display: none; }
  .res-tab {
    flex-shrink: 0; padding: 8px 18px;
    font-family: var(--font-head); font-size: 13px; font-weight: 700;
    letter-spacing: 0.04em; color: rgba(245, 248, 250, 0.6);
    background: transparent; border: 1px solid rgba(var(--mint-rgb), 0.2);
    border-radius: 999px; cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .res-tab:hover { color: var(--off-white); border-color: rgba(var(--mint-rgb), 0.4); }
  .res-tab.is-active { color: var(--navy-deep); background: var(--mint); border-color: var(--mint); }

  /* ---------- CARD GRID ---------- */
  .res-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: clamp(24px, 3vw, 36px);
  }
  .res-grid--guides { grid-template-columns: repeat(3, 1fr); }

  .res-card {
    background: rgba(16, 35, 45, 0.55);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(var(--mint-rgb), 0.22);
    border-radius: 16px; overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .res-card:hover {
    border-color: rgba(var(--mint-rgb), 0.45);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4), 0 0 24px rgba(var(--mint-rgb), 0.12);
    transform: translateY(-3px);
  }
  .res-card__link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .res-card__media { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--navy-deep); position: relative; }
  .res-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.45s ease; }
  .res-card:hover .res-card__media img { transform: scale(1.04); }
  .res-card__logo-panel {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%; background-color: var(--navy-deep);
    background-image: url('/images/textures/texture-circuit-navy-steel-print-dark.jpg');
    background-size: cover; background-position: center;
  }
  .res-card__logo-panel img { width: 56%; max-width: 260px; height: auto; object-fit: contain; }
  .res-card__body { display: flex; flex-direction: column; gap: 10px; padding: clamp(24px, 2.8vw, 32px); flex: 1; }
  .res-card__kicker { display: flex; align-items: center; gap: 10px; margin: 0 0 2px; }
  .res-card__kicker::before { content: ''; width: 24px; height: 2px; background: var(--mint); }
  .res-card__kicker span {
    font-family: var(--font-head); font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--mint);
  }
  .res-card__title {
    font-family: var(--font-head); font-size: clamp(20px, 2.2vw, 24px);
    font-weight: 700; line-height: 1.18; letter-spacing: -0.015em; color: var(--off-white);
  }
  .res-card__meta { font-family: var(--font-head); font-size: 13px; font-weight: 600; letter-spacing: 0.02em; color: rgba(245, 248, 250, 0.72); }
  .res-card__meta span { font-weight: 400; color: rgba(245, 248, 250, 0.5); }
  .res-card__desc {
    font-family: var(--font-body); font-size: 15px; font-weight: 400;
    line-height: 1.55; color: rgba(245, 248, 250, 0.72); flex: 1;
  }
  .res-card__cta {
    margin-top: auto; padding-top: 16px; border-top: 1px solid rgba(var(--mint-rgb), 0.14);
    font-family: var(--font-head); font-size: 14px; font-weight: 700; color: var(--mint);
  }
  .res-card__cta span { display: inline-block; transition: transform 0.2s ease; }
  .res-card__link:hover .res-card__cta span { transform: translateX(4px); }

  /* ---------- VIDEO ---------- */
  .res-video {
    max-width: 900px; margin-inline: auto;
    display: flex; flex-direction: column; gap: clamp(28px, 4vw, 48px);
  }
  .res-video__item { display: flex; flex-direction: column; gap: 12px; }
  .res-video__label {
    margin: 0; font-family: var(--font-head); font-size: 13px; font-weight: 700;
    letter-spacing: 0.04em; color: rgba(245, 248, 250, 0.82);
  }
  .res-video__player {
    width: 100%; aspect-ratio: 16 / 9; border-radius: 16px;
    border: 1px solid rgba(var(--mint-rgb), 0.22);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
    background: var(--navy-deep);
  }

  /* ---------- BLOG PLACEHOLDER ---------- */
  .res-grid--blog { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
  .res-grid--newsletter { grid-template-columns: 1fr; max-width: 600px; margin-inline: auto; }
  .res-card--placeholder {
    border-style: dashed; border-color: rgba(var(--mint-rgb), 0.35);
    background: rgba(255, 255, 255, 0.03);
  }
  .res-card__soon {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%;
    background-color: var(--navy-deep);
    background-image: url('/images/textures/texture-circuit-navy-steel-print-dark.jpg');
    background-size: cover; background-position: center;
    font-family: var(--font-head); font-size: 13px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: rgba(104, 227, 190, 0.7);
  }

  /* ---------- CTA ---------- */
  :global(#res-cta.section) { border-top: 2px solid var(--mint); }
  .res-cta { max-width: 64ch; padding-block: clamp(28px, 4vw, 44px); }
  .res-cta__kicker { color: var(--mint); margin-bottom: var(--space-3); }
  .res-cta__title {
    margin: 0 0 var(--space-3); font-family: var(--font-head);
    font-size: clamp(26px, 3.6vw, 36px); font-weight: 700;
    line-height: 1.15; letter-spacing: -0.02em; color: var(--off-white);
  }
  .res-cta__title em { font-style: normal; color: var(--gold); }
  .res-cta__deck {
    max-width: 52ch; margin: 0 0 var(--space-4); font-family: var(--font-body);
    font-size: 17px; line-height: 1.6; color: rgba(245, 248, 250, 0.78);
  }
  .res-cta__btn { margin-top: 0; }

  @media (max-width: 900px) {
    .res-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
    .res-grid--guides { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  /* CTA mesh band — matches the global site CTA treatment */
  #res-cta.section {
    position: relative; isolation: isolate; overflow: hidden;
  }
  #res-cta.section::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: url('/images/mesh/luci-bg-wide-2560x800.svg') center / cover no-repeat;
    mix-blend-mode: screen; opacity: 0.6;
  }
  #res-cta.section::after {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(10, 22, 28, 0.82) 18%, rgba(10, 22, 28, 0.82) 82%, transparent 100%);
  }
  #res-cta > .container { position: relative; z-index: 1; }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.res-tab'));
  const sectionEls = [
    { tab: 'case-studies', el: document.getElementById('res-case-studies') },
    { tab: 'guides', el: document.getElementById('res-guides') },
    { tab: 'video', el: document.getElementById('res-video') },
    { tab: 'blog', el: document.getElementById('res-blog') },
    { tab: 'newsletter', el: document.getElementById('res-newsletter') },
  ].filter((s): s is { tab: string; el: HTMLElement } => !!s.el);

  function setActive(tab: string) {
    tabs.forEach((t) => t.classList.toggle('is-active', t.dataset.tab === tab));
    if (tab === 'all') {
      sectionEls.forEach(({ el }) => (el.style.display = ''));
    } else {
      sectionEls.forEach(({ tab: t, el }) => {
        el.style.display = t === tab ? '' : 'none';
      });
    }
  }

  tabs.forEach((t) => t.addEventListener('click', () => setActive(t.dataset.tab)));
</script>
