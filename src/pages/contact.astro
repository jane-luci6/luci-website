---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import { homeTrust } from '../data/site';
import '../styles/contact-page.css';

const { strips } = homeTrust;
const SUPPORT_HREF = 'https://support.lucisystems.com';
const GENERAL_HREF = 'mailto:info@lucisystems.com';
// 2-minute overview video — stand-in until a dedicated 2-min cut is produced.
const OVERVIEW_VIDEO = '/videos/luci-platform-run.mp4';
const OVERVIEW_POSTER = '/videos/luci-platform-run-poster.jpg';
---

<BaseLayout title="Contact" description="Book a live demo of LUCI running on a property like yours." darkHeader>
  <h1 class="contact-sr-only">Contact — Book a live demo</h1>

  <!-- 1. HERO + DEMO FORM -->
  <section id="contact-thesis" class="contact-hero" aria-label="Book a live demo of LUCI">
    <div class="contact-hero__mesh" aria-hidden="true"></div>
    <div class="contact-hero__inner container container--wide">
      <div class="contact-hero__copy">
        <h2 class="contact-hero__headline">See what <em>simpler A/V looks like.</em></h2>
        <p class="contact-hero__deck">See how LUCI brings screens, audio, signage, and A/V systems across an entire property into one place.</p>
        <button class="contact-hero__watch" type="button" data-open-overview aria-haspopup="dialog" aria-controls="overview-modal">
          Watch 2-minute overview
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </button>

        <div class="contact-hero__points">
          <p class="contact-hero__points-label">What you&rsquo;ll see</p>
          <ol class="contact-points" role="list">
            <li class="contact-point">
              <span class="contact-point__num">01</span>
              <p class="contact-point__head">See your property from one interface.</p>
              <p class="contact-point__body">Manage every endpoint across a complex environment from one place.</p>
            </li>
            <li class="contact-point">
              <span class="contact-point__num">02</span>
              <p class="contact-point__head">See what goes away.</p>
              <p class="contact-point__body">Replace proprietary control hardware, specialist programming, and fragmented systems.</p>
            </li>
            <li class="contact-point">
              <span class="contact-point__num">03</span>
              <p class="contact-point__head">Bring us your environment.</p>
              <p class="contact-point__body">See what LUCI could look like on your existing network.</p>
            </li>
          </ol>
        </div>
      </div>

      <div class="contact-hero__form-col">
        <div class="contact-form-card">
          <div class="contact-form-card__head">
            <h3 class="contact-form-card__title">Book a live demo</h3>
            <p class="contact-form-card__deck">Tell us a little about yourself. We&rsquo;ll show you LUCI in action, answer your questions, and focus the conversation on what matters most to your environment.</p>
          </div>
          <div class="luci-acform">
            <div class="_form_7"></div>
          </div>
          <script is:inline src="https://lucisystems.activehosted.com/f/embed.php?id=7" charset="utf-8"></script>
          <p class="contact-form-card__micro">See LUCI in action and talk through your environment with our team.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TRUSTED BY -->
  <section id="trusted-by" class="contact-trust" aria-label="Operators running LUCI">
    <div class="container container--wide">
      <p class="contact-trust__label">Trusted by</p>
      <ul class="contact-trust__grid" role="list">
        {strips.map((strip) => (
          <li class="contact-trust__cell">
            <img class="contact-trust__strip" src={strip.src} alt={strip.alt} loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. SECONDARY CONTACT PATHS -->
  <SectionBlock id="other-inquiries" tone="deep" wide>
    <div class="contact-paths">
      <article class="contact-path">
        <span class="contact-path__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 1 16 0"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19v1a3 3 0 0 1-3 3h-2"/></svg></span>
        <h3 class="contact-path__head">Already a LUCI customer?</h3>
        <p class="contact-path__body">Need help with your system or something happening on property? Our team can help.</p>
        <a class="contact-path__cta" href={SUPPORT_HREF}>Contact support<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </article>
      <article class="contact-path">
        <span class="contact-path__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 6.5l8 6 8-6"/></svg></span>
        <h3 class="contact-path__head">Looking for something else?</h3>
        <p class="contact-path__body">Partnerships, press, careers, vendor inquiries, and general questions.</p>
        <a class="contact-path__cta" href={GENERAL_HREF}>Contact LUCI<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      </article>
    </div>
  </SectionBlock>

  <!-- 4. OPTIONAL CLOSING CTA -->
  <SectionBlock id="closing-cta" tone="deep" wide>
    <div class="contact-closing">
      <div class="contact-closing__copy">
        <h2 class="contact-closing__title">Complex property. <em>Simple A/V.</em></h2>
        <p class="contact-closing__deck">See how LUCI brings your A/V environment together.</p>
      </div>
      <div class="contact-closing__actions">
        <a class="btn btn--mint contact-closing__btn" href="/contact#contact-thesis">Book a live demo</a>
        <button class="btn btn--ghost contact-closing__btn" type="button" data-open-overview>Watch 2-minute overview</button>
      </div>
    </div>
  </SectionBlock>
</BaseLayout>

<!-- 2-MINUTE OVERVIEW MODAL -->
<div id="overview-modal" class="overview-modal" role="dialog" aria-modal="true" aria-labelledby="overview-title" aria-describedby="overview-deck" hidden>
  <div class="overview-modal__backdrop" data-close-overview></div>
  <div class="overview-modal__panel" role="document" tabindex="-1">
    <button class="overview-modal__close" type="button" data-close-overview aria-label="Close video"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    <div class="overview-modal__head">
      <h2 id="overview-title" class="overview-modal__title">LUCI in 2 minutes</h2>
      <p id="overview-deck" class="overview-modal__deck">See how LUCI replaces fragmented A/V systems with one platform for controlling screens, audio, signage, and more across a property.</p>
    </div>
    <div class="overview-modal__video">
      <video class="overview-modal__player" controls preload="metadata" poster={OVERVIEW_POSTER} aria-label="LUCI in 2 minutes — overview of the platform">
        <source src={OVERVIEW_VIDEO} type="video/mp4" />
      </video>
    </div>
    <a class="btn btn--mint overview-modal__cta" href="/contact#contact-thesis" data-close-overview>Want to see it live? Book a demo</a>
  </div>
</div>

<script>
  const modal = document.getElementById('overview-modal');
  const video = modal?.querySelector('video');
  const openers = document.querySelectorAll('[data-open-overview]');
  const closers = document.querySelectorAll('[data-close-overview]');
  function openModal() {
    if (!modal) return;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    window.addEventListener('keydown', onKeydown);
    requestAnimationFrame(() => modal.querySelector('.overview-modal__panel')?.focus?.());
  }
  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
    window.removeEventListener('keydown', onKeydown);
    if (video) video.pause();
  }
  function onKeydown(e) { if (e.key === 'Escape') closeModal(); }
  openers.forEach((btn) => btn.addEventListener('click', openModal));
  closers.forEach((el) => el.addEventListener('click', closeModal));
</script>
