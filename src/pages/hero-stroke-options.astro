---
import BaseLayout from '../layouts/BaseLayout.astro';
import { heroStrokeWholeSvg, heroStrokePropSvg } from '../data/heroStrokeSvg';

// SVGs are generated by scripts/gen-hero-stroke-svg.py from REAL Syncopate
// glyph geometry: each letter's outline is the exact font shape, and each
// zone name runs along a true skeletonized stroke centerline, sized to the
// real local stroke thickness. Regenerate with: python3 scripts/gen-hero-stroke-svg.py
---

<BaseLayout title="Hero stroke-filled — real Syncopate geometry" description="Preview: zone names knocked out of real Syncopate letter strokes" darkHeader>
  <div class="sopts">
    <div class="sopts__intro">
      <span class="sopts__intro-k">Real glyph geometry — opentype + skeleton</span>
      <span class="sopts__intro-d">Each Syncopate letter is the actual font outline (pulled from the embedded woff2 via fontTools). Each zone name follows a real stroke centerline found by skeletonizing the rasterized glyph, and is sized to that stroke's measured thickness. Thirteen locations, each once, each inside its own stroke.</span>
    </div>

    <div class="sopts__card">
      <div class="sopts__card-head">
        <span class="sopts__card-k">Refined composition</span>
        <span class="sopts__card-d">Mint letterforms supply the outline and shape. Navy zone names occupy the strokes as clean negative space, running along the stroke direction.</span>
      </div>
      <div class="sopts__stage">
        <p class="sopts__lead">Control your</p>
        <div class="sopts__word sopts__word--big" set:html={heroStrokeWholeSvg} />
        <div class="sopts__word sopts__word--big" set:html={heroStrokePropSvg} />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .sopts {
    background: var(--navy-deep);
    padding-bottom: 80px;
  }
  .sopts__intro {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px var(--page-pad);
    background: var(--navy);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .sopts__intro-k {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .sopts__intro-d {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.72);
    max-width: 70ch;
  }
  .sopts__card {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .sopts__card-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px var(--page-pad) 0;
  }
  .sopts__card-k {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .sopts__card-d {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.62);
    max-width: 64ch;
  }
  .sopts__stage {
    padding: 56px var(--page-pad) 96px;
    overflow-x: auto;
  }
  .sopts__lead {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--off-white);
    line-height: 0.95;
  }
  .sopts__word {
    width: max-content;
    max-width: 100%;
    margin-top: -6px;
  }
  .sopts__word :global(svg) {
    display: block;
    height: auto;
    max-width: 100%;
    overflow: visible;
  }
  .sopts__word--big :global(svg) {
    width: min(1100px, 96vw);
  }
</style>
