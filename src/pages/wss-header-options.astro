---
import BaseLayout from '../layouts/BaseLayout.astro';
const s = { head: 'Your teams, on the same floor', sub: 'Six functions, one platform, one guest — tap a role to see what it can do.' };
const h = { head: 'Operations', sub: 'Run a tighter operation. Automate the routine. Respond instantly to the unexpected.' };
const c = { head: 'See what your team can do.', sub: 'Your teams are already on the floor. LUCI puts them on the same platform.' };
---
<BaseLayout title="Header options" description="Four directions for the Who We Serve section header.">
  <div class="hopts">
    <div class="hopts__intro container container--wide">
      <h1 class="h2">Section header — four directions</h1>
      <p class="measure">No kicker, no static rule, no uppercase-tracked role line. Each direction pairs a bold Space Grotesk headline with a plain-sentence subhead. Shown in three contexts: a dark section header, a hero, and a sand CTA.</p>
    </div>

    <section class="hopts__variant" id="hdr-1">
      <header class="hopts__label">
        <span class="hopts__tag">1</span>
        <div>
          <h2 class="hopts__title">Ghost numeral marker</h2>
          <p class="hopts__desc">A large, low-opacity outlined index numeral replaces the kicker and rule as the wayfinding device. Edgy via scale contrast.</p>
        </div>
      </header>

      <div class="hopts__spot hopts__spot--deep">
        <header class="hdr hdr--numeral">
          <span class="hdr__numeral" aria-hidden="true">01</span>
          <h3 class="hdr__head">{s.head}</h3>
          <p class="hdr__sub">{s.sub}</p>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--hero">
        <header class="hdr hdr--numeral hdr--hero">
          <span class="hdr__numeral hdr__numeral--ghost" aria-hidden="true">02</span>
          <h3 class="hdr__head">{h.head}</h3>
          <p class="hdr__sub">{h.sub}</p>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--sand">
        <header class="hdr hdr--numeral">
          <span class="hdr__numeral" aria-hidden="true">03</span>
          <h3 class="hdr__head">{c.head}</h3>
          <p class="hdr__sub">{c.sub}</p>
        </header>
      </div>
    </section>

    <section class="hopts__variant" id="hdr-2">
      <header class="hopts__label">
        <span class="hopts__tag">2</span>
        <div>
          <h2 class="hopts__title">Inline lead-word</h2>
          <p class="hopts__desc">The kicker folds into the headline: the lead phrase sits in the accent color inline with the rest — no separate label, no rule.</p>
        </div>
      </header>

      <div class="hopts__spot hopts__spot--deep">
        <header class="hdr hdr--inline">
          <h3 class="hdr__head"><span class="hdr__accent">Your teams</span> — on the same floor</h3>
          <p class="hdr__sub">{s.sub}</p>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--hero">
        <header class="hdr hdr--inline hdr--hero">
          <h3 class="hdr__head"><span class="hdr__accent">Operations</span></h3>
          <p class="hdr__sub">{h.sub}</p>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--sand">
        <header class="hdr hdr--inline">
          <h3 class="hdr__head"><span class="hdr__accent--light">See</span> what your team can do.</h3>
          <p class="hdr__sub">{c.sub}</p>
        </header>
      </div>
    </section>

    <section class="hopts__variant" id="hdr-3">
      <header class="hopts__label">
        <span class="hopts__tag">3</span>
        <div>
          <h2 class="hopts__title">Gradient edge block</h2>
          <p class="hopts__desc">A vertical mint-to-transparent accent block to the left of the header replaces the horizontal rule. No uppercase label anywhere.</p>
        </div>
      </header>

      <div class="hopts__spot hopts__spot--deep">
        <header class="hdr hdr--edge">
          <span class="hdr__edge" aria-hidden="true"></span>
          <span class="hdr__edge-body">
            <h3 class="hdr__head">{s.head}</h3>
            <p class="hdr__sub">{s.sub}</p>
          </span>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--hero">
        <header class="hdr hdr--edge hdr--hero">
          <span class="hdr__edge" aria-hidden="true"></span>
          <span class="hdr__edge-body">
            <h3 class="hdr__head">{h.head}</h3>
            <p class="hdr__sub">{h.sub}</p>
          </span>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--sand">
        <header class="hdr hdr--edge">
          <span class="hdr__edge hdr__edge--light" aria-hidden="true"></span>
          <span class="hdr__edge-body">
            <h3 class="hdr__head">{c.head}</h3>
            <p class="hdr__sub">{c.sub}</p>
          </span>
        </header>
      </div>
    </section>

    <section class="hopts__variant" id="hdr-4">
      <header class="hopts__label">
        <span class="hopts__tag">4</span>
        <div>
          <h2 class="hopts__title">Split-weight editorial</h2>
          <p class="hopts__desc">No color accent, no rule, no numeral — one flowing sentence where the lead is regular and the continuation is bold. Separation comes from a scroll-in reveal, not a graphic device.</p>
        </div>
      </header>

      <div class="hopts__spot hopts__spot--deep">
        <header class="hdr hdr--split" data-reveal>
          <h3 class="hdr__head">Your teams, <span class="hdr__strong">on the same floor</span></h3>
          <p class="hdr__sub">{s.sub}</p>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--hero">
        <header class="hdr hdr--split hdr--hero" data-reveal>
          <h3 class="hdr__head">Run a <span class="hdr__strong">tighter operation</span></h3>
          <p class="hdr__sub">{h.sub}</p>
        </header>
      </div>

      <div class="hopts__spot hopts__spot--sand">
        <header class="hdr hdr--split" data-reveal>
          <h3 class="hdr__head">See what <span class="hdr__strong">your team can do.</span></h3>
          <p class="hdr__sub">{c.sub}</p>
        </header>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hopts { padding-block: clamp(40px, 6vw, 64px); }
  .hopts__intro { max-width: 64ch; margin-bottom: clamp(28px, 4vw, 44px); }
  .hopts__intro .h2 { color: var(--off-white); }
  .hopts__intro .measure { color: rgba(245, 248, 250, 0.72); }

  .hopts__variant { max-width: var(--content-wide); margin-inline: auto; padding-inline: var(--page-pad); }
  .hopts__variant + .hopts__variant { margin-top: clamp(40px, 6vw, 72px); padding-top: clamp(40px, 6vw, 72px); border-top: 1px solid rgba(255, 255, 255, 0.1); }

  .hopts__label { display: flex; gap: 14px; align-items: flex-start; margin-bottom: clamp(20px, 3vw, 28px); }
  .hopts__tag {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 9999px;
    background: rgba(104, 227, 190, 0.14); color: var(--mint);
    font-family: var(--font-display); font-size: 13px; font-weight: 700;
  }
  .hopts__title { margin: 0 0 6px; font-family: var(--font-body); font-size: clamp(20px, 2vw, 26px); font-weight: 700; letter-spacing: -0.015em; line-height: 1.15; color: var(--off-white); }
  .hopts__desc { margin: 0; max-width: 70ch; font-size: 15px; line-height: 1.5; color: rgba(245, 248, 250, 0.72); }

  .hopts__spot { border-radius: 14px; padding: clamp(24px, 3vw, 36px); margin-bottom: 14px; }
  .hopts__spot--deep { background: var(--navy); border: 1px solid rgba(255, 255, 255, 0.08); }
  .hopts__spot--hero { background: linear-gradient(135deg, var(--navy-deep), var(--navy)); border: 1px solid rgba(var(--mint-rgb), 0.16); min-height: 200px; display: flex; align-items: center; }
  .hopts__spot--sand { background: var(--sand); }

  /* ---- Header base ---- */
  .hdr { position: relative; display: block; max-width: 60ch; }
  .hdr__head { font-family: var(--font-body); font-size: clamp(26px, 4vw, 38px); font-weight: 700; line-height: 1.08; letter-spacing: -0.025em; margin: 0; }
  .hdr__sub { font-family: var(--font-body); font-size: clamp(16px, 1.5vw, 18px); font-weight: 400; line-height: 1.55; margin: 14px 0 0; max-width: 54ch; }
  .hopts__spot--deep .hdr__head { color: var(--off-white); }
  .hopts__spot--deep .hdr__sub { color: rgba(245, 248, 250, 0.72); }
  .hopts__spot--sand .hdr__head { color: var(--ink-strong); }
  .hopts__spot--sand .hdr__sub { color: var(--navy-muted); }

  .hdr--hero .hdr__head { font-size: clamp(34px, 5.5vw, 52px); }
  .hdr--hero .hdr__sub { font-size: clamp(17px, 1.7vw, 20px); max-width: 48ch; }

  /* ---- Variant 1: ghost numeral ---- */
  .hdr--numeral { padding-left: clamp(48px, 5vw, 72px); }
  .hdr__numeral {
    position: absolute; left: 0; top: -0.18em;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(40px, 4.5vw, 64px); line-height: 1;
    color: rgba(104, 227, 190, 0.16);
  }
  .hopts__spot--sand .hdr__numeral { color: rgba(43, 158, 128, 0.18); }
  .hdr__numeral--ghost { font-size: clamp(80px, 11vw, 160px); top: -0.28em; color: rgba(104, 227, 190, 0.1); }

  /* ---- Variant 2: inline lead-word ---- */
  .hdr__accent { color: var(--mint); }
  .hdr__accent--light { color: var(--accent-light); }

  /* ---- Variant 3: gradient edge block ---- */
  .hdr--edge { display: flex; gap: clamp(16px, 2vw, 24px); align-items: stretch; max-width: 64ch; }
  .hdr__edge {
    flex-shrink: 0; width: 4px; border-radius: 2px;
    background: linear-gradient(to bottom, var(--mint), rgba(104, 227, 190, 0));
  }
  .hdr__edge--light { background: linear-gradient(to bottom, var(--accent-light), rgba(43, 158, 128, 0)); }
  .hdr__edge-body { display: block; }
  .hdr--hero .hdr__edge { width: 6px; }

  /* ---- Variant 4: split-weight editorial ---- */
  .hdr--split .hdr__head { font-weight: 400; }
  .hdr__strong { font-weight: 700; }
  .hopts__spot--sand .hdr--split .hdr__head { color: var(--ink); }
  .hopts__spot--sand .hdr--split .hdr__strong { color: var(--ink-strong); }

  /* scroll-in reveal for variant 4 */
  .hdr--split[data-reveal] .hdr__head,
  .hdr--split[data-reveal] .hdr__sub {
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hdr--split[data-reveal].is-in .hdr__head,
  .hdr--split[data-reveal].is-in .hdr__sub { opacity: 1; transform: none; }
  .hdr--split[data-reveal] .hdr__sub { transition-delay: 0.12s; }

  @media (prefers-reduced-motion: reduce) {
    .hdr--split[data-reveal] .hdr__head,
    .hdr--split[data-reveal] .hdr__sub { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.hdr--split[data-reveal]').forEach((el) => {
    if (reduce || !('IntersectionObserver' in window)) { el.classList.add('is-in'); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { el.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.3 });
    io.observe(el);
  });
</script>
