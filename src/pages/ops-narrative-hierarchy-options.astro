---
/**
 * Ops narrative hierarchy options — pick A / B / C.
 * Temporary comparison page; delete after Jane chooses.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const moments = [
  { time: 'Doors open', caption: 'The room is ready before the first guest walks in.' },
  { time: 'Event trigger', caption: 'A jackpot hits, a goal scores, a flight delays — the floor responds in the moment.' },
  { time: 'Room turnover', caption: 'The space becomes what the next event needs, on schedule.' },
  { time: 'Saturday night', caption: 'Sold-out show, packed floor, high-traffic rush — the atmosphere holds.' },
];
const support =
  'LUCI hands you the controls — adjust the audio curve, the screen strategy, and the whole atmosphere — on a schedule or in real-time.';
const closing = 'You reach for one screen, not five people to make it happen.';

const wavePath =
  'M0,195 C 70,195 80,130 125,130 C 170,130 210,185 250,185 C 290,185 320,95 375,95 C 430,95 460,180 500,180 C 540,180 580,62 625,62 C 670,62 710,175 750,175 C 790,175 840,30 875,30 C 920,30 960,165 1000,165';
const areaPath = `${wavePath} L 1000,240 L 0,240 Z`;
---

<BaseLayout title="Ops narrative hierarchy options" description="Compare A/B/C hierarchy treatments" darkHeader>
  <div class="cmp-banner">
    <p class="cmp-banner__k">Operations · narrative hierarchy</p>
    <h1 class="cmp-banner__h">Pick A, B, or C</h1>
    <p class="cmp-banner__d">Same copy and curve. Three ways to organize the graph vs. the two sentences below it.</p>
    <nav class="cmp-banner__nav" aria-label="Jump to option">
      <a href="#opt-a">A · Curve as statement</a>
      <a href="#opt-b">B · Three-tier stack</a>
      <a href="#opt-c">C · Side rail</a>
    </nav>
  </div>

  <!-- ========== A: Curve as the statement, copy as the payoff ========== -->
  <section id="opt-a" class="cmp-opt">
    <header class="cmp-opt__meta">
      <span class="cmp-opt__letter">A</span>
      <div>
        <h2 class="cmp-opt__title">Curve as the statement, copy as the payoff</h2>
        <p class="cmp-opt__desc">Peaks labeled lightly under the curve. Support + closing sit in a centered band below a hairline — closing larger/bolder. Curve = story; text = punchline.</p>
      </div>
    </header>

    <div class="cmp-stage">
      <div class="header-lockup is-in">
        <h2 class="header-lockup__name">You're the one the floor answers to</h2>
        <span class="header-lockup__rule" aria-hidden="true"></span>
        <p class="header-lockup__role">A day on your floor</p>
      </div>

      <div class="a-curve">
        <svg class="a-wave" viewBox="0 0 1000 240" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="aFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#68e3be" stop-opacity="0.26" />
              <stop offset="1" stop-color="#68e3be" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="aStroke" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#2b9e80" />
              <stop offset="0.55" stop-color="#68e3be" />
              <stop offset="1" stop-color="#ceb06e" />
            </linearGradient>
          </defs>
          <line class="a-axis" x1="0" y1="196" x2="1000" y2="196" />
          <path d={areaPath} fill="url(#aFill)" />
          <path d={wavePath} fill="none" stroke="url(#aStroke)" stroke-width="2.5" stroke-linecap="round" />
          <g>
            <circle cx="125" cy="130" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="375" cy="95" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="625" cy="62" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="875" cy="30" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="125" cy="130" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="375" cy="95" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="625" cy="62" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="875" cy="30" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
          </g>
        </svg>
        <ol class="a-marks" role="list">
          {moments.map((m) => (
            <li class="a-mark">
              <span class="a-mark__t">{m.time}</span>
              <p class="a-mark__c">{m.caption}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="a-payoff">
        <p class="a-support">{support}</p>
        <p class="a-closing">{closing}</p>
      </div>
    </div>
  </section>

  <!-- ========== B: Three-tier stack ========== -->
  <section id="opt-b" class="cmp-opt">
    <header class="cmp-opt__meta">
      <span class="cmp-opt__letter">B</span>
      <div>
        <h2 class="cmp-opt__title">Three-tier stack</h2>
        <p class="cmp-opt__desc">1) Lockup → 2) Curve + peaks as a visual chapter → 3) Centered support as body, then closing as a mint-ruled pull quote. Clear zones; nothing runs together.</p>
      </div>
    </header>

    <div class="cmp-stage">
      <div class="header-lockup is-in">
        <h2 class="header-lockup__name">You're the one the floor answers to</h2>
        <span class="header-lockup__rule" aria-hidden="true"></span>
        <p class="header-lockup__role">A day on your floor</p>
      </div>

      <div class="b-chapter">
        <p class="b-chapter__label">The energy curve</p>
        <svg class="b-wave" viewBox="0 0 1000 240" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="bFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#68e3be" stop-opacity="0.26" />
              <stop offset="1" stop-color="#68e3be" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="bStroke" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#2b9e80" />
              <stop offset="0.55" stop-color="#68e3be" />
              <stop offset="1" stop-color="#ceb06e" />
            </linearGradient>
          </defs>
          <line class="b-axis" x1="0" y1="196" x2="1000" y2="196" />
          <path d={areaPath} fill="url(#bFill)" />
          <path d={wavePath} fill="none" stroke="url(#bStroke)" stroke-width="2.5" stroke-linecap="round" />
          <g>
            <circle cx="125" cy="130" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="375" cy="95" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="625" cy="62" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="875" cy="30" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="125" cy="130" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="375" cy="95" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="625" cy="62" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="875" cy="30" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
          </g>
        </svg>
        <ol class="b-marks" role="list">
          {moments.map((m) => (
            <li class="b-mark">
              <span class="b-mark__t">{m.time}</span>
              <p class="b-mark__c">{m.caption}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="b-copy">
        <p class="b-support">{support}</p>
        <blockquote class="b-closing">{closing}</blockquote>
      </div>
    </div>
  </section>

  <!-- ========== C: Side rail / centered column under marks ========== -->
  <section id="opt-c" class="cmp-opt">
    <header class="cmp-opt__meta">
      <span class="cmp-opt__letter">C</span>
      <div>
        <h2 class="cmp-opt__title">Centered rail under the marks</h2>
        <p class="cmp-opt__desc">Curve full-width. Support + closing stack in a narrow centered column under the marks, with a mint top rule and generous gap so marks never collide with the sentences.</p>
      </div>
    </header>

    <div class="cmp-stage">
      <div class="header-lockup is-in">
        <h2 class="header-lockup__name">You're the one the floor answers to</h2>
        <span class="header-lockup__rule" aria-hidden="true"></span>
        <p class="header-lockup__role">A day on your floor</p>
      </div>

      <div class="c-curve">
        <svg class="c-wave" viewBox="0 0 1000 240" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="cFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#68e3be" stop-opacity="0.26" />
              <stop offset="1" stop-color="#68e3be" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="cStroke" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#2b9e80" />
              <stop offset="0.55" stop-color="#68e3be" />
              <stop offset="1" stop-color="#ceb06e" />
            </linearGradient>
          </defs>
          <line class="c-axis" x1="0" y1="196" x2="1000" y2="196" />
          <path d={areaPath} fill="url(#cFill)" />
          <path d={wavePath} fill="none" stroke="url(#cStroke)" stroke-width="2.5" stroke-linecap="round" />
          <g>
            <circle cx="125" cy="130" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="375" cy="95" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="625" cy="62" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="875" cy="30" r="13" fill="rgba(104,227,190,0.22)" />
            <circle cx="125" cy="130" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="375" cy="95" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="625" cy="62" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
            <circle cx="875" cy="30" r="6.5" fill="#0a161c" stroke="#68e3be" stroke-width="2" />
          </g>
        </svg>
        <ol class="c-marks" role="list">
          {moments.map((m) => (
            <li class="c-mark">
              <span class="c-mark__t">{m.time}</span>
              <p class="c-mark__c">{m.caption}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="c-rail">
        <p class="c-support">{support}</p>
        <p class="c-closing">{closing}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cmp-banner {
    background: var(--navy-deep);
    color: var(--off-white);
    padding: clamp(48px, 8vw, 80px) clamp(28px, 6vw, 60px) clamp(32px, 5vw, 48px);
    border-bottom: 1px solid rgba(245, 248, 250, 0.12);
  }
  .cmp-banner__k {
    margin: 0 0 12px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .cmp-banner__h {
    margin: 0 0 12px;
    font-family: var(--font-body);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .cmp-banner__d {
    margin: 0 0 24px;
    max-width: 52ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.72);
  }
  .cmp-banner__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cmp-banner__nav a {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(104, 227, 190, 0.35);
    color: var(--mint);
    text-decoration: none;
  }
  .cmp-banner__nav a:hover { background: rgba(104, 227, 190, 0.12); }

  .cmp-opt {
    background: var(--navy);
    color: var(--off-white);
    padding: clamp(40px, 6vw, 64px) 0;
    border-bottom: 8px solid var(--navy-deep);
  }
  .cmp-opt__meta {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
    max-width: 1120px;
    margin: 0 auto clamp(28px, 4vw, 40px);
    padding: 0 clamp(28px, 6vw, 60px);
  }
  .cmp-opt__letter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(104, 227, 190, 0.14);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--mint);
  }
  .cmp-opt__title {
    margin: 0 0 6px;
    font-family: var(--font-body);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .cmp-opt__desc {
    margin: 0;
    max-width: 62ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.68);
  }

  .cmp-stage {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 40px) clamp(28px, 6vw, 60px);
    background: var(--navy-deep);
    border-radius: 16px;
    border: 1px solid rgba(245, 248, 250, 0.1);
  }

  /* Shared lockup inside stage */
  .cmp-stage :global(.header-lockup) { margin-bottom: clamp(24px, 3vw, 36px); }
  .cmp-stage :global(.header-lockup__name) {
    font-family: var(--font-body);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin: 0;
    max-width: 18ch;
  }
  .cmp-stage :global(.header-lockup__rule) {
    display: block;
    width: 40px;
    height: 3px;
    margin: 14px 0 12px;
    background: var(--mint);
    border-radius: 2px;
  }
  .cmp-stage :global(.header-lockup__role) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mint);
  }

  /* ----- A ----- */
  .a-wave, .b-wave, .c-wave {
    width: 100%;
    height: clamp(140px, 18vw, 220px);
    display: block;
  }
  .a-axis, .b-axis, .c-axis {
    stroke: rgba(245, 248, 250, 0.18);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .a-marks, .b-marks, .c-marks {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .a-mark, .b-mark, .c-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }
  .a-mark__t, .b-mark__t, .c-mark__t {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .a-mark__c, .b-mark__c, .c-mark__c {
    margin: 0;
    max-width: 22ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13.5px;
    line-height: 1.45;
    color: rgba(245, 248, 250, 0.72);
  }
  .a-payoff {
    margin-top: clamp(28px, 4vw, 40px);
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid rgba(245, 248, 250, 0.16);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .a-support {
    margin: 0;
    max-width: 52ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.78);
  }
  .a-closing {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-body);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--off-white);
  }

  /* ----- B ----- */
  .b-chapter {
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid rgba(245, 248, 250, 0.12);
    border-radius: 14px;
    background: rgba(16, 35, 45, 0.55);
  }
  .b-chapter__label {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 248, 250, 0.45);
  }
  .b-copy {
    margin-top: clamp(28px, 4vw, 40px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .b-support {
    margin: 0;
    max-width: 52ch;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.78);
  }
  .b-closing {
    margin: 0;
    max-width: 34ch;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--mint);
    text-align: left;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--off-white);
    font-style: normal;
  }

  /* ----- C ----- */
  .c-curve { margin-bottom: clamp(32px, 5vw, 48px); }
  .c-rail {
    max-width: 42ch;
    margin: 0 auto;
    padding-top: 22px;
    border-top: 2px solid var(--mint);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .c-support {
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.78);
  }
  .c-closing {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--off-white);
  }

  @media (max-width: 760px) {
    .a-marks, .b-marks, .c-marks { grid-template-columns: 1fr; }
    .a-mark, .b-mark, .c-mark { align-items: flex-start; text-align: left; }
  }
</style>
