---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import PlatformChapterNav from '../../components/PlatformChapterNav.astro';
import PersonaHeroStage from '../../components/PersonaHeroStage.astro';
import PersonaCapabilities from '../../components/PersonaCapabilities.astro';
import PersonaSpotlight from '../../components/PersonaSpotlight.astro';
import WssHeader from '../../components/WssHeader.astro';
import { personas } from '../../data/personas';
import { getPersonaDetail, hasPersonaDetail } from '../../data/personaDetails';
import { site } from '../../data/site';

export function getStaticPaths() {
  return personas
    .filter((p) => hasPersonaDetail(p.id))
    .map((persona) => ({
      params: { persona: persona.id },
      props: { persona },
    }));
}

const { persona } = Astro.props;
if (!persona) return Astro.redirect('/who-we-serve');

const detail = getPersonaDetail(persona.id);
if (!detail) return Astro.redirect('/who-we-serve');

const splitLead = (s: string) => {
  const m = s.match(/^(\S+)(.*)$/);
  return { lead: m ? m[1] : s, rest: m ? m[2] : '' };
};
const narrativeHead = splitLead(detail.narrativeLockup.lockupName);
const capabilitiesHead = splitLead(detail.capabilitiesLockup.lockupName);
const ctaHead = splitLead(detail.ctaTitle);
---

<BaseLayout
  title={`${persona.label} — ${persona.role}`}
  description={detail.heroDeck}
  darkHeader
>
  <h1 class="persona-sr-only">{persona.label} — {persona.role}</h1>
  <PlatformChapterNav chapters={detail.chapters} contextLabel={persona.label} />

  <PersonaHeroStage
    heroImage={detail.heroImage}
    heroAlt={detail.heroAlt}
    lead={persona.label}
    sub={detail.heroDeck}
  />

  <SectionBlock id="persona-narrative" tone="white">
    <WssHeader
      lead={narrativeHead.lead}
      rest={narrativeHead.rest}
      sub={detail.narrativeLockup.lockupRole}
      tone="light"
    />
    <div class="persona-narrative">
      {detail.narrative.map((para) => (
        <p>{para}</p>
      ))}
    </div>
  </SectionBlock>

  <SectionBlock id="persona-capabilities" tone="deep" wide>
    <WssHeader
      lead={capabilitiesHead.lead}
      rest={capabilitiesHead.rest}
      sub={detail.capabilitiesLockup.lockupRole}
      tone="dark"
    />
    <PersonaCapabilities
      capabilities={detail.capabilities}
      lead={detail.lead}
      takeaway={detail.takeaway}
    />
  </SectionBlock>

  <SectionBlock id="persona-spotlight" tone="sand">
    <PersonaSpotlight
      label={detail.spotlight.label}
      text={detail.spotlight.text}
      accent={detail.spotlight.accent}
    />
  </SectionBlock>

  <SectionBlock id="persona-cta" tone="deep">
    <div class="persona-cta">
      <WssHeader
        lead={ctaHead.lead}
        rest={ctaHead.rest}
        tone="dark"
        class="persona-cta__head"
      />
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact">{site.ctaPrimary}</a>
        <a class="btn btn--ghost" href="/platform">Explore the platform</a>
      </div>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .persona-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #persona-thesis,
  #persona-narrative,
  #persona-capabilities,
  #persona-spotlight,
  #persona-cta {
    scroll-margin-top: 156px;
  }

  @media (max-width: 640px) {
    #persona-thesis,
    #persona-narrative,
    #persona-capabilities,
    #persona-spotlight,
    #persona-cta {
      scroll-margin-top: 132px;
    }
  }

  .persona-narrative {
    max-width: var(--measure);
  }
  .persona-narrative p {
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 20px);
    font-weight: 400;
    line-height: 1.68;
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }
  .persona-narrative p:last-child {
    margin-bottom: 0;
  }

  .persona-cta {
    text-align: center;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .persona-cta :global(.persona-cta__head) {
    margin-inline: auto;
    text-align: center;
    margin-bottom: var(--space-4);
  }
  .persona-cta :global(.persona-cta__head .wss-header__head),
  .persona-cta :global(.persona-cta__head .wss-header__sub) {
    margin-inline: auto;
    text-align: center;
  }
</style>
