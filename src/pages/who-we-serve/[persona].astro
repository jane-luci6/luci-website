---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import PlatformChapterNav from '../../components/PlatformChapterNav.astro';
import PersonaHeroStage from '../../components/PersonaHeroStage.astro';
import PersonaNarrativeTimeline from '../../components/PersonaNarrativeTimeline.astro';
import PersonaTwoShifts from '../../components/PersonaTwoShifts.astro';
import PersonaChallenges from '../../components/PersonaChallenges.astro';
import PersonaIndustrySwitcher from '../../components/PersonaIndustrySwitcher.astro';
import PersonaCapabilitiesFlow from '../../components/PersonaCapabilitiesFlow.astro';
import { personas } from '../../data/personas';
import { getPersonaDetail, hasPersonaDetail } from '../../data/personaDetails';
import { site } from '../../data/site';

export function getStaticPaths() {
  return personas
    .filter((p) => hasPersonaDetail(p.id))
    .map((persona) => ({
      params: { persona: persona.id },
      props: { persona },
    }));
}

const { persona } = Astro.props;
if (!persona) return Astro.redirect('/who-we-serve');

const detail = getPersonaDetail(persona.id);
if (!detail) return Astro.redirect('/who-we-serve');
---

<BaseLayout
  title={`${persona.label} — ${persona.role}`}
  description={detail.heroDeck}
  darkHeader
>
  <h1 class="persona-sr-only">{persona.label} — {persona.role}</h1>
  <PlatformChapterNav chapters={detail.chapters} contextLabel={persona.label} />

  <PersonaHeroStage
    heroImage={detail.heroImage}
    heroAlt={detail.heroAlt}
    kicker={detail.heroKicker}
    lockupName={persona.label}
    lockupRole={persona.role}
    deck={detail.heroDeck}
  />

  <SectionBlock
    id="persona-narrative"
    lockupName={detail.narrativeLockup.lockupName}
    lockupRole={detail.narrativeLockup.lockupRole}
    tone="deep"
    wide
  >
    <PersonaNarrativeTimeline narrative={detail.narrative} />
  </SectionBlock>

  <SectionBlock
    id="persona-two-shifts"
    lockupName={detail.twoShiftsLockup.lockupName}
    lockupRole={detail.twoShiftsLockup.lockupRole}
    tone="light"
    wide
  >
    <PersonaTwoShifts shifts={detail.twoShifts} />
  </SectionBlock>

  <SectionBlock
    id="persona-challenges"
    lockupName={detail.challengesLockup.lockupName}
    lockupRole={detail.challengesLockup.lockupRole}
    tone="deep"
    wide
  >
    <PersonaChallenges groups={detail.challenges} />
  </SectionBlock>

  <SectionBlock
    id="persona-industries"
    lockupName={detail.industryLockup.lockupName}
    lockupRole={detail.industryLockup.lockupRole}
    tone="light"
    wide
  >
    <PersonaIndustrySwitcher stakes={detail.industryStakes} />
  </SectionBlock>

  <SectionBlock
    id="persona-capabilities"
    lockupName={detail.capabilitiesLockup.lockupName}
    lockupRole={detail.capabilitiesLockup.lockupRole}
    tone="deep"
    wide
    pattern
  >
    <PersonaCapabilitiesFlow
      capabilities={detail.capabilities}
      lead={detail.lead}
    />
  </SectionBlock>

  <SectionBlock id="persona-cta" tone="deep">
    <div class="persona-cta">
      <p class="display-label persona-cta__kicker">Next step</p>
      <h2 class="h2 persona-cta__title">{detail.ctaTitle}</h2>
      <p class="persona-cta__deck">Let us show you what it looks like when it isn’t — on your floor, with your team, on your existing setup.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact">{site.ctaPrimary}</a>
        <a class="btn btn--ghost" href="/platform">Explore the platform</a>
      </div>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .persona-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #persona-thesis,
  #persona-narrative,
  #persona-two-shifts,
  #persona-challenges,
  #persona-industries,
  #persona-capabilities,
  #persona-cta {
    scroll-margin-top: 156px;
  }

  @media (max-width: 640px) {
    #persona-thesis,
    #persona-narrative,
    #persona-two-shifts,
    #persona-challenges,
    #persona-industries,
    #persona-capabilities,
    #persona-cta {
      scroll-margin-top: 132px;
    }
  }

  .persona-cta {
    text-align: center;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .persona-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-2);
  }
  .persona-cta__title {
    color: var(--off-white);
    margin-bottom: var(--space-3);
    max-width: 22ch;
    margin-inline: auto;
  }
  .persona-cta__deck {
    max-width: 52ch;
    margin: 0 auto var(--space-4);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.78);
  }
</style>
