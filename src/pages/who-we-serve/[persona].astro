---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import PlatformChapterNav from '../../components/PlatformChapterNav.astro';
import PersonaHeroStage from '../../components/PersonaHeroStage.astro';
import PersonaNarrativeTimeline from '../../components/PersonaNarrativeTimeline.astro';
import PersonaChallenges from '../../components/PersonaChallenges.astro';
import PersonaIndustrySwitcher from '../../components/PersonaIndustrySwitcher.astro';
import PersonaCapabilitiesFlow from '../../components/PersonaCapabilitiesFlow.astro';
import { personas } from '../../data/personas';
import { getPersonaDetail, hasPersonaDetail } from '../../data/personaDetails';
import { site } from '../../data/site';

export function getStaticPaths() {
  return personas
    .filter((p) => hasPersonaDetail(p.id))
    .map((persona) => ({
      params: { persona: persona.id },
      props: { persona },
    }));
}

const { persona } = Astro.props;
if (!persona) return Astro.redirect('/who-we-serve');

const detail = getPersonaDetail(persona.id);
if (!detail) return Astro.redirect('/who-we-serve');
---

<BaseLayout
  title={`${persona.label} — ${persona.role}`}
  description={detail.heroDeck}
  darkHeader
>
  <h1 class="persona-sr-only">{persona.label} — {persona.role}</h1>
  <PlatformChapterNav chapters={detail.chapters} contextLabel={persona.label} />

  <PersonaHeroStage
    heroImage={detail.heroImage}
    heroAlt={detail.heroAlt}
    heroVideo={detail.heroVideo}
    heroPoster={detail.heroPoster}
    kicker={detail.heroKicker}
    lockupName={persona.label}
    lockupRole={persona.role}
    deckHtml={detail.narrativeLockup.lockupName}
  />

  <SectionBlock
    id="persona-narrative"
    lockupName={detail.graphLockup.lockupName}
    deck={detail.graphLockup.deck}
    tone="deep"
    wide
  >
    <PersonaNarrativeTimeline narrative={detail.narrative} />
  </SectionBlock>

  <SectionBlock
    id="persona-challenges"
    lockupName={detail.challengesLockup.lockupName}
    tone="deep"
    wide
  >
    <PersonaChallenges challenges={detail.challenges} />
  </SectionBlock>

  <SectionBlock
    id="persona-capabilities"
    lockupName={detail.capabilitiesLockup.lockupName}
    tone="deep"
    wide
  >
    <PersonaCapabilitiesFlow
      capabilities={detail.capabilities}
      lead={detail.lead}
      takeaway={detail.takeaway}
      hubLabel={detail.hubLabel}
      hubSub={detail.hubSub}
    />
  </SectionBlock>

  <SectionBlock
    id="persona-industries"
    lockupName={detail.industryLockup.lockupName}
    tone="mid"
    wide
  >
    <PersonaIndustrySwitcher stakes={detail.industryStakes} />
  </SectionBlock>

  <SectionBlock id="persona-cta" tone="deep">
    <div class="persona-cta">
      <p class="display-label persona-cta__kicker">Next step</p>
      <h2 class="persona-cta__title" set:html={detail.ctaTitle} />
      {detail.ctaDeck && <p class="persona-cta__deck">{detail.ctaDeck}</p>}
      <a class="btn btn--mint-outline persona-cta__btn" href="/contact">{site.ctaPrimary}</a>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .persona-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #persona-thesis,
  #persona-narrative,
  #persona-challenges,
  #persona-industries,
  #persona-capabilities,
  #persona-cta {
    scroll-margin-top: 156px;
  }

  @media (max-width: 640px) {
    #persona-thesis,
    #persona-narrative,
    #persona-challenges,
    #persona-industries,
    #persona-capabilities,
    #persona-cta {
      scroll-margin-top: 132px;
    }
  }

  :global(#persona-industries.section) {
    padding-bottom: clamp(28px, 4vw, 44px);
  }
  :global(#persona-cta.section) {
    border-top: 2px solid var(--mint);
    padding-block: clamp(36px, 5vw, 48px);
  }
  .persona-cta {
    max-width: 64ch;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .persona-cta__kicker {
    color: var(--mint);
    margin-bottom: var(--space-3);
  }
  .persona-cta__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
  }
  .persona-cta__title :global(em) {
    font-style: normal;
    color: var(--gold);
  }
  .persona-cta__deck {
    max-width: 52ch;
    margin: 0 0 var(--space-4);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(245, 248, 250, 0.78);
  }
  .persona-cta__btn {
    margin-top: 0;
  }
</style>

<style is:global>
  /* ============================================================
     Persona pages — mesh (with horizontal navy veil) on the
     narrative + capabilities sections, replacing the
     circuit `pattern`. The mesh reads only at the far
     left/right margins; opacity bumped to 0.7 so the
     line-work reads stronger around the outside of the content.
     The challenges section ("What gets in your way")
     drops the blue/slate `mid` tone for the darker
     `deep` navy, so it no longer reads
     blue/slate. Each section's veil matches its own bg.
     ============================================================ */
  #persona-narrative.section,
  #persona-capabilities.section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  #persona-narrative.section::before,
  #persona-capabilities.section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/mesh/luci-bg-hero-1920x1080.svg?v=1') center / cover no-repeat;
    mix-blend-mode: screen;
    opacity: 0.7;
  }
  /* Veil matches each section's own bg so the center reads solid
     and the mesh reads only at the left/right margins. */
  #persona-narrative.section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(10, 22, 28, 0.86) 16%,
      rgba(10, 22, 28, 0.86) 84%,
      transparent 100%
    );
  }
  #persona-capabilities.section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(16, 35, 45, 0.86) 16%,
      rgba(16, 35, 45, 0.86) 84%,
      transparent 100%
    );
  }
  @media (max-width: 720px) {
    #persona-narrative.section::after {
      background: linear-gradient(
        90deg,
        rgba(10, 22, 28, 0.55) 0%,
        rgba(10, 22, 28, 0.9) 18%,
        rgba(10, 22, 28, 0.9) 82%,
        rgba(10, 22, 28, 0.55) 100%
      );
    }
    #persona-capabilities.section::after {
      background: linear-gradient(
        90deg,
        rgba(16, 35, 45, 0.55) 0%,
        rgba(16, 35, 45, 0.9) 18%,
        rgba(16, 35, 45, 0.9) 82%,
        rgba(16, 35, 45, 0.55) 100%
      );
    }
  }
  #persona-narrative > .container,
  #persona-capabilities > .container {
    position: relative;
    z-index: 1;
  }
</style>
