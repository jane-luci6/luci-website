---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeDifferentiator from '../components/HomeDifferentiator.astro';
import HomeLedger from '../components/HomeLedger.astro';
import HomeIndustries from '../components/HomeIndustries.astro';
import HomeIntro from '../components/HomeIntro.astro';
import HomeTrustBar from '../components/HomeTrustBar.astro';
import HomeProof from '../components/HomeProof.astro';
import HomePersonas from '../components/HomePersonas.astro';
import HomeResources from '../components/HomeResources.astro';
import SectionBlock from '../components/SectionBlock.astro';
import { site } from '../data/site';
---

<BaseLayout title="Home" description={site.subTagline} darkHeader>
  <HomeHero />
  <HomeDifferentiator />
  <HomeLedger />
  <HomeIndustries />
  <HomeIntro />
  <HomeTrustBar />
  <HomePersonas />
  <HomeProof />
  <HomeResources />

  <SectionBlock tone="deep">
    <h2 class="h2">Ready to see LUCI on your property?</h2>
    <p class="measure" style="margin-top: 1rem; color: rgba(245, 248, 250, 0.82)">
      {site.tagline} — {site.subTagline}
    </p>
    <div class="btn-row">
      <a class="btn btn--mint" href="/contact">{site.ctaPrimary}</a>
      <a class="btn btn--ghost" href="/platform">{site.ctaSecondary}</a>
    </div>
  </SectionBlock>
</BaseLayout>
