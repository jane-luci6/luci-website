---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeDifferentiator from '../components/HomeDifferentiator.astro';
import HomeLedger from '../components/HomeLedger.astro';
import HomeIndustries from '../components/HomeIndustries.astro';
import HomeIntro from '../components/HomeIntro.astro';
import HomeTrustBar from '../components/HomeTrustBar.astro';
import HomeProof from '../components/HomeProof.astro';
import HomePersonas from '../components/HomePersonas.astro';
import HomeWhyItMatters from '../components/HomeWhyItMatters.astro';
import HomePlatformRun from '../components/HomePlatformRun.astro';
import SectionBlock from '../components/SectionBlock.astro';
import HomeMesh from '../components/HomeMesh.astro';
import { site } from '../data/site';
---

<BaseLayout title="Home" description={site.subTagline} darkHeader>
  <HomeMesh />
  <HomeHero variant="none" zones askInput />
  <HomeDifferentiator />
  <HomeIntro photoSrc="/images/venue-guest-experience-casual-v2.jpg?v=1" />
  <HomeLedger />
  <HomeWhyItMatters />
  <HomeProof />
  <HomePlatformRun />
  <HomeIndustries />
  <HomePersonas />
  <HomeTrustBar />

  <SectionBlock id="home-cta" tone="deep">
    <div class="home-cta">
      <p class="display-label home-cta__kicker">Next step</p>
      <h2 class="home-cta__title">See LUCI on <em>your floor</em>.</h2>
      <a class="btn btn--mint-outline home-cta__btn" href="/contact">{site.ctaPrimary}</a>
    </div>
  </SectionBlock>
</BaseLayout>

