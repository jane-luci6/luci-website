</style>

<script>
  (function () {
    var switcher = document.querySelector('[data-thesis-switcher]');
    if (!switcher) return;
    var btns = Array.prototype.slice.call(switcher.querySelectorAll('[data-thesis-btn]'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.ug-mock-thesis'));

    function activate(id, opts) {
      var opts = opts || {};
      btns.forEach(function (b) {
        var match = String(b.getAttribute('data-thesis-btn')) === String(id);
        b.setAttribute('aria-selected', match ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        var match = String(p.getAttribute('data-thesis')) === String(id);
        if (match) {
          p.removeAttribute('hidden');
          p.classList.add('is-active');
        } else {
          p.setAttribute('hidden', '');
          p.classList.remove('is-active');
        }
      });
      if (!opts.skipHistory) {
        var url = new URL(window.location.href);
        url.searchParams.set('thesis', String(id));
        window.history.replaceState(null, '', url.toString());
      }
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        activate(b.getAttribute('data-thesis-btn'));
      });
    });

    // Deep-link: ?thesis=1|2|3 wins; else #thesis-N hash; else default 1.
    var params = new URLSearchParams(window.location.search);
    var requested = params.get('thesis');
    if (!requested) {
      var hash = window.location.hash.replace(/^#thesis-/, '');
      if (/^[1-3]$/.test(hash)) requested = hash;
    }
    if (requested && /^[1-3]$/.test(requested)) {
      activate(requested, { skipHistory: true });
    } else {
      activate(1, { skipHistory: true });
    }
  })();
</script>
