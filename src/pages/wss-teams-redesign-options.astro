---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamsOrbit from '../components/teams-redesign/TeamsOrbit.astro';
import TeamsDial from '../components/teams-redesign/TeamsDial.astro';
import TeamsFilmstrip from '../components/teams-redesign/TeamsFilmstrip.astro';
import TeamsConstellation from '../components/teams-redesign/TeamsConstellation.astro';

const variants = [
  {
    tag: 'A',
    title: 'Orbit — refined',
    desc: 'The ring concept, rebuilt: no boxy panel, no spoke lines. A bigger guest-experience core, six teams on a soft circular path, and the selected role\u2019s detail floats centered beneath the stage.',
    Component: TeamsOrbit,
  },
  {
    tag: 'B',
    title: 'Dial',
    desc: 'A control-panel gauge. Six role labels sit around the rim; a needle points to the active one and the readout swaps inside the hub itself \u2014 like turning a dial to a channel.',
    Component: TeamsDial,
  },
  {
    tag: 'C',
    title: 'Filmstrip',
    desc: 'A horizontal beam of light travels through six stations left to right \u2014 the guest experience running through every team, literally. Linear instead of radial; reads naturally top-to-bottom on mobile.',
    Component: TeamsFilmstrip,
  },
  {
    tag: 'D',
    title: 'Constellation',
    desc: 'An asymmetric network graph \u2014 six nodes scattered at varied distances from the guest-experience core, connected by thin lines like a star map. Less geometric, more organic than a perfect ring.',
    Component: TeamsConstellation,
  },
];
---

<BaseLayout title="Teams redesign — options" description="Four distinct directions for the Who We Serve teams selector.">
  <div class="tro-opts">
    <div class="tro-opts__intro container container--wide">
      <h1 class="h2">Teams selector — four directions</h1>
      <p class="measure">Same six roles, same guest-experience core, same job (pick a role, see what they do, jump to their page) \u2014 four different visual and interaction concepts. Scroll through and compare; click around on each one.</p>
    </div>

    {variants.map(({ tag, title, desc, Component }) => (
      <section class="tro-opts__variant">
        <div class="tro-opts__variant-head container container--wide">
          <span class="tro-opts__tag">{tag}</span>
          <div>
            <h2 class="tro-opts__title">{title}</h2>
            <p class="tro-opts__desc">{desc}</p>
          </div>
        </div>
        <div class="tro-opts__stage container container--wide">
          <Component />
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .tro-opts { padding-block: clamp(40px, 6vw, 64px); background: var(--navy-deep); color: var(--off-white); }
  .tro-opts__intro { max-width: 64ch; margin-bottom: clamp(28px, 4vw, 44px); }
  .tro-opts__intro .h2 { color: var(--off-white); margin: 0 0 1rem; }
  .tro-opts__intro .measure { color: rgba(245, 248, 250, 0.72); }

  .tro-opts__variant + .tro-opts__variant { margin-top: clamp(48px, 7vw, 84px); padding-top: clamp(48px, 7vw, 84px); border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .tro-opts__variant-head { display: flex; gap: 16px; align-items: flex-start; margin-bottom: clamp(24px, 3.5vw, 36px); }
  .tro-opts__tag {
    flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 9999px;
    background: rgba(104, 227, 190, 0.14); color: var(--mint);
    font-family: var(--font-display); font-size: 13px; font-weight: 700;
  }
  .tro-opts__title {
    margin: 0 0 6px;
    font-family: var(--font-body); font-size: clamp(20px, 2vw, 26px); font-weight: 700;
    letter-spacing: -0.015em; line-height: 1.15; color: var(--off-white);
  }
  .tro-opts__desc { margin: 0; max-width: 72ch; font-size: 15px; line-height: 1.55; color: rgba(245, 248, 250, 0.72); }
  .tro-opts__stage { max-width: var(--content-wide); }
</style>
