---
import BaseLayout from '../layouts/BaseLayout.astro';

const options = [
  {
    n: '01',
    name: 'The guest',
    desc: 'A single person — gold head, mint shoulders. The most literal: the experience is for the guest. (Refined version of what is live today.)',
    svg: `<svg viewBox="0 0 64 64" fill="none" stroke="#2b9e80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="24" r="9" fill="#CEB06E" fill-opacity="0.85"/><path d="M16 52c0-9.94 8.06-18 16-18s16 8.06 16 18"/></svg>`,
  },
  {
    n: '02',
    name: 'Radiant guest',
    desc: 'The guest at the center with the experience radiating outward across the property — concentric rings (mint, gold dashed, faint mint).',
    svg: `<svg viewBox="0 0 64 64" fill="none" stroke-linecap="round"><circle cx="32" cy="28" r="6" fill="#CEB06E" fill-opacity="0.9"/><path d="M22 46c0-5.5 4.5-10 10-10s10 4.5 10 10" stroke="#2b9e80" stroke-width="2.2" stroke-linejoin="round"/><circle cx="32" cy="32" r="13" stroke="#2b9e80" stroke-width="1.8" stroke-opacity="0.55"/><circle cx="32" cy="32" r="20" stroke="#CEB06E" stroke-width="1.6" stroke-opacity="0.45" stroke-dasharray="3 5"/><circle cx="32" cy="32" r="27" stroke="#2b9e80" stroke-width="1.4" stroke-opacity="0.28"/></svg>`,
  },
  {
    n: '03',
    name: 'The crowd',
    desc: 'A central gold guest with smaller mint guests orbiting around it — every guest, at scale. Reads as: the whole room, not one person.',
    svg: `<svg viewBox="0 0 64 64" fill="none" stroke="#2b9e80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="30" r="6" fill="#CEB06E" fill-opacity="0.9"/><path d="M24 46c0-4.4 3.6-8 8-8s8 3.6 8 8"/><circle cx="14" cy="18" r="3"/><path d="M10 26c0-2.2 1.8-4 4-4s4 1.8 4 4"/><circle cx="50" cy="16" r="3"/><path d="M46 24c0-2.2 1.8-4 4-4s4 1.8 4 4"/><circle cx="12" cy="46" r="3"/><path d="M8 54c0-2.2 1.8-4 4-4s4 1.8 4 4"/><circle cx="52" cy="44" r="3"/><path d="M48 52c0-2.2 1.8-4 4-4s4 1.8 4 4"/></svg>`,
  },
  {
    n: '04',
    name: 'Atmosphere orb',
    desc: 'No person at all — a gold core with radiating mint rings, a dashed gold outer ring, and four gold rays. Pure ambiance: the energy the guest feels.',
    svg: `<svg viewBox="0 0 64 64" fill="none" stroke-linecap="round"><circle cx="32" cy="32" r="6" fill="#CEB06E" fill-opacity="0.95"/><circle cx="32" cy="32" r="13" stroke="#2b9e80" stroke-width="2" stroke-opacity="0.7"/><circle cx="32" cy="32" r="20" stroke="#2b9e80" stroke-width="1.6" stroke-opacity="0.45"/><circle cx="32" cy="32" r="27" stroke="#CEB06E" stroke-width="1.4" stroke-opacity="0.4" stroke-dasharray="3 5"/><path d="M32 5v7M32 52v7M5 32h7M52 32h7" stroke="#CEB06E" stroke-width="2" stroke-opacity="0.55"/></svg>`,
  },
  {
    n: '05',
    name: 'Spotlight guest',
    desc: 'A guest standing in a cone of light — the guest as the focus, the star of the show. The beam is gold; the guest is gold-headed, mint-shouldered.',
    svg: `<svg viewBox="0 0 64 64" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4L42 4L46 28L18 28Z" fill="#CEB06E" fill-opacity="0.2" stroke="#CEB06E" stroke-width="1.6" stroke-opacity="0.6"/><circle cx="32" cy="40" r="6" fill="#CEB06E" fill-opacity="0.9"/><path d="M22 56c0-5.5 4.5-10 10-10s10 4.5 10 10" stroke="#2b9e80" stroke-width="2.2"/></svg>`,
  },
];
---

<BaseLayout title="Guest experience globe — options" description="Five visualizations for the guest-experience landing zone on the Operations page" darkHeader>
  <div class="ggo">
    <div class="ggo__intro">
      <span class="ggo__intro-k">Guest experience globe — 5 options</span>
      <span class="ggo__intro-d">Five directions for the orb at the end of the “What you can do” flow on the Operations page. Each is shown in the same dark-orb treatment (gold border, mint+gold gradient) it will live in. Pick one and we will wire it in. (The orb container itself is not changing — only the figure inside.)</span>
    </div>

    <div class="ggo__grid">
      {options.map((o) => (
        <figure class="ggo__card">
          <div class="ggo__orb">
            <div class="ggo__orb-figure" set:html={o.svg} />
          </div>
          <span class="ggo__card-n">{o.n}</span>
        </figure>
        <figcaption class="ggo__card-meta">
          <h3 class="ggo__card-name">{o.name}</h3>
          <p class="ggo__card-desc">{o.desc}</p>
        </figcaption>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .ggo { background: var(--navy-deep); min-height: 100%; }
  .ggo__intro {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px var(--page-pad);
    background: var(--navy);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ggo__intro-k {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .ggo__intro-d {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: rgba(245, 248, 250, 0.72);
    max-width: 80ch;
  }

  .ggo__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(28px, 3vw, 48px) clamp(20px, 3vw, 40px);
    padding: clamp(40px, 6vw, 80px) var(--page-pad);
  }

  .ggo__card {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .ggo__orb {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(220px, 22vw, 300px);
    height: clamp(220px, 22vw, 300px);
    border-radius: 9999px;
    background:
      radial-gradient(circle at 50% 40%, rgba(104, 227, 190, 0.2) 0%, rgba(104, 227, 190, 0) 60%),
      linear-gradient(160deg, rgba(206, 176, 110, 0.22) 0%, rgba(8, 17, 22, 0.4) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(206, 176, 110, 0.42),
      0 0 48px rgba(var(--mint-rgb), 0.16);
  }
  .ggo__orb-figure { width: 58%; height: 58%; display: grid; place-items: center; }
  .ggo__orb-figure :global(svg) { width: 100%; height: 100%; display: block; }

  .ggo__card-n {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: rgba(206, 176, 110, 0.5);
  }

  .ggo__card-meta { max-width: 36ch; text-align: center; }
  .ggo__card-name {
    margin: 0 0 6px;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--off-white);
  }
  .ggo__card-desc {
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(245, 248, 250, 0.66);
  }
</style>
