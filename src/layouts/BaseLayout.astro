---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  darkHeader?: boolean;
}

const { title, description = site.subTagline, darkHeader = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.tagline} · ${site.name}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        var KEY = 'luci-theme';
        try {
          var saved = localStorage.getItem(KEY);
          document.documentElement.setAttribute(
            'data-theme',
            saved === 'light' || saved === 'dark' ? saved : 'dark',
          );
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Syncopate:wght@700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>

    <!-- Google Analytics 4 — only loads on the production hostname and only when a
         Measurement ID is configured, so the review VM (10.10.1.37) and localhost
         never load gtag.js or pollute the data. -->
    <script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
      (function () {
        var GA_ID = gaId;
        if (!GA_ID) return;
        var host = location.hostname;
        if (host !== 'lucisystems.com' && host !== 'www.lucisystems.com') return;
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
        var el = document.createElement('script');
        el.async = true;
        el.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(el);
      })();
    </script>
  </head>
  <body>
    <Header dark={darkHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  main {
    min-height: 60vh;
  }
</style>
